//Output commands for the command ReportWriteNormal
template ReportWriteNormal
begin
   if (NOT report_write_teststep(RES_Text))
   begin
      Data = RES_Text;
      Pos = StrPosition('<br>', StrLowerCase(Data));
      while (Pos > 0)
      begin
         Pos = Pos - 1;
         Line = StrCopy(Data, 1, Pos);
         WriteLn(Line);
         Chars = Pos + 4;
         Data = StrDelete(Data, 1, Chars);
         Pos = StrPosition('<br>', StrLowerCase(Data));
      end;
      Write(Data);
   end;
end;

