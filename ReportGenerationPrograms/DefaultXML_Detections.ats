function write_detections_result(TestStepResult: integer): void;
begin
   Line = '<TestStepResult Type="Detections">';
   write_line(Line);
   inc_indent();
   switch (TestStepResult)
   begin
      case TESTSTEP_Passed:
      begin
         Text = 'Passed';
      end;
      case TESTSTEP_Failed:
      begin
         Text = 'Failed';
      end;
      default: begin
         Text = 'Invalid';
      end;
   end;
   Line = '<Result>' + Text + '</Result>';
   write_line(Line);
   dec_indent();
   write_line('</TestStepResult>');
end;

template LV_ConnectorDetectionTest
begin
   write_line('<TestStep Cmd="LV_ConnectorDetectionTest">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_one_lv_pin_basics(RES_Name, RES_Pin);
   write_detections_result(RES_Result);
   dec_indent();
   write_line('</TestStep>');
end;

template LV_DetectionTest
begin
   write_line('<TestStep Cmd="LV_DetectionTest">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_two_lv_pin_basics(RES_Name, RES_Pin1, RES_Pin2);
   write_detections_result(RES_Result);
   dec_indent();
   write_line('</TestStep>');
end;
