template DiodeTest
begin
   write_line('<TestStep Cmd="DiodeTest">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_two_pin_basics(RES_Name, RES_Pin1, RES_Pin2, RES_OriginalPin1, RES_OriginalPin2);
   ErroInfo = '';
   if (RES_Result == TESTSTEP_Failed)
   begin
      if (RES_U1Ok AND (NOT RES_U2Ok) AND RES_U3Ok)
      begin
         ErroInfo = 'Open';
      end
      else
      begin
         if ((NOT RES_U1Ok) AND RES_U2Ok AND (NOT RES_U3Ok))
         begin
            ErroInfo = 'Short';
         end
         else
         begin
            if (RES_U1Ok AND (NOT RES_U2Ok) AND (NOT RES_U3Ok))
            begin
               ErroInfo = 'Reversed';
            end
            else
            begin
               ErroInfo = 'Defective';
            end;
         end;
      end;
   end;
   write_electrical_component_result('Diode', RES_Result, RES_ExtVoltageFound, RES_Arc, ErroInfo);
   dec_indent();
   write_line('</TestStep>');
end;

