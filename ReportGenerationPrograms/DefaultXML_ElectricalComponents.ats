function write_electrical_component_result(Component: string; TestStepResult: integer; IsExternalVoltage,
   IsArc: boolean; ErrorInfo: string = ''): void;
begin
   Line = '<TestStepResult Type="' + Component + '">';
   write_line(Line);
   inc_indent();
   switch (TestStepResult)
   begin
      case TESTSTEP_Passed:
      begin
         Text = 'Passed';
      end;
      case TESTSTEP_Failed:
      begin
         Text = 'Failed';
      end;
      default: begin
         Text = 'Invalid';
      end;
   end;
   Line = '<Result>' + Text + '</Result>';
   write_line(Line);
   Line = '<ExtVoltageFound>' + IsExternalVoltage + '</ExtVoltageFound>';
   write_line(Line);
   Line = '<Arc>' + IsArc + '</Arc>';
   write_line(Line);
   if (StrCompare(ErrorInfo, '') <> 0)
   begin
      Line = '<ErrorInfo>' + ErrorInfo + '</ErrorInfo>';
      write_line(Line);
   end;
   dec_indent();
   write_line('</TestStepResult>');
end;

template ResistorTest
begin
   write_line('<TestStep Cmd="ResistorTest">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_two_pin_basics(RES_Name, RES_Pin1, RES_Pin2, RES_OriginalPin1, RES_OriginalPin2);
   write_value_and_tolerances(RES_Resistance, RES_LowerTol, RES_UpperTol, 'Ohm');
   write_electrical_component_result('Resistor', RES_Result, RES_ExtVoltageFound, RES_Arc);
   Line = get_value_with_prefix('Resistance', 'Ohm', RES_Prefix, RES_Value);
   write_line(Line);
   dec_indent();
   write_line('</TestStep>');
end;

