template SimpleNoConnPinVsGroupDB
begin
   write_line('<TestStep Cmd="SimpleNoConnPinVsGroupDB">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   MiscCreateList(HighGroupPins, 1);
   HighGroupPins[1] = RES_Pin;
   write_group_pin_basics(RES_Name, '', RES_LowGroup, 1, RES_LowGroupPinCount, HighGroupPins,
      RES_LowGroupPins);
   write_dielectricbreakdown_parameters(RES_DBVoltage, RES_DBTrise, RES_DBTwait, RES_DBTmeas,
      RES_DBTmeasFactor, RES_DBVoltageRamp, RES_DBThresholdIr, RES_DBThresholdIi);

   write_dielectricbreakdown_result(RES_Result, FALSE, FALSE);
   if (RES_Result == TESTSTEP_Passed)
   begin
