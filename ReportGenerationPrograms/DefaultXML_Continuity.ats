template NoConnAll
begin
   write_line('<TestStep Cmd="NoConnAll">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_one_pin_basics(RES_Name, RES_Pin, RES_OriginalPin);
   write_continuity_parameters(RES_CCurrent, RES_CThreshold, RES_CTrise, RES_CTwait,
      RES_CTmeas, RES_CAutoRange, RES_CVoltageLimit);

   write_continuity_result(RES_Result, FALSE, FALSE);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Line = get_value_with_prefix('Resistance', 'Ohm', RES_Prefix, RES_Value);
      write_line(Line);
   end
   else
   begin
      if (RES_ErrorPinCount > 0)
      begin
         write_line('<Fails>');
         inc_indent();
         for Index = 1 to RES_ErrorPinCount do
         begin
            write_line('<Fail>');
            inc_indent();

            Line = '<PinAddr>' + RES_ErrorPins[Index] + '</PinAddr>';
            write_line(Line);
            PinName = get_pin_name(RES_ErrorPins[Index]);
            Line = '<PinName>' + PinName + '</PinName>';
            write_line(Line);
            Line = '<Arc>' + RES_Arcs[Index] + '</Arc>';
            write_line(Line);
            Line = get_value_with_prefix('Resistance', 'Ohm', RES_Prefixes[Index], RES_Values[Index]);
            write_line(Line);
            dec_indent();
            write_line('</Fail>');
         end;
         dec_indent();
         write_line('</Fails>');
      end;
   end;
   dec_indent();
   write_line('</TestStep>');
end;

