template WireTest
begin
   write_line('<TestStep Cmd="WireTest">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_two_pin_basics(RES_Name, RES_Pin1, RES_Pin2, RES_OriginalPin1, RES_OriginalPin2);
   write_continuity_parameters(RES_CCurrent, RES_CThreshold, RES_CTrise, RES_CTwait,
      RES_CTmeas, RES_CAutoRange, RES_CVoltageLimit);
   write_continuity_result(RES_Result, RES_ExtVoltageFound, RES_Arc);
   Line = get_value_with_prefix('Resistance', 'Ohm', RES_Prefix, RES_Value);
   write_line(Line);

   if (RES_Result == TESTSTEP_Failed)
   begin
      write_interchanges(RES_Pin1, RES_Pin2, RES_InterchangedWiresPin1, RES_InterchangedWiresPin2);
   end;
   dec_indent();
   write_line('</TestStep>');
end;

template SwitchTest
begin
   write_line('<TestStep Cmd="SwitchTest">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_two_pin_basics(RES_Name, RES_Pin1, RES_Pin2, RES_OriginalPin1, RES_OriginalPin2);
   write_continuity_parameters(RES_CCurrent, RES_CThreshold, RES_CTrise, RES_CTwait,
      RES_CTmeas, RES_CAutoRange, RES_CVoltageLimit);
   Line = '<SwitchClosed>' + RES_SwitchClosed + '</SwitchClosed>';
   write_line(Line);
   write_continuity_result(RES_Result, RES_ExtVoltageFound, RES_Arc);
   Line = get_value_with_prefix('Resistance', 'Ohm', RES_Prefix, RES_Value);
   write_line(Line);
   dec_indent();
   write_line('</TestStep>');
end;

