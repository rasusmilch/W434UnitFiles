function write_continuity_result(TestStepResult: integer; IsExternalVoltage, IsArc: boolean): void;
begin
   Line = '<TestStepResult Type="Continuity">';
   write_line(Line);
   inc_indent();
   switch (TestStepResult)
   begin
      case TESTSTEP_Passed:
      begin
         Text = 'Passed';
      end;
      case TESTSTEP_Failed:
      begin
         Text = 'Failed';
      end;
      default: begin
         Text = 'Invalid';
      end;
   end;
   Line = '<Result>' + Text + '</Result>';
   write_line(Line);
   Line = '<ExtVoltageFound>' + IsExternalVoltage + '</ExtVoltageFound>';
   write_line(Line);
   Line = '<Arc>' + IsArc + '</Arc>';
   write_line(Line);
   dec_indent();
   write_line('</TestStepResult>');
end;

function write_interchanges(Pin1, Pin2, InterchangePin1, InterchangePin2: integer): void;
begin
   HasInterchanges = (InterchangePin1 <> PINADDRESS_None) OR
      (InterchangePin2 <> PINADDRESS_None);
   if (HasInterchanges)
   begin
      write_line('<Interchanges>');
      inc_indent();
      if (InterchangePin1 <> PINADDRESS_None)
      begin
         write_line('<Interchange>');
         inc_indent();
         Pin1 = get_pin_name(Pin1);
         Pin2 = get_pin_name(InterchangePin1);
         Line = '<Pin1>' + Pin1 + '</Pin1>';
         write_line(Line);
         Line = '<Pin2>' + Pin2 + '</Pin2>';
         write_line(Line);
         dec_indent();
         write_line('</Interchange>');
      end;
      if (InterchangePin2 <> PINADDRESS_None)
      begin
         write_line('<Interchange>');
         inc_indent();
         Pin1 = get_pin_name(Pin2);
         Pin2 = get_pin_name(InterchangePin2);
         Line = '<Pin1>' + Pin1 + '</Pin1>';
         write_line(Line);
         Line = '<Pin2>' + Pin2 + '</Pin2>';
         write_line(Line);
         dec_indent();
         write_line('</Interchange>');
      end;
      dec_indent();
      write_line('</Interchanges>');
   end;
end;

template ParamContinuity
begin
   write_line('<TestStep Cmd="ParamContinuity">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_continuity_parameters(RES_CCurrent, RES_CThreshold, RES_CTrise, RES_CTwait,
      RES_CTmeas, RES_CAutoRange, RES_CVoltageLimit);
   dec_indent();
   write_line('</TestStep>');
end;

