               UIWriteError(Line2);
            end;
         end;
      end;
   end;
end;

//Output for the command NoConnGroup3xHV
template NoConnGroup3xHV
begin
   Name = get_teststep_name(RES_Name, LocalText('218#NCG 3xHV'));
   Name = format_teststep_name(Name);
   HighGroup = format_teststep_pin(RES_HighGroup);
   LowGroup = format_teststep_pin(RES_LowGroup);
   if (RES_Result == TESTSTEP_Passed)
   begin
      ResultText = format_teststep_result(LocalText('5#Passed'));
      Value = LocalText('211#HV1') + ': ';
      Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
      Value = StrAdd(Value, get_double_dash_text(LocalText('212#HV2')));
      Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix, RES_HV2Value));
      if (RES_HV3Done)
      begin
         Value = StrAdd(Value, get_double_dash_text(LocalText('213#HV3')));
         Value = StrAdd(Value, get_resistance_value(RES_HV3Prefix, RES_HV3Value));
      end;
      Line1 = StrAdd(ResultText, Name);
      Line1 = StrAdd(Line1, HighGroup);
      Line1 = StrAdd(Line1, LowGroup);
      UIWriteNormal(Line1);
      Space = format_teststep_result(' ');
      Line2 = StrAdd(Space, Value);
      UIWriteNormal(Line2);
   end
   else
   begin
      if (RES_ErrorInfo == ISOLATION_3xHV_1_3_Error)
      begin
         Line1 = '';
         Line2 = '';
         get_3xhv_1_3_error(Name, RES_HighGroup, RES_LowGroup, RES_HV1Prefix, RES_HV1Value,
            RES_HV2Prefix, RES_HV2Value, RES_HV3Prefix, RES_HV3Value, Line1, Line2);
         UIWriteError(Line1);
         UIWriteError(Line2);
      end
      else
      begin
         for Index = 1 to RES_ErrorCount do
         begin
            IsArc = RES_HVArcs[Index];
            IsdIdt = RES_HVdIdts[Index];
            IsEnergyLimit = RES_HVELims[Index];
            IsShort = (NOT IsArc) AND (NOT IsdIdt) AND (NOT IsEnergyLimit);
            ResultText = get_hv_isolation_error_text(IsArc, IsdIdt, IsEnergyLimit);
            Value = ' ';
            if (IsShort)
            begin
               Value = get_resistance_value(RES_HVPrefixes[Index], RES_HVValues[Index]);
            end;
            if ((RES_ErrorHighPins[Index] == PINADDRESS_NotSearched) OR
                (RES_ErrorHighPins[Index] == PINADDRESS_NotFound))
            begin
               Pin1 = RES_HighGroup;
            end
            else
            begin
               Pin1 = get_pinname(RES_ErrorHighPins[Index]);
            end;
            if ((RES_ErrorLowPins[Index] == PINADDRESS_NotSearched) OR
                (RES_ErrorLowPins[Index] == PINADDRESS_NotFound))
            begin
               Pin2 = RES_LowGroup;
            end
            else
            begin
               Pin2 = get_pinname(RES_ErrorLowPins[Index]);
            end;
            Pin1 = format_teststep_pin(Pin1);
            Pin2 = format_teststep_pin(Pin2);
            FailText = get_3xhv_fail_text(RES_ErrorInfo);
            Line1 = StrAdd(format_teststep_result(ResultText), Name);
            Line1 = StrAdd(Line1, Pin1);
            Line1 = StrAdd(Line1, Pin2);
            Line1 = StrAdd(Line1, FailText);
            UIWriteError(Line1);
            if (StrCompare(StrTrim(Value), '') <> 0)
            begin
               Line2 = StrAdd(format_teststep_result(' '), Value);
               UIWriteError(Line2);
            end;
            short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
         end;
      end;
   end;
end;
