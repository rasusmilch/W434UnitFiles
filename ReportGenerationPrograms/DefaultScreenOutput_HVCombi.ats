//Output for the command ParamIsolationHVCombi
template ParamIsolationHVCombi
begin
   Line = '';
   if (RES_HVCLowerHV2TolChanged)
   begin
      Value = RES_HVCLowerHV2Tol;
      Line = StrAdd(Line, LocalText('138#Lower tol.'));
      Line = Line + '=' + Value + '%; ';
   end;
   if (RES_HVCUpperHV2TolChanged)
   begin
      Value = RES_HVCUpperHV2Tol;
      Line = StrAdd(Line, LocalText('139#Upper tol.'));
      Line = Line + '=' + Value + '%; ';
   end;
   if (RES_HVCDelay1Changed)
   begin
      Value = FormatTime(RES_HVCDelay1);
      Line = StrAdd(Line, LocalText('140#Delay 1'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_HVCDelay2Changed)
   begin
      Value = FormatTime(RES_HVCDelay2);
      Line = StrAdd(Line, LocalText('141#Delay 2'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_HVCExecuteHV2Changed)
   begin
      if (RES_HVCExecuteHV2)
      begin
         Value = LocalText('143#Yes');
      end
      else
      begin
         Value = LocalText('144#No');
      end;
      Line = StrAdd(Line, LocalText('142#Execute HV 2'));
      Line = Line + '=' + Value + '; ';
   end;
   if (StrCompare(Line, '') <> 0)
   begin
      Pos = StrLength(Line) - 1;
      Line = StrDelete(Line, Pos, 2);
      UIWriteNormal(LocalText('145#Parameters for the combined high voltage test'));
      UIWriteNormal(Line);
   end;
end;

//Output for the command NoConnectionHVCombi
template NoConnectionHVCombi
begin
   Name = get_teststep_name(RES_Name, LocalText('208#NC HVCombi'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
         end;
         case TESTSTEP_Failed:
         begin
            IsArc = RES_HV1Arc OR RES_DBArc OR RES_HV2Arc;
            IsdIdt = RES_HV1dIdt OR RES_HV2dIdt;
            IsEnergyLimit = RES_HV1ELim OR RES_HV2ELim;
            ResultText = get_hv_isolation_error_text(IsArc, IsdIdt, IsEnergyLimit);
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
         end;
      end;
      ResultText = format_teststep_result(ResultText);

      DBValue = TRUE;
      HV2Value = RES_HV2Done;
      FailText = get_hv_combi_fail_text(RES_ErrorInfo);
      switch (RES_ErrorInfo)
      begin
         case HV_COMBI_HV1Error: begin
            DBValue = FALSE;
            HV2Value = FALSE;
         end;
         case HV_COMBI_DBError: begin
            HV2Value = FALSE;
         end;
      end;
      Value = StrAdd(LocalText('205#HV1'), ': ');
      ValueText = get_hv_isolation_value_text(RES_HV1Arc, RES_HV1dIdt, RES_HV1ELim, RES_HV1Prefix, RES_HV1Value);
      Value = StrAdd(Value, ValueText);
      if (DBValue)
      begin
         Value = StrAdd(Value, get_double_dash_text(LocalText('204#DB')));
         if (RES_DBArc)
         begin
            ValueText = LocalText('202#Arc');
         end
         else
         begin
            ValueText = get_dielectric_breakdown_value(RES_DBArc, RES_DBValueValid,
               RES_DBValueIr, RES_DBPrefixIr, RES_DBValueIi, RES_DBPrefixIi);
         end;
         Value = StrAdd(Value, ValueText);
      end;
      if (HV2Value)
      begin
         Value = StrAdd(Value, get_double_dash_text(LocalText('206#HV2')));
         ValueText = get_hv_isolation_value_text(RES_HV2Arc, RES_HV2dIdt, RES_HV2ELim, RES_HV2Prefix, RES_HV2Value);
         Value = StrAdd(Value, ValueText);
      end;
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
      Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
      Line1 = StrAdd(ResultText, Name);
      Line1 = StrAdd(Line1, Pin1);
      Line1 = StrAdd(Line1, Pin2);
      Line1 = StrAdd(Line1, FailText);
      Space = format_teststep_result(' ');
      Line2 = StrAdd(Space, Value);
      if (RES_Result == TESTSTEP_Passed)
      begin
         UIWriteNormal(Line1);
         UIWriteNormal(Line2);
      end
      else
      begin
         UIWriteError(Line1);
         short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
         UIWriteError(Line2);
      end;
   end;
end;

//Output for the command NoConnAllHVCombi
template NoConnAllHVCombi
begin
   Name = get_teststep_name(RES_Name, LocalText('209#NCA HVCombi'));
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_pinname(RES_Pin));
   if (RES_Result == TESTSTEP_Passed)
   begin
      Value = StrAdd(LocalText('205#HV1'), ': ');
      Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
      Value = StrAdd(Value, get_double_dash_text(LocalText('204#DB')));
      Value = StrAdd(Value, get_dielectric_breakdown_value(RES_DBArc, RES_DBValueValid,
         RES_DBValueIr, RES_DBPrefixIr, RES_DBValueIi, RES_DBPrefixIi));
      if (RES_HV2Done)
      begin
         Value = StrAdd(Value, get_double_dash_text(LocalText('206#HV2')));
         Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix, RES_HV2Value));
      end;
      Line1 = StrAdd(format_teststep_result(LocalText('5#Passed')), Name);
      Line1 = StrAdd(Line1, Pin1);
      Line1 = StrAdd(Line1, format_teststep_pin(' '));
      Line2 = StrAdd(format_teststep_result(' '), Value);
      UIWriteNormal(Line1);
      UIWriteNormal(Line2);
   end
   else
   begin
      if (RES_ErrorInfo == HV_COMBI_HV1HV2Error)
      begin
         Pin2 = format_teststep_pin(get_pinname(PINADDRESS_NotSearched));
         FailText = get_hv_combi_fail_text(HV_COMBI_HV1HV2Error);
         Value = StrAdd(LocalText('205#HV1'), ': ');
         Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
         Value = StrAdd(Value, get_double_dash_text(LocalText('204#DB')));
         Value = StrAdd(Value, get_dielectric_breakdown_value(RES_DBArc, RES_DBValueValid,
            RES_DBValueIr, RES_DBPrefixIr, RES_DBValueIi, RES_DBPrefixIi));
         Value = StrAdd(Value, get_double_dash_text(LocalText('206#HV2')));
         Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix, RES_HV2Value));
         Line1 = StrAdd(format_teststep_result(LocalText('16#Error')), Name);
         Line1 = StrAdd(Line1, Pin1);
         Line1 = StrAdd(Line1, Pin2);
         Line1 = StrAdd(Line1, FailText);
         UIWriteError(Line1);
         Line2 = StrAdd(format_teststep_result(' '), Value);
         UIWriteError(Line2);
      end
      else
      begin
         for Index = 1 to RES_ErrorPinCount do
         begin
            IsArc = RES_HVArcs[Index] OR RES_DBArcs[Index];
            IsdIdt = RES_HVdIdts[Index];
            IsEnergyLimit = RES_HVELims[Index];
            IsShort = (NOT IsArc) AND (NOT IsdIdt) AND (NOT IsEnergyLimit);
            ResultText = get_hv_isolation_error_text(IsArc, IsdIdt, IsEnergyLimit);
            Value = ' ';
            if (IsShort)
            begin
               if (RES_ErrorInfo == HV_COMBI_DBError)
               begin
                  Value = get_dielectric_breakdown_value(RES_DBArcs[Index], RES_DBValuesValid[Index],
                     RES_DBValuesIr[Index], RES_DBPrefixesIr[Index], RES_DBValuesIi[Index],
                     RES_DBPrefixesIi[Index]);
               end
               else
               begin
                  Value = get_resistance_value(RES_HVPrefixes[Index], RES_HVValues[Index]);
               end;
            end;
            Pin2 = format_teststep_pin(get_pinname(RES_ErrorPins[Index]));
            FailText = get_hv_combi_fail_text(RES_ErrorInfo);
            Line1 = StrAdd(format_teststep_result(ResultText), Name);
            Line1 = StrAdd(Line1, Pin1);
            Line1 = StrAdd(Line1, Pin2);
            Line1 = StrAdd(Line1, FailText);
            UIWriteError(Line1);
            if (StrCompare(StrTrim(Value), '') <> 0)
            begin
               Line2 = StrAdd(format_teststep_result(' '), Value);
               UIWriteError(Line2);
            end;
         end;
      end;
   end;
end;

//Output for the command NoConnLowerHVCombi
