function write_isolationhv_result(TestStepResult: integer; IsExternalVoltage, IsArc, IsdIdt,
   IsEnergyLimit: boolean): void;
begin
   Line = '<TestStepResult Type="IsolationHV">';
   write_line(Line);
   inc_indent();
   switch (TestStepResult)
   begin
      case TESTSTEP_Passed:
      begin
         Text = 'Passed';
      end;
      case TESTSTEP_Failed:
      begin
         Text = 'Failed';
      end;
      default: begin
         Text = 'Invalid';
      end;
   end;
   Line = '<Result>' + Text + '</Result>';
   write_line(Line);
   Line = '<ExtVoltageFound>' + IsExternalVoltage + '</ExtVoltageFound>';
   write_line(Line);
   Line = '<Arc>' + IsArc + '</Arc>';
   write_line(Line);
   Line = '<dIdt>' + IsdIdt + '</dIdt>';
   write_line(Line);
   Line = '<ELim>' + IsEnergyLimit + '</ELim>';
   write_line(Line);
   dec_indent();
   write_line('</TestStepResult>');
end;

function write_isolationhv_fail(Pin1Addr, Pin2Addr: integer; IsArc, IsdIdt, IsEnergyLimit: boolean;
   RPrefix: string; RValue: real; IPrefix: string; IValue: real): void;
begin
   write_line('<Fail>');
   inc_indent();

   Line = '<Pin1Addr>' + Pin1Addr + '</Pin1Addr>';
   write_line(Line);
   PinName = get_pin_name(Pin1Addr);
   Line = '<Pin1Name>' + PinName + '</Pin1Name>';
   write_line(Line);

   Line = '<Pin2Addr>' + Pin2Addr + '</Pin2Addr>';
   write_line(Line);
   PinName = get_pin_name(Pin2Addr);
   Line = '<Pin2Name>' + PinName + '</Pin2Name>';
   write_line(Line);

   Line = '<Arc>' + IsArc + '</Arc>';
   write_line(Line);
   Line = '<dIdt>' + IsdIdt + '</dIdt>';
   write_line(Line);
   Line = '<ELim>' + IsEnergyLimit + '</ELim>';
   write_line(Line);

   Line = get_value_with_prefix('Resistance', 'Ohm', RPrefix, RValue);
   write_line(Line);
   Line = get_value_with_prefix('Current', 'A', IPrefix, IValue);
   write_line(Line);

   dec_indent();
   write_line('</Fail>');
end;

template ParamIsolationHV
begin
   write_line('<TestStep Cmd="ParamIsolationHV">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_isolationhv_parameters(RES_HVVoltage, RES_HVThreshold, RES_HVUseIThreshold, RES_HVIThreshold,
      RES_HVTrise, RES_HVTwait, RES_HVTmeas, RES_HVAutoRange, RES_HVCurrentLimit, RES_HVTmeasReduction,
      RES_HVTmeasFactor, RES_HVVoltageRamp, RES_HVdIdtEnabled, RES_HVdIdtCurrentThreshold,
      RES_HVdIdtTimeThreshold);
   dec_indent();
   write_line('</TestStep>');
end;

template ParamResetIsolationHV
begin
   write_line('<TestStep Cmd="ParamResetIsolationHV">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_isolationhv_parameters(RES_HVVoltage, RES_HVThreshold, RES_HVUseIThreshold, RES_HVIThreshold,
      RES_HVTrise, RES_HVTwait, RES_HVTmeas, RES_HVAutoRange, RES_HVCurrentLimit, RES_HVTmeasReduction,
      RES_HVTmeasFactor, RES_HVVoltageRamp, RES_HVdIdtEnabled, RES_HVdIdtCurrentThreshold,
      RES_HVdIdtTimeThreshold);
   dec_indent();
   write_line('</TestStep>');
end;

template NoConnectionHV
begin
   write_line('<TestStep Cmd="NoConnectionHV">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_two_pin_basics(RES_Name, RES_Pin1, RES_Pin2, RES_OriginalPin1, RES_OriginalPin2);
   write_isolationhv_parameters(RES_HVVoltage, RES_HVThreshold, RES_HVUseIThreshold, RES_HVIThreshold,
      RES_HVTrise, RES_HVTwait, RES_HVTmeas, RES_HVAutoRange, RES_HVCurrentLimit, RES_HVTmeasReduction,
      RES_HVTmeasFactor, RES_HVVoltageRamp, RES_HVdIdtEnabled, RES_HVdIdtCurrentThreshold,
      RES_HVdIdtTimeThreshold);
   write_isolationhv_result(RES_Result, RES_ExtVoltageFound, RES_Arc, RES_dIdt, RES_ELim);
   Line = get_value_with_prefix('Resistance', 'Ohm', RES_Prefix, RES_Value);
   write_line(Line);
   dec_indent();
   write_line('</TestStep>');
end;

template NoConnAllHV
begin
   write_line('<TestStep Cmd="NoConnAllHV">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_one_pin_basics(RES_Name, RES_Pin, RES_OriginalPin);
   write_isolationhv_parameters(RES_HVVoltage, RES_HVThreshold, RES_HVUseIThreshold, RES_HVIThreshold,
      RES_HVTrise, RES_HVTwait, RES_HVTmeas, RES_HVAutoRange, RES_HVCurrentLimit, RES_HVTmeasReduction,
      RES_HVTmeasFactor, RES_HVVoltageRamp, RES_HVdIdtEnabled, RES_HVdIdtCurrentThreshold,
      RES_HVdIdtTimeThreshold);

   write_isolationhv_result(RES_Result, FALSE, FALSE, FALSE, FALSE);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Line = get_value_with_prefix('Resistance', 'Ohm', RES_Prefix, RES_Value);
      write_line(Line);
      Line = get_value_with_prefix('Current', 'A', RES_IPrefix, RES_IValue);
      write_line(Line);
   end
   else
   begin
      if (RES_ErrorPinCount > 0)
      begin
         write_line('<Fails>');
         inc_indent();
         for Index = 1 to RES_ErrorPinCount do
         begin
            write_isolationhv_fail(RES_Pin, RES_ErrorPins[Index], RES_Arcs[Index], RES_dIdts[Index],
               RES_ELims[Index], RES_Prefixes[Index], RES_Values[Index], RES_IPrefixes[Index],
               RES_IValues[Index]);
         end;
         dec_indent();
         write_line('</Fails>');
      end;
   end;
   dec_indent();
   write_line('</TestStep>');
end;

