//Output commands for the command ManualTestProbe
template ManualTestProbe
begin
   WriteLn(LocalText('82#Probe in manual test:'));
   PinCount = 0;
   PinsPerLine = 4;
   Line= '';
   for Count = 1 to RES_PinCount do
   begin
      PinName = PinGetData(RES_Pins[Count], PIN_AnyName);
      Line = StrAdd(Line, PinName);
      if (Count < RES_PinCount)
      begin
         Line = StrAdd(Line, ', ');
      end;
      PinCount = PinCount + 1;
      if (PinCount == PinsPerLine)
      begin
         WriteLn(Line);
         PinCount = 0;
      end;
   end;
   if (PinCount > 0)
   begin
      WriteLn(Line);
   end;
end;

//Output commands for the command OFAttenuationTest
template OFAttenuationTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('111#Optical fiber');
   end
   else
   begin
      Name = RES_Name;
   end;
   switch (RES_Result)
   begin
      case TESTSTEP_Passed:
      begin
         ResultText = LocalText('5#Passed');
      end;
      case TESTSTEP_Failed:
      begin
         if (StrCompare(RES_Prefix, '%') == 0)
         begin
            ResultText = LocalText('45#Defective');
         end
         else
         begin
            if (RES_Value > RES_MaxAttenuation)
            begin
               ResultText = LocalText('12#Too high');
            end
            else
            begin
               ResultText = LocalText('13#Too low');
            end;
         end;
      end;
      default:
      begin
         ResultText = LocalText('7#Invalid');
      end;
   end;
   ResultText = format_teststep_result(ResultText);
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_optical_pinname(RES_Pin1));
   Pin2 = format_teststep_pin(get_optical_pinname(RES_Pin2));
   Value = get_attenuation_value(RES_Prefix, RES_Value);
   Line = StrAdd(ResultText, Name);
   Line = StrAdd(Line, Pin1);
   Line = StrAdd(Line, Pin2);
   Line = StrAdd(Line, Value);
   Write(Line);
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output commands for the command OFPinScan
template OFPinScan
begin
   Name = format_teststep_name('OFPinScan');
   Pin1 = format_teststep_pin(get_optical_pinname(RES_Pin));

   if (RES_Result == TESTSTEP_Passed)
   begin
      ResultText = format_teststep_result(' ');
      Pin2 = format_teststep_pin(' ');
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Write(Line);
   end
   else
   begin
      ResultText = format_teststep_result(LocalText('17#Found'));
      for PinZaehl = 1 to RES_ErrorPinCount do
      begin
         Pin2 = format_teststep_pin(get_optical_pinname(RES_ErrorPins[PinZaehl]));
         Line = StrAdd(ResultText, Name);
         Line = StrAdd(Line, Pin1);
         Line = StrAdd(Line, Pin2);
         if (PinZaehl == RES_ErrorPinCount)
         begin
            Write(Line);
         end
         else
         begin
            WriteLn(Line);
         end;
      end;
   end;
end;

//Output commands for the command WireTestAnalysis
template WireTestAnalysis
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('8#Wire');
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = 'Arc';
            end
            else
            begin
               ResultText = LocalText('6#Open');
            end;
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
         end;
      end;
      ResultText = format_teststep_result(ResultText);
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
      Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
      Value = get_resistance_value(RES_Prefix, RES_Value);

      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      if (RES_Result == TESTSTEP_Passed)
      begin
         Write(Line);
      end
      else
      begin
         WriteLn(Line);
      end;
      if (RES_Result == TESTSTEP_Failed)
      begin
         //Write results of continuity analysis
         for Network = 1 to RES_NetworkCount do
         begin
            Space = StrAdd(format_teststep_result(' '), format_teststep_name(' '));
            for PinIndex = 1 to RES_NetworkPinCount[Network] do
            begin
               WriteLn(StrAdd(Space, get_pinname(RES_NetworkPins[Network, PinIndex])));
            end;
            if (Network < RES_NetworkCount)
            begin
               if (RES_ValuesToNextNWArc[Network])
               begin
                  Value = 'Arc';
               end
               else
               begin
                  Value = get_resistance_value(RES_ValuesToNextNWPrefix[Network], RES_ValuesToNextNW[Network]);
               end;
               Value = StrAdd(format_teststep_result(' '), Value);
               WriteLn(Value);
            end;
         end;
         //Write results of LV isolation analysis
         for Network = 1 to RES_NetworkCount do
         begin
            if (RES_NCAExecuted[Network])
            begin
               if (RES_ShortCount[Network] == 0)
               begin
                  Value = get_resistance_value(RES_NCAValuesPrefix[Network], RES_NCAValues[Network]);
                  Pin = get_pinname(RES_NetworkPins[Network, 1]);
                  Pin = FormatAlignLeft(Pin, 40, ' ');
                  Line = FormatAlignLeft('NCA', 25, ' ');
                  Line = StrAdd(Line, ' ');
                  Line = StrAdd(Line, Pin);
                  Line = StrAdd(Line, ' ');
                  Line = StrAdd(Line, Value);
                  if (Network == RES_NetworkCount)
                  begin
                     Write(Line);
                  end
                  else
                  begin
                     WriteLn(Line);
                  end;
               end
               else
               begin
                  Line = FormatAlignLeft(LocalText('43#Short'), 25, ' ');
                  Line = StrAdd(Line, ' ');
                  Pin1 = get_pinname(RES_NetworkPins[Network, 1]);
                  Pin1 = FormatAlignLeft(Pin1, 20, ' ');
                  Line = StrAdd(Line, Pin1);
                  for PinIndex = 1 to RES_ShortCount[Network] do
                  begin
                     Pin2 = get_pinname(RES_Shorts[Network, PinIndex]);
                     Pin2 = FormatAlignLeft(Pin2, 20, ' ');
                     if (RES_ShortArcs[Network, PinIndex])
                     begin
                        Value = 'Arc';
                     end
                     else
                     begin
                        Value = get_resistance_value(RES_ShortPrefixes[Network, PinIndex], RES_ShortValues[Network, PinIndex]);
                     end;
                     Line = StrAdd(Line, ' ');
                     Line = StrAdd(Line, Pin2);
                     Line = StrAdd(Line, Value);
                     if ((Network == RES_NetworkCount) AND (PinIndex == RES_ShortCount[Network]))
                     begin
                        Write(Line);
                     end
                     else
                     begin
                        WriteLn(Line);
                     end;
                  end;
               end;
            end;
         end;
      end;
   end;
end;

//Output commands for the command ReportWriteMeasurementParameters
template ReportWriteMeasurementParameters
begin
   Text = '';
   Parameters = '';
   switch (RES_CommandGroup)
   begin
      case CMDGRP_Continuity: begin
         Text = LocalText('60#Parameters for continuity test');
         Parameters = get_continuity_parameters_text(RES_CCurrent,
                         RES_CThreshold, RES_CTrise, RES_CTwait, RES_CTmeas,
                         RES_CAutoRange, RES_CVoltageLimit);
      end;
      case CMDGRP_IsolationLV: begin
         Text = LocalText('65#Parameters for LV isolation test');
         Parameters = get_isolationlv_parameters_text(RES_LVVoltage,
                         RES_LVThreshold, RES_LVTrise, RES_LVTwait, RES_LVTmeas,
                         RES_LVAutoRange, RES_LVCurrentLimit,
                         RES_LVTmeasReduction);
      end;
      case CMDGRP_IsolationHV: begin
         if (ParamGetIsolationHV(PARAM_IsolationHVValid))
         begin
            Text = LocalText('67#Parameters for HV isolation test');
            Parameters = get_isolationhv_parameters_text(RES_HVVoltage,
                            RES_HVThreshold, RES_HVIThreshold, RES_HVTrise,
                            RES_HVTwait, RES_HVTmeas, RES_HVAutoRange,
                            RES_HVCurrentLimit, RES_HVTmeasReduction,
                            RES_HVTmeasFactor, RES_HVVoltageRamp,
                            RES_HVUseIThreshold);
         end;
      end;
      case CMDGRP_DielectricBreakdown: begin
         if (ParamGetDielectricBreakdown(PARAM_DielectricBreakdownValid))
         begin
            Text = LocalText('68#Parameters for dielectric breakdown test');
            Parameters = get_dielectricbreakdown_parameters_text(RES_DBVoltage,
                            RES_DBTrise, RES_DBTwait, RES_DBTmeas,
                            RES_DBTmeasFactor, RES_DBVoltageRamp,
                            RES_DBThresholdIr, RES_DBThresholdIi);
         end;
      end;
   end;
   if (StrCompare('Parameters', '') <> 0)
   begin
      WriteLn(Text);
      Line = StrCopy(Parameters, 1, 80);
      WriteLn(Line);
      Parameters = StrDelete(Parameters, 1, 80);
      if (StrLength(Parameters) > 0)
      begin
         WriteLn(Parameters);
      end;
      WriteLn('');
   end;
end;

//Output for the command CANRxTest
template CANRxTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'CANRxTest';
   end
   else
   begin
      Name = RES_Name;
   end;
   switch (RES_Result)
   begin
      case TESTSTEP_Passed:
      begin
         ResultText = LocalText('5#Passed');
      end;
      case TESTSTEP_Failed:
      begin
         ResultText = LocalText('114#Failed');
      end;
      default:
      begin
         ResultText = LocalText('7#Invalid');
      end;
   end;
   ResultText = FormatAlignLeft(ResultText, 20, ' ');
   ResultText = format_teststep_result(ResultText);
   Line = StrAdd(ResultText, Name);
   Write(Line);
end;

