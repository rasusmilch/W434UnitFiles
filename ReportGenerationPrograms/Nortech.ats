//Output commands for the command ReportWriteNormal
template ReportWriteNormal
begin
   Data = RES_Text;
   Pos = StrPosition('<br>', StrLowerCase(Data));
   while (Pos > 0)
   begin
      Pos = Pos - 1;
      Line = StrCopy(Data, 1, Pos);
      WriteLn(Line);
      Chars = Pos + 4;
      Data = StrDelete(Data, 1, Chars);
      Pos = StrPosition('<br>', StrLowerCase(Data));
   end;
   Write(Data);
end;

//Output commands for the command ReportWriteError
template ReportWriteError
begin
   Data = RES_Text;
   Pos = StrPosition('<br>', StrLowerCase(Data));
   while (Pos > 0)
   begin
      Pos = Pos - 1;
      Line = StrCopy(Data, 1, Pos);
      WriteLn(Line);
      Chars = Pos + 4;
      Data = StrDelete(Data, 1, Chars);
      Pos = StrPosition('<br>', StrLowerCase(Data));
   end;
   Write(Data);
end;

//Output commands for the command ReportWriteTag
template ReportWriteTag
begin
   if (StrCompare('', RES_Tag) <> 0)
   begin
      Data = RES_Text;
      Pos = StrPosition('<br>', StrLowerCase(Data));
      while (Pos > 0)
      begin
         Pos = Pos - 1;
         Line = StrCopy(Data, 1, Pos);
         WriteLn(Line);
         Chars = Pos + 4;
         Data = StrDelete(Data, 1, Chars);
         Pos = StrPosition('<br>', StrLowerCase(Data));
      end;
      Write(Data);
   end;
end;

//Output commands for the command ReportWriteStrings
template ReportWriteStrings
begin
   Data = RES_Text;
   Pos = StrPosition('<br>', StrLowerCase(Data));
   while (Pos > 0)
   begin
      Pos = Pos - 1;
      Line = StrCopy(Data, 1, Pos);
      WriteLn(Line);
      Chars = Pos + 4;
      Data = StrDelete(Data, 1, Chars);
      Pos = StrPosition('<br>', StrLowerCase(Data));
   end;
   if (RES_StringCount == 0)
   begin
      Write(Data);
   end
   else
   begin
      WriteLn(Data);
      for Index = 1 to RES_StringCount do
      begin
         Data = RES_Strings[Index];
         Pos = StrPosition('<br>', StrLowerCase(Data));
         while (Pos > 0)
         begin
            Pos = Pos - 1;
            Line = StrCopy(Data, 1, Pos);
            WriteLn(Line);
            Chars = Pos + 4;
            Data = StrDelete(Data, 1, Chars);
            Pos = StrPosition('<br>', StrLowerCase(Data));
         end;
         if (Index == RES_StringCount)
         begin
            Write(Data);
         end
         else
         begin
            WriteLn(Data);
         end;
      end;
   end;
end;

//Output commands for the command VoltageTest
template VoltageTest
begin
   switch (RES_Result)
   begin
      case TESTSTEP_Passed:
      begin
         ResultText = LocalText('5#Passed');
      end;
      case TESTSTEP_Failed:
      begin
         if (RES_Value > RES_MaxVoltage)
         begin
            ResultText = LocalText('12#Too high');
         end
         else
         begin
            ResultText = LocalText('13#Too low');
         end;
      end;
      default:
      begin
         ResultText = LocalText('7#Invalid');
      end;
   end;
   ResultText = FormatAlignLeft(ResultText, 10, ' ');
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('48#Voltage');
   end
   else
   begin
      Name = RES_Name;
   end;
   ResultText = format_teststep_result(ResultText);
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
   Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
   Value = get_voltage_value(RES_Prefix, RES_Value);
   Line = StrAdd(ResultText, Name);
   Line = StrAdd(Line, Pin1);
   Line = StrAdd(Line, Pin2);
   Line = StrAdd(Line, Value);
   Write(Line);
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output commands for the command VoltageTestCustom
template VoltageTestCustom
begin
   switch (RES_Result)
   begin
      case TESTSTEP_Passed:
      begin
         ResultText = LocalText('5#Passed');
      end;
      case TESTSTEP_Failed:
      begin
         if (RES_Value > RES_MaxVoltage)
         begin
            ResultText = LocalText('12#Too high');
         end
         else
         begin
            ResultText = LocalText('13#Too low');
         end;
      end;
      default:
      begin
         ResultText = LocalText('7#Invalid');
      end;
   end;
   ResultText = FormatAlignLeft(ResultText, 10, ' ');
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('48#Voltage');
   end
   else
   begin
      Name = RES_Name;
   end;
   ResultText = format_teststep_result(ResultText);
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
   Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
   Value = get_voltage_value(RES_Prefix, RES_Value);

   Line = StrAdd(ResultText, Name);
   Line = StrAdd(Line, Pin1);
   Line = StrAdd(Line, Pin2);
   Line = StrAdd(Line, Value);
   Write(Line);
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output commands for the command NoConnGroupLV
template NoConnGroupLV
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NCG LV';
   end
   else
   begin
      Name = RES_Name;
   end;
   Name = format_teststep_name(Name);

   if (RES_Result == TESTSTEP_Passed)
   begin
      ResultText = format_teststep_result(LocalText('5#Passed'));
      HighGroup = format_teststep_pin(RES_HighGroup);
      LowGroup = format_teststep_pin(RES_LowGroup);
      Value = get_resistance_value(RES_Prefix, RES_Value);
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, HighGroup);
      Line = StrAdd(Line, LowGroup);
      Line = StrAdd(Line, Value);
      Write(Line);
   end
   else
   begin
      for PinZaehl = 1 to RES_ErrorCount do
      begin
         if (RES_Arcs[PinZaehl])
         begin
            ResultText = 'Arc';
            Value = ' ';
         end
         else
         begin
            ResultText = LocalText('15#Short');
            Value = get_resistance_value(RES_Prefixes[PinZaehl], RES_Values[PinZaehl]);
         end;
         if ((RES_ErrorHighPins[PinZaehl] == PINADDRESS_NotSearched) OR (RES_ErrorHighPins[PinZaehl] == PINADDRESS_NotFound))
         begin
            Pin1 = RES_HighGroup;
         end
         else
         begin
            Pin1 = get_pinname(RES_ErrorHighPins[PinZaehl]);
         end;
         if ((RES_ErrorLowPins[PinZaehl] == PINADDRESS_NotSearched) OR (RES_ErrorLowPins[PinZaehl] == PINADDRESS_NotFound))
         begin
            Pin2 = RES_LowGroup;
         end
         else
         begin
            Pin2 = get_pinname(RES_ErrorLowPins[PinZaehl]);
         end;
         ResultText = format_teststep_result(ResultText);
         Pin1 = format_teststep_pin(Pin1);
         Pin2 = format_teststep_pin(Pin2);
         Line = StrAdd(ResultText, Name);
         Line = StrAdd(Line, Pin1);
         Line = StrAdd(Line, Pin2);
         Line = StrAdd(Line, Value);
         if (PinZaehl == RES_ErrorCount)
         begin
            Write(Line);
         end
         else
         begin
            WriteLn(Line);
         end;
      end;
      if (RES_ShortToLowerVoltageLevel)
      begin
         WriteLn('');
         Line = FormatAlignLeft(' ', 25, ' ');
         Line = StrAdd(Line, LocalText('85#Possible short to lower voltagelevel'));
         Write(Line);
      end;
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

