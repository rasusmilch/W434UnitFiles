//Output commands for the command AttenuatorTest
template AttenuatorTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('116#Attenuator');
   end
   else
   begin
      Name = RES_Name;
   end;
   switch (RES_Result)
   begin
      case TESTSTEP_Passed:
      begin
         ResultText = LocalText('5#Passed');
      end;
      case TESTSTEP_Failed:
      begin
         ResultText = '';
         if (StrCompare(RES_Prefix, '%') == 0)
         begin
            ResultText = LocalText('45#Defective');
         end
         else
         begin
            if (RES_Value > RES_MaxAttenuation)
            begin
               ResultText = LocalText('12#Too high');
            end
            else
            begin
               if (RES_Value < RES_MinAttenuation)
               begin
                  ResultText = LocalText('13#Too low');
               end;
            end;
            if (RES_PolarityTest)
            begin
               if (NOT RES_PolarityOk)
               begin
                  if (StrCompare('', ResultText) == 0)
                  begin
                     ResultText = LocalText('44#Reversed');
                  end
                  else
                  begin
                     ResultText = StrAdd(ResultText, ' (');
                     ResultText = StrAdd(ResultText, LocalText('44#Reversed'));
                     ResultText = StrAdd(ResultText, ')');
                  end;
               end;
            end;
         end;
      end;
      default:
      begin
         ResultText = LocalText('7#Invalid');
      end;
   end;
   ResultText = format_teststep_result(ResultText);
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_pinname(RES_PinA1));
   Pin2 = format_teststep_pin(get_pinname(RES_PinB1));
   Value = get_attenuation_value(RES_Prefix, RES_Value);
   Line = StrAdd(ResultText, Name);
   Line = StrAdd(Line, Pin1);
   Line = StrAdd(Line, Pin2);
   Line = StrAdd(Line, Value);
   Write(Line);
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output for the command NoConnectionHVCombi
template NoConnectionHVCombi
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NC HVCombi';
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_HV1Arc OR RES_DBArc OR RES_HV2Arc)
            begin
               ResultText = 'Arc';
            end
            else
            begin
               ResultText = LocalText('15#Short');
            end;
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
         end;
      end;
      ResultText = format_teststep_result(ResultText);

      DBValue = TRUE;
      HV2Value = RES_HV2Done;
      FailText = '';
      switch (RES_ErrorInfo)
      begin
         case HV_COMBI_HV1Error: begin
            FailText = 'HV1';
            DBValue = FALSE;
            HV2Value = FALSE;
         end;
         case HV_COMBI_DBError: begin
            FailText = 'DB';
            HV2Value = FALSE;
         end;
         case HV_COMBI_HV2Error: begin
            FailText = 'HV2';
         end;
         case HV_COMBI_HV1HV2Error: begin
            FailText = 'HV1/HV2';
         end;
      end;
      Value = 'HV1: ';
      if (RES_HV1Arc)
      begin
         Value = StrAdd(Value, 'Arc');
      end
      else
      begin
         Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
      end;
      if (DBValue)
      begin
         Value = StrAdd(Value, '  --  DB: ');
         if (RES_DBArc)
         begin
            Value = StrAdd(Value, 'Arc');
         end
         else
         begin
            Value = StrAdd(Value, get_dielectric_breakdown_value(
                                     RES_DBArc, RES_DBValueValid,
                                     RES_DBValueIr, RES_DBPrefixIr,
                                     RES_DBValueIi, RES_DBPrefixIi));
         end;
      end;
      if (HV2Value)
      begin
         Value = StrAdd(Value, '  --  HV2: ');
         if (RES_DBArc)
         begin
            Value = StrAdd(Value, 'Arc');
         end
         else
         begin
            Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix,
                                     RES_HV2Value));
         end;
      end;
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
      Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
      Line1 = StrAdd(ResultText, Name);
      Line1 = StrAdd(Line1, Pin1);
      Line1 = StrAdd(Line1, Pin2);
      Line1 = StrAdd(Line1, FailText);
      Space = format_teststep_result(' ');
      Line2 = StrAdd(Space, Value);
      if (RES_Result == TESTSTEP_Passed)
      begin
         WriteLn(Line1);
         Write(Line2);
      end
      else
      begin
         WriteLn(Line1);
         if (RES_ShortToLowerVoltageLevel)
         begin
            Space = TESTSTEP_RESULT_WIDTH + TESTSTEP_NAME_WIDTH;
            Space = FormatAlignLeft(' ', Space, ' ');
            Line = StrAdd(Space, LocalText('85#Possible short to lower voltagelevel'));
            WriteLn(Line);
         end;
         Write(Line2);
      end;
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output for the command NoConnAllHVCombi
template NoConnAllHVCombi
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NCA HVCombi';
   end
   else
   begin
      Name = RES_Name;
   end;
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_pinname(RES_Pin));
   if (RES_Result == TESTSTEP_Passed)
   begin
      Value = 'HV1: ';
      Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
      Value = StrAdd(Value, '  --  DB: ');
      Value = StrAdd(Value, get_dielectric_breakdown_value(
                               RES_DBArc, RES_DBValueValid,
                               RES_DBValueIr, RES_DBPrefixIr,
                               RES_DBValueIi, RES_DBPrefixIi));
      if (RES_HV2Done)
      begin
         Value = StrAdd(Value, '  --  HV2: ');
         Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix,
                                  RES_HV2Value));
      end;
      Line1 = StrAdd(format_teststep_result(LocalText('5#Passed')), Name);
      Line1 = StrAdd(Line1, Pin1);
      Line1 = StrAdd(Line1, format_teststep_pin(' '));
      Line2 = StrAdd(format_teststep_result(' '), Value);
      WriteLn(Line1);
      Write(Line2);
   end
   else
   begin
      if (RES_ErrorInfo == HV_COMBI_HV1HV2Error)
      begin
         Pin2 = format_teststep_pin(get_pinname(PINADDRESS_NotSearched));
         FailText = 'HV1/HV2';
         Value = 'HV1: ';
         Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
         Value = StrAdd(Value, '  --  DB: ');
         Value = StrAdd(Value, get_dielectric_breakdown_value(
                                  RES_DBArc, RES_DBValueValid,
                                  RES_DBValueIr, RES_DBPrefixIr,
                                  RES_DBValueIi, RES_DBPrefixIi));
         Value = StrAdd(Value, '  --  HV2: ');
         Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix,
                                  RES_HV2Value));
         Line1 = StrAdd(format_teststep_result(LocalText('16#Error')), Name);
         Line1 = StrAdd(Line1, Pin1);
         Line1 = StrAdd(Line1, Pin2);
         Line1 = StrAdd(Line1, FailText);
         WriteLn(Line1);
         Line2 = StrAdd(format_teststep_result(' '), Value);
         Write(Line2);
      end
      else
      begin
         for Index = 1 to RES_ErrorPinCount do
         begin
            if (RES_HVArcs[Index] OR RES_DBArcs[Index])
            begin
               ResultText = 'Arc';
            end
            else
            begin
               ResultText = LocalText('15#Short');
            end;
            Pin2 = format_teststep_pin(get_pinname(RES_ErrorPins[Index]));
            FailText = '';
            switch (RES_ErrorInfo)
            begin
               case HV_COMBI_HV1Error: begin
                  FailText = 'HV1';
               end;
               case HV_COMBI_DBError: begin
                  FailText = 'DB';
               end;
               case HV_COMBI_HV2Error: begin
                  FailText = 'HV2';
               end;
            end;
            if (RES_HVArcs[Index] OR RES_DBArcs[Index])
            begin
               Value = 'Arc';
            end
            else
            begin
               if (RES_ErrorInfo == HV_COMBI_DBError)
               begin
                  Value = get_dielectric_breakdown_value(
                             RES_DBArcs[Index], RES_DBValuesValid[Index],
                             RES_DBValuesIr[Index], RES_DBPrefixesIr[Index],
                             RES_DBValuesIi[Index], RES_DBPrefixesIi[Index]);
               end
               else
               begin
                  Value = get_resistance_value(
                             RES_HVPrefixes[Index], RES_HVValues[Index]);
               end;
            end;
            Line1 = StrAdd(format_teststep_result(ResultText), Name);
            Line1 = StrAdd(Line1, Pin1);
            Line1 = StrAdd(Line1, Pin2);
            Line1 = StrAdd(Line1, FailText);
            WriteLn(Line1);
            Line2 = StrAdd(format_teststep_result(' '), Value);
            if (Index == RES_ErrorPinCount)
            begin
               Write(Line2);
            end
            else
            begin
               WriteLn(Line2);
            end;
         end;
      end;
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

