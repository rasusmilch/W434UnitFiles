//Output for the command NoConnGroupHVCombi
template NoConnGroupHVCombi
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NCG HVCombi';
   end
   else
   begin
      Name = RES_Name;
   end;
   Name = format_teststep_name(Name);
   HighGroup = format_teststep_pin(RES_HighGroup);
   LowGroup = format_teststep_pin(RES_LowGroup);
   if (RES_Result == TESTSTEP_Passed)
   begin
      ResultText = format_teststep_result(LocalText('5#Passed'));
      Value = 'HV1: ';
      Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
      Value = StrAdd(Value, '  --  DB: ');
      Value = StrAdd(Value, get_dielectric_breakdown_value(
                               RES_DBArc, RES_DBValueValid,
                               RES_DBValueIr, RES_DBPrefixIr,
                               RES_DBValueIi, RES_DBPrefixIi));
      if (RES_HV2Done)
      begin
         Value = StrAdd(Value, '  --  HV2: ');
         Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix,
                                  RES_HV2Value));
      end;
      Line1 = StrAdd(ResultText, Name);
      Line1 = StrAdd(Line1, HighGroup);
      Line1 = StrAdd(Line1, LowGroup);
      WriteLn(Line1);
      Space = format_teststep_result(' ');
      Line2 = StrAdd(Space, Value);
      Write(Line2);
   end
   else
   begin
      if (RES_ErrorInfo == HV_COMBI_HV1HV2Error)
      begin
         ResultText = LocalText('16#Error');
         FailText = 'HV1/HV2';
         Value = 'HV1: ';
         Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
         Value = StrAdd(Value, '  --  DB: ');
         Value = StrAdd(Value, get_dielectric_breakdown_value(
                                  RES_DBArc, RES_DBValueValid,
                                  RES_DBValueIr, RES_DBPrefixIr,
                                  RES_DBValueIi, RES_DBPrefixIi));
         Value = StrAdd(Value, '  --  HV2: ');
         Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix,
                                  RES_HV2Value));
         ResultText = format_teststep_result(ResultText);
         Line1 = StrAdd(ResultText, Name);
         Line1 = StrAdd(Line1, HighGroup);
         Line1 = StrAdd(Line1, LowGroup);
         Line1 = StrAdd(Line1, FailText);
         WriteLn(Line1);
         Space = format_teststep_result(' ');
         Line2 = StrAdd(Space, Value);
         Write(Line2);
      end
      else
      begin
         for Index = 1 to RES_ErrorCount do
         begin
            if (RES_HVArcs[Index] OR RES_DBArcs[Index])
            begin
               ResultText = 'Arc';
               Value = ' ';
            end
            else
            begin
               ResultText = LocalText('15#Short');
               Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
            end;
            if ((RES_ErrorHighPins[Index] == PINADDRESS_NotSearched) OR
                (RES_ErrorHighPins[Index] == PINADDRESS_NotFound))
            begin
               Pin1 = RES_HighGroup;
            end
            else
            begin
               Pin1 = get_pinname(RES_ErrorHighPins[Index]);
            end;
            if ((RES_ErrorLowPins[Index] == PINADDRESS_NotSearched) OR
                (RES_ErrorLowPins[Index] == PINADDRESS_NotFound))
            begin
               Pin2 = RES_LowGroup;
            end
            else
            begin
               Pin2 = get_pinname(RES_ErrorLowPins[Index]);
            end;
            Pin1 = format_teststep_pin(Pin1);
            Pin2 = format_teststep_pin(Pin2);
            FailText = '';
            switch (RES_ErrorInfo)
            begin
               case HV_COMBI_HV1Error: begin
                  FailText = 'HV1';
               end;
               case HV_COMBI_DBError: begin
                  FailText = 'DB';
               end;
               case HV_COMBI_HV2Error: begin
                  FailText = 'HV2';
               end;
            end;
            if (RES_HVArcs[Index] OR RES_DBArcs[Index])
            begin
               Value = ' ';
            end
            else
            begin
               if (RES_ErrorInfo == HV_COMBI_DBError)
               begin
                  Value = get_dielectric_breakdown_value(
                             RES_DBArcs[Index], RES_DBValuesValid[Index],
                             RES_DBValuesIr[Index], RES_DBPrefixesIr[Index],
                             RES_DBValuesIi[Index], RES_DBPrefixesIi[Index]);
               end
               else
               begin
                  Value = get_resistance_value(
                             RES_HVPrefixes[Index], RES_HVValues[Index]);
               end;
            end;
            Line1 = StrAdd(format_teststep_result(ResultText), Name);
            Line1 = StrAdd(Line1, Pin1);
            Line1 = StrAdd(Line1, Pin2);
            Line1 = StrAdd(Line1, FailText);
            Line2 = '';
            Line3 = '';
            if (StrCompare(StrTrim(Value), '') <> 0)
            begin
               Space = format_teststep_result(' ');
               Line2 = StrAdd(Space, Value);
            end;
            if (RES_ShortToLowerVoltageLevel)
            begin
               Space = TESTSTEP_RESULT_WIDTH + TESTSTEP_NAME_WIDTH;
               Space = FormatAlignLeft(' ', Space, ' ');
               Line2 = StrAdd(Space, LocalText('85#Possible short to lower voltagelevel'));
            end;
            Line2Data = StrCompare(StrTrim(Line2), '') <> 0;
            Line3Data = StrCompare(StrTrim(Line3), '') <> 0;
            if (Line2Data OR Line3Data)
            begin
               WriteLn(Line1);
            end
            else
            begin
               if (Index == RES_ErrorCount)
               begin
                  Write(Line1);
               end
               else
               begin
                  WriteLn(Line1);
               end;
            end;
            if (Line2Data)
            begin
               if (Line3Data)
               begin
                  WriteLn(Line2);
               end
               else
               begin
                  if (Index == RES_ErrorCount)
                  begin
                     Write(Line2);
                  end
                  else
                  begin
                     WriteLn(Line2);
                  end;
               end;
            end;
            if (Line3Data)
            begin
               if (Index == RES_ErrorCount)
               begin
                  Write(Line3);
               end
               else
               begin
                  WriteLn(Line3);
               end;
            end;
         end;
      end;
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output commands for the command NoConnAll
template NoConnAll
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NCA';
   end
   else
   begin
      Name = RES_Name;
   end;
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_pinname(RES_Pin));

   if (RES_Result == TESTSTEP_Passed)
   begin
      ResultText = format_teststep_result(LocalText('5#Passed'));
      Pin2 = format_teststep_pin(' ');
      Value = get_resistance_value(RES_Prefix, RES_Value);
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      Write(Line);
   end
   else
   begin
      for PinZaehl = 1 to RES_ErrorPinCount do
      begin
         if (RES_Arcs[PinZaehl])
         begin
            ResultText = 'Arc';
            Value = ' ';
         end
         else
         begin
            ResultText = LocalText('15#Short');
            Value = get_resistance_value(RES_Prefixes[PinZaehl], RES_Values[PinZaehl]);
         end;
         ResultText = format_teststep_result(ResultText);
         Pin2 = format_teststep_pin(get_pinname(RES_ErrorPins[PinZaehl]));
         Line = StrAdd(ResultText, Name);
         Line = StrAdd(Line, Pin1);
         Line = StrAdd(Line, Pin2);
         Line = StrAdd(Line, Value);
         if (PinZaehl == RES_ErrorPinCount)
         begin
            Write(Line);
         end
         else
         begin
            WriteLn(Line);
         end;
      end;
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output commands for the header
template Header
begin
   //Caption
   Line = 'WEETECH GmbH';
   WriteLn(Line);
   Line = get_underline(Line);
   
   //General informations
   WriteLn(Line);
   WriteLn('');
   Length = StrLength(LocalText('119#Full name'));
   Line = FormatAlignLeft(LocalText('18#Software version'), Length, ' ');
   Line = StrAdd(Line, ': ');
   Line = StrAdd(Line, RES_SoftwareVersion);
   WriteLn(Line);
   Line = FormatAlignLeft(LocalText('19#Unit under test'), Length, ' ');
   Line = StrAdd(Line, ': ');
   Line = StrAdd(Line, ProjectGetName());
   WriteLn(Line);
   Line = FormatAlignLeft(LocalText('20#Filename'), Length, ' ');
   Line = StrAdd(Line, ': ');
   Line = StrAdd(Line, get_relative_filename(ProjectGetFilename()));
   WriteLn(Line);
   DateTime = DTGetTestDateTime();
   DateTime = DTDateTimeString(DateTime);
   Line = FormatAlignLeft(LocalText('21#Date/Time'), Length, ' ');
   Line = StrAdd(Line, ': ');
   Line = StrAdd(Line, DateTime);
   WriteLn(Line);

   //Order number
   display_ordernumber(Length);

   //Serial number
   display_serialnumber(Length);
   
   //User name
   // display_username(Length);

   //Full user name
   // display_fullusername(Length);
   
   //Group name
   // display_usergroupname(Length);

   //Additional input data from the test start program
   display_teststart_inputdata(Length);

   //Rangetest
   display_rangetest(Length);

   WriteLn('');

   //Sections
   display_sections();

   //Test result
   switch (RES_Result)
   begin
      case TEST_Passed:
      begin
         ResultText = LocalText('34#P A S S E D');
         DetailedResult = TRUE;
      end;
      case TEST_Failed:
      begin
         ResultText = LocalText('35#F A I L E D');
         DetailedResult = TRUE;
      end;
      case TEST_Aborted:
      begin
         ResultText = LocalText('36#A B O R T E D');
         DetailedResult = FALSE;
      end;
      default:
      begin
         ResultText = LocalText('37#I N V A L I D');
         DetailedResult = FALSE;
      end;
   end;
   ResultText = FormatAlignCenter(ResultText, 24);
   ResultText = StrAdd(ResultText, '---------------');
   ResultText = StrAdd('---------------', ResultText);
   Length = StrLength(ResultText);

   if (DetailedResult)
   begin
      //Passed + Failed
      Caption = FormatAlignCenter(LocalText('38#T e s t   r e s u l t'), Length);
      WriteLn(Caption);
      Line = FormatAlignLeft('-', Length, '-');
      WriteLn(Line);

      ContinuityResult =
         get_commandgroup_resultstring(
         ParamIsCommandGroupActive(CMDGRP_Continuity),
         FailCounterGet(FAILCOUNTER_Continuity),
         MiscGetNumberOfExecutedCommands(CMDGRP_Continuity));
      LVIsolationResult =
         get_commandgroup_resultstring(
            ParamIsCommandGroupActive(CMDGRP_IsolationLV),
            FailCounterGet(FAILCOUNTER_IsolationLV),
            MiscGetNumberOfExecutedCommands(CMDGRP_IsolationLV));
      HVIsolationResult =
         get_commandgroup_resultstring(
            ParamIsCommandGroupActive(CMDGRP_IsolationHV),
            FailCounterGet(FAILCOUNTER_IsolationHV),
            MiscGetNumberOfExecutedCommands(CMDGRP_IsolationHV));
      DielectricBreakdownResult =
         get_commandgroup_resultstring(
            ParamIsCommandGroupActive(CMDGRP_DielectricBreakdown),
            FailCounterGet(FAILCOUNTER_DielectricBreakdown),
            MiscGetNumberOfExecutedCommands(CMDGRP_DielectricBreakdown));
      ComponentsResult =
         get_commandgroup_resultstring(
            ParamIsCommandGroupActive(CMDGRP_ElectricalComponents),
            FailCounterGet(FAILCOUNTER_ElectricalComponents),
            MiscGetNumberOfExecutedCommands(CMDGRP_ElectricalComponents));
      OpticalComponentsResult =
         get_commandgroup_resultstring(
            ParamIsCommandGroupActive(CMDGRP_OpticalComponents),
            FailCounterGet(FAILCOUNTER_OpticalComponents),
            MiscGetNumberOfExecutedCommands(CMDGRP_OpticalComponents));
      CANBusResult =
         get_commandgroup_resultstring(
            ParamIsCommandGroupActive(CMDGRP_CANBus),
            FailCounterGet(FAILCOUNTER_CANBus),
            MiscGetNumberOfExecutedCommands(CMDGRP_CANBus));
      OthersResult = get_commandgroup_resultstring(TRUE,
                            FailCounterGet(FAILCOUNTER_Others), 1);

      Line = FormatAlignLeft(LocalText('27#Continuity test'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, ContinuityResult);
      WriteLn(Line);
      Line = FormatAlignLeft(LocalText('28#LV isolation test'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, LVIsolationResult);
      WriteLn(Line);
      Line = FormatAlignLeft(LocalText('29#HV isolation test'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, HVIsolationResult);
      WriteLn(Line);
      Line = FormatAlignLeft(LocalText('30#Test for dielectric breakdown'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, DielectricBreakdownResult);
      WriteLn(Line);
      Line = FormatAlignLeft(LocalText('31#Test of electrical components'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, ComponentsResult);
      WriteLn(Line);
      Line = FormatAlignLeft(LocalText('112#Test of optical components'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, OpticalComponentsResult);
      WriteLn(Line);
      Line = FormatAlignLeft(LocalText('115#CAN bus'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, CANBusResult);
      WriteLn(Line);
      Line = FormatAlignLeft(LocalText('32#Other tests'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, OthersResult);
      WriteLn(Line);
      WriteLn(ResultText);
   end
   else
   begin
      //Aborted + Invalid
      WriteLn(ResultText);
   end;
   
   //Remove "//" from the next line to write the measurement parameters into the report
   //write_parameters();

   //Adaptercables
   check_adaptercables();
   show_lastisolationtestcable();
   
   WriteLn('');
end;

//Output commands for the footer
template Footer
begin
end;

