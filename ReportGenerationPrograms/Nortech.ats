//Achtung!
//Änderungen an den Programmen für die Protokollerzeugung, die an den
//Original-Dateien durchgeführt werden, werden bei der Installation eines
//Softwareupdates überschrieben.
//Falls Sie Anpassungen am Protokoll benötigen, ändern Sie nicht die
//Script-Dateien, die mit CEETIS ausgeliefert werden.
//Erstellen Sie Kopien der Scripte ("Datei->Programm speichern unter" oder
//"Datei->Speichern unter") und führen Sie die Änderungen in den Kopien durch.
//Um die geänderten Programme immer automatisch in Ihre Projekte einzubinden
//können Sie Projektvorlagen erstellen.

//Attention!
//Changes in the programs for report generation, which are made in the original
//files will be overwritten when installing a software-update.
//If you need to cusomize the report do not change the script-files that are
//distributed with CEETIS.
//Make a copy of these files ("File->Save Program as" or "File->Save as") and
//customize the copies.
//If you want to bind the customized programs automatically to your projects,
//you can create project templates.


//Output commands for the command WireTest
template WireTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('8#Wire');
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = 'Arc';
            end
            else
            begin
               ResultText = LocalText('6#Open');
            end;
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
         end;
      end;
      ResultText = format_teststep_result(ResultText);
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
      Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
      if (RES_AutoRangePassedAfterFail)
      begin
         Value = get_resistance_value('>', RES_CThreshold);
         Value = StrAdd(Value, '!');
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;

      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      Write(Line);
      if (RES_Result == TESTSTEP_Failed)
      begin
         if (RES_InterchangedWiresPin1 <> PINADDRESS_None)
         begin
            Space = format_teststep_result(' ');
            ResultText = format_teststep_name(LocalText('69#Connected'));
            Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
            Pin2 = format_teststep_pin(get_pinname(RES_InterchangedWiresPin1));
            Line = StrAdd(Space, ResultText);
            Line = StrAdd(Line, Pin1);
            Line = StrAdd(Line, Pin2);
            WriteLn('');
            Write(Line);
         end;
         if (RES_InterchangedWiresPin2 <> PINADDRESS_None)
         begin
            Space = format_teststep_result(' ');
            ResultText = format_teststep_name(LocalText('69#Connected'));
            Pin1 = format_teststep_pin(get_pinname(RES_Pin2));
            Pin2 = format_teststep_pin(get_pinname(RES_InterchangedWiresPin2));
            Line = StrAdd(Space, ResultText);
            Line = StrAdd(Line, Pin1);
            Line = StrAdd(Line, Pin2);
            WriteLn('');
            Write(Line);
         end;
      end;
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output commands for the command SwitchTest
template SwitchTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('11#Switch');
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = 'Arc';
            end
            else
            begin
               if (RES_SwitchClosed)
               begin
                  ResultText = LocalText('9#Open');
               end
               else
               begin
                  ResultText = LocalText('33#Closed');
               end;
            end;
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
         end;
      end;
      ResultText = format_teststep_result(ResultText);
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
      Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
      if (RES_AutoRangePassedAfterFail)
      begin
         Value = get_resistance_value('>', RES_CThreshold);
         Value = StrAdd(Value, '!');
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;

      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      Write(Line);
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

