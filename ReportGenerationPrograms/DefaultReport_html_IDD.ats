//Output for the command ParamIDD
template ParamIDD
begin
   Line = '';
   if (RES_UseNoiseFilterChanged)
   begin
      if (RES_UseNoiseFilter)
      begin
         Value = LocalText('56#On');
      end
      else
      begin
         Value = LocalText('57#Off');
      end;
      Line = StrAdd(Line, LocalText('197#Use noise filter'));
      Line = StrAdd(Line, '=');
      Line = StrAdd(Line, Value);
      Line = StrAdd(Line, '; ');
   end;
   if (RES_UseBandWidthFilterChanged)
   begin
      if (RES_UseBandWidthFilter)
      begin
         Value = LocalText('56#On');
      end
      else
      begin
         Value = LocalText('57#Off');
      end;
      Line = StrAdd(Line, LocalText('279#Use band width filter'));
      Line = StrAdd(Line, '=');
      Line = StrAdd(Line, Value);
      Line = StrAdd(Line, '; ');
   end;
   if (StrCompare(Line, '') <> 0)
   begin
      Pos = StrLength(Line) - 1;
      Line = StrDelete(Line, Pos, 2);
      WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD class=bold>');
      Write(LocalText('198#IDD: General parameters'));
      WriteLn('</TD></TR>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(Line);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;
end;

//Output for the command ParamIDDStaticContinuity
template ParamIDDStaticContinuity
begin
   Line = '';
   if (RES_LowerThresholdChanged)
   begin
      Line = StrAdd(Line, LocalText('182#Lower Threshold'));
      Line = Line + '=' + RES_SC_LowerThreshold + '; ';
   end;
   if (RES_UpperThresholdChanged)
   begin
      Line = StrAdd(Line, LocalText('183#Upper Threshold'));
      Line = Line + '=' + RES_SC_UpperThreshold + '; ';
   end;
   if (RES_TtestChanged)
   begin
      Value = FormatTime(RES_SC_Ttest);
      Line = StrAdd(Line, LocalText('184#Duration'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_DelayChanged)
   begin
      Value = FormatTime(RES_SC_Delay);
      Line = StrAdd(Line, LocalText('185#Delay'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_RxAmplificationChanged)
   begin
      Line = StrAdd(Line, LocalText('186#Rx-Amplification'));
      Line = Line + '=' + RES_SC_RxAmplification + '; ';
   end;
   if (RES_CountingIntervalChanged)
   begin
      Value = FormatTime(RES_SC_CountingInterval);
      Line = StrAdd(Line, LocalText('187#Counting Interval'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_GapWidthChanged)
   begin
      Value = FormatTime(RES_SC_GapWidth);
      Line = StrAdd(Line, LocalText('188#Gap Width'));
      Line = Line + '=' + Value + '; ';
   end;
   if (StrCompare(Line, '') <> 0)
   begin
      Pos = StrLength(Line) - 1;
      Line = StrDelete(Line, Pos, 2);
      WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD class=bold>');
      Write(LocalText('189#IDD: Parameters for the Static Continuity Tests'));
      WriteLn('</TD></TR>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(Line);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;
end;

