function display_rangetest(): void;
begin
   if (MiscRangeTestRunning())
   begin
      RangeTestType = MiscRangeTestGetType();
      WriteFunctions = FALSE;
      WriteConnectors = FALSE;
      WriteCables = FALSE;
      if (RangeTestType == RANGETEST_Functions)
      begin
         WriteFunctions = TRUE;
      end;
      if (RangeTestType == RANGETEST_Connectors)
      begin
         UsedConnectorCount =
            MiscRangeTestConnectors(RangeTestUsedConnectors, TRUE);
         UnusedConnectorCount =
            MiscRangeTestConnectors(RangeTestUnusedConnectors, FALSE);
         WriteConnectors = TRUE;
      end;
      if ((RangeTestType == RANGETEST_AdtIsolationLV) OR
          (RangeTestType == RANGETEST_AdtIsolationHV) OR
          (RangeTestType == RANGETEST_AdtDielectricBreakdown))
      begin
         WriteCables = TRUE;
      end;

      Write('<TR><TD Width=300>');
      Write(LocalText('74#Rangetest'));
      Write('</TD><TD>');
      
      //normal rangetest
      if (WriteFunctions)
      begin
         FunctionCount = MiscRangeTestFunctionCount();
         if (FunctionCount > 0)
         begin
            Write(MiscRangeTestFunction(1));
            WriteLn('</TD></TR>');
            for Index = 2 to FunctionCount do
            begin
               Write('<TR><TD Width=300>&nbsp;</TD><TD>');
               Write(MiscRangeTestFunction(Index));
               WriteLn('</TD></TR>');
            end;
         end;
      end;
      
      //Rangetest with connectors
      if (WriteConnectors)
      begin
         if (UsedConnectorCount <= UnusedConnectorCount)
         begin
            Write(RangeTestUsedConnectors[1]);
            WriteLn('</TD></TR>');
            for Index = 2 to UsedConnectorCount do
            begin
               Write('<TR><TD Width=300>&nbsp;</TD><TD>');
               Write(RangeTestUsedConnectors[Index]);
               WriteLn('</TD></TR>');
            end;
         end
         else
         begin
            Write(LocalText('132#Disabled connectors'));
            WriteLn('</TD></TR>');
            for Index = 1 to UnusedConnectorCount do
            begin
               Write('<TR><TD Width=300>&nbsp;</TD><TD>');
               Write(RangeTestUnusedConnectors[Index]);
               WriteLn('</TD></TR>');
            end;
         end;
      end;
      
      //Rangetest Isolation with adaptercables
      if (WriteCables)
      begin
         CableCount = AdapterCablesGetList(AdapterCables,
                         ADAPTERCABLES_RangeTestIsolation);
         if (CableCount > 0)
         begin
            Line = LocalText('83#From cable');
            Line = StrAdd(Line, ' "');
            Line = StrAdd(Line, AdapterCables[1]);
            Line = StrAdd(Line, '" ');
            Line = StrAdd(Line, LocalText('84#to cable'));
            Line = StrAdd(Line, ' "');
            Line = StrAdd(Line, AdapterCables[CableCount]);
            Line = StrAdd(Line, '"');
            Write(Line);
            WriteLn('</TD></TR>');
         end;
      end;
   end;
end;

