function display_teststepcomment(Comment: string; Style: string;
            DeclaredAsPassed: boolean = FALSE;
            DeclaredAsPassedBy: string = ''): void;
begin
   if (DeclaredAsPassed)
   begin
      Text = LocalText('146#Declared as "passed" by');
      Text = StrAdd(Text, ': ');
      Text = StrAdd(Text, DeclaredAsPassedBy);
      if (StrCompare(Comment, '') <> 0)
      begin
         Text = StrAdd(Text, '<br>');
         Comment = StrAdd(Text, Comment);
      end
      else
      begin
         Comment = Text;
      end;
   end;
   if (StrCompare(Comment, '') <> 0)
   begin
      Write('<TR><TD COLSPAN=2>&nbsp;</TD><TD>');
      Write(Comment);
      WriteLn('</TD></TR>');
   end;
end;

