//Returns a value text for HV isolation test steps
function get_hv_isolation_value_text(IsArc, IsdIdt, IsEnergyLimit: boolean;
   Prefix: string; Value: real): string;
begin
   if (IsArc)
   begin
      Result = LocalText('202#Arc');
   end
   else
   begin
      if (IsdIdt)
      begin
         Result = LocalText('203#dIdt');
      end
      else
      begin
         if (IsEnergyLimit)
         begin
            Result = LocalText('164#Energy > 350 mJ');
         end
         else
         begin
            Result = get_resistance_value(Prefix, Value);
         end;
      end;
   end;
end;

