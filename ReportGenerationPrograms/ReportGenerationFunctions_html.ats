//Returns the value for a dielectric breakdown measurement
function get_dielectric_breakdown_value(Arc: boolean;
            ValueValid: boolean; ValueIr: real; PrefixIr: string;
            ValueIi: real; PrefixIi: string): string;
begin
   if (Arc)
   begin
      Result = '&nbsp;';
   end
   else
   begin
      if (ValueValid)
      begin
         ValueIr = get_current_value(PrefixIr, ValueIr);
         ValueIi = get_current_value(PrefixIi, ValueIi);
         if (StrCompare(ValueIr, '&nbsp;') == 0)
         begin
            if (StrCompare(ValueIi, '&nbsp;') == 0)
            begin
               Result = '&nbsp;';
            end
            else
            begin
               Result = StrAdd('Ii=', ValueIi);
            end;
         end
         else
         begin
            if (StrCompare(ValueIi, '&nbsp;') == 0)
            begin
               Result = StrAdd('Ir=', ValueIr);
            end
            else
            begin
               Result = StrAdd('Ir=', ValueIr);
               Result = StrAdd(Result, '; Ii=');
               Result = StrAdd(Result, ValueIi);
            end;
         end;
      end
      else
      begin
         Result = '&nbsp;';
      end;
   end;
end;

//writes the header for the HTML document
function write_html_header(WindowCaption: string): void;
begin
   WriteLn('<HTML>');
   WriteLn('<HEAD>');
   //The next line is required for cyrillic characters
   //WriteLn('<meta http-equiv="content-type" content="text/html; charset=Windows-1251">');
   WriteLn('<LINK REL="stylesheet" TYPE="text/css" HREF="..\..\images\Report.css">');
   Write('<TITLE>');
   Text = WindowCaption;
   Write(Text);
   WriteLn('</TITLE>');
   WriteLn('</HEAD>');
   WriteLn('<BODY BGCOLOR="#FFFFFF" FONTCOLOR="#000000">');
   WriteLn('');
end;

//writes the footer for the HTML document
function write_html_footer(): void;
begin
   WriteLn('</BODY>');
   WriteLn('</HTML>');
end;

//returns the picture for a test step
function get_teststepimage(StepResult: integer; ManualTest: boolean): string;
begin
   if (ManualTest)
   begin
      if (StepResult == TESTSTEP_Passed)
      begin
         Result = '..\..\images\ManualTestPass.jpg';
      end
      else
      begin
         Result = '..\..\images\ManualTestFail.jpg';
      end;
   end
   else
   begin
      if (StepResult == TESTSTEP_Passed)
      begin
         Result = '..\..\images\TeststepPass.jpg';
      end
      else
      begin
         Result = '..\..\images\TeststepFail.jpg';
      end;
   end;
end;

//returns the style for the output of a command group
function get_commandgroup_resultstyle(Available, Active: boolean; Errors,
   ExecutedCommands: integer): string;
begin
   Result = '';
   if (Available)
   begin
      if (Active)
      begin
         if (Errors == 0)
         begin
            if (ExecutedCommands == 0)
            begin
               Result = 'commandgroupnocommands';
            end
            else
            begin
               Result = 'commandgrouppass';
            end;
         end
         else
         begin
            Result = 'commandgroupfail';
         end;
      end
      else
      begin
         Result = 'commandgroupdisabled';
      end;
   end;
end;

function get_command_group_result_style(CmdGroup, FailcounterID: integer): string;
begin
   Available = ParamIsCommandGroupAvailable(CmdGroup);
   Active = ParamIsCommandGroupActive(CmdGroup);
   Errors = FailCounterGet(FailcounterID);
   ExecutedCommands = MiscGetNumberOfExecutedCommands(CmdGroup);
   Result = get_commandgroup_resultstyle(Available, Active, Errors, ExecutedCommands);
end;

//returns the text and the style for the output of a command group
function get_commandgroup_result(Available, Active: boolean; Errors: integer;
   ExecutedCommands: integer; var Style: string): string;
begin
   Result = get_commandgroup_resultstring(Available, Active, Errors, 
      ExecutedCommands);
   Style = get_commandgroup_resultstyle(Available, Active, Errors, 
      ExecutedCommands);
end;

function get_command_group_result(CmdGroup, FailcounterID: integer;
   var Style: string): string;
begin
   Result = get_command_group_result_string(CmdGroup, FailcounterID);
   Style = get_command_group_result_style(CmdGroup, FailcounterID); 
end;   

//Output if external voltage was detected
function external_voltage_error(Name: string; Pin1: integer;
            Pin2: integer; Value: real; ValuePrefix: string): void;
begin
   ResultText = LocalText('50#Ext. Volt.');
   Style = 'teststepfail';
   File = get_teststepimage(RES_Result, RES_ManualTest);
   Write('<TABLE Border=0 Width=640 class=');
   Write(Style);
   WriteLn('>');
   Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
   Write('<IMG SRC="');
   Write(File);
   WriteLn('" Width=16 Height=16>&nbsp;</TD>');
   Write('<TD Width=100 class=bold>');
   Write(ResultText);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   Write(Name);
   WriteLn('</TD>');
   PinStr1 = get_pinname(Pin1);
   PinStr2 = get_pinname(Pin2);
   Write('<TD Width=130>');
   Write(PinStr1);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   Write(PinStr2);
   WriteLn('</TD>');
   Value = get_voltage_value(ValuePrefix, Value);
   Write('<TD Align=RIGHT>');
   Write(Value);
   WriteLn('</TD></TR>');
   WriteLn('</TABLE>');
end;

//writes section information into the report
function display_sections(): void;
begin
   Count = ProjectGetSectionCount();
   if (Count > 0)
   begin
      WriteLn('<TABLE Width=640 class=header>');
      Write('<TR><TD Width=300 class=bold>');
      Write(LocalText('70#Sections'));
      Write('</TD><TD>&nbsp;</TD></TR>');
      for Index = 1 to Count do
      begin
         Name = ProjectGetSectionName(Index);
         Enabled = ProjectSectionEnabled(Name);
         if (Enabled == TRUE)
         begin
            State = LocalText('71#enabled');
         end
         else
         begin
            State = LocalText('72#disabled');
         end;

         Write('<TR><TD Width=300>');
         Write(Name);
         Write('</TD><TD>');
         Write(State);
         WriteLn('</TD></TR>');
      end;
      WriteLn('</TABLE>');
      WriteLn('<BR>');
   end;
end;

//Writes a warning into the report if not all required adapter cables were connected
function check_adaptercables(): boolean;
begin
   Result = TRUE;
   AllCableCount = AdapterCablesGetList(AllCables, ADAPTERCABLES_All);
   ConnectedCableCount = 0;
   NotConnectedCableCount = 0;
   if (AllCableCount > 0)
   begin
      ConnectedCableCount = AdapterCablesGetList(ConnectedCables,
                               ADAPTERCABLES_Connected);
      MissingCableCount = AdapterCablesGetList(NotConnectedCables,
                             ADAPTERCABLES_Missing);
   end;
   if (ConnectedCableCount <> AllCableCount)
   begin
      Result = FALSE;
      WriteLn('<BR>');
      WriteLn('<TABLE Width=640 class=testheaderwarningtable>');
      Write('<TR>');
      Write('<TD COLSPAN=3 ALIGN=CENTER class=testheaderwarningtitle>');
      Write(LocalText('75#Test incomplete'));
      WriteLn('</TD></TR>');


      WriteLn('<TR class=testheaderwarningtext>');
      Write('<TD class=center>');
      Write(LocalText('76#Required adapter cables'));
      Write(':&nbsp;');
      Write(AllCableCount);
      WriteLn('</TD>');

      Write('<TD class=center>');
      Write(LocalText('77#Connected adapter cables'));
      Write(':&nbsp;');
      Write(ConnectedCableCount);
      WriteLn('</TD>');

      Write('<TD class=center>');
      Write(LocalText('78#Missing adapter cables'));
      Write(':&nbsp;');
      Write(MissingCableCount);
      WriteLn('</TD>');

      WriteLn('</TR>');
      WriteLn('</TABLE>');
   end;
end;

function show_lastisolationtestcable(): void;
begin
   CableCount = AdapterCablesGetList(Cables, ADAPTERCABLES_All);
   if (CableCount > 0)
   begin
      Pin = PinGetLastIsolationtestPin();
      if (Pin <> PINADDRESS_Invalid)
      begin
         Cable = PinGetData(Pin, PIN_AdapterCableName);
         WriteLn('<TABLE Width=640 class=header><TR><TD>');
         Line = StrAdd(LocalText('86#Last cable tested in isolation test:'), ' ');
         Line = StrAdd(Line, Cable);
         WriteLn(Line);
         WriteLn('</TD></TR></TABLE>');
      end;
   end;
end;


