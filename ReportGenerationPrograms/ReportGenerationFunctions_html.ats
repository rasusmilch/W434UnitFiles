//Funtion for ReportWriteNormal and ReportWriteError
function report_write_teststep(Data: string; Passed: boolean): boolean;
begin
   Result = FALSE;
   // Search for tag
   Tag = '<TESTSTEP>';
   if (StrPosition(Tag, Data) == 1)
   begin
      Result = TRUE;
      // Tag found. Expected entry structure is as follows.
      // ReportWriteNormal('<TESTSTEP>Passed;StepName;Pin1;Pin2;Value');
      // Remaining text after tag will be separated by each semicolon and
      // written into report like a test step.
      Data = StrDelete(Data, 1, StrLength(Tag));
      Columns = 5;
      MiscCreateList(ColumnList, Columns);
      PrelastColumn = Columns - 1;
      for Column = 1 to PrelastColumn do
      begin
         SemicolonPos = StrPosition(';', Data);
         Length = SemicolonPos - 1;
         ColumnList[Column] = StrCopy(Data, 1, Length);
         Data = StrDelete(Data, 1, SemicolonPos);
      end;
      ColumnList[Columns] = Data;
      if (Passed)
      begin
         Style = 'teststeppass';
         File = '..\..\images\TeststepPass.jpg';
      end
      else
      begin
         Style = 'teststepfail';
         File = '..\..\images\TeststepFail.jpg';
      end;
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ColumnList[1]);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(ColumnList[2]);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(ColumnList[3]);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(ColumnList[4]);
      WriteLn('</TD>');
      Write('<TD Align=RIGHT>');
      Write(ColumnList[5]);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;
end;

function report_write_tag_get_image_size(Tag: string; var Width: integer;
            var Height: integer): boolean;
begin
   Result = FALSE;
   Len = StrLength('Image');
   Size = StrDelete(Tag, 1,  Len);
   Size = StrLowerCase(Size);
   SizeLength = StrLength(Size);
   X_Pos = StrPosition('x', StrLowerCase(Size));
   //size value contains an x?
   if (X_Pos > 1)
   begin
      //separate value in front of and after x
      WidthLength = X_Pos - 1;
      HeightPos = X_Pos + 1;
      HeightLength = SizeLength - X_Pos;
      Width = StrCopy(Size, 1, WidthLength);
      Height = StrCopy(Size, HeightPos, HeightLength);
      //both must be integer
      if ((FormatIsInteger(Width)) AND ((FormatIsInteger(Height)))
      begin
         Result = TRUE;
         // DIN-A4 page sizes...
         DinA4Width = 640;
         DinA4Height = 905;
         //reduce if width > DIN A4 width
         if (Width > DinA4Width)
         begin
            Factor = Width / DinA4Width;
            Width = DinA4Width;
            Height = Height / Factor;
            Height = ArithRound(Height, 0);
         end;
         //reduce if height > DIN A4 height
         if (Height > DinA4Height)
         begin
            Factor = Height / DinA4Height;
            Height = DinA4Height;
            Width = Width / Factor;
            Width = ArithRound(Width, 0);
         end;
      end;
   end;
end;

//Inserts an image into the report
function insert_image(Filename: string; Width: integer; Height: integer): void;
begin
   AbsoluteFilename = FileExpandName(Filename);
   //Blank line before image
   WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
   WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
   WriteLn('<TD></TD></TR>');
   WriteLn('</TABLE>');

   //Image
   WriteLn('<TABLE Width=640>');
   Line = '<TR><TD ALIGN="CENTER"><IMG SRC="';
   Line = StrAdd(Line, AbsoluteFilename);
   Line = StrAdd(Line, '"');
   if ((Width > 0) AND (Height > 0))
   begin
      Line = StrAdd(Line, ' width="');
      Line = StrAdd(Line, Width);
      Line = StrAdd(Line, '" height="');
      Line = StrAdd(Line, Height);
      Line = StrAdd(Line, '"');
   end;
   Line = StrAdd(Line, '></TD></TR>');
   WriteLn(Line);
   WriteLn('</TABLE><BR>');

   //Blank line after image
   WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
   WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
   WriteLn('<TD></TD></TR>');
   WriteLn('</TABLE>');
end;

function write_default_table_line(File, ResultText, Name: string;
   Pin1: string = '&nbsp;'; Pin2: string = '&nbsp;';
   Value: string = '&nbsp;'): void;
begin
   if (StrCompare(File, '&nbsp;') == 0)
   begin
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write(File);
      WriteLn('</TD>');
   end
   else
   begin
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
   end;
   Write('<TD Width=100 class=bold>');
   Write(ResultText);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   Write(Name);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   Write(Pin1);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   Write(Pin2);
   WriteLn('</TD>');
   Write('<TD Align=RIGHT>');
   Write(Value);
   WriteLn('</TD>');
   WriteLn('</TR>');
end;

