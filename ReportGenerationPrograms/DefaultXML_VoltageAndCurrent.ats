function write_voltage_result(TestStepResult: integer): void;
begin
   Line = '<TestStepResult Type="Voltage">';
   write_line(Line);
   inc_indent();
   switch (TestStepResult)
   begin
      case TESTSTEP_Passed:
      begin
         Text = 'Passed';
      end;
      case TESTSTEP_Failed:
      begin
         Text = 'Failed';
      end;
      default: begin
         Text = 'Invalid';
      end;
   end;
   Line = '<Result>' + Text + '</Result>';
   write_line(Line);
   dec_indent();
   write_line('</TestStepResult>');
end;

template VoltageTest
begin
   write_line('<TestStep Cmd="VoltageTest">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_two_pin_basics(RES_Name, RES_Pin1, RES_Pin2, RES_OriginalPin1, RES_OriginalPin2);
   write_value_and_tolerances(RES_Voltage, RES_LowerTol, RES_UpperTol, 'V');
   write_voltage_result(RES_Result);
   Line = get_value_with_prefix('Voltage', 'V', RES_Prefix, RES_Value);
   write_line(Line);
   dec_indent();
   write_line('</TestStep>');
end;

