//Verbindungstest-Funktionen sind die Funktionen, bei denen die
//Durchgangsparameter für die Messung verwendet werden.

//Continuity functions are those, for which the continuity parameters are used

function get_continuity_result_text(ResultValue: integer; IsArc: boolean; var Style: string): string;
begin
   switch (ResultValue)
   begin
      case TESTSTEP_Passed:
      begin
         Result = LocalText('5#Passed');
         Style = 'teststeppass';
      end;
      case TESTSTEP_Failed:
      begin
         if (IsArc)
         begin
            Result = LocalText('202#Arc');
         end
         else
         begin
            Result = LocalText('6#Open');
         end;
         Style = 'teststepfail';
      end;
      default:
      begin
         Result = LocalText('7#Invalid');
         Style = 'teststepfail';
      end;
   end;
end;

//Output for the command ParamContinuity
template ParamContinuity
begin
   Line = '';
   if (RES_CurrentChanged)
   begin
      Value = FormatCurrent(RES_CCurrent);
      Line = StrAdd(Line, LocalText('51#Current'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_ThresholdChanged)
   begin
      Value = FormatResistance(RES_CThreshold);
      Line = StrAdd(Line, LocalText('52#Threshold'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TriseChanged)
   begin
      Value = FormatTime(RES_CTrise);
      Line = StrAdd(Line, LocalText('53#Trise'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TwaitChanged)
   begin
      Value = FormatTime(RES_CTwait);
      Line = StrAdd(Line, LocalText('54#Twait'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TmeasChanged)
   begin
      Value = FormatTime(RES_CTmeas);
      Line = StrAdd(Line, LocalText('55#Tmeas'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_AutoRangeChanged)
   begin
      if (RES_CAutoRange)
      begin
         Value = LocalText('56#On');
      end
      else
      begin
         Value = LocalText('57#Off');
      end;
      Line = StrAdd(Line, LocalText('58#Auto ranging'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_VoltageLimitChanged)
   begin
      Value = FormatVoltage(RES_CVoltageLimit);
      Line = StrAdd(Line, LocalText('59#Voltage limit'));
      Line = Line + '=' + Value + '; ';
   end;
   if (StrCompare(Line, '') <> 0)
   begin
      Pos = StrLength(Line) - 1;
      Line = StrDelete(Line, Pos, 2);
      WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD class=bold>');
      Write(LocalText('60#Parameters for continuity test'));
      WriteLn('</TD></TR>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(Line);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;
end;

