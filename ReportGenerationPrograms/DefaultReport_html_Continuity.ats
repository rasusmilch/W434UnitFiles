//Output for the command NoConnection
template NoConnection
begin
   Name = get_teststep_name(RES_Name, LocalText('232#NC'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      Style = 'teststepfail';
      if ((RES_Result == TESTSTEP_Failed) AND (NOT RES_Arc))
      begin
         ResultText = LocalText('15#Short');
      end
      else
      begin
         ResultText = get_continuity_result_text(RES_Result, RES_Arc, Style);
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      if (RES_Arc)
      begin
         Value = '&nbsp;';
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      display_teststepcomment(RES_Comment, Style,
         RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

//Output for the command WireTestAnalysis
template WireTestAnalysis
begin
   Name = get_teststep_name(RES_Name, LocalText('8#Wire'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      Style = '';
      ResultText = get_continuity_result_text(RES_Result, RES_Arc, Style);
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      Value = get_resistance_value(RES_Prefix, RES_Value);
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      if (RES_Result == TESTSTEP_Failed)
      begin
         //Write results of continuity analysis
         for Network = 1 to RES_NetworkCount do
         begin
            for Index = 1 to RES_NetworkPinCount[Network] do
            begin
               Write('<TR><TD Width=20>&nbsp;</TD><TD>&nbsp;</TD><TD>&nbsp;</TD><TD>');
               Write(get_pinname(RES_NetworkPins[Network, Index]));
               WriteLn('</TD><TD>&nbsp;</TD><TD>&nbsp;</TD></TD></TR>');
            end;
            Write('<TR><TD Width=20>&nbsp;</TD><TD>&nbsp;</TD><TD>');
            if (Network < RES_NetworkCount)
            begin
               if (RES_ValuesToNextNWArc[Network])
               begin
                  Write('Arc');
               end
               else
               begin
                  Write(get_resistance_value(RES_ValuesToNextNWPrefix[Network],
                     RES_ValuesToNextNW[Network]));
               end;
               Write('</TD><TD>&nbsp;</TD><TD>&nbsp;</TD><TD>&nbsp;</TD>');
            end;
            WriteLn('</TR>');
         end;
         //Write results of LV isolation analysis
         for Network = 1 to RES_NetworkCount do
         begin
            if (RES_NCAExecuted[Network])
            begin
               if (RES_ShortCount[Network] == 0)
               begin
                  Write('<TR><TD Width=20 class=teststeppass>&nbsp;</TD><TD class=teststeppass>');
                  Write(LocalText('233#NCA'));
                  Write('</TD><TD class=teststeppass>&nbsp;</TD><TD class=teststeppass>');
                  Pin = get_pinname(RES_NetworkPins[Network, 1]);
                  Write(Pin);
                  Write('</TD><TD class=teststeppass>&nbsp;</TD><TD class=teststeppass>');
                  Value = get_resistance_value(RES_NCAValuesPrefix[Network], RES_NCAValues[Network]);
                  Write(Value);
                  WriteLn('</TD></TR>');
               end
               else
               begin
                  Pin1 = get_pinname(RES_NetworkPins[Network, 1]);
                  for Index = 1 to RES_ShortCount[Network] do
                  begin
                     Write('<TR><TD Width=20>&nbsp;</TD><TD>');
                     Write(LocalText('43#Short'));
                     Write('</TD><TD>&nbsp;</TD><TD>');
                     Write(Pin1);
                     Write('</TD><TD>');
                     Pin2 = get_pinname(RES_Shorts[Network, Index]);
                     Write(Pin2);
                     Write('</TD><TD>');
                     if (RES_ShortArcs[Network, Index])
                     begin
                        Value = LocalText('202#Arc');
                     end
                     else
                     begin
                        Value = get_resistance_value(RES_ShortPrefixes[Network, Index],
                           RES_ShortValues[Network, Index]);
                     end;
                     Write(Value);
                     WriteLn('</TD></TR>');
                  end;
               end;
            end;
         end;
      end;
      WriteLn('</TABLE>');
   end;
end;

//Output for the command NoConnAll
template NoConnAll
begin
   Name = get_teststep_name(RES_Name, LocalText('233#NCA'));
   Pin1 = get_pinname(RES_Pin);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      Value = get_resistance_value(RES_Prefix, RES_Value);
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(LocalText('5#Passed'));
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>&nbsp;</TD>');
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      for Index = 1 to RES_ErrorPinCount do
      begin
         Pin2 = get_pinname(RES_ErrorPins[Index]);
         if (RES_Arcs[Index])
         begin
            ResultText = LocalText('202#Arc');
            Value = '&nbsp;';
         end
         else
         begin
            ResultText = LocalText('15#Short');
            Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
         end;
         Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
         Write('<IMG SRC="');
         Write(File);
         WriteLn('" Width=16 Height=16>&nbsp;</TD>');
         Write('<TD Width=100 class=bold>');
         Write(ResultText);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Name);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin1);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin2);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
   end;
   display_teststepcomment(RES_Comment, Style,
      RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;
