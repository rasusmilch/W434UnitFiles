//Output for the command WireTest
template WireTest
begin
   Name = get_teststep_name(RES_Name, LocalText('8#Wire'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      Style = '';
      ResultText = get_continuity_result_text(RES_Result, RES_Arc, Style);
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      if (RES_AutoRangePassedAfterFail)
      begin
         Value = get_resistance_value('>', RES_CThreshold);
         Value = StrAdd(Value, '!');
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      if (RES_Result == TESTSTEP_Failed)
      begin
         if (RES_InterchangedWiresPin1 <> PINADDRESS_None)
         begin
            Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
            Write('<TD Width=100 class=bold>&nbsp;</TD>');
            Write('<TD Width=130>');
            Write(LocalText('69#Connected'));
            WriteLn('</TD>');
            Pin1 = get_pinname(RES_Pin1);
            Pin2 = get_pinname(RES_InterchangedWiresPin1);
            Write('<TD Width=130>');
            Write(Pin1);
            WriteLn('</TD>');
            Write('<TD Width=130>');
            Write(Pin2);
            WriteLn('</TD>');
            WriteLn('<TD Align=RIGHT>&nbsp;</TD></TR>');
         end;
         if (RES_InterchangedWiresPin2 <> PINADDRESS_None)
         begin
            Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
            Write('<TD Width=100 class=bold>&nbsp;</TD>');
            Write('<TD Width=130>');
            Write(LocalText('69#Connected'));
            WriteLn('</TD>');
            Pin1 = get_pinname(RES_Pin2);
            Pin2 = get_pinname(RES_InterchangedWiresPin2);
            Write('<TD Width=130>');
            Write(Pin1);
            WriteLn('</TD>');
            Write('<TD Width=130>');
            Write(Pin2);
            WriteLn('</TD>');
            WriteLn('<TD Align=RIGHT>&nbsp;</TD></TR>');
         end;
      end;
      display_teststepcomment(RES_Comment, Style,
         RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

//Output for the command SwitchTest
template SwitchTest
begin
   Name = get_teststep_name(RES_Name, LocalText('11#Switch'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      Style = 'teststepfail';
      if ((RES_Result == TESTSTEP_Failed) AND (NOT RES_Arc))
      begin
         if (RES_SwitchClosed)
         begin
            ResultText = LocalText('9#Open');
         end
         else
         begin
            ResultText = LocalText('10#Closed');
         end;
      end
      else
      begin
         ResultText = get_continuity_result_text(RES_Result, RES_Arc, Style);
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      if (RES_AutoRangePassedAfterFail)
      begin
         Value = get_resistance_value('>', RES_CThreshold);
         Value = StrAdd(Value, '!');
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      display_teststepcomment(RES_Comment, Style,
         RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

