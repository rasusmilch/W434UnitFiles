//HV-Isolationstest-Funktionen sind die Funktionen, bei denen die
//HV-DC-Parameter für die Messung verwendet werden.

//HV isolation test functions are those, for which the HV DC parameters are used


//Output for the command ParamIsolationHV
template ParamIsolationHV
begin
   Line = get_isolationhv_parameters_text(RES_VoltageChanged, RES_HVVoltage,
      RES_ThresholdChanged, RES_HVThreshold, RES_HVUseIThreshold,
      RES_HVIThreshold, RES_TriseChanged, RES_HVTrise,
      RES_TwaitChanged, RES_HVTwait, RES_TmeasChanged, RES_HVTmeas,
      RES_AutoRangeChanged, RES_HVAutoRange,
      RES_CurrentLimitChanged, RES_HVCurrentLimit,
      RES_TmeasReductionChanged, RES_HVTmeasReduction,
      RES_TmeasFactorChanged, RES_HVTmeasFactor,
      RES_VoltageRampChanged, RES_HVVoltageRamp,
      RES_dIdtEnabledChanged, RES_HVdIdtEnabled,
      RES_dIdtCurrentThresholdChanged, RES_HVdIdtCurrentThreshold,
      RES_dIdtTimeThresholdChanged, RES_HVdIdtTimeThreshold);
   if (StrCompare(Line, '') <> 0)
   begin
      WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD class=bold>');
      Write(LocalText('67#Parameters for HV isolation test'));
      WriteLn('</TD></TR>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(Line);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;
end;

