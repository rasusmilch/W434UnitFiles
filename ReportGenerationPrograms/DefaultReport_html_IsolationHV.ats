//Output for the command NoConnectionHV
template NoConnectionHV
begin
   Name = get_teststep_name(RES_Name, LocalText('226#NC HV'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
            Style = 'teststeppass';
         end;
         case TESTSTEP_Failed:
         begin
            ResultText = get_hv_isolation_error_text(RES_Arc, RES_dIdt, RES_ELim);
            Style = 'teststepfail';
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
            Style = 'teststepfail';
         end;
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      Value = '&nbsp;';
      IsShort = (NOT RES_Arc) AND (NOT RES_dIdt) AND (NOT RES_ELim);
      if (IsShort)
      begin
         if (RES_HVUseIThreshold)
         begin
            Value = get_current_value(RES_IPrefix, RES_IValue);
         end
         else
         begin
            Value = get_resistance_value(RES_Prefix, RES_Value);
         end;
      end;
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      display_teststepcomment(RES_Comment, Style,
         RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

//Output for the command NoConnAllHV
template NoConnAllHV
begin
   Name = get_teststep_name(RES_Name, LocalText('227#NCA HV'));
   Pin1 = get_pinname(RES_Pin);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      if (RES_HVUseIThreshold)
      begin
         Value = get_current_value(RES_IPrefix, RES_IValue);
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(LocalText('5#Passed'));
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>&nbsp;</TD>');
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      for Index = 1 to RES_ErrorPinCount do
      begin
         Pin2 = get_pinname(RES_ErrorPins[Index]);
         ResultText = get_hv_isolation_error_text(RES_Arcs[Index],
            RES_dIdts[Index], RES_ELims[Index]);
         IsShort = (NOT RES_Arcs[Index]) AND (NOT RES_dIdts[Index]) AND
            (NOT RES_ELims[Index]);
         Value = '&nbsp;';
         if (IsShort)
         begin
            if (RES_HVUseIThreshold)
            begin
               Value = get_current_value(RES_IPrefixes[Index], RES_IValues[Index]);
            end
            else
            begin
               Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
            end;
         end;
         Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
         Write('<IMG SRC="');
         Write(File);
         WriteLn('" Width=16 Height=16>&nbsp;</TD>');
         Write('<TD Width=100 class=bold>');
         Write(ResultText);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Name);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin1);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin2);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
   end;
   display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

