         Write('<TD Width=130>');
         Write(HighPin);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(LowPin);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
      display_short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
   end;
   display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed,
      RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;
