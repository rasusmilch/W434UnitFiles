//Output for the command NoConnGroupHV
template NoConnGroupHV
begin
   Name = get_teststep_name(RES_Name, LocalText('229#NCG HV'));
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      if (RES_HVUseIThreshold)
      begin
         Value = get_current_value(RES_IPrefix, RES_IValue);
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(LocalText('5#Passed'));
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(RES_HighGroup);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(RES_LowGroup);
      WriteLn('</TD>');
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      for Index = 1 to RES_ErrorCount do
      begin
         ResultText = get_hv_isolation_error_text(RES_Arcs[Index],
            RES_dIdts[Index], RES_ELims[Index]);
         IsShort = (NOT RES_Arcs[Index]) AND (NOT RES_dIdts[Index]) AND
            (NOT RES_ELims[Index]);
         Value = '&nbsp;';
         if (IsShort)
         begin
            if (RES_HVUseIThreshold)
            begin
               Value = get_current_value(RES_IPrefixes[Index], RES_IValues[Index]);
            end
            else
            begin
               Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
            end;
         end;
         if ((RES_ErrorHighPins[Index] == PINADDRESS_NotSearched) OR
             (RES_ErrorHighPins[Index] == PINADDRESS_NotFound))
         begin
            Pin1 = RES_HighGroup;
         end
         else
         begin
            Pin1 = get_pinname(RES_ErrorHighPins[Index]);
         end;
         if ((RES_ErrorLowPins[Index] == PINADDRESS_NotSearched) OR
             (RES_ErrorLowPins[Index] == PINADDRESS_NotFound))
         begin
            Pin2 = RES_LowGroup;
         end
         else
         begin
            Pin2 = get_pinname(RES_ErrorLowPins[Index]);
         end;
         Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
         Write('<IMG SRC="');
         Write(File);
         WriteLn('" Width=16 Height=16>&nbsp;</TD>');
         Write('<TD Width=100 class=bold>');
         Write(ResultText);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Name);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin1);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin2);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
      display_short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
   end;
   display_teststepcomment(RES_Comment, Style,
      RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

//Output for the command ConnectionTestHV
template ConnectionTestHV
begin
   Name = get_teststep_name(RES_Name, LocalText('230#ConnectionTestHV'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
            Style = 'teststeppass';
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = LocalText('202#Arc');
            end
            else
            begin
               ResultText = LocalText('6#Open');
            end;
            Style = 'teststepfail';
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
            Style = 'teststepfail';
         end;
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      if (RES_Arc)
      begin
         Value = '&nbsp;';
      end
      else
      begin
         if (RES_HVUseIThreshold)
         begin
            Value = get_current_value(RES_IPrefix, RES_IValue);
         end
         else
         begin
            Value = get_resistance_value(RES_Prefix, RES_Value);
         end;
      end;
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

//Output for the command SimpleNoConnPinVsGroupHV
template SimpleNoConnPinVsGroupHV
begin
   Name = get_teststep_name(RES_Name, LocalText('231#SPvG HV'));
   HighPin = get_pinname(RES_Pin);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      if (RES_HVUseIThreshold)
      begin
         Value = get_current_value(RES_IPrefix, RES_IValue);
      end
