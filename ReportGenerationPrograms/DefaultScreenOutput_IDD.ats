//Output for the command ParamIDDIsolationMonitoring
template ParamIDDIsolationMonitoring
begin
   Line = '';

   if (RES_RxThresholdChanged)
   begin
      Line = StrAdd(Line, LocalText('190#Rx Threshold'));
      Line = Line + '=' + RES_IM_RxThreshold + '; ';
   end;
   if (RES_NWThresholdChanged)
   begin
      Line = StrAdd(Line, LocalText('191#NW Threshold'));
      Line = Line + '=' + RES_IM_NWThreshold + '; ';
   end;

   if (RES_ThresholdChanged)
   begin
      Line = StrAdd(Line, LocalText('52#Threshold'));
      Line = Line + '=' + RES_IM_Threshold + '; ';
   end;
   if (RES_RxAmplificationChanged)
   begin
      Line = StrAdd(Line, LocalText('186#Rx-Amplification'));
      Line = Line + '=' + RES_IM_RxAmplification + '; ';
   end;
   if (RES_StaticCountingChanged)
   begin
      if (RES_IM_StaticCounting)
      begin
         Value = LocalText('56#On');
      end
      else
      begin
         Value = LocalText('57#Off');
      end;
      Line = StrAdd(Line, LocalText('196#Static Counting'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_CountingIntervalChanged)
   begin
      Value = FormatTime(RES_IM_CountingInterval);
      Line = StrAdd(Line, LocalText('187#Counting Interval'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_GapWidthChanged)
   begin
      Value = FormatTime(RES_IM_GapWidth);
      Line = StrAdd(Line, LocalText('188#Gap Width'));
      Line = Line + '=' + Value + '; ';
   end;
   if (StrCompare(Line, '') <> 0)
   begin
      Pos = StrLength(Line) - 1;
      Line = StrDelete(Line, Pos, 2);
      UIWriteNormal(LocalText('194#IDD: Parameters for the Isolation Monitoring'));
      UIWriteNormal(Line);
   end;
end;

//Output for the command IDDRun
template IDDRun
begin
   Name = get_teststep_name(RES_Name, LocalText('267#IDD'));
   Name = format_teststep_name(Name);
   if (RES_Result == TESTSTEP_Passed)
   begin
      ResultText = format_teststep_result(LocalText('5#Passed'));
      Line = ResultText + Name;
      UIWriteNormal(Line);
   end
   else
   begin
      //Transmitter fails
      for Index = 1 to RES_TxCount do
      begin
         ResultText = '';
         Passed = get_idd_tx_result(RES_TxResults[Index], ResultText);
         if (NOT Passed)
         begin
            ResultText = format_teststep_result(ResultText);
            Pin1 = format_teststep_pin(get_pinname(RES_TxPins[Index]));
            Pin2 = format_teststep_pin('');
            if (RES_TxValues[Index] == 0)
            begin
               Value = '';
            end
            else
            begin
               Value = RES_TxValues[Index];
            end;
            Line = ResultText + Name + Pin1 + Pin2 + Value;
            UIWriteError(Line);
         end;
      end;
      //Receiver fails
      for Index = 1 to RES_FailedRxCount do
      begin
         ResultText = get_idd_rx_fail_text(RES_RxResults[Index]);
         ResultText = format_teststep_result(ResultText);
         Pin1 = format_teststep_pin(get_pinname(RES_TxFailPins[Index]));
         Pin2 = format_teststep_pin(get_pinname(RES_RxFailPins[Index]));
         if (RES_RxValues[Index] == 0)
         begin
            Value = '';
         end
         else
         begin
            Value = RES_RxValues[Index];
         end;
         Line = ResultText + Name + Pin1 + Pin2 + Value;
         UIWriteError(Line);
      end;
   end;
end;
