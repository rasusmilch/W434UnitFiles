begin
end;

function write_usergroupname(): void;
begin
end;

function write_teststep_comment(Comment: string; DeclaredAsPassed: boolean = FALSE;
   DeclaredAsPassedByUser: string = ''): void;
begin
   if (DeclaredAsPassed)
   begin
      write_line('<DeclaredAsPassed>1</DeclaredAsPassed>');
      Line = '<DeclaredAsPassedByUser>' + DeclaredAsPassedByUser + '</DeclaredAsPassedByUser>';
      write_line(Line);
   end;
   if (StrCompare(Comment, '') <> 0)
   begin
      Line = '<Comment>' + Comment + '<Comment>';
      write_line(Line);
   end;
end;

//Writes the results of the command groups
function write_command_group_result(CmdGroup, FailcounterID: integer; CmdGrpName: string): void;
begin
   Available = ParamIsCommandGroupAvailable(CmdGroup);
   if (Available)
   begin
      Active = ParamIsCommandGroupActive(CmdGroup);
      Errors = FailCounterGet(FailcounterID);
      ExecutedCommands = MiscGetNumberOfExecutedCommands(CmdGroup);
      Line = '<CommandGroupResult Group="' + CmdGrpName + '">';
      write_line(Line);
      inc_indent();
      if (Active)
      begin
         switch (Errors)
         begin
            case 0:
            begin
               if (ExecutedCommands == 0)
               begin
                  Value = 'NoCommands';
               end
               else
               begin
                  Value = 'Pass';
               end;
            end;
            default:
            begin
               Value = 'Fail';
            end;
         end;
      end
      else
      begin
         Value = 'NotActive';
      end;
      Line = '<Result>' + Value + '</Result>';
      write_line(Line);
      Line = '<ErrorCount>' + Errors + '</ErrorCount>';
      write_line(Line);
      dec_indent();
      write_line('</CommandGroupResult>');
   end;
end;

function write_command_group_results(): void;
begin
   write_line('<CommandGroupResults>');
   inc_indent();
   write_command_group_result(CMDGRP_Continuity, FAILCOUNTER_Continuity, 'Continuity');
   write_command_group_result(CMDGRP_IsolationLV, FAILCOUNTER_IsolationLV, 'IsolationLV');
   write_command_group_result(CMDGRP_IsolationHV, FAILCOUNTER_IsolationHV, 'IsolationHV');
   write_command_group_result(CMDGRP_DielectricBreakdown, FAILCOUNTER_DielectricBreakdown, 'DielectricBreakdown');
   write_command_group_result(CMDGRP_ElectricalComponents, FAILCOUNTER_ElectricalComponents, 'ElectricalComponents');
   write_command_group_result(CMDGRP_VoltageAndCurrent, FAILCOUNTER_VoltageAndCurrent, 'VoltageAndCurrent');
   write_command_group_result(CMDGRP_OpticalComponents, FAILCOUNTER_OpticalComponents, 'OpticalComponents');
   write_command_group_result(CMDGRP_CANBus, FAILCOUNTER_CANBus, 'CANBus');
   write_command_group_result(CMDGRP_IDD, FAILCOUNTER_IDD, 'IDD');
   write_command_group_result(CMDGRP_Detections, FAILCOUNTER_Detections, 'Detections');
   write_command_group_result(CMDGRP_Others, FAILCOUNTER_Others, 'Others');
   dec_indent();
   write_line('</CommandGroupResults>');
end;

function write_teststep_basics(FileIndex, StartLine, ModuleFileIndex, ModuleLine: integer): void;
begin
   Line = '<FileIndex>' + FileIndex + '</FileIndex>';
   write_line(Line);
   Line = '<StartLine>' + StartLine + '</StartLine>';
   write_line(Line);
   Line = '<ModuleFileIndex>' + ModuleFileIndex + '</ModuleFileIndex>';
   write_line(Line);
   Line = '<ModuleLine>' + ModuleLine + '</ModuleLine>';
   write_line(Line);
end;

function write_one_pin_basics(Name: string; Pin, OrigPin: integer): void;
begin
   write_line('<OnePinBasics>');
   inc_indent();
   Line = '<Name>' + Name + '</Name>';
   write_line(Line);
   Line = '<PinAddr>' + Pin + '</PinAddr>';
   write_line(Line);
   Line = '<OriginalPinAddr>' + OrigPin + '</OriginalPinAddr>';
   write_line(Line);

   PinName = get_pin_name(Pin);
   Line = '<PinName>' + PinName + '</PinName>';
   write_line(Line);
   PinName = get_pin_name(OrigPin);
   Line = '<OriginalPinName>' + PinName + '</OriginalPinName>';
   write_line(Line);

   dec_indent();
   write_line('</OnePinBasics>');
end;

function write_two_pin_basics(Name: string; Pin1, Pin2, OrigPin1, OrigPin2: integer): void;
begin
   write_line('<TwoPinBasics>');
   inc_indent();
   Line = '<Name>' + Name + '</Name>';
   write_line(Line);
   Line = '<Pin1Addr>' + Pin1 + '</Pin1Addr>';
   write_line(Line);
   Line = '<Pin2Addr>' + Pin2 + '</Pin2Addr>';
   write_line(Line);
   Line = '<OriginalPin1Addr>' + OrigPin1 + '</OriginalPin1Addr>';
   write_line(Line);
   Line = '<OriginalPin2Addr>' + OrigPin2 + '</OriginalPin2Addr>';
   write_line(Line);

   PinName = get_pin_name(Pin1);
   Line = '<Pin1Name>' + PinName + '</Pin1Name>';
   write_line(Line);
   PinName = get_pin_name(Pin2);
   Line = '<Pin2Name>' + PinName + '</Pin2Name>';
   write_line(Line);
   PinName = get_pin_name(OrigPin1);
   Line = '<OriginalPin1Name>' + PinName + '</OriginalPin1Name>';
   write_line(Line);
   PinName = get_pin_name(OrigPin2);
   Line = '<OriginalPin2Name>' + PinName + '</OriginalPin2Name>';
   write_line(Line);
   dec_indent();
   write_line('</TwoPinBasics>');
end;

function write_group_pin_basics(Name: string; HighGroupName, LowGroupName: string; HighGroupCount,
   LowGroupCount: integer; HighGroupPins, LowGroupPins: tintegerarray): void;
begin
   write_line('<GroupPinBasics>');
   inc_indent();
   Line = '<Name>' + Name + '</Name>';
   write_line(Line);
   if ((HighGroupCount > 0) OR (StrCompare(HighGroupName, '') <> 0))
   begin
      write_line('<HighGroup>');
      inc_indent();
      Line = '<Name>' + HighGroupName + '</Name>';
      write_line(Line);
      if (HighGroupCount > 0)
      begin
         write_line('<Pins>');
         inc_indent();
         for Index = 1 to HighGroupCount do
         begin
            PinName = get_pin_name(HighGroupPins[Index]);
            Line = '<Pin><PinAddr>' + HighGroupPins[Index] + '</PinAddr><PinName>' + PinName + '</PinName></Pin>';
            write_line(Line);
         end;
         dec_indent();
         write_line('</Pins>');
      end;
      dec_indent();
      write_line('</HighGroup>');
   end;
   if ((LowGroupCount > 0) OR (StrCompare(LowGroupName, '') <> 0))
   begin
      write_line('<LowGroup>');
      inc_indent();
      Line = '<Name>' + LowGroupName + '</Name>';
      write_line(Line);
      if (LowGroupCount > 0)
      begin
         write_line('<Pins>');
         inc_indent();
         for Index = 1 to LowGroupCount do
         begin
            PinName = get_pin_name(LowGroupPins[Index]);
            Line = '<Pin><PinAddr>' + LowGroupPins[Index] + '</PinAddr><PinName>' + PinName + '</PinName></Pin>';
            write_line(Line);
         end;
         dec_indent();
         write_line('</Pins>');
      end;
      dec_indent();
      write_line('</LowGroup>');
   end;
   dec_indent();
   write_line('</GroupPinBasics>');
end;

