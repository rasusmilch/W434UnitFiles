function init_indent(): void;
begin
   GlobalDataWrite('Indent', '', 'XML');
end;

function inc_indent(): void;
begin
   Indent = GlobalDataRead('Indent', '', 'XML');
   Indent = Indent + '  ';
   GlobalDataWrite('Indent', Indent, 'XML');
end;

function dec_indent(): void;
begin
   Indent = GlobalDataRead('Indent', '', 'XML');
   Length = StrLength(Indent);
   if (Length > 0)
   begin
      Length = Length - 2;
      Indent = StrCopy(Indent, 1, Length);
   end;
   GlobalDataWrite('Indent', Indent, 'XML');
end;

function write_line(Line: string): void;
begin
   Indent = GlobalDataRead('Indent', '', 'XML');
   Line = Indent + Line;
   WriteLn(Line);
end;

function get_value_with_unit(Tag, MeasUnit: string; Value: real): string;
begin
   Result = '<' + Tag + ' Unit="' + MeasUnit + '">'+ Value +'</' + Tag + '>';
end;

function get_value_with_prefix(Tag, MeasUnit, Prefix: string; Value: real): string;
begin
   if (StrCompare(MeasUnit, '') <> 0)
   begin
      Result = '<' + Tag + ' Unit="' + MeasUnit + '"><Prefix>' + Prefix + '</Prefix><Value>' + Value + '</Value>' + '</' + Tag + '>';
   end
   else
   begin
      Result = '<' + Tag + '><Prefix>' + Prefix + '</Prefix><Value>' + Value + '</Value>' + '</' + Tag + '>';
   end;
end;

function get_pin_name(Address: integer): string;
begin
   switch (Address)
   begin
      case PINADDRESS_SystemGround: begin
         Result = 'SystemGround';
      end;
      case PINADDRESS_Invalid: begin
         Result = '!Invalid!';
      end;
      case PINADDRESS_NotSearched: begin
         Result = '?NotSearched?';
      end;
      case PINADDRESS_NotFound: begin
         Result = '?NotFound?';
      end;
      case PINADDRESS_None: begin
         Result = '!None!';
      end;
      case PINADDRESS_None: begin
         Result = '!None!';
      end;
      default: begin
         Result = PinGetData(Address, PIN_AnyName);
      end;
   end;
end;

function get_optical_pin_name(Address: integer): string;
begin
   Result = OpticalPinGetData(Address, OPTICALPIN_AnyName);
end;

function get_lv_pin_name(Address: integer): string;
begin
   Result = LV_PinGetData(Address, PIN_AnyName);
end;

function write_continuity_parameters(Current: tcurrent; Threshold: tresistance;
   Trise, Twait, Tmeas: ttime; AutoRange: boolean; VoltageLimit: tvoltage): string;
begin
   write_line('<MeasurementParameters Type="Continuity">');
   inc_indent();
   write_line(get_value_with_unit('Current', 'A', Current));
   write_line(get_value_with_unit('Threshold', 'Ohm', Threshold));
   write_line(get_value_with_unit('Trise', 's', Trise));
   write_line(get_value_with_unit('Twait', 's', Twait));
   write_line(get_value_with_unit('Tmeas', 's', Tmeas));
   Line = '<AutoRange>' + AutoRange + '</AutoRange>';
   write_line(Line);
   write_line(get_value_with_unit('VoltageLimit', 'V', Tmeas));
   dec_indent();
   write_line('</MeasurementParameters>');
end;

function write_isolationlv_parameters(Voltage: tvoltage; Threshold: tresistance; Trise,
   Twait, Tmeas: ttime; AutoRange: boolean; CurrentLimit: tcurrent; TmeasReduction: boolean): string;
begin
   write_line('<MeasurementParameters Type="IsolationLV">');
   inc_indent();
   write_line(get_value_with_unit('Voltage', 'V', Voltage));
   write_line(get_value_with_unit('Threshold', 'Ohm', Threshold));
   write_line(get_value_with_unit('Trise', 's', Trise));
   write_line(get_value_with_unit('Twait', 's', Twait));
   write_line(get_value_with_unit('Tmeas', 's', Tmeas));
   Line = '<AutoRange>' + AutoRange + '</AutoRange>';
   write_line(Line);
   write_line(get_value_with_unit('CurrentLimit', 'A', CurrentLimit));
   Line = '<TmeasReduction>' + TmeasReduction + '</TmeasReduction>';
   write_line(Line);
   dec_indent();
   write_line('</MeasurementParameters>');
end;

function write_isolationhv_parameters(Voltage: tvoltage; RThreshold: tresistance;
   UseIThreshold: boolean; IThreshold: tcurrent; Trise, Twait, Tmeas: ttime; AutoRange: boolean;
   CurrentLimit: tcurrent; TmeasReduction: boolean; TmeasFactor: real; VoltageRamp: tvoltageramp;
   DIdtEnabled: boolean; DIdtCurrentThreshold: tcurrent; DIdtTimeThreshold: ttime;
   ParamType: string = 'IsolationHV'): string;
begin
   Line = '<MeasurementParameters Type="' + ParamType + '">';
   write_line(Line);
   inc_indent();
   write_line(get_value_with_unit('Voltage', 'V', Voltage));
   write_line(get_value_with_unit('Threshold', 'Ohm', RThreshold));
   Line = '<UseIThreshold>' + UseIThreshold + '</UseIThreshold>';
   write_line(Line);
   write_line(get_value_with_unit('IThreshold', 'A', IThreshold));
   write_line(get_value_with_unit('Trise', 's', Trise));
   write_line(get_value_with_unit('Twait', 's', Twait));
   write_line(get_value_with_unit('Tmeas', 's', Tmeas));
   Line = '<AutoRange>' + AutoRange + '</AutoRange>';
   write_line(Line);
   write_line(get_value_with_unit('CurrentLimit', 'A', CurrentLimit));
   Line = '<TmeasReduction>' + TmeasReduction + '</TmeasReduction>';
   write_line(Line);
   Line = '<TmeasFactor>' + TmeasFactor + '</TmeasFactor>';
   write_line(Line);
   write_line(get_value_with_unit('VoltageRamp', 'Vps', VoltageRamp));
   Line = '<DIdtEnabled>' + DIdtEnabled + '</DIdtEnabled>';
   write_line(Line);
   write_line(get_value_with_unit('DIdtCurrentThreshold', 'A', DIdtCurrentThreshold));
   write_line(get_value_with_unit('DIdtTimeThreshold', 's', DIdtTimeThreshold));
   dec_indent();
   write_line('</MeasurementParameters>');
end;

function write_dielectricbreakdown_parameters(Voltage: tvoltage; Trise, Twait,
   Tmeas: ttime; TmeasFactor: real; VoltageRamp: tvoltageramp; ThresholdIr: tcurrent;
   ThresholdIi: tcurrent): string;
begin
   write_line('<MeasurementParameters Type="DielectricBreakdown">');
   inc_indent();

   write_line(get_value_with_unit('Voltage', 'V', Voltage));
   ThresholdsValid = ParamGetDielectricBreakdown(PARAM_DielectricBreakdownCurrentThresholdsValid);
   Line = '<ThresholdsValid>' + ThresholdsValid + '</ThresholdsValid>';
   write_line(Line);
   if (ThresholdsValid)
   begin
      write_line(get_value_with_unit('ThresholdIr', 'A', ThresholdIr));
      write_line(get_value_with_unit('ThresholdIi', 'A', ThresholdIi));
   end;
   write_line(get_value_with_unit('Trise', 's', Trise));
   write_line(get_value_with_unit('Twait', 's', Twait));
   write_line(get_value_with_unit('Tmeas', 's', Tmeas));
   Line = '<TmeasFactor>' + TmeasFactor + '</TmeasFactor>';
   write_line(Line);
   write_line(get_value_with_unit('VoltageRamp', 'Vps', VoltageRamp));
   dec_indent();
   write_line('</MeasurementParameters>');
end;

//write section information into the report
function write_sections(): void;
begin
   Count = ProjectGetSectionCount();
   if (Count > 0)
   begin
      write_line('<Sections>');
      inc_indent();
      for Index = 1 to Count do
      begin
         Name = ProjectGetSectionName(Index);
         Enabled = ProjectSectionEnabled(Name);
         Line = '<Section><Name>' + Name + '</Name><Enabled>' + Enabled + '</Enabled></Section>';
         write_line(Line);
      end;
      dec_indent();
      write_line('</Sections>');
   end;
end;

function write_rangetest(): void;
begin
   if (MiscRangeTestRunning())
   begin
      RangeTestType = MiscRangeTestGetType();
      Line = '<RangeTest><Type>';
      switch (RangeTestType)
      begin
         case RANGETEST_Connectors: begin
            Line = Line + 'Connectors';
         end;
         case RANGETEST_AdtIsolationLV: begin
            Line = Line + 'AdtIsolationLV';
         end;
         case RANGETEST_AdtIsolationLV: begin
            Line = Line + 'AdtIsolationHV';
         end;
         case RANGETEST_AdtDielectricBreakdown: begin
            Line = Line + 'AdtIsolationDB';
         end;
         default: begin
            Line = Line + 'Functions';
         end;
      end;
      Line = Line + '</Type></RangeTest>';
      write_line(Line);
   end;
end;

function write_ordernumber(): void;
begin
   OrderNumber = GlobalDataGetOrderNumber();
   if (StrCompare(OrderNumber, '') <> 0)
   begin
      Line = '<OrderNumber>' + OrderNumber + '</OrderNumber>';
      write_line(Line);
   end;
end;

function write_serialnumber(): void;
begin
   SerialNumber = GlobalDataGetSerialNumber();
   if (StrCompare(SerialNumber, '') <> 0)
   begin
      Line = '<SerialNumber>' + SerialNumber + '</SerialNumber>';
      write_line(Line);
   end;
end;

function write_teststart_inputdata(): void;
begin
   MiscCreateList(Data, 6);
   Found = FALSE;
   for Index = 1 to 6 do
   begin
      Text = GlobalDataRead(StrAdd('Text', Index), '', 'TestStart InputData');
      Value = GlobalDataRead(StrAdd('Value', Index), '', 'TestStart InputData');
      if ((StrCompare(Text, '') <> 0) AND (StrCompare(Value, '') <> 0))
      begin
         Found = TRUE;
      end;
      Data[Index] = '<Value Text="' + Text + '">' + Value + '</Value>';
   end;
   if (Found)
   begin
      write_line('<TestStartInputData>');
      inc_indent();
      for Index = 1 to 6 do
      begin
         write_line(Data[Index]);
      end;
      dec_indent();
      write_line('</TestStartInputData>');
   end;
end;

function write_user(): void;
begin
   if (UserManagementGetEnabled())
   begin
      write_line('<User>');
      inc_indent();
      UserName = UserManagementGetUsername();
      Line = '<Name>' + UserName + '</Name>';
      write_line(Line);
      FullUserName = UserManagementGetUsername();
      if (StrCompare(FullUserName, '') <> 0)
      begin
         Line = '<FullName>' + FullUserName + '</FullName>';
         write_line(Line);
      end;
      UserGroupName = UserManagementGetUsername();
      Line = '<Group>' + UserGroupName + '</Group>';
      write_line(Line);
      dec_indent();
      write_line('</User>');
   end;
end;

