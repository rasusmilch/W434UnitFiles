function write_value_and_tolerances(Value, LowerTol, UpperTol: real; MeasUnit: string = ''): void;
begin
   if (StrCompare(MeasUnit, '') <> 0)
   begin
      Line = '<ValueAndTolerances Unit="' + MeasUnit + '">';
   end
   else
   begin
      Line = '<ValueAndTolerances>';
   end;
   write_line(Line);
   inc_indent();
   Line = '<Value>' + Value + '</Value>';
   write_line(Line);
   Line = '<LowerTol>' + LowerTol + '</LowerTol>';
   write_line(Line);
   Line = '<UpperTol>' + UpperTol + '</UpperTol>';
   write_line(Line);
   dec_indent();
   write_line('</ValueAndTolerances>');
end;

function write_limits(LowerLimit, UpperLimit: real; MeasUnit: string = ''): void;
begin
   if (StrCompare(MeasUnit, '') <> 0)
   begin
      Line = '<Limits Unit="' + MeasUnit + '">';
   end
   else
   begin
      Line = '<Limits>';
   end;
   write_line(Line);
   inc_indent();
   Line = '<LowerLimit>' + LowerLimit + '</LowerLimit>';
   write_line(Line);
   Line = '<UpperLimit>' + UpperLimit + '</UpperLimit>';
   write_line(Line);
   dec_indent();
   write_line('</Limits>');
end;
