function write_isolationhvcombi_result(TestStepResult: integer): void;
begin
   Line = '<TestStepResult Type="IsolationHVCombi">';
   write_line(Line);
   inc_indent();
   switch (TestStepResult)
   begin
      case TESTSTEP_Passed:
      begin
         Text = 'Passed';
      end;
      case TESTSTEP_Failed:
      begin
         Text = 'Failed';
      end;
      default: begin
         Text = 'Invalid';
      end;
   end;
   Line = '<Result>' + Text + '</Result>';
   write_line(Line);
   dec_indent();
   write_line('</TestStepResult>');
end;

template ParamIsolationHVCombi
begin
   write_line('<TestStep Cmd="ParamIsolationHVCombi">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);

   dec_indent();
   write_line('</TestStep>');
end;

template NoConnectionHVCombi
begin
   write_line('<TestStep Cmd="NoConnectionHVCombi">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_two_pin_basics(RES_Name, RES_Pin1, RES_Pin2, RES_OriginalPin1, RES_OriginalPin2);
   write_isolationhv_parameters(RES_HVVoltage, RES_HVThreshold, RES_HVUseIThreshold, RES_HVIThreshold,
      RES_HVTrise, RES_HVTwait, RES_HVTmeas, RES_HVAutoRange, RES_HVCurrentLimit, RES_HVTmeasReduction,
      RES_HVTmeasFactor, RES_HVVoltageRamp, RES_HVdIdtEnabled, RES_HVdIdtCurrentThreshold,
      RES_HVdIdtTimeThreshold);
   write_dielectricbreakdown_parameters(RES_DBVoltage, RES_DBTrise, RES_DBTwait, RES_DBTmeas,
      RES_DBTmeasFactor, RES_DBVoltageRamp, RES_DBThresholdIr, RES_DBThresholdIi);

   write_isolationhvcombi_result(RES_Result);

   dec_indent();
   write_line('</TestStep>');
end;

