//Output for the command NoConnGroupHVTwoLevels
template NoConnGroupHVTwoLevels
begin
   Name = get_teststep_name(RES_Name, LocalText('225#NCG HV2L'));
   Name = format_teststep_name(Name);
   HighGroup = format_teststep_pin(RES_HighGroup);
   LowGroup = format_teststep_pin(RES_LowGroup);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Value = LocalText('220#Lvl1') + ': ';
      Value = StrAdd(Value, get_resistance_value(RES_Level1Prefix, RES_Level1Value));
      Value = StrAdd(Value, get_double_dash_text(LocalText('221#Lvl2')));
      Value = StrAdd(Value, get_resistance_value(RES_Level2Prefix, RES_Level2Value));
      Line1 = StrAdd(format_teststep_result(LocalText('5#Passed')), Name);
      Line1 = StrAdd(Line1, HighGroup);
      Line1 = StrAdd(Line1, LowGroup);
      Line2 = StrAdd(format_teststep_result(' '), Value);
      UIWriteNormal(Line1);
      Space = format_teststep_result(' ');
      Line2 = StrAdd(Space, Value);
      UIWriteNormal(Line2);
   end
   else
   begin
      if (RES_ErrorCount > 0)
      begin
         Index = RES_ErrorCount;
         ResultText = get_hv_isolation_error_text(RES_Arcs[Index], RES_dIdts[Index], RES_ELims[Index]);
         IsShort = (NOT RES_Arcs[Index]) AND (NOT RES_dIdts[Index]) AND (NOT RES_ELims[Index]);
         Value = ' ';
         if (IsShort)
         begin
            Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
         end;
         if ((RES_ErrorHighPins[Index] == PINADDRESS_NotSearched) OR
             (RES_ErrorHighPins[Index] == PINADDRESS_NotFound))
         begin
            Pin1 = RES_HighGroup;
         end
         else
         begin
            Pin1 = get_pinname(RES_ErrorHighPins[Index]);
         end;
         if ((RES_ErrorLowPins[Index] == PINADDRESS_NotSearched) OR
             (RES_ErrorLowPins[Index] == PINADDRESS_NotFound))
         begin
            Pin2 = RES_LowGroup;
         end
         else
         begin
            Pin2 = get_pinname(RES_ErrorLowPins[Index]);
         end;
         Pin1 = format_teststep_pin(Pin1);
         Pin2 = format_teststep_pin(Pin2);
         FailText = '';
         if (RES_Level1Errors[Index])
         begin
            FailText = 'Lvl1';
         end
         else
         begin
            FailText = 'Lvl2';
         end;
         Line1 = StrAdd(format_teststep_result(ResultText), Name);
         Line1 = StrAdd(Line1, Pin1);
         Line1 = StrAdd(Line1, Pin2);
         Line1 = StrAdd(Line1, FailText);
         UIWriteError(Line1);
         if (StrCompare(StrTrim(Value), '') <> 0)
         begin
            Line2 = StrAdd(format_teststep_result(' '), Value);
            UIWriteError(Line2);
         end;
         short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
      end;
   end;
end;

