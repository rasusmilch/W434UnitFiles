      WriteLn(Line);
   end;
end;

//Output if possible short to lower voltage level
function short_to_lower_voltage_level(IsShort: boolean): void;
begin
   if (IsShort)
   begin
      WriteLn('');
      Line = FormatAlignLeft(' ', 25, ' ');
      Line = StrAdd(Line, LocalText('85#Possible short to lower voltagelevel'));
      Write(Line);
   end;
end;

//Returns a value text for HV isolation test steps
function get_hv_isolation_value_text(IsArc, IsdIdt, IsEnergyLimit: boolean;
   Prefix: string; Value: real): string;
begin
   if (IsArc)
   begin
      Result = LocalText('202#Arc');
   end
   else
   begin
      if (IsdIdt)
      begin
         Result = LocalText('203#dIdt');
      end
      else
      begin
         if (IsEnergyLimit)
         begin
            Result = LocalText('164#Energy > 350 mJ');
         end
         else
         begin
            Result = get_resistance_value(Prefix, Value);
         end;
      end;
   end;
end;

function get_default_line(ResultText, Name, PinName1, PinName2, Value: string): string;
begin
   ResultText = format_teststep_result(ResultText);
   Name = format_teststep_name(Name);
   PinName1 = format_teststep_pin(PinName1);
   PinName2 = format_teststep_pin(PinName2);
   Result = ResultText + Name + PinName1 + PinName2 + Value;
end;