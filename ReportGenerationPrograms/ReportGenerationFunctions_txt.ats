function display_teststepcomment(Comment: string; 
   DeclaredAsPassed: boolean = FALSE; DeclaredAsPassedBy: string = ''): void;
begin
   if (DeclaredAsPassed)
   begin
      Text = LocalText('146#Declared as "passed" by');
      Text = StrAdd(Text, ': ');
      Text = StrAdd(Text, DeclaredAsPassedBy);
      if (StrCompare(Comment, '') <> 0)
      begin
         Text = StrAdd(Text, '<br>');
         Comment = StrAdd(Text, Comment);
      end
      else
      begin
         Comment = Text;
      end;
   end;
   if (StrCompare(Comment, '') <> 0)
   begin
      WriteLn('');
      Pos = StrPosition('<br>', StrLowerCase(Comment));
      while (Pos > 0)
      begin
         Pos = Pos - 1;
         Line = StrCopy(Comment, 1, Pos);
         WriteLn(Line);
         Chars = Pos + 4;
         Comment = StrDelete(Comment, 1, Chars);
         Pos = StrPosition('<br>', StrLowerCase(Comment));
      end;
      Write(Comment);
   end;
end;

//Funtion for ReportWriteNormal and ReportWriteError
function report_write_teststep(Data: string): boolean;
begin
   Result = FALSE;
   // Search for hidden tag
   Tag = '<TESTSTEP>';
   if (StrPosition(Tag, Data) == 1)
   begin
      Result = TRUE;
      // Hidden tag found. Expected entry structure is as follows.
      // ReportWriteNormal('<TESTSTEP>Passed;StepName;Pin1;Pin2;Value');
      // Remaining text after tag will be separated by each semicolon and
      // written into report like a test step.
      Data = StrDelete(Data, 1, StrLength(Tag));
      Columns = 5;
      MiscCreateList(ColumnList, Columns);
      PrelastColumn = Columns - 1;
      for Column = 1 to PrelastColumn do
      begin
         SemicolonPos = StrPosition(';', Data);
         Length = SemicolonPos - 1;
         ColumnList[Column] = StrCopy(Data, 1, Length);
         Data = StrDelete(Data, 1, SemicolonPos);
      end;
      ColumnList[Columns] = Data;

      State = FormatAlignLeft(ColumnList[1], TESTSTEP_RESULT_WIDTH, ' ');
      Name = FormatAlignLeft(ColumnList[2], TESTSTEP_NAME_WIDTH, ' ');
      Pin1 = FormatAlignLeft(ColumnList[3], TESTSTEP_PIN_WIDTH, ' ');
      Pin2 = FormatAlignLeft(ColumnList[4], TESTSTEP_PIN_WIDTH, ' ');
      Value = ColumnList[5];
      Line = StrAdd(StrAdd(StrAdd(StrAdd(State, Name), Pin1), Pin2), Value);
      Write(Line);
   end;
end;

//Writes the results of the command groups in the report
function write_command_group_results(): void;
begin
   Text = get_command_group_result_string(CMDGRP_Continuity, 
      FAILCOUNTER_Continuity);
   if (StrCompare('', Text) <> 0)
   begin
      Line = FormatAlignLeft(LocalText('27#Continuity test'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, Text);
      WriteLn(Line);
   end;
