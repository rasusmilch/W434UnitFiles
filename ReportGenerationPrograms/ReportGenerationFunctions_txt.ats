//Returns the name of a pin
function get_pinname(Address: integer): string;
begin
   switch (Address)
   begin
      case PINADDRESS_SystemGround: begin
         Result = LocalText('276#SystemGround');
      end;
      case PINADDRESS_Invalid: begin
         Result = LocalText('272#!Invalid!');
      end;
      case PINADDRESS_NotSearched: begin
         Result = LocalText('273#?NotSearched?');
      end;
      case PINADDRESS_NotFound: begin
         Result = LocalText('274#?NotFound?');
      end;
      case PINADDRESS_None: begin
         Result = LocalText('275#!None!');
      end;
      case PINADDRESS_None: begin
         Result = LocalText('275#!None!');
      end;
      default: begin
         Result = PinGetData(Address, PIN_AnyName);
      end;
   end;
end;

//Returns a resistance value with prefix
function get_resistance_value(Prefix: string; Value: real): string;
begin
   if (StrCompare(Prefix, '%') == 0)
   begin
      Result = ' ';
   end
   else
   begin
      Result = FormatResistance(Value);
      Result = StrAdd(Prefix, Result);
   end;
end;

