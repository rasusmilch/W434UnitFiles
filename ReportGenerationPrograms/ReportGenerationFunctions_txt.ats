   end;
end;

//writes the measurement parameters
function write_parameters(): void;
begin
   WriteLn('');
   write_continuity_parameters();
   write_isolationlv_parameters();
   write_isolationhv_parameters();
   write_dielectricbreakdown_parameters();
end;

function writereport_comppath_design1(PinCount: integer; Pins: tarray): void;
begin
   for Count = 1 to PinCount do
   begin
      Pin = Pins[Count];
      Pin = get_pinname(Pin);
      if ((Count <> 1) AND (Count <> PinCount))
      begin
         Pin = StrAdd('   ', Pin);
      end;
      Pin = FormatAlignLeft(Pin, 20, ' ');
      Zone = PinGetData(Pins[Count], PIN_InstallationZone);
      Zone = FormatAlignLeft(Zone, 10, ' ');
      Line = StrAdd(Pin, Zone);
      if (Count == PinCount)
      begin
         Write(Line);
      end
      else
      begin
         WriteLn(Line);
      end;
   end;
end;

function writescreen_comppath_design1(PinCount: integer; Pins: tarray;
            TeststepResult: integer): void;
begin
   for Count = 1 to PinCount do
   begin
      Pin = Pins[Count];
      Pin = get_pinname(Pin);
      if ((Count <> 1) AND (Count <> PinCount))
      begin
         Pin = StrAdd('   ', Pin);
      end;
      Pin = FormatAlignLeft(Pin, 20, ' ');
      Zone = PinGetData(Pins[Count], PIN_InstallationZone);
      Zone = FormatAlignLeft(Zone, 10, ' ');
      Line = StrAdd(Pin, Zone);
      if (TeststepResult == TESTSTEP_Passed)
      begin
         UIWriteNormal(Line);
      end
      else
      begin
         UIWriteError(Line);
      end;
   end;
end;

function display_rangetest(Length: integer): void;
begin
   if (MiscRangeTestRunning())
   begin
      RangeTestType = MiscRangeTestGetType();
      WriteFunctions = FALSE;
      WriteConnectors = FALSE;
      WriteCables = FALSE;
      if (RangeTestType == RANGETEST_Functions)
      begin
         WriteFunctions = TRUE;
      end;
      if (RangeTestType == RANGETEST_Connectors)
      begin
         UsedConnectorCount =
            MiscRangeTestConnectors(RangeTestUsedConnectors, TRUE);
         UnusedConnectorCount =
            MiscRangeTestConnectors(RangeTestUnusedConnectors, FALSE);
         WriteConnectors = TRUE;
      end;
      if ((RangeTestType == RANGETEST_AdtIsolationLV) OR
          (RangeTestType == RANGETEST_AdtIsolationHV) OR
          (RangeTestType == RANGETEST_AdtDielectricBreakdown))
      begin
         WriteCables = TRUE;
      end;
      Line = FormatAlignLeft(LocalText('74#Rangetest'), Length, ' ');
      Line = StrAdd(Line, ': ');
      //normal rangetest
      if (WriteFunctions)
      begin
         FunctionCount = MiscRangeTestFunctionCount();
         if (FunctionCount > 0)
         begin
            Line = StrAdd(Line, MiscRangeTestFunction(1));
            WriteLn(Line);
            for Index = 2 to FunctionCount do
            begin
               Line = FormatAlignLeft(' ', Length, ' ');
               Line = StrAdd(Line, '  ');
               Line = StrAdd(Line, MiscRangeTestFunction(Index));
               WriteLn(Line);
            end;
         end;
      end;
      //Rangetest with connectors
      if (WriteConnectors)
      begin
         if (UsedConnectorCount <= UnusedConnectorCount)
         begin
            Line = StrAdd(Line, RangeTestUsedConnectors[1]);
            WriteLn(Line);
            for Index = 2 to UsedConnectorCount do
            begin
               Line = FormatAlignLeft(' ', Length, ' ');
               Line = StrAdd(Line, '  ');
               Line = StrAdd(Line, RangeTestUsedConnectors[Index]);
               WriteLn(Line);
            end;
         end
         else
         begin
            Line = StrAdd(Line, LocalText('132#Disabled connectors'));
            WriteLn(Line);
            for Index = 1 to UnusedConnectorCount do
            begin
               Line = FormatAlignLeft(' ', Length, ' ');
               Line = StrAdd(Line, '  ');
               Line = StrAdd(Line, RangeTestUnusedConnectors[Index]);
               WriteLn(Line);
            end;
         end;
      end;
      //Rangetest Isolation with adaptercables
      if (WriteCables)
      begin
         CableCount = AdapterCablesGetList(AdapterCables,
                         ADAPTERCABLES_RangeTestIsolation);
         if (CableCount > 0)
         begin
            Line = StrAdd(Line, LocalText('83#From cable'));
            Line = StrAdd(Line, ' "');
            Line = StrAdd(Line, AdapterCables[1]);
            Line = StrAdd(Line, '" ');
            Line = StrAdd(Line, LocalText('84#to cable'));
            Line = StrAdd(Line, ' "');
            Line = StrAdd(Line, AdapterCables[CableCount]);
            Line = StrAdd(Line, '"');
            WriteLn(Line);
         end;
      end;
   end;
end;

