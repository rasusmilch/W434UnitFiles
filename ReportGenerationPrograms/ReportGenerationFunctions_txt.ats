   begin
      Text = GlobalDataRead(StrAdd('Text', Index), '', 'TestStart InputData');
      Value = GlobalDataRead(StrAdd('Value', Index), '', 'TestStart InputData');
      if ((StrCompare(Text, '') <> 0) AND (StrCompare(Value, '') <> 0))
      begin
         Line = FormatAlignLeft(Text, Length, ' ');
