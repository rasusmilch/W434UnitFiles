//Returns the value for a dielectric breakdown measurement
function get_dielectric_breakdown_value(Arc: boolean;
            ValueValid: boolean; ValueIr: real; PrefixIr: string;
            ValueIi: real; PrefixIi: string): string;
begin
   if (Arc)
   begin
      Result = ' ';
   end
   else
   begin
      if (ValueValid)
      begin
         ValueIr = get_current_value(PrefixIr, ValueIr);
         ValueIi = get_current_value(PrefixIi, ValueIi);
         if (StrCompare(ValueIr, ' ') == 0)
         begin
            if (StrCompare(ValueIr, ' ') <> 0)
            begin
               Result = StrAdd('Ii=', ValueIi);
            end
            else
            begin
               Result = ' ';
            end;
         end
         else
         begin
            if (StrCompare(ValueIi, ' ') == 0)
            begin
               Result = StrAdd('Ir=', ValueIr);
            end
            else
            begin
               Result = StrAdd('Ir=', ValueIr);
               Result = StrAdd(Result, '; Ii=');
               Result = StrAdd(Result, ValueIi);
            end;
         end;
      end
      else
      begin
         Result = ' ';
      end;
   end;
end;

//returns a line of dashes with the same length of the passed string
function get_underline(Line: string): string;
begin
   Length = StrLength(Line);
   Result = '';
   for Zaehl = 1 to Length do
   begin
      Result = StrAdd(Result, '-');
   end;
end;

constants
begin
   TESTSTEP_RESULT_WIDTH = 10;
   TESTSTEP_NAME_WIDTH = 15;
   TESTSTEP_PIN_WIDTH = 20;
end;

//Formats the result of a teststep
function format_teststep_result(Text: string): string;
begin
   if (StrCompare(Text, '') == 0)
   begin
      Text = ' ';
   end;
   Text = StrCopy(Text, 1, TESTSTEP_RESULT_WIDTH);
   Result = FormatAlignLeft(Text, TESTSTEP_RESULT_WIDTH, ' ');
end;

//Formats the name of a teststep
function format_teststep_name(Text: string): string;
begin
   if (StrCompare(Text, '') == 0)
   begin
      Text = ' ';
   end;
   Text = StrCopy(Text, 1, TESTSTEP_NAME_WIDTH);
   Result = FormatAlignLeft(Text, TESTSTEP_NAME_WIDTH, ' ');
end;

//Formats a pin of a teststep
function format_teststep_pin(Text: string): string;
begin
   if (StrCompare(Text, '') == 0)
   begin
      Text = ' ';
   end;
   Result = FormatAlignLeft(Text, TESTSTEP_PIN_WIDTH, ' ');
end;

//Output if external voltage was detected
function external_voltage_error(Name: string; Pin1: integer;
            Pin2: integer; Value: real; ValuePrefix: string): void;
begin
   ResultText = format_teststep_result(LocalText('50#Ext. Volt.'));
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_pinname(Pin1));
   Pin2 = format_teststep_pin(get_pinname(Pin2));
   Value = get_voltage_value(ValuePrefix, Value);

   Line = StrAdd(ResultText, Name);
   Line = StrAdd(Line, Pin1);
   Line = StrAdd(Line, Pin2);
   Line = StrAdd(Line, Value);
   Write(Line);
end;

//write section information into the report
function display_sections(): void;
begin
   Count = ProjectGetSectionCount();
   if (Count > 0)
   begin
      WriteLn(LocalText('70#Sections'));
      Length = 40 + StrLength(LocalText('72#disabled'));
      DashLine = FormatAlignLeft('-', Length, '-');
      WriteLn(DashLine);
      for Index = 1 to Count do
      begin
         Name = ProjectGetSectionName(Index);
         Enabled = ProjectSectionEnabled(Name);
         if (Enabled == TRUE)
         begin
            State = LocalText('71#enabled');
         end
         else
         begin
            State = LocalText('72#disabled');
         end;
         Line = FormatAlignLeft(Name, 40, ' ');
         Line = StrAdd(Line, State);
         WriteLn(Line);
      end;
      WriteLn(DashLine);
      WriteLn('');
   end;
end;

//Writes a warning into the report if not all required adapter cables were connected
function check_adaptercables(): boolean;
begin
   Result = TRUE;
   AllCableCount = AdapterCablesGetList(AllCables, ADAPTERCABLES_All);
   ConnectedCableCount = 0;
   NotConnectedCableCount = 0;
   if (AllCableCount > 0)
   begin
      ConnectedCableCount = AdapterCablesGetList(ConnectedCables,
                               ADAPTERCABLES_Connected);
      MissingCableCount = AdapterCablesGetList(NotConnectedCables,
                             ADAPTERCABLES_Missing);
   end;
   if (ConnectedCableCount <> AllCableCount)
   begin
      Result = FALSE;
      WriteLn('');

      TextAll = LocalText('76#Required adapter cables');
      Length1 = StrLength(TextAll);
      TextConnected = LocalText('77#Connected adapter cables');
      Length2 = StrLength(TextConnected);
      TextMissing = LocalText('78#Missing adapter cables');
      Length3 = StrLength(TextMissing);

      Length = ArithMax(Length1, Length2);
      Length = ArithMax(Length, Length3);

      TextAll = FormatAlignLeft(TextAll, Length, ' ');
      TextAll = StrAdd(TextAll, ': ');
      TextAll = StrAdd(TextAll, AllCableCount);
      Length1 = StrLength(TextAll);

      TextConnected = FormatAlignLeft(TextConnected, Length, ' ');
      TextConnected = StrAdd(TextConnected, ': ');
      TextConnected = StrAdd(TextConnected, ConnectedCableCount);
      Length2 = StrLength(TextConnected);

      TextMissing = FormatAlignLeft(TextMissing, Length, ' ');
      TextMissing = StrAdd(TextMissing, ': ');
      TextMissing = StrAdd(TextMissing, MissingCableCount);
      Length3 = StrLength(TextMissing);

      Length = ArithMax(Length1, Length2);
      Length = ArithMax(Length, Length3);

      Caption = FormatAlignCenter(LocalText('75#Test incomplete'), Length);
      Line = FormatAlignLeft('-', Length, '-');
      WriteLn(Caption);
      WriteLn(Line);
      WriteLn(TextAll);
      WriteLn(TextConnected);
      WriteLn(TextMissing);
   end;
end;

function show_lastisolationtestcable(): void;
begin
   CableCount = AdapterCablesGetList(Cables, ADAPTERCABLES_All);
   if (CableCount > 0)
   begin
      Pin = PinGetLastIsolationtestPin();
      if (Pin <> PINADDRESS_Invalid)
      begin
         Cable = PinGetData(Pin, PIN_AdapterCableName);
         Line = StrAdd(LocalText('86#Last cable tested in isolation test:'), ' ');
         Line = StrAdd(Line, Cable);
         WriteLn(Line);
      end;
   end;
end;

//Writes measurement parameters for continuity test
function write_continuity_parameters(): void;
begin
   CommandsExecuted = (MiscGetNumberOfExecutedCommands(CMDGRP_Continuity) > 0);
   if (ParamIsCommandGroupActive(CMDGRP_Continuity) AND
       CommandsExecuted)
   begin
      Line = get_continuity_parameters();
      WriteLn(LocalText('60#Parameters for continuity test'));
      WriteLn(Line);
      WriteLn('');
   end;
end;

//Writes measurement parameters for LV isolation test
function write_isolationlv_parameters(): void;
begin
