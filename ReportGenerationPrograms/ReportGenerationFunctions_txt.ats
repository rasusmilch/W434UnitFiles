   begin
      Line = FormatAlignLeft(LocalText('112#Test of optical components'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, Text);
      WriteLn(Line);
   end;
   Text = get_command_group_result_string(CMDGRP_CANBus, FAILCOUNTER_CANBus);
   if (StrCompare('', Text) <> 0)
   begin
      Line = FormatAlignLeft(LocalText('115#CAN bus'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, Text);
      WriteLn(Line);
   end;
   Text = get_command_group_result_string(CMDGRP_IDD, FAILCOUNTER_IDD);
   if (StrCompare('', Text) <> 0)
   begin
      Line = FormatAlignLeft(LocalText('180#IDD'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, Text);
      WriteLn(Line);
   end;
   Text = get_command_group_result_string(CMDGRP_Detections, FAILCOUNTER_Detections);
   if (StrCompare('', Text) <> 0)
   begin
      Line = FormatAlignLeft(LocalText('181#Detections'), 35, ' ');
      Line = StrAdd(Line, ': ');
      Line = StrAdd(Line, Text);
      WriteLn(Line);
   end;
   Text = get_command_group_result_string(CMDGRP_Others, FAILCOUNTER_Others);
   if (StrCompare('', Text) <> 0)
