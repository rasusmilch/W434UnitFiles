//Writes measurement parameters for dielectric breakdown test
function write_dielectricbreakdown_parameters(): void;
begin
   CommandsExecuted = (MiscGetNumberOfExecutedCommands(CMDGRP_DielectricBreakdown) > 0);
   if (ParamIsCommandGroupActive(CMDGRP_DielectricBreakdown) AND
       ParamGetDielectricBreakdown(PARAM_DielectricBreakdownValid) AND
       CommandsExecuted)
   begin
