end;

//Writes measurement parameters for HV isolation test
function write_isolationhv_parameters(): void;
begin
   CommandsExecuted = (MiscGetNumberOfExecutedCommands(CMDGRP_IsolationHV) > 0);
   if (ParamIsCommandGroupActive(CMDGRP_IsolationHV) AND
       ParamGetIsolationHV(PARAM_IsolationHVValid) AND
       CommandsExecuted)
   begin
      Line = get_isolationhv_parameters();
      WriteLn(LocalText('67#Parameters for HV isolation test'));
