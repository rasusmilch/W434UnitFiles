function handle_3xhv_1_3_error(File, Name, Pin1, Pin2, HV1Prefix, HV1Value, HV2Prefix,
   HV2Value, HV3Prefix, HV3Value: string): void;
begin
   Value = LocalText('211#HV1') + ': ';
   Value = StrAdd(Value, get_resistance_value(HV1Prefix, HV1Value));
   Value = StrAdd(Value, get_double_dash_text(LocalText('212#HV2')));
   Value = StrAdd(Value, get_resistance_value(HV2Prefix, HV2Value));
   Value = StrAdd(Value, get_double_dash_text(LocalText('213#HV3')));
   Value = StrAdd(Value, get_resistance_value(HV3Prefix, HV3Value));
   FailText = get_3xhv_fail_text(ISOLATION_3xHV_1_3_Error);
   hv_multi_step_line_output(File, LocalText('16#Error'), Name, Pin1,
      get_pinname(PINADDRESS_NotSearched), FailText, Value);
end;

//Output for the command ParamIsolation3xHV2ndMeasurement
template ParamIsolation3xHV2ndMeasurement
begin
   Line = get_isolationhv_parameters_text(RES_VoltageChanged, RES_3xHV2ndM_Voltage,
      RES_ThresholdChanged, RES_3xHV2ndM_Threshold, RES_3xHV2ndM_UseIThreshold,
      RES_3xHV2ndM_IThreshold, RES_TriseChanged, RES_3xHV2ndM_Trise,
      RES_TwaitChanged, RES_3xHV2ndM_Twait, RES_TmeasChanged, RES_3xHV2ndM_Tmeas,
      RES_AutoRangeChanged, RES_3xHV2ndM_AutoRange,
      RES_CurrentLimitChanged, RES_3xHV2ndM_CurrentLimit,
      RES_TmeasReductionChanged, RES_3xHV2ndM_TmeasReduction,
      RES_TmeasFactorChanged, RES_3xHV2ndM_TmeasFactor,
      RES_VoltageRampChanged, RES_3xHV2ndM_VoltageRamp,
      RES_dIdtEnabledChanged, RES_3xHV2ndM_dIdtEnabled,
      RES_dIdtCurrentThresholdChanged, RES_3xHV2ndM_dIdtCurrentThreshold,
      RES_dIdtTimeThresholdChanged, RES_3xHV2ndM_dIdtTimeThreshold);
   if (StrCompare(Line, '') <> 0)
   begin
      WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD class=bold>');
      Write(LocalText('199#Parameters for the second measurement of the triple HV isolation test'));
      WriteLn('</TD></TR>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(Line);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;
end;

//Output for the command ParamIsolation3xHV
template ParamIsolation3xHV
begin
   Line = '';
   if (RES_3xHV_Lower_1_3_Tol_Changed)
   begin
      Value = RES_3xHV_Lower_1_3_Tol;
      Line = StrAdd(Line, LocalText('138#Lower tol.'));
      Line = Line + '=' + Value + '%; ';
   end;
   if (RES_3xHV_Upper_1_3_Tol_Changed)
   begin
      Value = RES_3xHV_Upper_1_3_Tol;
      Line = StrAdd(Line, LocalText('139#Upper tol.'));
      Line = Line + '=' + Value + '%; ';
   end;
   if (RES_3xHV_Delay1_Changed)
   begin
      Value = FormatTime(RES_3xHV_Delay1);
      Line = StrAdd(Line, LocalText('140#Delay 1'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_3xHV_Delay2_Changed)
   begin
      Value = FormatTime(RES_3xHV_Delay2);
      Line = StrAdd(Line, LocalText('141#Delay 2'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_3xHV_ExecuteHV3_Changed)
   begin
      if (RES_3xHV_ExecuteHV3)
      begin
         Value = LocalText('143#Yes');
      end
      else
      begin
         Value = LocalText('144#No');
      end;
      Line = StrAdd(Line, LocalText('200#Execute HV 3'));
      Line = Line + '=' + Value + '; ';
   end;
   if (StrCompare(Line, '') <> 0)
   begin
      Pos = StrLength(Line) - 1;
      Line = StrDelete(Line, Pos, 2);
      WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD class=bold>');
      Write(LocalText('201#Parameters the triple HV isolation test'));
      WriteLn('</TD></TR>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(Line);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;
end;

//Output for the command NoConnection3xHV
template NoConnection3xHV
begin
   Name = get_teststep_name(RES_Name, LocalText('215#NC 3xHV'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
            Style = 'teststeppass';
         end;
         case TESTSTEP_Failed:
         begin
            IsArc = RES_HV1Arc OR RES_HV2Arc OR RES_HV3Arc;
            IsdIdt = RES_HV1dIdt OR RES_HV2dIdt OR RES_HV3dIdt;
            IsEnergyLimit = RES_HV1ELim OR RES_HV2ELim OR RES_HV3ELim;
            ResultText = get_hv_isolation_error_text(IsArc, IsdIdt, IsEnergyLimit);
            Style = 'teststepfail';
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
            Style = 'teststepfail';
         end;
      end;
      HV2Value = TRUE;
      HV3Value = RES_HV3Done;
      FailText = get_3xhv_fail_text(RES_ErrorInfo);
      switch (RES_ErrorInfo)
      begin
         case ISOLATION_3xHV_1_Error: begin
            HV2Value = FALSE;
            HV3Value = FALSE;
         end;
         case ISOLATION_3xHV_2_Error: begin
            HV3Value = FALSE;
         end;
      end;
      Value = LocalText('211#HV1') + ': ';
      ValueText = get_hv_isolation_value_text(RES_HV1Arc, RES_HV1dIdt, RES_HV1ELim,
         RES_HV1Prefix, RES_HV1Value);
      Value = StrAdd(Value, ValueText);
      if (HV2Value)
      begin
         Value = StrAdd(Value, get_double_dash_text(LocalText('212#HV2')));
         ValueText = get_hv_isolation_value_text(RES_HV2Arc, RES_HV2dIdt, RES_HV2ELim,
            RES_HV2Prefix, RES_HV2Value);
         Value = StrAdd(Value, ValueText);
      end;
      if (HV3Value)
      begin
         Value = StrAdd(Value, get_double_dash_text(LocalText('213#HV3')));
         ValueText = get_hv_isolation_value_text(RES_HV3Arc, RES_HV3dIdt, RES_HV3ELim,
            RES_HV3Prefix, RES_HV3Value);
         Value = StrAdd(Value, ValueText);
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      hv_multi_step_line_output(File, ResultText, Name, Pin1, Pin2, FailText, Value);
      display_short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
      display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

//Output for the command NoConnAll3xHV
template NoConnAll3xHV
begin
   Name = get_teststep_name(RES_Name, LocalText('216#NCA 3xHV'));
   Pin1 = get_pinname(RES_Pin);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Value = LocalText('211#HV1') + ': ';
      Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
      Value = StrAdd(Value, get_double_dash_text(LocalText('212#HV2')));
      Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix, RES_HV2Value));
      if (RES_HV3Done)
      begin
         Value = StrAdd(Value, get_double_dash_text(LocalText('213#HV3')));
         Value = StrAdd(Value, get_resistance_value(RES_HV3Prefix, RES_HV3Value));
      end;
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      hv_multi_step_line_output(File, LocalText('5#Passed'), Name, Pin1, '&nbsp;', '&nbsp;', Value);
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      if (RES_ErrorInfo == ISOLATION_3xHV_1_3_Error)
      begin
         handle_3xhv_1_3_error(File, Name, Pin1, get_pinname(PINADDRESS_NotSearched),
            RES_HV1Prefix, RES_HV1Value, RES_HV2Prefix, RES_HV2Value, RES_HV3Prefix, RES_HV3Value);
      end
      else
      begin
         for Index = 1 to RES_ErrorPinCount do
         begin
            IsArc = RES_HVArcs[Index];
            IsdIdt = RES_HVdIdts[Index];
            IsEnergyLimit = RES_HVELims[Index];
            IsShort = (NOT IsArc) AND (NOT IsdIdt) AND (NOT IsEnergyLimit);
            ResultText = get_hv_isolation_error_text(IsArc, IsdIdt, IsEnergyLimit);
            Value = '&nbsp;';
            if (IsShort)
            begin
               Value = get_resistance_value(RES_HVPrefixes[Index], RES_HVValues[Index]);
            end;
            Pin2 = get_pinname(RES_ErrorPins[Index]);
            FailText = get_3xhv_fail_text(RES_ErrorInfo);
            hv_multi_step_line_output(File, ResultText, Name, Pin1, Pin2,
               FailText, Value);
         end;
      end;
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

