function write_isolation3xhv_result(TestStepResult: integer): void;
begin
   Line = '<TestStepResult Type="Isolation3xHV">';
   write_line(Line);
   inc_indent();
   switch (TestStepResult)
   begin
      case TESTSTEP_Passed:
      begin
         Text = 'Passed';
      end;
      case TESTSTEP_Failed:
      begin
         Text = 'Failed';
      end;
      default: begin
         Text = 'Invalid';
      end;
   end;
   Line = '<Result>' + Text + '</Result>';
   write_line(Line);
   dec_indent();
   write_line('</TestStepResult>');
end;

template ParamIsolation3xHV2ndMeasurement
begin
   write_line('<TestStep Cmd="ParamIsolation3xHV2ndMeasurement">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_isolationhv_parameters(RES_3xHV2ndM_Voltage, RES_3xHV2ndM_Threshold,
      RES_3xHV2ndM_UseIThreshold, RES_3xHV2ndM_IThreshold, RES_3xHV2ndM_Trise, RES_3xHV2ndM_Twait,
      RES_3xHV2ndM_Tmeas, RES_3xHV2ndM_AutoRange, RES_3xHV2ndM_CurrentLimit, RES_3xHV2ndM_TmeasReduction,
      RES_3xHV2ndM_TmeasFactor, RES_3xHV2ndM_VoltageRamp, RES_3xHV2ndM_dIdtEnabled,
      RES_3xHV2ndM_dIdtCurrentThreshold, RES_3xHV2ndM_dIdtTimeThreshold, 'Isolation3xHV2ndMeasurement');
   dec_indent();
   write_line('</TestStep>');
end;

template ParamIsolation3xHV
begin
   write_line('<TestStep Cmd="ParamIsolation3xHV">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);

   dec_indent();
   write_line('</TestStep>');
end;

template NoConnection3xHV
begin
   write_line('<TestStep Cmd="NoConnection3xHV">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_two_pin_basics(RES_Name, RES_Pin1, RES_Pin2, RES_OriginalPin1, RES_OriginalPin2);
   write_isolationhv_parameters(RES_HVVoltage, RES_HVThreshold, RES_HVUseIThreshold, RES_HVIThreshold,
      RES_HVTrise, RES_HVTwait, RES_HVTmeas, RES_HVAutoRange, RES_HVCurrentLimit, RES_HVTmeasReduction,
      RES_HVTmeasFactor, RES_HVVoltageRamp, RES_HVdIdtEnabled, RES_HVdIdtCurrentThreshold,
      RES_HVdIdtTimeThreshold);
   write_isolationhv_parameters(RES_3xHV2ndM_Voltage, RES_3xHV2ndM_Threshold,
      RES_3xHV2ndM_UseIThreshold, RES_3xHV2ndM_IThreshold, RES_3xHV2ndM_Trise, RES_3xHV2ndM_Twait,
      RES_3xHV2ndM_Tmeas, RES_3xHV2ndM_AutoRange, RES_3xHV2ndM_CurrentLimit, RES_3xHV2ndM_TmeasReduction,
      RES_3xHV2ndM_TmeasFactor, RES_3xHV2ndM_VoltageRamp, RES_3xHV2ndM_dIdtEnabled,
      RES_3xHV2ndM_dIdtCurrentThreshold, RES_3xHV2ndM_dIdtTimeThreshold, 'Isolation3xHV2ndMeasurement');

   write_isolation3xhv_result(RES_Result);

   dec_indent();
   write_line('</TestStep>');
end;

