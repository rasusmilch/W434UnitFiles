function write_canbus_result(TestStepResult: integer): void;
begin
   Line = '<TestStepResult Type="CANBus">';
   write_line(Line);
   inc_indent();
   switch (TestStepResult)
   begin
      case TESTSTEP_Passed:
      begin
         Text = 'Passed';
      end;
      case TESTSTEP_Failed:
      begin
         Text = 'Failed';
      end;
      default: begin
         Text = 'Invalid';
      end;
   end;
   Line = '<Result>' + Text + '</Result>';
   write_line(Line);
   dec_indent();
   write_line('</TestStepResult>');
end;

template CANRxTest
begin
   write_line('<TestStep Cmd="CANRxTest">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   Line = '<Name>' + RES_Name + '</Name>';
   write_line(Line);
   write_canbus_result(RES_Result);
   dec_indent();
   write_line('</TestStep>');
end;

