//Output for the command ProbeTest
template ProbeTest
begin
   Name = get_teststep_name(RES_Name, '');
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      ResultText = get_continuity_result_text(RES_Result, RES_Arc);
      ResultText = format_teststep_result(ResultText);
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin));
      Pin2 = format_teststep_pin(LocalText('117#Probe'));
      Value = get_resistance_value(RES_Prefix, RES_Value);
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      if (RES_Result == TESTSTEP_Passed)
      begin
         UIWriteNormal(Line);
      end
      else
      begin
         UIWriteError(Line);
      end;
   end;
end;

//Output for the command ProbeTest
template ProbeTestSearch
begin
   Name = get_teststep_name(RES_Name, '');
   ResultText = get_continuity_result_text(RES_Result, RES_Arc);
   ResultText = format_teststep_result(ResultText);
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_pinname(RES_Pin));
   Pin2 = format_teststep_pin(LocalText('117#Probe'));
   Line = StrAdd(ResultText, Name);
   Line = StrAdd(Line, Pin1);
   Line = StrAdd(Line, Pin2);
   if (RES_Result == TESTSTEP_Passed)
   begin
      UIWriteNormal(Line);
   end
   else
   begin
      UIWriteError(Line);
   end;
end;

//Output for the command NoConnection
template NoConnection
begin
   Name = get_teststep_name(RES_Name, LocalText('232#NC'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      if ((RES_Result == TESTSTEP_Failed) AND (NOT RES_Arc))
      begin
         ResultText = LocalText('15#Short');
      end
      else
      begin
         ResultText = get_continuity_result_text(RES_Result, RES_Arc);
      end;
      ResultText = format_teststep_result(ResultText);
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
      Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
      if (RES_Arc)
      begin
         Value = ' ';
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      if (RES_Result == TESTSTEP_Passed)
      begin
         UIWriteNormal(Line);
      end
      else
      begin
         UIWriteError(Line);
      end;
   end;
end;

//Output for the command WireTestAnalysis
template WireTestAnalysis
begin
   Name = get_teststep_name(RES_Name, LocalText('8#Wire'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      ResultText = get_continuity_result_text(RES_Result, RES_Arc);
      ResultText = format_teststep_result(ResultText);
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
      Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
      Value = get_resistance_value(RES_Prefix, RES_Value);

      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      if (RES_Result == TESTSTEP_Passed)
      begin
         UIWriteNormal(Line);
      end
      else
      begin
         UIWriteError(Line);
      end;
      if (RES_Result == TESTSTEP_Failed)
      begin
         //Write results of continuity analysis
         for Network = 1 to RES_NetworkCount do
         begin
            Space = TESTSTEP_RESULT_WIDTH + TESTSTEP_NAME_WIDTH;
            Space = FormatAlignLeft(' ', Space, ' ');
            for Index = 1 to RES_NetworkPinCount[Network] do
            begin
               UIWriteError(StrAdd(Space, get_pinname(RES_NetworkPins[Network, Index])));
            end;
            if (Network < RES_NetworkCount)
            begin
               if (RES_ValuesToNextNWArc[Network])
               begin
                  Value = LocalText('202#Arc');
               end
               else
               begin
                  Value = get_resistance_value(RES_ValuesToNextNWPrefix[Network], RES_ValuesToNextNW[Network]);
               end;
               UIWriteError(Value);
            end;
         end;
         //Write results of LV isolation analysis
         for Network = 1 to RES_NetworkCount do
         begin
            if (RES_NCAExecuted[Network])
            begin
               if (RES_ShortCount[Network] == 0)
               begin
                  Value = get_resistance_value(RES_NCAValuesPrefix[Network], RES_NCAValues[Network]);
                  Width = TESTSTEP_RESULT_WIDTH + TESTSTEP_NAME_WIDTH;
                  Name = FormatAlignLeft(LocalText('233#NCA'), Width, ' ');
                  Width = 2 * TESTSTEP_PIN_WIDTH;
                  Pin = FormatAlignLeft(get_pinname(RES_NetworkPins[Network, 1]), 50, ' ');
                  Line = StrAdd(Name, Pin);
                  Line = StrAdd(Line, Value);
                  UIWriteNormal(Line);
               end
               else
               begin
                  Width = TESTSTEP_RESULT_WIDTH + TESTSTEP_NAME_WIDTH;
                  Line = FormatAlignLeft(LocalText('43#Short'), Width, ' ');
                  Pin1 = format_teststep_pin(get_pinname(RES_NetworkPins[Network, 1]));
                  Line = StrAdd(Line, Pin1);
                  for Index = 1 to RES_ShortCount[Network] do
                  begin
                     Pin2 = format_teststep_pin(get_pinname(RES_Shorts[Network, Index]));
                     if (RES_ShortArcs[Network, Index])
                     begin
                        Value = LocalText('202#Arc');
                     end
                     else
                     begin
                        Value = get_resistance_value(RES_ShortPrefixes[Network, Index], RES_ShortValues[Network, Index]);
                     end;
                     Line = StrAdd(Line, Pin2);
                     Line = StrAdd(Line, Value);
                     UIWriteError(Line);
                  end;
               end;
            end;
         end;
      end;
   end;
end;

//Output for the command NoConnAll
template NoConnAll
begin
   Name = get_teststep_name(RES_Name, LocalText('233#NCA'));
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_pinname(RES_Pin));

   if (RES_Result == TESTSTEP_Passed)
   begin
      ResultText = format_teststep_result(LocalText('5#Passed'));
      Pin2 = format_teststep_pin(' ');
      Value = get_resistance_value(RES_Prefix, RES_Value);
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      UIWriteNormal(Line);
   end
   else
   begin
      if (RES_ErrorPinCount > 0)
      begin
         Index = RES_ErrorPinCount;
         if (RES_Arcs[Index])
         begin
            ResultText = LocalText('202#Arc');
            Value = ' ';
         end
         else
         begin
            ResultText = LocalText('15#Short');
            Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
         end;
         ResultText = format_teststep_result(ResultText);
         Pin2 = format_teststep_pin(get_pinname(RES_ErrorPins[Index]));

         Line = StrAdd(ResultText, Name);
         Line = StrAdd(Line, Pin1);
         Line = StrAdd(Line, Pin2);
         Line = StrAdd(Line, Value);
         UIWriteError(Line);
      end;
   end;
end;
