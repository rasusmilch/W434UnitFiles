         Line = StrAdd(Line, Pin1);
         Line = StrAdd(Line, Pin2);
         Line = StrAdd(Line, Value);
         if (Index == RES_ErrorPinCount)
         begin
            Write(Line);
         end
         else
         begin
            WriteLn(Line);
         end;
      end;
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output commands for the command PinScan
template PinScan
begin
   if (RES_ManualTest)
   begin
      Name = format_teststep_name(LocalText('239#PinScan'));
      Pin1 = format_teststep_pin(get_pinname(RES_Pin));
      if (RES_Result == TESTSTEP_Passed)
      begin
         ResultText = format_teststep_result(' ');
         Pin2 = format_teststep_pin(' ');
         Value = get_resistance_value(RES_Prefix, RES_Value);
         Line = StrAdd(ResultText, Name);
         Line = StrAdd(Line, Pin1);
         Line = StrAdd(Line, Pin2);
         Line = StrAdd(Line, Value);
         Write(Line);
      end
      else
      begin
         ResultText = format_teststep_result(LocalText('17#Found'));
         for Index = 1 to RES_ErrorPinCount do
         begin
            Pin2 = format_teststep_pin(get_pinname(RES_ErrorPins[Index]));
            Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
            Line = StrAdd(ResultText, Name);
            Line = StrAdd(Line, Pin1);
            Line = StrAdd(Line, Pin2);
            Line = StrAdd(Line, Value);
            if (Index == RES_ErrorPinCount)
            begin
               Write(Line);
            end
            else
            begin
               WriteLn(Line);
            end;
         end;
      end;
   end;
end;

//Output commands for the command NoConnGroupLV
template NoConnGroupLV
begin
   Name = get_teststep_name(RES_Name, LocalText('237#NCG LV'));
   Name = format_teststep_name(Name);

   if (RES_Result == TESTSTEP_Passed)
   begin
      ResultText = format_teststep_result(LocalText('5#Passed'));
      HighGroup = format_teststep_pin(RES_HighGroup);
      LowGroup = format_teststep_pin(RES_LowGroup);
      Value = get_resistance_value(RES_Prefix, RES_Value);
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, HighGroup);
      Line = StrAdd(Line, LowGroup);
      Line = StrAdd(Line, Value);
      Write(Line);
   end
   else
   begin
      for Index = 1 to RES_ErrorCount do
      begin
         if (RES_Arcs[Index])
         begin
            ResultText = LocalText('202#Arc');
            Value = ' ';
         end
         else
         begin
            ResultText = LocalText('15#Short');
            Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
         end;
         if ((RES_ErrorHighPins[Index] == PINADDRESS_NotSearched) OR (RES_ErrorHighPins[Index] == PINADDRESS_NotFound))
         begin
            Pin1 = RES_HighGroup;
         end
         else
         begin
            Pin1 = get_pinname(RES_ErrorHighPins[Index]);
         end;
         if ((RES_ErrorLowPins[Index] == PINADDRESS_NotSearched) OR (RES_ErrorLowPins[Index] == PINADDRESS_NotFound))
         begin
            Pin2 = RES_LowGroup;
         end
         else
         begin
            Pin2 = get_pinname(RES_ErrorLowPins[Index]);
         end;
         ResultText = format_teststep_result(ResultText);
         Pin1 = format_teststep_pin(Pin1);
         Pin2 = format_teststep_pin(Pin2);
         Line = StrAdd(ResultText, Name);
         Line = StrAdd(Line, Pin1);
         Line = StrAdd(Line, Pin2);
         Line = StrAdd(Line, Value);
         if (Index == RES_ErrorCount)
         begin
            Write(Line);
         end
         else
         begin
            WriteLn(Line);
         end;
      end;
      short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output commands for the command ConnectionTestLV
template ConnectionTestLV
begin
   Name = get_teststep_name(RES_Name, LocalText('238#ConnectionTestLV'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = LocalText('202#Arc');
            end
            else
            begin
               ResultText = LocalText('6#Open');
            end;
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
         end;
      end;
      ResultText = format_teststep_result(ResultText);
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
      Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
      if (RES_Arc)
      begin
         Value = ' ';
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      Write(Line);
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;


