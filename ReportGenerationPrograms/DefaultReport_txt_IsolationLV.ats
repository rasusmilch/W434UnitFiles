//LV-Isolationstest-Funktionen sind die Funktionen, bei denen die
//LV-Parameter für die Messung verwendet werden.

//LV isolation test functions are those, for which the LV parameters are used


//Output for the command ParamIsolationLV
template ParamIsolationLV
begin
   Line = '';
   if (RES_VoltageChanged)
   begin
      Value = FormatVoltage(RES_LVVoltage);
      Line = StrAdd(Line, LocalText('61#Voltage'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_ThresholdChanged)
   begin
      Value = FormatResistance(RES_LVThreshold);
      Line = StrAdd(Line, LocalText('52#Threshold'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TriseChanged)
   begin
      Value = FormatTime(RES_LVTrise);
      Line = StrAdd(Line, LocalText('53#Trise'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TwaitChanged)
   begin
      Value = FormatTime(RES_LVTwait);
      Line = StrAdd(Line, LocalText('54#Twait'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TmeasChanged)
   begin
      Value = FormatTime(RES_LVTmeas);
      Line = StrAdd(Line, LocalText('55#Tmeas'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_AutoRangeChanged)
   begin
      if (RES_LVAutoRange)
      begin
         Value = LocalText('56#On');
      end
      else
      begin
         Value = LocalText('57#Off');
      end;
      Line = StrAdd(Line, LocalText('58#Auto ranging'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_CurrentLimitChanged)
   begin
      Value = FormatCurrent(RES_LVCurrentLimit);
      Line = StrAdd(Line, LocalText('62#Current limit'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TmeasReductionChanged)
   begin
      if (RES_LVTmeasReduction)
      begin
         Value = LocalText('56#On');
      end
      else
      begin
         Value = LocalText('57#Off');
      end;
      Line = StrAdd(Line, LocalText('63#Tmeas red.'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TmeasFactorChanged)
   begin
      Value = RES_LVTmeasFactor;
      Line = StrAdd(Line, LocalText('64#Tmeas fact.'));
      Line = Line + '=' + Value + '; ';
   end;
   if (StrCompare(Line, '') <> 0)
   begin
      Pos = StrLength(Line) - 1;
      Line = StrDelete(Line, Pos, 2);
      WriteLn(LocalText('65#Parameters for LV isolation test'));
      Write(Line);
   end;
end;

