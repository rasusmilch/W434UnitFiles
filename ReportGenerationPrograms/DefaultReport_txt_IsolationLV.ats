//Output commands for the command NoConnectionLV
template NoConnectionLV
begin
   Name = get_teststep_name(RES_Name, LocalText('234#NC LV'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = LocalText('202#Arc');
            end
            else
            begin
               ResultText = LocalText('15#Short');
            end;
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
         end;
      end;
      ResultText = format_teststep_result(ResultText);
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
      Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
      if (RES_Arc)
      begin
         Value = ' ';
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      Write(Line);
      short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output commands for the command NoConnAllLV
template NoConnAllLV
begin
   Name = get_teststep_name(RES_Name, LocalText('235#NCA LV'));
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_pinname(RES_Pin));

   if (RES_Result == TESTSTEP_Passed)
   begin
      ResultText = format_teststep_result(LocalText('5#Passed'));
      Pin2 = format_teststep_pin(' ');
      Value = get_resistance_value(RES_Prefix, RES_Value);
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      Write(Line);
   end
   else
   begin
      for Index = 1 to RES_ErrorPinCount do
      begin
         if (RES_Arcs[Index])
         begin
            ResultText = LocalText('202#Arc');
            Value = ' ';
         end
         else
         begin
            ResultText = LocalText('15#Short');
            Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
         end;
         ResultText = format_teststep_result(ResultText);
         Pin2 = format_teststep_pin(get_pinname(RES_ErrorPins[Index]));
         Line = StrAdd(ResultText, Name);
         Line = StrAdd(Line, Pin1);
         Line = StrAdd(Line, Pin2);
         Line = StrAdd(Line, Value);
         if (Index == RES_ErrorPinCount)
         begin
            Write(Line);
         end
         else
         begin
            WriteLn(Line);
         end;
      end;
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

