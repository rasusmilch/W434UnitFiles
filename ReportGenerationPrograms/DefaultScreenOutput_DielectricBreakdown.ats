end;

//Output for the command
template NoConnGroupDB
begin
   Name = get_teststep_name(RES_Name, LocalText('254#NCG DB'));
   Name = format_teststep_name(Name);

   if (RES_Result == TESTSTEP_Passed)
   begin
      ResultText = format_teststep_result(LocalText('5#Passed'));
      ResultText = FormatAlignLeft(ResultText, 20, ' ');
      HighGroup = format_teststep_pin(RES_HighGroup);
      LowGroup = format_teststep_pin(RES_LowGroup);
      Value = get_dielectric_breakdown_value(RES_Arc, RES_ValueValid, RES_ValueIr, RES_PrefixIr,
         RES_ValueIi, RES_PrefixIi);
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, HighGroup);
      Line = StrAdd(Line, LowGroup);
      Line = StrAdd(Line, Value);
      UIWriteNormal(Line);
   end
   else
   begin
      if (RES_ErrorCount > 0)
      begin
         Index = RES_ErrorCount;
         Value = get_dielectric_breakdown_value(RES_Arcs[Index], RES_ValuesValid[Index],
            RES_ValuesIr[Index], RES_PrefixesIr[Index], RES_ValuesIi[Index], RES_PrefixesIi[Index]);
         if (RES_Arcs[Index])
         begin
            ResultText = LocalText('202#Arc');
         end
         else
         begin
            ResultText = LocalText('15#Short');
         end;
         if ((RES_ErrorHighPins[Index] == PINADDRESS_NotSearched) OR
             (RES_ErrorHighPins[Index] == PINADDRESS_NotFound))
         begin
            Pin1 = RES_HighGroup;
         end
         else
         begin
            Pin1 = get_pinname(RES_ErrorHighPins[Index]);
         end;
         if ((RES_ErrorLowPins[Index] == PINADDRESS_NotSearched) OR
             (RES_ErrorLowPins[Index] == PINADDRESS_NotFound))
         begin
            Pin2 = RES_LowGroup;
         end
         else
         begin
            Pin2 = get_pinname(RES_ErrorLowPins[Index]);
         end;
         ResultText = format_teststep_result(ResultText);
         Pin1 = format_teststep_pin(Pin1);
         Pin2 = format_teststep_pin(Pin2);

         Line = StrAdd(ResultText, Name);
         Line = StrAdd(Line, Pin1);
         Line = StrAdd(Line, Pin2);
         Line = StrAdd(Line, Value);
         UIWriteError(Line);
         short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
      end;
   end;
end;

//Output for the command ConnectionTestDB
template ConnectionTestDB
begin
   Name = get_teststep_name(RES_Name, LocalText('255#ConnectionTestDB'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = 'Arc';
            end
            else
            begin
               ResultText = LocalText('6#Open');
            end;
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
         end;
      end;
      ResultText = format_teststep_result(ResultText);
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
      Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
      Value = get_dielectric_breakdown_value(RES_Arc, RES_ValueValid, RES_ValueIr, RES_PrefixIr,
         RES_ValueIi, RES_PrefixIi);

      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      if (RES_Result == TESTSTEP_Passed)
      begin
         UIWriteNormal(Line);
      end
      else
      begin
         UIWriteError(Line);
      end;
   end;
end;

//Output for the command SimpleNoConnPinVsGroupDB
template SimpleNoConnPinVsGroupDB
begin
   Name = get_teststep_name(RES_Name, LocalText('256#SPvG DB'));
   Name = format_teststep_name(Name);
   HighPin = format_teststep_pin(get_pinname(RES_Pin));
   if (RES_Result == TESTSTEP_Passed)
   begin
      ResultText = format_teststep_result(LocalText('5#Passed'));
      LowGroup = format_teststep_pin(RES_LowGroup);
      Value = get_dielectric_breakdown_value(RES_Arc, RES_ValueValid, RES_ValueIr, RES_PrefixIr,
         RES_ValueIi, RES_PrefixIi);
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, HighPin);
      Line = StrAdd(Line, LowGroup);
      Line = StrAdd(Line, Value);
      UIWriteNormal(Line);
   end
   else
   begin
      if (RES_ErrorPinCount > 0)
      begin
         Index = RES_ErrorPinCount;
         Value = get_dielectric_breakdown_value(RES_Arcs[Index], RES_ValuesValid[Index],
            RES_ValuesIr[Index], RES_PrefixesIr[Index], RES_ValuesIi[Index], RES_PrefixesIi[Index]);
         if (RES_Arcs[Index])
         begin
            ResultText = LocalText('202#Arc');
         end
         else
         begin
            ResultText = LocalText('15#Short');
         end;
         if ((RES_ErrorPins[Index] == PINADDRESS_NotSearched) OR
             (RES_ErrorPins[Index] == PINADDRESS_NotFound))
         begin
            LowPin = RES_LowGroup;
         end
         else
         begin
            LowPin = get_pinname(RES_ErrorPins[Index]);
         end;
         ResultText = format_teststep_result(ResultText);
         LowPin = format_teststep_pin(LowPin);
         Line = StrAdd(ResultText, Name);
         Line = StrAdd(Line, HighPin);
         Line = StrAdd(Line, LowPin);
         Line = StrAdd(Line, Value);
         UIWriteError(Line);
         short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
      end;
   end;
end;

