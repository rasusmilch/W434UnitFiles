function write_idd_result(TestStepResult: integer): void;
begin
   Line = '<TestStepResult Type="IDD">';
   write_line(Line);
   inc_indent();
   switch (TestStepResult)
   begin
      case TESTSTEP_Passed:
      begin
         Text = 'Passed';
      end;
      case TESTSTEP_Failed:
      begin
         Text = 'Failed';
      end;
      default: begin
         Text = 'Invalid';
      end;
   end;
   Line = '<Result>' + Text + '</Result>';
   write_line(Line);
   dec_indent();
   write_line('</TestStepResult>');
end;

template ParamIDD
begin
   write_line('<TestStep Cmd="ParamIDD">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);

   dec_indent();
   write_line('</TestStep>');
end;

