//Output for the command IDDRun
template IDDRun
begin
   write_line('<TestStep Cmd="IDDRun">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);

   Line = '<Name>' + RES_Name + '</Name>';
   write_line(Line);
   if (RES_TxCount > 0)
   begin
      write_line('<Transmitters>');
      inc_indent();
      for Index = 1 to RES_TxCount do
      begin
         PinName = get_pin_name(RES_TxPins[Index]);
         Line = '<Transmitter><PinAddr>' + RES_TxPins[Index] + '</PinAddr><PinName>' + PinName + '</PinName></Transmitter>';
         write_line(Line);
      end;
      dec_indent();
      write_line('</Transmitters>');
   end;

   write_idd_result(RES_Result);

   dec_indent();
   write_line('</TestStep>');
end;
