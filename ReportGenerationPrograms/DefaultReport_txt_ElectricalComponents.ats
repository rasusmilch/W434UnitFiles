//Output commands for the command AttenuatorTest
template AttenuatorTest
begin
   Name = get_teststep_name(RES_Name, LocalText('116#Attenuator'));
   switch (RES_Result)
   begin
      case TESTSTEP_Passed:
      begin
         ResultText = LocalText('5#Passed');
      end;
      case TESTSTEP_Failed:
      begin
         ResultText = '';
         if (StrCompare(RES_Prefix, '%') == 0)
         begin
            ResultText = LocalText('45#Defective');
         end
         else
         begin
            if (RES_Value > RES_MaxAttenuation)
            begin
               ResultText = LocalText('12#Too high');
            end
            else
            begin
               if (RES_Value < RES_MinAttenuation)
               begin
                  ResultText = LocalText('13#Too low');
               end;
            end;
            if (RES_PolarityTest)
            begin
               if (NOT RES_PolarityOk)
               begin
                  if (StrCompare('', ResultText) == 0)
                  begin
                     ResultText = LocalText('44#Reversed');
                  end
                  else
                  begin
                     ResultText = StrAdd(ResultText, ' (');
                     ResultText = StrAdd(ResultText, LocalText('44#Reversed'));
                     ResultText = StrAdd(ResultText, ')');
                  end;
               end;
            end;
         end;
      end;
      default:
      begin
         ResultText = LocalText('7#Invalid');
      end;
   end;
   ResultText = format_teststep_result(ResultText);
   Name = format_teststep_name(Name);
   Pin1 = format_teststep_pin(get_pinname(RES_PinA1));
   Pin2 = format_teststep_pin(get_pinname(RES_PinB1));
   Value = get_attenuation_value(RES_Prefix, RES_Value);
   Line = StrAdd(ResultText, Name);
   Line = StrAdd(Line, Pin1);
   Line = StrAdd(Line, Pin2);
   Line = StrAdd(Line, Value);
   Write(Line);
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;

//Output commands for the command VariableResistorTest
template VariableResistorTest
begin
   Name = get_teststep_name(RES_Name, LocalText('148#Variable resistor'));
   Name = Name + ' [' + RES_StateName + ']';
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = LocalText('202#Arc');
            end
            else
            begin
               if (StrCompare(RES_Prefix, '%') == 0)
               begin
                  ResultText = LocalText('45#Defective');
               end
               else
               begin
                  if (RES_Value > RES_MaxResistance)
                  begin
                     ResultText = LocalText('12#Too high');
                  end
                  else
                  begin
                     ResultText = LocalText('13#Too low');
                  end;
               end;
            end;
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
         end;
      end;
      ResultText = format_teststep_result(ResultText);
      Name = format_teststep_name(Name);
      Pin1 = format_teststep_pin(get_pinname(RES_Pin1));
      Pin2 = format_teststep_pin(get_pinname(RES_Pin2));
      if (RES_Arc)
      begin
         Value = ' ';
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Line = StrAdd(ResultText, Name);
      Line = StrAdd(Line, Pin1);
      Line = StrAdd(Line, Pin2);
      Line = StrAdd(Line, Value);
      Write(Line);
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
end;
