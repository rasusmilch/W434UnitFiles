//Output commands for the command LV_DetectionTest
template LV_DetectionTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'DET';
   end
   else
   begin
      Name = RES_Name;
   end;
   Pin1 = get_lv_pinname(RES_Pin1);
   Pin2 = get_lv_pinname(RES_Pin2);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      WriteLn('teststeppass>');
      ResultText = LocalText('5#Passed');
      write_default_table_line(File, ResultText, Name, Pin1, Pin2);
   end
   else
   begin
      WriteLn('teststepfail>');
      if (RES_On)
      begin
         ResultText = LocalText('57#Off');
      end
      else
      begin
         ResultText = LocalText('56#On');
      end;
      write_default_table_line(File, ResultText, Name, Pin1, Pin2);
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

//Output for the command IDDRun
template IDDRun
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'IDD';
   end
   else
   begin
      Name = RES_Name;
   end;

   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      WriteLn('teststeppass>');
      ResultText = LocalText('5#Passed');
      write_default_table_line(File, ResultText, Name);
   end
   else
   begin
      WriteLn('teststepfail>');
      
      for Index = 1 to RES_TxCount do
      begin
         ResultText = '';
         Passed = get_idd_tx_passed(RES_TxResults[Index], ResultText);
         if (NOT Passed)
         begin
            Pin1 = get_pinname(RES_TxPins[Index]);
            Pin2 = '&nbsp;';
            Value = '&nbsp;';
            if (RES_TxValues[Index] <> 0)
            begin
               Value = RES_TxValues[Index];
            end;
            write_default_table_line(File, ResultText, Name, Pin1, Pin2, Value);
         end;
      end;
      for Index = 1 to RES_FailedRxCount do
      begin
         ResultText = get_idd_rx_text(RES_RxResults[Index]);
         Pin1 = get_pinname(RES_TxFailPins[Index]);
         Pin2 = get_pinname(RES_RxFailPins[Index]);
         if (RES_RxValues[Index] == 0)
         begin
            Value = '';
         end
         else
         begin
            Value = RES_RxValues[Index];
         end;
         write_default_table_line(File, ResultText, Name, Pin1, Pin2, Value);
      end;
   end;
   WriteLn('</TABLE>');
end;


//Output for the command SimpleNoConnPinVsGroupHV
template SimpleNoConnPinVsGroupHV
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'SPvG HV';
   end
   else
   begin
      Name = RES_Name;
   end;
   HighPin = get_pinname(RES_Pin);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      if (RES_HVUseIThreshold)
      begin
         Value = get_current_value(RES_IPrefix, RES_IValue);
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(LocalText('5#Passed'));
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(HighPin);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(RES_LowGroup);
      WriteLn('</TD>');
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      for Index = 1 to RES_ErrorPinCount do
      begin
         ResultText = get_hv_isolation_error_text(RES_Arcs[Index],
            RES_dIdts[Index], RES_ELims[Index]);
         IsShort = (NOT RES_Arcs[Index]) AND (NOT RES_dIdts[Index]) AND
            (NOT RES_ELims[Index]);
         Value = '&nbsp;';
         if (IsShort)
         begin
            if (RES_HVUseIThreshold)
            begin
               Value = get_current_value(RES_IPrefixes[Index], RES_IValues[Index]);
            end
            else
            begin
               Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
            end;
         end;
         if ((RES_ErrorPins[Index] == PINADDRESS_NotSearched) OR
             (RES_ErrorPins[Index] == PINADDRESS_NotFound))
         begin
            LowPin = RES_LowGroup;
         end
         else
         begin
            LowPin = get_pinname(RES_ErrorPins[Index]);
         end;
         Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
         Write('<IMG SRC="');
         Write(File);
         WriteLn('" Width=16 Height=16>&nbsp;</TD>');
         Write('<TD Width=100 class=bold>');
         Write(ResultText);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Name);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(HighPin);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(LowPin);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
      display_short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
   end;
   display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed,
      RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;


//Output for the command SimpleNoConnPinVsGroupDB
template SimpleNoConnPinVsGroupDB
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'SPvG DB';
   end
   else
   begin
      Name = RES_Name;
   end;
   HighPin = get_pinname(RES_Pin);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      Value = get_dielectric_breakdown_value(RES_Arc, RES_ValueValid,
         RES_ValueIr, RES_PrefixIr, RES_ValueIi, RES_PrefixIi);
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(LocalText('5#Passed'));
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(HighPin);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(RES_LowGroup);
      WriteLn('</TD>');
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      for Index = 1 to RES_ErrorPinCount do
      begin
         Value = get_dielectric_breakdown_value(RES_Arcs[Index],
            RES_ValuesValid[Index], RES_ValuesIr[Index], RES_PrefixesIr[Index],
            RES_ValuesIi[Index], RES_PrefixesIi[Index]);
         if (RES_Arcs[Index])
         begin
            ResultText = 'Arc';
         end
         else
         begin
            ResultText = LocalText('15#Short');
         end;
         if ((RES_ErrorPins[Index] == PINADDRESS_NotSearched) OR
             (RES_ErrorPins[Index] == PINADDRESS_NotFound))
         begin
            LowPin = RES_LowGroup;
         end
         else
         begin
            LowPin = get_pinname(RES_ErrorPins[Index]);
         end;
         Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
         Write('<IMG SRC="');
         Write(File);
         WriteLn('" Width=16 Height=16>&nbsp;</TD>');
         Write('<TD Width=100 class=bold>');
         Write(ResultText);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Name);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(HighPin);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(LowPin);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
      display_short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
   end;
   display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed,
      RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

