//Output for the command VoltageFrequencyTest
template VoltageFrequencyTest
begin
   switch (RES_Result)
   begin
      case TESTSTEP_Passed:
      begin
         ResultText = LocalText('5#Passed');
         Style = 'teststeppass';
      end;
      case TESTSTEP_Failed:
      begin
         ResultTextU = 'U: ' + LocalText('122#Fail');
         ResultTextf = 'f: ' + LocalText('122#Fail');
         if (RES_VoltagePassed)
         begin
            ResultTextU = 'U: ' + LocalText('121#Pass');
         end;
         if (RES_FrequencyPassed)
         begin
            ResultTextf = 'f: ' + LocalText('121#Pass');
         end;
         ResultText = ResultTextU + '; ' + ResultTextf;
         Style = 'teststepfail';
      end;
      default:
      begin
         ResultText = LocalText('7#Invalid');
         Style = 'teststepfail';
      end;
   end;
   File = get_teststepimage(RES_Result, RES_ManualTest);
   Write('<TABLE Border=0 Width=640 class=');
   Write(Style);
   WriteLn('>');
   Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
   Write('<IMG SRC="');
   Write(File);
   WriteLn('" Width=16 Height=16>&nbsp;</TD>');
   Write('<TD Width=100 class=bold>');
   Write(ResultText);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   if (StrCompare('', RES_Name) == 0)
   begin
      Write(LocalText('165#Voltage+Frequency'));
   end
   else
   begin
      Write(RES_Name);
   end;
   WriteLn('</TD>');
   Pin1 = get_pinname(RES_Pin1);
   Pin2 = get_pinname(RES_Pin2);
   Write('<TD Width=130>');
   Write(Pin1);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   Write(Pin2);
   WriteLn('</TD>');
   ValueU = get_voltage_value(RES_Prefix, RES_Value);
   Valuef = get_frequency_value(RES_fPrefix, RES_fValue);
   Value = ValueU + '; ' + Valuef;
   Write('<TD Align=RIGHT>');
   Write(Value);
   WriteLn('</TD></TR>');
   display_teststepcomment(RES_Comment, Style,
      RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

//Output for the command NoConnGroupLV
template NoConnGroupLV
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NCG LV';
   end
   else
   begin
      Name = RES_Name;
   end;
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      Value = get_resistance_value(RES_Prefix, RES_Value);
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(LocalText('5#Passed'));
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(RES_HighGroup);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(RES_LowGroup);
      WriteLn('</TD>');
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      for Index = 1 to RES_ErrorCount do
      begin
         if (RES_Arcs[Index])
         begin
            ResultText = 'Arc';
            Value = '&nbsp;';
         end
         else
         begin
            ResultText = LocalText('15#Short');
            Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
         end;
         if ((RES_ErrorHighPins[Index] == PINADDRESS_NotSearched) OR (RES_ErrorHighPins[Index] == PINADDRESS_NotFound))
         begin
            Pin1 = RES_HighGroup;
         end
         else
         begin
            Pin1 = get_pinname(RES_ErrorHighPins[Index]);
         end;
         if ((RES_ErrorLowPins[Index] == PINADDRESS_NotSearched) OR  (RES_ErrorLowPins[Index] == PINADDRESS_NotFound))
         begin
            Pin2 = RES_LowGroup;
         end
         else
         begin
            Pin2 = get_pinname(RES_ErrorLowPins[Index]);
         end;
         Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
         Write('<IMG SRC="');
         Write(File);
         WriteLn('" Width=16 Height=16>&nbsp;</TD>');
         Write('<TD Width=100 class=bold>');
         Write(ResultText);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Name);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin1);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin2);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
      display_short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
   end;
   display_teststepcomment(RES_Comment, Style,
      RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

//Output for the command NoConnGroupHV
template NoConnGroupHV
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NCG HV';
   end
   else
   begin
      Name = RES_Name;
   end;
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      if (RES_HVUseIThreshold)
      begin
         Value = get_current_value(RES_IPrefix, RES_IValue);
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(LocalText('5#Passed'));
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(RES_HighGroup);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(RES_LowGroup);
      WriteLn('</TD>');
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      for Index = 1 to RES_ErrorCount do
      begin
         ResultText = get_hv_isolation_error_text(RES_Arcs[Index],
            RES_dIdts[Index], RES_ELims[Index]);
         IsShort = (NOT RES_Arcs[Index]) AND (NOT RES_dIdts[Index]) AND
            (NOT RES_ELims[Index]);
         Value = '&nbsp;';
         if (IsShort)
         begin
            if (RES_HVUseIThreshold)
            begin
               Value = get_current_value(RES_IPrefixes[Index], RES_IValues[Index]);
            end
            else
            begin
               Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
            end;
         end;
         if ((RES_ErrorHighPins[Index] == PINADDRESS_NotSearched) OR
             (RES_ErrorHighPins[Index] == PINADDRESS_NotFound))
         begin
            Pin1 = RES_HighGroup;
         end
         else
         begin
            Pin1 = get_pinname(RES_ErrorHighPins[Index]);
         end;
         if ((RES_ErrorLowPins[Index] == PINADDRESS_NotSearched) OR
             (RES_ErrorLowPins[Index] == PINADDRESS_NotFound))
         begin
            Pin2 = RES_LowGroup;
         end
         else
         begin
            Pin2 = get_pinname(RES_ErrorLowPins[Index]);
         end;
         Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
         Write('<IMG SRC="');
         Write(File);
         WriteLn('" Width=16 Height=16>&nbsp;</TD>');
         Write('<TD Width=100 class=bold>');
         Write(ResultText);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Name);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin1);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin2);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
      display_short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
   end;
   display_teststepcomment(RES_Comment, Style,
      RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

