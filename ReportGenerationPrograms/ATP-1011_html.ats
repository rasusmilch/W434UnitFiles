//Attention!
//Changes in the programs for report generation, which are made in the original
//files will be overwritten when installing a software-update.
//If you need to cusomize the report do not change the script-files that are
//distributed with CEETIS.
//Make a copy of these files ("File->Save Program as" or "File->Save as") and
//customize the copies.
//If you want to bind the customized programs automatically to your projects,
//you can create project templates.


//Output for the report header
template Header
begin
   //HTML Header
   write_html_header('');
   //Caption
   WriteLn('<TABLE Width=640 class=title>');
   WriteLn('<TR><TD Width=280 ALIGN="left">Nortech Systems, Inc.</TD>');
   WriteLn('<TD ALIGN="right"><IMG SRC="..\..\images\Nortech.jpg" width="150" height="31">&nbsp;</TD></TR>');
   WriteLn('</TABLE><BR>');

   //General information
   WriteLn('<TABLE Width=640 class=header>');

   Write('<TR><TD Width=300>');
   Write('W434 Test Station ID');
   Write('</TD><TD>');
   Write(MiscGetTestStationIdentifier());
   WriteLn('</TD></TR>');

   Write('<TR><TD Width=300>');
   Write('Calibration Due Date');
   Write('</TD><TD>');
   Write(get_system_calibration_due_date());
   WriteLn('</TD></TR>');

   Write('<TR><TD Width=300>');
   Write(LocalText('18#Software version'));
   Write('</TD><TD>');
   Write(RES_SoftwareVersion);
   WriteLn('</TD></TR>');

   Write('<TR><TD Width=300>');
   Write(LocalText('20#Filename'));
   Write('</TD><TD>');
   Write(FileExtractName(ProjectGetFilename()));
   WriteLn('</TD></TR>');

   Write('<TR><TD Width=300>');
   Write('Test Revision');
   Write('</TD><TD>');
   Write(get_collins_testrev());
   WriteLn('</TD></TR>');

   Write('<TR><TD Width=300>');
   Write(LocalText('19#Unit under test'));
   Write('</TD><TD>');
   Write(get_collins_partnum());
   WriteLn('</TD></TR>');

   //Serial number
   display_serialnumber();

   Write('<TR><TD Width=300>');
   Write(LocalText('CAGE Code'));
   Write('</TD><TD>');
   Write(CAGE_CODE);
   WriteLn('</TD></TR>');

   DateTime = DTGetTestDateTime();
   DateTime = DTDateTimeString(DateTime);
   Write('<TR><TD Width=300>');
   Write(LocalText('21#Date/Time'));
   Write('</TD><TD>');
   Write(DateTime);
   WriteLn('</TD></TR>');

   //Additional input data from the test start program
   display_teststart_inputdata();

   //Order number
   display_ordernumber();

   //User name
   // display_username();

   //Full user name
   // display_fullusername();

   //Group name
   // display_usergroupname();

   //Rangetest
   display_rangetest();

   WriteLn('</TABLE>');
   WriteLn('<BR>');

   //Sections
   display_sections();

   //Test result
   switch (RES_Result)
   begin
      case TEST_Passed:
      begin
         ResultText = LocalText('22#PASSED');
         Style = 'testpass';
         DetailedResult = TRUE;
      end;
      case TEST_Failed:
      begin
         ResultText = LocalText('23#FAILED');
         Style = 'testfail';
         DetailedResult = TRUE;
      end;
      case TEST_Aborted:
      begin
         ResultText = LocalText('24#ABORTED');
         Style = 'testfail';
         DetailedResult = FALSE;
      end;
      default:
      begin
         ResultText = LocalText('25#INVALID');
         Style = 'testfail';
         DetailedResult = FALSE;
      end;
   end;
   if (DetailedResult)
   begin
      //Passed + Failed
      WriteLn('<TABLE Width=640 class=result>');
      Write('<TR>');
      Write('<TD COLSPAN=2 ALIGN=CENTER class=');
      Write(Style);
      Write('>');
      Write(LocalText('26#Test result'));
      WriteLn('</TD></TR>');

      write_command_group_results();

      Write('<TR>');
      Write('<TD Colspan=2 Align=CENTER class=');
      Write(Style);
      Write('>');
      Write(ResultText);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end
   else
   begin
      //Aborted + Invalid
      WriteLn('<TABLE Width=640 class=result>');
      Write('<TR>');
      Write('<TD Align=CENTER class=');
      Write(Style);
      Write('>');
      Write(ResultText);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;

   //Remove "//" from the next line to write the measurement parameters into the report
   //write_parameters();

   //Adaptercables
   check_adaptercables();
   show_lastisolationtestcable();

   WriteLn('<BR><BR>');
end;

//Output for the report footer
template Footer
begin
   print_html_examination_info();

   write_html_footer();
end;

//Output for the command WireTest
template WireTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('8#Wire');
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
            Style = 'teststeppass';
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = 'Arc';
            end
            else
            begin
               ResultText = LocalText('6#Open');
            end;
            Style = 'teststepfail';
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
            Style = 'teststepfail';
         end;
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      if (RES_AutoRangePassedAfterFail)
      begin
         Value = get_resistance_value('>', RES_CThreshold);
         Value = StrAdd(Value, '!');
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      if (RES_Result == TESTSTEP_Failed)
      begin
         if (RES_InterchangedWiresPin1 <> PINADDRESS_None)
         begin
            Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
            Write('<TD Width=100 class=bold>&nbsp;</TD>');
            Write('<TD Width=130>');
            Write(LocalText('69#Connected'));
            WriteLn('</TD>');
            Pin1 = get_pinname(RES_Pin1);
            Pin2 = get_pinname(RES_InterchangedWiresPin1);
            Write('<TD Width=130>');
            Write(Pin1);
            WriteLn('</TD>');
            Write('<TD Width=130>');
            Write(Pin2);
            WriteLn('</TD>');
            WriteLn('<TD Align=RIGHT>&nbsp;</TD></TR>');
         end;
         if (RES_InterchangedWiresPin2 <> PINADDRESS_None)
         begin
            Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
            Write('<TD Width=100 class=bold>&nbsp;</TD>');
            Write('<TD Width=130>');
            Write(LocalText('69#Connected'));
            WriteLn('</TD>');
            Pin1 = get_pinname(RES_Pin2);
            Pin2 = get_pinname(RES_InterchangedWiresPin2);
            Write('<TD Width=130>');
            Write(Pin1);
            WriteLn('</TD>');
            Write('<TD Width=130>');
            Write(Pin2);
            WriteLn('</TD>');
            WriteLn('<TD Align=RIGHT>&nbsp;</TD></TR>');
         end;
      end;
      display_teststepcomment(RES_Comment, Style,
         RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

//Output for the command SwitchTest
template SwitchTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('11#Switch');
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
            Style = 'teststeppass';
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = 'Arc';
            end
            else
            begin
               if (RES_SwitchClosed)
               begin
                  ResultText = LocalText('9#Open');
               end
               else
               begin
                  ResultText = LocalText('10#Closed');
               end;
            end;
            Style = 'teststepfail';
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
            Style = 'teststepfail';
         end;
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      if (RES_AutoRangePassedAfterFail)
      begin
         Value = get_resistance_value('>', RES_CThreshold);
         Value = StrAdd(Value, '!');
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      display_teststepcomment(RES_Comment, Style,
         RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

