      begin
         ResultText = LocalText('16#Error');
         Pin1 = get_pinname(PINADDRESS_NotSearched);
         Pin2 = get_pinname(PINADDRESS_NotSearched);
         Value = 'HV1: ';
         Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
         Value = StrAdd(Value, '  --  DB: ');
         Value = StrAdd(Value, get_dielectric_breakdown_value(RES_DBArc, RES_DBValueValid,
            RES_DBValueIr, RES_DBPrefixIr, RES_DBValueIi, RES_DBPrefixIi));
         Value = StrAdd(Value, '  --  HV2: ');
         Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix, RES_HV2Value));
         hv_multi_step_line_output(File, LocalText('16#Error'), Name,
            Pin1, Pin2, 'HV1/HV2', Value);
      end
      else
      begin
         for Index = 1 to RES_ErrorCount do
         begin
            IsArc = RES_HVArcs[Index] OR RES_DBArcs[Index];
            IsdIdt = RES_HVdIdts[Index];
            IsEnergyLimit = RES_HVELims[Index];
            IsShort = (NOT IsArc) AND (NOT IsdIdt) AND (NOT IsEnergyLimit);
            ResultText = get_hv_isolation_error_text(IsArc, IsdIdt, IsEnergyLimit);
            Value = '&nbsp;';
            if (IsShort)
            begin
               if (RES_ErrorInfo == HV_COMBI_DBError)
               begin
                  Value = get_dielectric_breakdown_value(RES_DBArcs[Index],
                     RES_DBValuesValid[Index], RES_DBValuesIr[Index],
                     RES_DBPrefixesIr[Index], RES_DBValuesIi[Index],
                     RES_DBPrefixesIi[Index]);
               end
               else
               begin
                  Value = get_resistance_value(RES_HVPrefixes[Index], RES_HVValues[Index]);
               end;
            end;
            if ((RES_ErrorHighPins[Index] == PINADDRESS_NotSearched) OR
                (RES_ErrorHighPins[Index] == PINADDRESS_NotFound))
            begin
               Pin1 = RES_HighGroup;
            end
            else
            begin
               Pin1 = get_pinname(RES_ErrorHighPins[Index]);
            end;
            if ((RES_ErrorLowPins[Index] == PINADDRESS_NotSearched) OR
                (RES_ErrorLowPins[Index] == PINADDRESS_NotFound))
            begin
               Pin2 = RES_LowGroup;
            end
            else
            begin
               Pin2 = get_pinname(RES_ErrorLowPins[Index]);
            end;
            FailText = '';
            switch (RES_ErrorInfo)
            begin
               case HV_COMBI_HV1Error: begin
                  FailText = 'HV1';
               end;
               case HV_COMBI_DBError: begin
                  FailText = 'DB';
               end;
               case HV_COMBI_HV2Error: begin
                  FailText = 'HV2';
               end;
            end;
            hv_multi_step_line_output(File, ResultText, Name, Pin1, Pin2,
               FailText, Value);
         end;
         display_short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
      end;
   end;
   display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

//Output for the command NoConnAll
template NoConnAll
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NCA';
   end
   else
   begin
      Name = RES_Name;
   end;
   Pin1 = get_pinname(RES_Pin);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      Value = get_resistance_value(RES_Prefix, RES_Value);
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(LocalText('5#Passed'));
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>&nbsp;</TD>');
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      for Index = 1 to RES_ErrorPinCount do
      begin
         Pin2 = get_pinname(RES_ErrorPins[Index]);
         if (RES_Arcs[Index])
         begin
            ResultText = 'Arc';
            Value = '&nbsp;';
         end
         else
         begin
            ResultText = LocalText('15#Short');
            Value = get_resistance_value(RES_Prefixes[Index], RES_Values[Index]);
         end;
         Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
         Write('<IMG SRC="');
         Write(File);
         WriteLn('" Width=16 Height=16>&nbsp;</TD>');
         Write('<TD Width=100 class=bold>');
         Write(ResultText);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Name);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin1);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin2);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
   end;
   display_teststepcomment(RES_Comment, Style,
      RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

//Output for the command VariableResistorTest
template VariableResistorTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = StrAdd(LocalText('148#Variable resistor'), ' [');
   end
   else
   begin
      Name = StrAdd(RES_Name, ' [');
   end;
   Name = StrAdd(Name, RES_StateName);
   Name = StrAdd(Name, ']');
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
            Style = 'teststeppass';
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = 'Arc';
            end
            else
            begin
               if (StrCompare(RES_Prefix, '%') == 0)
               begin
                  ResultText = LocalText('45#Defective');
               end
               else
               begin
                  if (RES_Value > RES_MaxResistance)
                  begin
                     ResultText = LocalText('12#Too high');
                  end
                  else
                  begin
                     ResultText = LocalText('13#Too low');
                  end;
               end;
            end;
            Style = 'teststepfail';
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
            Style = 'teststepfail';
         end;
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      if (RES_Arc)
      begin
         Value = '&nbsp:';
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      display_teststepcomment(RES_Comment, Style,
         RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

//Output commands for the command NoConnectionHVTwoLevels
template NoConnectionHVTwoLevels
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NC HV2L';
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            Style = 'teststeppass';
            ResultText = LocalText('5#Passed');
            FailText = '&nbsp;';
            Level2Value = TRUE;
         end;
         case TESTSTEP_Failed:
         begin
            Style = 'teststepfail';
            IsArc = RES_Level1Arc OR RES_Level2Arc;
            IsdIdt = RES_Level1dIdt OR RES_Level2dIdt;
            IsEnergyLimit = RES_Level1ELim OR RES_Level2ELim;
            IsShort = (NOT IsArc) AND (NOT IsdIdt) AND (NOT IsEnergyLimit);
            ResultText = get_hv_isolation_error_text(IsArc, IsdIdt, IsEnergyLimit);
            if (RES_Level1Error)
            begin
               FailText = 'Lvl1';
               Level2Value = FALSE;
            end
            else
            begin
               FailText = 'Lvl2';
               Level2Value = TRUE;
            end;
         end;
         default:
         begin
            Style = 'teststepfail';
            ResultText = LocalText('7#Invalid');
            FailText = '&nbsp;';
            Level2Value = FALSE;
         end;
      end;
      Value = 'Lvl1: ';
      if (RES_Level1Arc)
      begin
         ValueText = 'Arc';
      end
      else
      begin
         if (RES_Level1dIdt)
         begin
            ValueText = 'dIdt';
         end
         else
         begin
            if (RES_Level1ELim)
            begin
               ValueText = LocalText('164#Energy > 350 mJ');
            end
            else
            begin
               ValueText = get_resistance_value(RES_Level1Prefix, RES_Level1Value);
            end;
         end;
      end;
      Value = StrAdd(Value, ValueText);
      if (Level2Value)
      begin
         Value = StrAdd(Value, '  --  Lvl2: ');
         if (RES_Level2Arc)
         begin
            ValueText = 'Arc';
         end
         else
         begin
            if (RES_Level2dIdt)
            begin
               ValueText = 'dIdt';
            end
            else
            begin
               if (RES_Level2ELim)
               begin
                  ValueText = LocalText('164#Energy > 350 mJ');
               end
               else
               begin
                  ValueText = get_resistance_value(RES_Level2Prefix, RES_Level2Value);
               end;
            end;
         end;
         Value = StrAdd(Value, ValueText);
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      hvtwolevels_line_output(File, ResultText, Name, Pin1, Pin2, FailText, Value);
      display_short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
      display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

