//Output for the command AttenuatorTest
template AttenuatorTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('116#Attenuator');
   end
   else
   begin
      Name = RES_Name;
   end;
   switch (RES_Result)
   begin
      case TESTSTEP_Passed:
      begin
         ResultText = LocalText('5#Passed');
         Style = 'teststeppass';
      end;
      case TESTSTEP_Failed:
      begin
         ResultText = '';
         if (StrCompare(RES_Prefix, '%') == 0)
         begin
            ResultText = LocalText('45#Defective');
         end
         else
         begin
            if (RES_Value > RES_MaxAttenuation)
            begin
               ResultText = LocalText('12#Too high');
            end
            else
            begin
               if (RES_Value < RES_MinAttenuation)
               begin
                  ResultText = LocalText('13#Too low');
               end;
            end;
            if (RES_PolarityTest)
            begin
               if (NOT RES_PolarityOk)
               begin
                  if (StrCompare('', ResultText) == 0)
                  begin
                     ResultText = LocalText('44#Reversed');
                  end
                  else
                  begin
                     ResultText = StrAdd(ResultText, ' (');
                     ResultText = StrAdd(ResultText, LocalText('44#Reversed'));
                     ResultText = StrAdd(ResultText, ')');
                  end;
               end;
            end;
         end;
         Style = 'teststepfail';
      end;
      default:
      begin
         ResultText = LocalText('7#Invalid');
         Style = 'teststepfail';
      end;
   end;
   File = get_teststepimage(RES_Result, RES_ManualTest);
   Write('<TABLE Border=0 Width=640 class=');
   Write(Style);
   WriteLn('>');
   Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
   Write('<IMG SRC="');
   Write(File);
   WriteLn('" Width=16 Height=16>&nbsp;</TD>');
   Write('<TD Width=100 class=bold>');
   Write(ResultText);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   Write(Name);
   WriteLn('</TD>');
   Pin1 = get_pinname(RES_PinA1);
   Pin2 = get_pinname(RES_PinB1);
   Write('<TD Width=130>');
   Write(Pin1);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   Write(Pin2);
   WriteLn('</TD>');
   Value = get_attenuation_value(RES_Prefix, RES_Value);
   Write('<TD Align=RIGHT>');
   Write(Value);
   WriteLn('</TD></TR>');
   WriteLn('</TABLE>');
end;

//Output for the command NoConnectionHVCombi
template NoConnectionHVCombi
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NC HVCombi';
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
            Style = 'teststeppass';
         end;
         case TESTSTEP_Failed:
         begin
            IsArc = RES_HV1Arc OR RES_DBArc OR RES_HV2Arc;
            IsdIdt = RES_HV1dIdt OR RES_HV2dIdt;
            IsEnergyLimit = RES_HV1ELim OR RES_HV2ELim;
            ResultText = get_hv_isolation_error_text(IsArc, IsdIdt, IsEnergyLimit);
            Style = 'teststepfail';
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
            Style = 'teststepfail';
         end;
      end;
      DBValue = TRUE;
      HV2Value = RES_HV2Done;
      FailText = '&nbsp;';
      switch (RES_ErrorInfo)
      begin
         case HV_COMBI_HV1Error: begin
            FailText = 'HV1';
            DBValue = FALSE;
            HV2Value = FALSE;
         end;
         case HV_COMBI_DBError: begin
            FailText = 'DB';
            HV2Value = FALSE;
         end;
         case HV_COMBI_HV2Error: begin
            FailText = 'HV2';
         end;
         case HV_COMBI_HV1HV2Error: begin
            FailText = 'HV1/HV2';
         end;
      end;
      Value = 'HV1: ';
      if (RES_HV1Arc)
      begin
         ValueText = 'Arc';
      end
      else
      begin
         if (RES_HV1dIdt)
         begin
            ValueText = 'dIdt';
         end
         else
         begin
            if (RES_HV1ELim)
            begin
               ValueText = LocalText('164#Energy > 350 mJ');
            end
            else
            begin
               ValueText = get_resistance_value(RES_HV1Prefix, RES_HV1Value);
            end;
         end;
      end;
      Value = StrAdd(Value, ValueText);
      if (DBValue)
      begin
         Value = StrAdd(Value, '  --  DB: ');
         if (RES_DBArc)
         begin
            ValueText = 'Arc';
         end
         else
         begin
            ValueText = get_dielectric_breakdown_value(RES_DBArc, RES_DBValueValid,
               RES_DBValueIr, RES_DBPrefixIr, RES_DBValueIi, RES_DBPrefixIi);
         end;
         Value = StrAdd(Value, ValueText);
      end;
      if (HV2Value)
      begin
         Value = StrAdd(Value, '  --  HV2: ');
         if (RES_HV2Arc)
         begin
            ValueText = 'Arc';
         end
         else
         begin
            if (RES_HV2dIdt)
            begin
               ValueText = 'dIdt';
            end
            else
            begin
               if (RES_HV2ELim)
               begin
                  ValueText = LocalText('164#Energy > 350 mJ');
               end
               else
               begin
                  ValueText = get_resistance_value(RES_HV2Prefix, RES_HV2Value);
               end;
            end;
         end;
         Value = StrAdd(Value, ValueText);
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      hv_multi_step_line_output(File, ResultText, Name, Pin1, Pin2, FailText, Value);
      display_short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
      display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

//Output for the command NoConnAllHVCombi
template NoConnAllHVCombi
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NCA HVCombi';
   end
   else
   begin
      Name = RES_Name;
   end;
   Pin1 = get_pinname(RES_Pin);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Value = 'HV1: ';
      Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
      Value = StrAdd(Value, '  --  DB: ');
      Value = StrAdd(Value, get_dielectric_breakdown_value(RES_DBArc, RES_DBValueValid,
         RES_DBValueIr, RES_DBPrefixIr, RES_DBValueIi, RES_DBPrefixIi));
      if (RES_HV2Done)
      begin
         Value = StrAdd(Value, '  --  HV2: ');
         Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix, RES_HV2Value));
      end;
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      hv_multi_step_line_output(File, LocalText('5#Passed'), Name, Pin1, '&nbsp;',
         '&nbsp;', Value);
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      if (RES_ErrorInfo == HV_COMBI_HV1HV2Error)
      begin
         Value = 'HV1: ';
         Value = StrAdd(Value, get_resistance_value(RES_HV1Prefix, RES_HV1Value));
         Value = StrAdd(Value, '  --  DB: ');
         Value = StrAdd(Value, get_dielectric_breakdown_value(RES_DBArc,
            RES_DBValueValid, RES_DBValueIr, RES_DBPrefixIr, RES_DBValueIi,
            RES_DBPrefixIi));
         Value = StrAdd(Value, '  --  HV2: ');
         Value = StrAdd(Value, get_resistance_value(RES_HV2Prefix, RES_HV2Value));
         hv_multi_step_line_output(File, LocalText('16#Error'), Name, Pin1,
            get_pinname(PINADDRESS_NotSearched), 'HV1/HV2', Value);
      end
      else
      begin
         for Index = 1 to RES_ErrorPinCount do
         begin
            IsArc = RES_HVArcs[Index] OR RES_DBArcs[Index];
            IsdIdt = RES_HVdIdts[Index];
            IsEnergyLimit = RES_HVELims[Index];
            IsShort = (NOT IsArc) AND (NOT IsdIdt) AND (NOT IsEnergyLimit);
            ResultText = get_hv_isolation_error_text(IsArc, IsdIdt, IsEnergyLimit);
            Value = '&nbsp;';
            if (IsShort)
            begin
               if (RES_ErrorInfo == HV_COMBI_DBError)
               begin
                  Value = get_dielectric_breakdown_value(RES_DBArcs[Index],
                     RES_DBValuesValid[Index], RES_DBValuesIr[Index],
                     RES_DBPrefixesIr[Index], RES_DBValuesIi[Index],
                     RES_DBPrefixesIi[Index]);
               end
               else
               begin
                  Value = get_resistance_value(RES_HVPrefixes[Index], RES_HVValues[Index]);
               end;
            end;
            Pin2 = get_pinname(RES_ErrorPins[Index]);
            FailText = '';
            switch (RES_ErrorInfo)
            begin
               case HV_COMBI_HV1Error: begin
                  FailText = 'HV1';
               end;
               case HV_COMBI_DBError: begin
                  FailText = 'DB';
               end;
               case HV_COMBI_HV2Error: begin
                  FailText = 'HV2';
               end;
            end;
            hv_multi_step_line_output(File, ResultText, Name, Pin1, Pin2,
               FailText, Value);
         end;
      end;
   end;
   display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

