//Output for the command ResistorTest
template ResistorTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('14#Resistor');
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
            Style = 'teststeppass';
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = 'Arc';
            end
            else
            begin
               if (StrCompare(RES_Prefix, '%') == 0)
               begin
                  ResultText = LocalText('45#Defective');
               end
               else
               begin
                  if (RES_Value > RES_MaxResistance)
                  begin
                     ResultText = LocalText('12#Too high');
                  end
                  else
                  begin
                     ResultText = LocalText('13#Too low');
                  end;
               end;
            end;
            Style = 'teststepfail';
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
            Style = 'teststepfail';
         end;
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      if (RES_Arc)
      begin
         Value = '&nbsp:';
      end
      else
      begin
         Value = get_resistance_value(RES_Prefix, RES_Value);
      end;
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      display_teststepcomment(RES_Comment, Style,
         RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

