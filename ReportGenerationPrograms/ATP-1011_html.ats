            Pin2 = get_pinname(RES_ErrorLowPins[Index]);
         end;
         Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
         Write('<IMG SRC="');
         Write(File);
         WriteLn('" Width=16 Height=16>&nbsp;</TD>');
         Write('<TD Width=100 class=bold>');
         Write(ResultText);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Name);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin1);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin2);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
      display_short_to_lower_voltage_level(RES_ShortToLowerVoltageLevel);
   end;
   display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

//Output for the command ParamContinuity
template ParamContinuity
begin
   Line = '';
   if (RES_CurrentChanged)
   begin
      Value = FormatCurrent(RES_CCurrent);
      Line = StrAdd(Line, LocalText('51#Current'));
      Line = StrAdd(Line, '=');
      Line = StrAdd(Line, Value);
      Line = StrAdd(Line, '; ');
   end;
   if (RES_ThresholdChanged)
   begin
      Value = FormatResistance(RES_CThreshold);
      Line = StrAdd(Line, LocalText('52#Threshold'));
      Line = StrAdd(Line, '=');
      Line = StrAdd(Line, Value);
      Line = StrAdd(Line, '; ');
   end;
   if (RES_TriseChanged)
   begin
      Value = FormatTime(RES_CTrise);
      Line = StrAdd(Line, LocalText('53#Trise'));
      Line = StrAdd(Line, '=');
      Line = StrAdd(Line, Value);
      Line = StrAdd(Line, '; ');
   end;
   if (RES_TwaitChanged)
   begin
      Value = FormatTime(RES_CTwait);
      Line = StrAdd(Line, LocalText('54#Twait'));
      Line = StrAdd(Line, '=');
      Line = StrAdd(Line, Value);
      Line = StrAdd(Line, '; ');
   end;
   if (RES_TmeasChanged)
   begin
      Value = FormatTime(RES_CTmeas);
      Line = StrAdd(Line, LocalText('55#Tmeas'));
      Line = StrAdd(Line, '=');
      Line = StrAdd(Line, Value);
      Line = StrAdd(Line, '; ');
   end;
   if (RES_AutoRangeChanged)
   begin
      if (RES_CAutoRange)
      begin
         Value = LocalText('56#On');
      end
      else
      begin
         Value = LocalText('57#Off');
      end;
      Line = StrAdd(Line, LocalText('58#Auto ranging'));
      Line = StrAdd(Line, '=');
      Line = StrAdd(Line, Value);
      Line = StrAdd(Line, '; ');
   end;
   if (RES_VoltageLimitChanged)
   begin
      Value = FormatVoltage(RES_CVoltageLimit);
      Line = StrAdd(Line, LocalText('59#Voltage limit'));
      Line = StrAdd(Line, '=');
      Line = StrAdd(Line, Value);
      Line = StrAdd(Line, '; ');
   end;
   if (StrCompare(Line, '') <> 0)
   begin
      Pos = StrLength(Line) - 1;
      Line = StrDelete(Line, Pos, 2);
      WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD class=bold>');
      Write(LocalText('60#Parameters for continuity test'));
      WriteLn('</TD></TR>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(Line);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;
end;

