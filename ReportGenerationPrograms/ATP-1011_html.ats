//Output for the command NoConnectionHV
template NoConnectionHV
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'NC HV';
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
            Style = 'teststeppass';
         end;
         case TESTSTEP_Failed:
         begin
            ResultText = get_hv_isolation_error_text(RES_Arc, RES_dIdt, RES_ELim);
            Style = 'teststepfail';
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
            Style = 'teststepfail';
         end;
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      Value = '&nbsp;';
      IsShort = (NOT RES_Arc) AND (NOT RES_dIdt) AND (NOT RES_ELim);
      if (IsShort)
      begin
         if (RES_HVUseIThreshold)
         begin
            Value = get_current_value(RES_IPrefix, RES_IValue);
         end
         else
         begin
            Value = get_resistance_value(RES_Prefix, RES_Value);
         end;
      end;
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      display_teststepcomment(RES_Comment, Style,
         RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

