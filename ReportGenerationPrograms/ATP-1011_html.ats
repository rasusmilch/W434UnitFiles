         Write('<TD Width=130>');
         Write(Pin1);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin2);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
   end;
   display_teststepcomment(RES_Comment, Style,
      RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

//Output for ReportWriteNormal
template ReportWriteNormal
begin
   if (NOT report_write_teststep(RES_Text, TRUE))
   begin
      WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(RES_Text);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;
end;

//Output for ReportWriteError
template ReportWriteError
begin
   if (NOT report_write_teststep(RES_Text, FALSE))
   begin
      WriteLn('<TABLE Border=0 Width=640 class=teststepfail>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(RES_Text);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;
end;

//Output for ReportWriteTag
template ReportWriteTag
begin
   Tag = RES_Tag;
   if (StrPosition('Image', Tag) == 1)
   begin
      ImageWidth = 0;
      ImageHeight = 0;
      if (report_write_tag_get_image_size(RES_Tag, ImageWidth, ImageHeight))
      begin
         Tag = 'Image';
      end;
   end;
   switch (Tag)
   begin
      case 'Headline': begin
         WriteLn('<TABLE Border=0 Width=640 class=teststeppass >');
         WriteLn('<TR><TD Width=640 Align=CENTER VAlign=Middle bgcolor="#0000FF">');
         Write(RES_Text);
         WriteLn('</TD></TR>');
         WriteLn('</TABLE>');
      end;
      case 'HeadlineFF': begin
         WriteLn('<TABLE Border=0 Width=640 class=teststeppass style="page-break-before:always">');
         WriteLn('<TR><TD Width=640 Align=CENTER VAlign=Middle bgcolor="#0000FF">');
         Write(RES_Text);
         WriteLn('</TD></TR>');
         WriteLn('</TABLE>');
      end;
      case 'Warning': begin
         WriteLn('<TABLE Border=0 Width=640 class=teststeppass >');
         WriteLn('<TR><TD Width=640 Align=LEFT VAlign=Middle bgcolor="#FFFF00">');
         Write(RES_Text);
         WriteLn('</TD></TR>');
         WriteLn('</TABLE>');
      end;
      case 'Image': begin
         insert_image(RES_Text, ImageWidth, ImageHeight);
      end;
      default: begin
         WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
         WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
         Write('<TD>');
         Write(RES_Text);
         WriteLn('</TD></TR>');
         WriteLn('</TABLE>');
      end;
   end;
end;

//Output commands for the command ReportWriteStrings
template ReportWriteStrings
begin
   WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
   WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
   Write('<TD>');
   Write(RES_Text);
   WriteLn('</TD></TR>');
   for Index = 1 to RES_StringCount do
   begin
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(RES_Strings[Index]);
      WriteLn('</TD></TR>');
   end;
   WriteLn('</TABLE>');
end;


//Output for the command VoltageTest
template VoltageTest
begin
   switch (RES_Result)
   begin
      case TESTSTEP_Passed:
      begin
         ResultText = LocalText('5#Passed');
         Style = 'teststeppass';
      end;
      case TESTSTEP_Failed:
      begin
         if (RES_Value > RES_MaxVoltage)
         begin
            ResultText = LocalText('12#Too high');
         end
         else
         begin
            ResultText = LocalText('13#Too low');
         end;
         Style = 'teststepfail';
      end;
      default:
      begin
         ResultText = LocalText('7#Invalid');
         Style = 'teststepfail';
      end;
   end;
   File = get_teststepimage(RES_Result, RES_ManualTest);
   Write('<TABLE Border=0 Width=640 class=');
   Write(Style);
   WriteLn('>');
   Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
   Write('<IMG SRC="');
   Write(File);
   WriteLn('" Width=16 Height=16>&nbsp;</TD>');
   Write('<TD Width=100 class=bold>');
   Write(ResultText);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   if (StrCompare('', RES_Name) == 0)
   begin
      Write(LocalText('48#Voltage'));
   end
   else
   begin
      Write(RES_Name);
   end;
   WriteLn('</TD>');
   Pin1 = get_pinname(RES_Pin1);
   Pin2 = get_pinname(RES_Pin2);
   Write('<TD Width=130>');
   Write(Pin1);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   Write(Pin2);
   WriteLn('</TD>');
   Value = get_voltage_value(RES_Prefix, RES_Value);
   Write('<TD Align=RIGHT>');
   Write(Value);
   WriteLn('</TD></TR>');
   display_teststepcomment(RES_Comment, Style,
      RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

