template ManualTestProbe
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('82#Probe in manual test:');
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_PinCount > 0)
   begin
      PinCount = 0;
      PinsPerLine = 4;

      WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
      Write('<TR>');
      Write('<TH Width=640 Align=Left VAlign=Middle>');
      Write(Name);
      Write('</TH>');
      WriteLn('</TR>');
      WriteLn('</Table>');
      
      WriteLn('<Table Border=0 Width=640 class=teststeppass>');
      WriteLn('<TR>');
      for Count = 1 to RES_PinCount do
      begin
         PinCount = PinCount + 1;
         Write('<TD Width=160 Align=Left VAlign=Middle>');
         Write(get_pinname(RES_Pins[Count]));
         WriteLn('</TD>');
         if (PinCount == PinsPerLine)
         begin
            PinCount = 0;
            WriteLn('</TR>');
            if (Count < RES_PinCount)
            begin
               WriteLn('<TR>');
            end;
         end;
      end;
      if (PinCount <> 0)
      begin
         WriteLn('</TR>');
      end;
      WriteLn('</TABLE>');
      WriteLn('<BR>');
   end;
end;

//Output for the command OFAttenuationTest
template OFAttenuationTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('111#Optical fiber');
   end
   else
   begin
      Name = RES_Name;
   end;
   switch (RES_Result)
   begin
      case TESTSTEP_Passed:
      begin
         ResultText = LocalText('5#Passed');
         Style = 'teststeppass';
      end;
      case TESTSTEP_Failed:
      begin
         if (StrCompare(RES_Prefix, '%') == 0)
         begin
            ResultText = LocalText('45#Defective');
         end
         else
         begin
            if (RES_Value > RES_MaxAttenuation)
            begin
               ResultText = LocalText('12#Too high');
            end
            else
            begin
               ResultText = LocalText('13#Too low');
            end;
         end;
         Style = 'teststepfail';
      end;
      default:
      begin
         ResultText = LocalText('7#Invalid');
         Style = 'teststepfail';
      end;
   end;
   File = get_teststepimage(RES_Result, RES_ManualTest);
   Write('<TABLE Border=0 Width=640 class=');
   Write(Style);
   WriteLn('>');
   Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
   Write('<IMG SRC="');
   Write(File);
   WriteLn('" Width=16 Height=16>&nbsp;</TD>');
   Write('<TD Width=100 class=bold>');
   Write(ResultText);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   Write(Name);
   WriteLn('</TD>');
   Pin1 = get_optical_pinname(RES_Pin1);
   Pin2 = get_optical_pinname(RES_Pin2);
   Write('<TD Width=130>');
   Write(Pin1);
   WriteLn('</TD>');
   Write('<TD Width=130>');
   Write(Pin2);
   WriteLn('</TD>');
   Value = get_attenuation_value(RES_Prefix, RES_Value);
   Write('<TD Align=RIGHT>');
   Write(Value);
   WriteLn('</TD></TR>');
   display_teststepcomment(RES_Comment, Style, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

//Output for the command OFPinScan
template OFPinScan
begin
   Pin1 = get_optical_pinname(RES_Pin);
   Name = 'PinScan';
   WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
   File = get_teststepimage(2, TRUE);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Value = '&nbsp;';
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write('&nbsp;');
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>&nbsp;</TD>');
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
   end
   else
   begin
      for Index = 1 to RES_ErrorPinCount do
      begin
         Pin2 = get_optical_pinname(RES_ErrorPins[Index]);
         Value = '&nbsp;';
         Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
         Write('<IMG SRC="');
         Write(File);
         WriteLn('" Width=16 Height=16>&nbsp;</TD>');
         Write('<TD Width=100 class=bold>');
         Write(LocalText('17#Found'));
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Name);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin1);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin2);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
   end;
   WriteLn('</TABLE>');
end;

//Output for the command WireTestAnalysis
template WireTestAnalysis
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = LocalText('8#Wire');
   end
   else
   begin
      Name = RES_Name;
   end;
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
            Style = 'teststeppass';
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = 'Arc';
            end
            else
            begin
               ResultText = LocalText('6#Open');
            end;
            Style = 'teststepfail';
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
            Style = 'teststepfail';
         end;
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      Value = get_resistance_value(RES_Prefix, RES_Value);
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      if (RES_Result == TESTSTEP_Failed)
      begin
         //Write results of continuity analysis
         for Network = 1 to RES_NetworkCount do
         begin
            for Index = 1 to RES_NetworkPinCount[Network] do
            begin
               Write('<TR><TD Width=20>&nbsp;</TD><TD>&nbsp;</TD><TD>&nbsp;</TD><TD>');
               Write(get_pinname(RES_NetworkPins[Network, Index]));
               WriteLn('</TD><TD>&nbsp;</TD><TD>&nbsp;</TD></TD></TR>');
            end;
            Write('<TR><TD Width=20>&nbsp;</TD><TD>&nbsp;</TD><TD>');
            if (Network < RES_NetworkCount)
            begin
               if (RES_ValuesToNextNWArc[Network])
               begin
                  Write('Arc');
               end
               else
               begin
                  Write(get_resistance_value(RES_ValuesToNextNWPrefix[Network], RES_ValuesToNextNW[Network]));
               end;
               Write('</TD><TD>&nbsp;</TD><TD>&nbsp;</TD><TD>&nbsp;</TD>');
            end;
            WriteLn('</TR>');
         end;
         //Write results of LV isolation analysis
         for Network = 1 to RES_NetworkCount do
         begin
            if (RES_NCAExecuted[Network])
            begin
               if (RES_ShortCount[Network] == 0)
               begin
                  Write('<TR><TD Width=20 class=teststeppass>&nbsp;</TD><TD class=teststeppass>');
                  Write('NCA');
                  Write('</TD><TD class=teststeppass>&nbsp;</TD><TD class=teststeppass>');
                  Pin = get_pinname(RES_NetworkPins[Network, 1]);
                  Write(Pin);
                  Write('</TD><TD class=teststeppass>&nbsp;</TD><TD class=teststeppass>');
                  Value = get_resistance_value(RES_NCAValuesPrefix[Network], RES_NCAValues[Network]);
                  Write(Value);
                  WriteLn('</TD></TR>');
               end
               else
               begin
                  Pin1 = get_pinname(RES_NetworkPins[Network, 1]);
                  for Index = 1 to RES_ShortCount[Network] do
                  begin
                     Write('<TR><TD Width=20>&nbsp;</TD><TD>');
                     Write(LocalText('43#Short'));
                     Write('</TD><TD>&nbsp;</TD><TD>');
                     Write(Pin1);
                     Write('</TD><TD>');
                     Pin2 = get_pinname(RES_Shorts[Network, Index]);
                     Write(Pin2);
                     Write('</TD><TD>');
                     if (RES_ShortArcs[Network, Index])
                     begin
                        Value = 'Arc';
                     end
                     else
                     begin
                        Value = get_resistance_value(RES_ShortPrefixes[Network, Index], RES_ShortValues[Network, Index]);
                     end;
                     Write(Value);
                     WriteLn('</TD></TR>');
                  end;
               end;
            end;
         end;
      end;
      WriteLn('</TABLE>');
   end;
end;

//Output commands for the command ReportWriteMeasurementParameters
template ReportWriteMeasurementParameters
begin
   Text = '';
   Parameters = '';
   switch (RES_CommandGroup)
   begin
      case CMDGRP_Continuity: begin
         Text = LocalText('60#Parameters for continuity test');
         Parameters = get_continuity_parameters_text(RES_CCurrent,
                         RES_CThreshold, RES_CTrise, RES_CTwait, RES_CTmeas,
                         RES_CAutoRange, RES_CVoltageLimit);
      end;
      case CMDGRP_IsolationLV: begin
         Text = LocalText('65#Parameters for LV isolation test');
         Parameters = get_isolationlv_parameters_text(RES_LVVoltage,
                         RES_LVThreshold, RES_LVTrise, RES_LVTwait, RES_LVTmeas,
                         RES_LVAutoRange, RES_LVCurrentLimit,
                         RES_LVTmeasReduction);
      end;
      case CMDGRP_IsolationHV: begin
         if (ParamGetIsolationHV(PARAM_IsolationHVValid))
         begin
            Text = LocalText('67#Parameters for HV isolation test');
            Parameters = get_isolationhv_parameters_text(RES_HVVoltage,
                            RES_HVThreshold, RES_HVIThreshold, RES_HVTrise,
                            RES_HVTwait, RES_HVTmeas, RES_HVAutoRange,
                            RES_HVCurrentLimit, RES_HVTmeasReduction,
                            RES_HVTmeasFactor, RES_HVVoltageRamp,
                            RES_HVUseIThreshold);
         end;
      end;
      case CMDGRP_DielectricBreakdown: begin
         if (ParamGetDielectricBreakdown(PARAM_DielectricBreakdownValid))
         begin
            Text = LocalText('68#Parameters for dielectric breakdown test');
            Parameters = get_dielectricbreakdown_parameters_text(RES_DBVoltage,
                            RES_DBTrise, RES_DBTwait, RES_DBTmeas,
                            RES_DBTmeasFactor, RES_DBVoltageRamp,
                            RES_DBThresholdIr, RES_DBThresholdIi);
         end;
      end;
   end;
   if (StrCompare('Parameters', '') <> 0)
   begin
      WriteLn('<TABLE Border=0 Width=640 class=header>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD class=bold>');
      Write(Text);
      WriteLn('</TD></TR>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(Parameters);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
      WriteLn('<BR>');
   end;
end;

//Output for the command CANRxTest
template CANRxTest
begin
   if (StrCompare('', RES_Name) == 0)
   begin
      Name = 'CANRxTest';
   end
   else
   begin
      Name = RES_Name;
   end;
   switch (RES_Result)
   begin
      case TESTSTEP_Passed:
      begin
         ResultText = LocalText('5#Passed');
         Style = 'teststeppass';
      end;
      case TESTSTEP_Failed:
      begin
         ResultText = LocalText('114#Failed');
         Style = 'teststepfail';
      end;
      default:
      begin
         ResultText = LocalText('7#Invalid');
         Style = 'teststepfail';
      end;
   end;

   File = get_teststepimage(RES_Result, RES_ManualTest);
   Write('<TABLE Border=0 Width=640 class=');
   Write(Style);
   WriteLn('>');
   Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
   Write('<IMG SRC="');
   Write(File);
   WriteLn('" Width=16 Height=16>&nbsp;</TD>');
   Write('<TD Width=100 class=bold>');
   Write(ResultText);
   WriteLn('</TD>');
   Write('<TD Width>');
   Write(Name);
   WriteLn('</TABLE>');
end;

