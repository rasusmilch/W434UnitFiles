//Output for the command NoConnectionDB
template NoConnectionDB
begin
   Name = get_teststep_name(RES_Name, LocalText('251#NC DB'));
   if (RES_ExtVoltageFound)
   begin
      external_voltage_error(Name, RES_ExtVoltagePin1, RES_ExtVoltagePin2,
         RES_ExtVoltageValue, RES_ExtVoltagePrefix);
   end
   else
   begin
      switch (RES_Result)
      begin
         case TESTSTEP_Passed:
         begin
            ResultText = LocalText('5#Passed');
            Style = 'teststeppass';
         end;
         case TESTSTEP_Failed:
         begin
            if (RES_Arc)
            begin
               ResultText = LocalText('202#Arc');
            end
            else
            begin
               ResultText = LocalText('15#Short');
            end;
            Style = 'teststepfail';
         end;
         default:
         begin
            ResultText = LocalText('7#Invalid');
            Style = 'teststepfail';
         end;
      end;
      File = get_teststepimage(RES_Result, RES_ManualTest);
      Write('<TABLE Border=0 Width=640 class=');
      Write(Style);
      WriteLn('>');
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Pin1 = get_pinname(RES_Pin1);
      Pin2 = get_pinname(RES_Pin2);
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin2);
      WriteLn('</TD>');
      Value = get_dielectric_breakdown_value(RES_Arc, RES_ValueValid, RES_ValueIr, RES_PrefixIr,
         RES_ValueIi, RES_PrefixIi);
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
      display_teststepcomment(RES_Comment, Style,
         RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
      WriteLn('</TABLE>');
   end;
end;

//Output for the command NoConnAllDB
template NoConnAllDB
begin
   Name = get_teststep_name(RES_Name, LocalText('252#NCA DB'));
   Pin1 = get_pinname(RES_Pin);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      Value = get_dielectric_breakdown_value(RES_Arc, RES_ValueValid, RES_ValueIr, RES_PrefixIr,
         RES_ValueIi, RES_PrefixIi);
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(LocalText('5#Passed'));
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin1);
      WriteLn('</TD>');
      Write('<TD Width=130>&nbsp;</TD>');
      Write('<TD Align=RIGHT>');
      Write(Value);
      WriteLn('</TD></TR>');
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      for Index = 1 to RES_ErrorPinCount do
      begin
         Pin2 = get_pinname(RES_ErrorPins[Index]);
         Value = get_dielectric_breakdown_value(RES_Arcs[Index], RES_ValuesValid[Index],
            RES_ValuesIr[Index], RES_PrefixesIr[Index], RES_ValuesIi[Index], RES_PrefixesIi[Index]);
         if (RES_Arcs[Index])
         begin
            ResultText = LocalText('202#Arc');
         end
         else
         begin
            ResultText = LocalText('15#Short');
         end;
         Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
         Write('<IMG SRC="');
         Write(File);
         WriteLn('" Width=16 Height=16>&nbsp;</TD>');
         Write('<TD Width=100 class=bold>');
         Write(ResultText);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Name);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin1);
         WriteLn('</TD>');
         Write('<TD Width=130>');
         Write(Pin2);
         WriteLn('</TD>');
         Write('<TD Align=RIGHT>');
         Write(Value);
         WriteLn('</TD></TR>');
      end;
   end;
   display_teststepcomment(RES_Comment, Style,
      RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

