//Funktionen für den Test auf dielektrischen Durchschlag, sind die Funktionen,
//bei denen die AC-Parameter für die Messung verwendet werden.

//Dielectric breakdown test functions are those, for which the AC parameters are used


//Output for the command ParamDielectricBreakdown
template ParamDielectricBreakdown
begin
   Line = '';
   if (RES_VoltageChanged)
   begin
      Value = FormatVoltage(RES_DBVoltage);
      Line = StrAdd(Line, LocalText('61#Voltage'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TriseChanged)
   begin
      Value = FormatTime(RES_DBTrise);
      Line = StrAdd(Line, LocalText('53#Trise'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TwaitChanged)
   begin
      Value = FormatTime(RES_DBTwait);
      Line = StrAdd(Line, LocalText('54#Twait'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TmeasChanged)
   begin
      Value = FormatTime(RES_DBTmeas);
      Line = StrAdd(Line, LocalText('55#Tmeas'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_TmeasFactorChanged)
   begin
      Value = RES_DBTmeasFactor;
      Line = StrAdd(Line, LocalText('64#Tmeas fact.'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_VoltageRampChanged)
   begin
      Value = FormatVoltageRamp(RES_DBVoltageRamp);
      Line = StrAdd(Line, LocalText('66#Voltage ramp'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_FrequencyChanged)
   begin
      Value = StrAdd(RES_DBFrequency, 'Hz');
      Line = StrAdd(Line, LocalText('79#Frequency'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_ThresholdIrChanged)
   begin
      Value = FormatCurrent(RES_DBThresholdIr);
      Line = StrAdd(Line, LocalText('80#Threshold (Ir)'));
      Line = Line + '=' + Value + '; ';
   end;
   if (RES_ThresholdIiChanged)
   begin
      Value = FormatCurrent(RES_DBThresholdIi);
      Line = StrAdd(Line, LocalText('81#Threshold (Ii)'));
      Line = Line + '=' + Value + '; ';
   end;
   if (StrCompare(Line, '') <> 0)
   begin
      Pos = StrLength(Line) - 1;
      Line = StrDelete(Line, Pos, 2);
      WriteLn('<TABLE Border=0 Width=640 class=teststeppass>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD class=bold>');
      Write(LocalText('68#Parameters for dielectric breakdown test'));
      WriteLn('</TD></TR>');
      WriteLn('<TR><TD Width=20 Align=CENTER VAlign=Middle>&nbsp;</TD>');
      Write('<TD>');
      Write(Line);
      WriteLn('</TD></TR>');
      WriteLn('</TABLE>');
   end;
end;

