function write_isolationhvtwolevels_result(TestStepResult: integer): void;
begin
   Line = '<TestStepResult Type="IsolationHVTwoLevels">';
   write_line(Line);
   inc_indent();
   switch (TestStepResult)
   begin
      case TESTSTEP_Passed:
      begin
         Text = 'Passed';
      end;
      case TESTSTEP_Failed:
      begin
         Text = 'Failed';
      end;
      default: begin
         Text = 'Invalid';
      end;
   end;
   Line = '<Result>' + Text + '</Result>';
   write_line(Line);
   dec_indent();
   write_line('</TestStepResult>');
end;


//Output for the command ParamIsolationHVFirstLevel
template ParamIsolationHVFirstLevel
begin
   write_line('<TestStep Cmd="ParamIsolationHVFirstLevel">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_isolationhv_parameters(RES_HVFLVoltage, RES_HVFLThreshold, RES_HVFLUseIThreshold, RES_HVFLIThreshold,
      RES_HVFLTrise, RES_HVFLTwait, RES_HVFLTmeas, RES_HVFLAutoRange, RES_HVFLCurrentLimit, RES_HVFLTmeasReduction,
      RES_HVFLTmeasFactor, RES_HVFLVoltageRamp, RES_HVFLdIdtEnabled, RES_HVFLdIdtCurrentThreshold,
      RES_HVFLdIdtTimeThreshold, 'IsolationHVFirstLevel');
   dec_indent();
   write_line('</TestStep>');
end;

template NoConnectionHVTwoLevels
begin
   write_line('<TestStep Cmd="NoConnectionHVTwoLevels">');
   inc_indent();
   write_teststep_basics(RES_FileIndex, RES_StartLine, RES_ModuleFileIndex, RES_ModuleLine);
   write_teststep_comment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   write_two_pin_basics(RES_Name, RES_Pin1, RES_Pin2, RES_OriginalPin1, RES_OriginalPin2);
   write_isolationhv_parameters(RES_HVVoltage, RES_HVThreshold, RES_HVUseIThreshold, RES_HVIThreshold,
      RES_HVTrise, RES_HVTwait, RES_HVTmeas, RES_HVAutoRange, RES_HVCurrentLimit, RES_HVTmeasReduction,
      RES_HVTmeasFactor, RES_HVVoltageRamp, RES_HVdIdtEnabled, RES_HVdIdtCurrentThreshold,
      RES_HVdIdtTimeThreshold);
   write_isolationhv_parameters(RES_HVFLVoltage, RES_HVFLThreshold, RES_HVFLUseIThreshold, RES_HVFLIThreshold,
      RES_HVFLTrise, RES_HVFLTwait, RES_HVFLTmeas, RES_HVFLAutoRange, RES_HVFLCurrentLimit, RES_HVFLTmeasReduction,
      RES_HVFLTmeasFactor, RES_HVFLVoltageRamp, RES_HVFLdIdtEnabled, RES_HVFLdIdtCurrentThreshold,
      RES_HVFLdIdtTimeThreshold, 'IsolationHVFirstLevel');

   write_isolationhvtwolevels_result(RES_Result);

   dec_indent();
   write_line('</TestStep>');
end;

