//Output commands for the command LV_ConnectorDetectionTest
template LV_ConnectorDetectionTest
begin
   Name = get_teststep_name(RES_Name, LocalText('268#CON DET'));
   Pin = get_lv_pinname(RES_Pin);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      Style = 'teststeppass';
      WriteLn(StrAdd(Style, '>'));
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      Write(LocalText('5#Passed'));
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin);
      WriteLn('</TD>');
      Write('<TD Width=130>&nbsp;</TD>');
      Write('<TD Align=RIGHT>&nbsp;</TD>');
      WriteLn('</TR>');
   end
   else
   begin
      Style = 'teststepfail';
      WriteLn(StrAdd(Style, '>'));
      Write('<TR><TD Width=20 Align=CENTER VAlign=Middle>');
      Write('<IMG SRC="');
      Write(File);
      WriteLn('" Width=16 Height=16>&nbsp;</TD>');
      Write('<TD Width=100 class=bold>');
      if (RES_On)
      begin
         ResultText = LocalText('57#Off');
      end
      else
      begin
         ResultText = LocalText('56#On');
      end;
      Write(ResultText);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Name);
      WriteLn('</TD>');
      Write('<TD Width=130>');
      Write(Pin);
      WriteLn('</TD>');
      Write('<TD Width=130>&nbsp;</TD>');
      Write('<TD Align=RIGHT>&nbsp;</TD>');
      WriteLn('</TR>');
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;

//Output commands for the command LV_DetectionTest
template LV_DetectionTest
begin
   Name = get_teststep_name(RES_Name, LocalText('269#DET'));
   Pin1 = get_lv_pinname(RES_Pin1);
   Pin2 = get_lv_pinname(RES_Pin2);
   Write('<TABLE Border=0 Width=640 class=');
   File = get_teststepimage(RES_Result, RES_ManualTest);
   if (RES_Result == TESTSTEP_Passed)
   begin
      WriteLn('teststeppass>');
      ResultText = LocalText('5#Passed');
      write_default_table_line(File, ResultText, Name, Pin1, Pin2);
   end
   else
   begin
      WriteLn('teststepfail>');
      if (RES_On)
      begin
         ResultText = LocalText('57#Off');
      end
      else
      begin
         ResultText = LocalText('56#On');
      end;
      write_default_table_line(File, ResultText, Name, Pin1, Pin2);
   end;
   display_teststepcomment(RES_Comment, RES_DeclaredAsPassed, RES_DeclaredAsPassedByUser);
   WriteLn('</TABLE>');
end;
