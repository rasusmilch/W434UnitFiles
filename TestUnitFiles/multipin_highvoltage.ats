{**
 @brief Run a dielectric-breakdown 'no-connection' test on POPULATED and UNPOPULATED contacts.

 @details
 Executes two dielectric-breakdown (DB) passes using no_conn_db_list():
 1) POPULATED contacts obtained from the primary netlist (WIRES ONLY!), then
 2) UNPOPULATED contacts computed as the set difference of all defined pins and all wired pins.

 The routine:
 - Adds visual spacing and section headers to the UI.
 - Builds pin lists by tokenizing semicolon-delimited strings.
 - Applies DB timing via ParamDielectricBreakdown() using @p Twait and @p Tmeas.
 - Records the active measurement parameters under CMDGRP_IsolationDB.
 - Invokes no_conn_db_list() for both pin sets, forwarding @p Description for report/log traceability.

 @param Description  Human-readable label/identifier forwarded to no_conn_db_list() for consistent reporting.
 @param Twait        Wait time before the DB measurement window (default 1s).
 @param Tmeas        Duration of the DB measurement window (default 1s).

 @return void

 @pre
 - Helper routines/identifiers are available: blank_line(), msg_box_border(), get_netlist_primary(),
   get_named_pin_list_all(), get_netlist_both(), MiscListFromString(), MiscSubtractLists(),
   ParamDielectricBreakdown(), ReportWriteMeasurementParameters(), no_conn_db_list(), CMDGRP_IsolationDB.
 - Variables/handles exist and are compatible with the helpers:
   PopulatedPinListStr, PopulatedPinList, AllPinsListStr, AllWireListStr,
   FullPinList, WirePinList, UnconnectedPinList.
 - @p Twait and @p Tmeas are valid for ParamDielectricBreakdown().

 @sideeffects
 - Produces UI/report output (headers and parameter blocks).
 - Updates dielectric-breakdown configuration via ParamDielectricBreakdown().
 - Initiates DB testing that may stress the UUT at high voltage.

 @note
 - UNPOPULATED pins are computed as: UnconnectedPinList = FullPinList - WirePinList.
 - Pin-list strings are expected to be semicolon-delimited (';').

 @see no_conn_db, ParamDielectricBreakdown, MiscListFromString, MiscSubtractLists,
      get_netlist_primary, get_named_pin_list_all, get_netlist_both
}
function no_conn_db_populated(Description: string = 'NCA DB'; Twait: ttime = 1s; Tmeas: ttime = 1s): void;
begin
   blank_line(); // Visual spacer before the POPULATED contacts section

   test_db_option();

   msg_box_border('Testing contacts -CONTAINED- in netlist', '*'); // Section header for POPULATED pins

   // NOTE: This only gathers WIRE pins, not other components.
   PopulatedPinListStr = get_netlist_primary(); // Acquire semicolon-delimited primary-netlist pins
   MiscListFromString(PopulatedPinListStr,PopulatedPinList,';'); // Tokenize into PopulatedPinList

   no_conn_db_list(Description, PopulatedPinList); // Execute dielectric-breakdown test on POPULATED pins with label

   blank_line(); // Spacer between sections
   msg_box_border('Testing contacts -NOT- in netlist', '*'); // Section header for UNPOPULATED pins

   ParamDielectricBreakdown(PARAM_DontChange, PARAM_DontChange, Twait, Tmeas); // Apply DB timing (wait/measure)

//   ReportWriteMeasurementParameters(CMDGRP_IsolationDB); // Log active DB parameters for traceability

   AllPinsListStr = get_named_pin_list_all(); // Retrieve all defined pins (fixture/connector scope)

   AllWireListStr = get_netlist_both(); // Retrieve all wired pins/ends from the combined netlist

   MiscListFromString(AllPinsListStr,FullPinList,';'); // Tokenize full pin inventory
   MiscListFromString(AllWireListStr,WirePinList,';'); // Tokenize wired-pin inventory

   // Compute Unconnected pins by removing netlist wires from the full list
   MiscSubtractLists(UnconnectedPinList, FullPinList, WirePinList); // Unconnected = FullPinList - WirePinList

   no_conn_db_list(Description, UnconnectedPinList); // Execute dielectric-breakdown test on UNPOPULATED pins with same label
end;

{**
  @brief Execute low-voltage “no-connection” guard checks across a list of pins.

  @param Description  Human-readable context string forwarded to the per-pin guard routine.
  @param PinList      Array of pins to evaluate for unintended low-voltage connectivity.

  @return void

  @details
  For each pin in PinList, this routine invokes the low-voltage isolation guard
  (no-connection check). It tracks an aggregate success flag (AllPassed), marking
  it FALSE on any failing subtest. Optional UI echoes of the pin count and the
  current pin under test are present but commented out.

  @pre MiscGetListSize, PinGetData, no_conn_all_lv_guard, and UIWriteNormal exist.
  @post Aggregate success is recorded in AllPassed; callers may inspect it if in scope.
**}
function no_conn_lv_list(Description: string; PinList: tpinarray): void;
begin
   // Initialize aggregate pass flag; assume success until a failure occurs.
   AllPassed = TRUE;

   // Determine how many pins are in the provided list.
   Count = MiscGetListSize(PinList);
   //UIWriteNormal(Count)

   // Run the low-voltage no-connection guard across each listed pin (if any).
   if (Count >= 1)
   begin
      // Iterate over each pin to evaluate isolation.
      for Index = 1 to Count do
      begin
         // Fetch a friendly pin name for optional logging/diagnostics.
         PinName = PinGetData(PinList[Index], PIN_Name);
         //UIWriteNormal(PinName)
         // Invoke the per-pin low-voltage no-connection guard; returns TRUE on pass.
         Result = no_conn_all_lv_guard(Description, PinList[Index]);
         // If any pin fails isolation, record the overall failure.
         if (Result == FALSE)
         begin
            AllPassed = FALSE;
         end;
      end;
   end;
end;

{**
  @brief Run a low-voltage isolation (no-connection) guard across all pins in the current fixture/connector scope.

  @details
  This routine performs a guard pass intended to catch unintended connections at low voltage:
  1) Inserts a visual spacer into the log for readability.
  2) Retrieves the primary netlist’s complete pin inventory as a semicolon-delimited string.
  3) Tokenizes that string into a list structure for downstream processing.
  4) Invokes the no-connection guard at low voltage over the full pin set, recorded under the label "NCA LV".

  @param Debug When TRUE, subordinate helper routines may emit diagnostic output useful during development and troubleshooting.

  @return None (procedure has side effects only).

  @pre The active fixture/connector context must be selected and populated; helper functions must be available:
       - get_netlist_primary_all(Debug): returns a semicolon-delimited string of all defined pins in scope.
       - MiscListFromString(src, dst, delim): tokenizes the string into a list.
       - no_conn_lv_list(label, list): performs the low-voltage no-connection guard using the provided list.

  @post The test plan/log will reflect execution of a low-voltage isolation guard over the full pin set, labeled "NCA LV".

  @sideeffects May append human-readable output to logs; may influence subsequent guard/reporting state.

  @note "LV" refers to low voltage. The "NCA LV" label is used for operator and report visibility.

  @header
  isolation_test_lv_guard(Debug: boolean = FALSE): void;
  Run low-voltage isolation guard across all fixture pins.
*}
function isolation_test_lv_guard(Debug: boolean = FALSE): void;
begin
   // Insert a visual spacer in the operator/test log for readability.
   blank_line();

   // Find all non-netlist pins
   AllPinsStr = get_named_pin_list_all(); // Retrieve all defined pins (fixture/connector scope)

   AllPrimaryPinListStr = get_netlist_primary_all();

   AllComponentsBothStr = get_netlist_both_all(); // Retrieve all wired pins/ends from the combined netlist

   MiscListFromString(AllPinsStr,AllPinList,';'); // Tokenize full pin inventory
   MiscListFromString(AllComponentsBothStr,ComponentBothPinList,';'); // Tokenize wired-pin inventory
   MiscListFromString(AllPrimaryPinListStr, AllPinPrimaryList, ';');

   // Compute Unconnected pins by removing netlist wires from the full list
   MiscSubtractLists(UnconnectedPinList, AllPinList, ComponentBothPinList); // Unconnected = FullPinList - WirePinList
   MiscAddLists(PrimaryPlusUnconnectedList, AllPinPrimaryList, UnconnectedPinList);

   if (Debug)
   begin
      PrimaryPlusUnconnectedListStr = MiscListToString(PrimaryPlusUnconnectedList, ',');
      ui_print_str_2('Pins to Test: ', PrimaryPlusUnconnectedListStr, FALSE, TRUE, FALSE, Debug);
   end;
   // Execute the low-voltage no-connection guard across the complete pin list with reporting label "NCA LV".
   no_conn_lv_list('NCL LV', PrimaryPlusUnconnectedList);
end;
