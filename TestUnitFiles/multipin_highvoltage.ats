{
  get_named_pin_list_all(): string
  //  Build a semicolon-delimited list of every pin in the pin table that has a non-empty name.

  get_named_pin_list(FromPin: tpin; ToPin: tpin): string
  //  Retrieve a semicolon-delimited string of named pins between two pin handles.

  transform_pinlist_name_str(PinList: tpinarray): string
  //  Convert an array of pin identifiers into a comma-separated string of their PIN_Name values.

  no_conn_db_lists(HighName: string; HighList: tpinarray; LowName: string; LowList: tpinarray): void
  //  Define and execute a no-connection db test group for specified high and low pin arrays.

  nc_db_pin_info_high(PinInfoStr: string; FullPinList: tarray): void
  //  Perform a no-connection DB test treating pins with matching PIN_Info as HIGH and all others as LOW.

  nc_db_pin_info_low(PinInfoStr: string; FullPinList: tarray): void
  //  Perform a no-connection DB test treating pins with matching PIN_Info as LOW and all others as HIGH.

  no_conn_hv_lists(HighName: string; HighList: tpinarray; LowName: string; LowList: tpinarray): void
  //  Execute a high-voltage no-connection test group for specified high and low pin arrays.

  nc_hv_pin_info_high(PinInfoStr: string; FullPinList: tarray): void
  //  Perform a high-voltage no-connection test treating pins with matching PIN_Info as HIGH.

  nc_hv_pin_info_low(PinInfoStr: string; FullPinList: tarray): void
  //  Perform a high-voltage no-connection test treating pins with matching PIN_Info as LOW.

  no_conn_lv_abort(Description: string; PinList: tpinarray): void
  //  Perform low-voltage isolation on each pin in the list and abort the test if any fail.

  get_netlist_primary(Debug: boolean = FALSE): string
  //  Retrieve all primary component pin names from the netlist as a semicolon-delimited string.

  get_netlist_both(Debug: boolean = FALSE): string
  //  Retrieve a list of all named wire pins from the netlist.

  no_conn_hv(Description: string; PinList: tpinarray)
  //  Execute a high-voltage “no-connection” (isolation) test across a list of pins.

  no_conn_hv_populated(Description: string; Trise: ttime = 1s)
  //  Run a high-voltage "no-connection" (isolation) test on POPULATED and UNPOPULATED contacts.

  no_conn_db(Description: string; PinList: tpinarray)
  //  Execute a dielectric-breakdown "no-connection" test for each pin in a list.

  no_conn_db_populated(Description: string; Twait: ttime = 1s, Tmeas: ttime = 1s)
  //  Run a dielectric-breakdown “no-connection” test on POPULATED and UNPOPULATED contacts.
}


{
 Dynamic no-connection test utilities using PIN_Info tags to build pin groups at runtime.

 Usage Example:
   // Retrieve all named pins between two endpoints:
   AllPinsListStr = get_named_pin_list("P1-A","P2-CASE");
   MiscListFromString(AllPinsListStr,ListAllPins,';');

   // Chassis DB test: pins tagged "CHASSIS" LOW vs. all others HIGH
   nc_db_pin_info_low('CHASSIS',ListAllPins);

   // HV isolation tests: treat switch contacts as HIGH against all others
   nc_hv_pin_info_high('SW1',ListAllPins);
   nc_hv_pin_info_high('SW2',ListAllPins);
   …

 Typical applications include chassis isolation tests, switch contact verification, and multipin protocols.
 For further examples see Collins AS-0191-001, ONBOARD SYSTEMS AS-0192-001 and especially
 AS-0188-001 for multiple pins tested against all other pins (switch contacts against all others.)
}

{**
  @brief   Retrieve a list of all primary named pins from the netlist.
  @details
    Calls NWCreatePinlist to gather pins of type COMPONENT_Wire with primary pin roles,
    then converts that pin list into a semicolon-delimited string for use in isolation or breakdown tests.
  @return  A string of primary pin names separated by ';'.
**}
function get_netlist_primary(Debug: boolean = FALSE): string;
begin
   // Create a pin list of all primary component pins of type wire
   NWCreatePinlist(PinList, COMPONENT_Wire, COMPONENTDATA_Name, '*', COMPONENTPINS_Primary, FALSE);

   // Convert the pin list to a semicolon-delimited string and return it
   Result = MiscListToString(PinList, ';');

   if (Debug)
   begin
      UIWriteNormal(Result);
   end;
end;

{**
  @brief   Retrieve a list of all named wire pins from the netlist.
  @details
    Calls NWCreatePinlist to gather pins of type COMPONENT_Wire,
    then converts that pin list into a semicolon-delimited string for use in isolation or breakdown tests.
  @return  A string of wire pin names separated by ';'.
**}
function get_netlist_both(Debug: boolean = FALSE): string;
begin
   // Create a pin list of all wire pins of type wire
   NWCreatePinlist(PinList, COMPONENT_Wire, COMPONENTDATA_Name, '*', COMPONENTPINS_Both, FALSE);

   // Convert the pin list to a semicolon-delimited string and return it
   Result = MiscListToString(PinList, ';');

   if (Debug)
   begin
      UIWriteNormal(Result);
   end;
end;

{**
  @brief   Retrieve a semicolon-delimited list of all named pins in the pin table.
  @details
    Iterates over every pin index from 1 to PinGetCount()-1, includes only pins whose
    PIN_Name is non-empty, and builds a semicolon-separated string of those pins.
  @return  A string of named pin indices separated by ';', or an empty string if none found.
**}
function get_named_pin_list_all(Debug: boolean = FALSE): string;
begin
   CreatedList = FALSE;            // Flag to indicate the list has been seeded

   // Determine total number of pins
   Count = PinGetCount();

   // Iterate through each pin index
   for Index = 1 to Count - 1 do
   begin
      PinName = PinGetData(Index, PIN_Name);  // fetch this pin’s name

      // Only include pins that have a non-empty name
      IsNull = StrCompare(PinName, '');
      if (IsNull <> 0)
      begin
         if (Debug)
         begin
            UIWriteNormal(PinName);               // Debug: output the pin name
         end;
         PinDefineList(SinglePinList, [Index]); // create a single-item list for this pin

         if (CreatedList == FALSE)
         begin
            PinDefineList(List, [Index]);     // seed the master list on first named pin
            CreatedList = TRUE;
         end
         else
         begin
            MiscAddLists(List, List, SinglePinList);  // append this pin to the master list
         end;
      end
      else
      begin
         // Skip unnamed pins
      end;
   end;

   // Convert the collected named pins to a semicolon-delimited string
   Text = MiscListToString(List, ';');
   Result = Text;                       // return the final string
end;


{**
  @brief   Retrieve a semicolon-delimited string of named pins within a specified range.
  @details
    1. Initializes a temporary list with the starting pin.
    2. Uses PinsInRange to collect all pins from @p FromPin to @p ToPin.
    3. Iterates through each pin, adding only those with a non-empty name to the list.
    4. Converts the final list to a semicolon-separated string.
  @param   FromPin  The first pin in the range to inspect.
  @param   ToPin    The last pin in the range to inspect.
  @return  A string of named pins separated by ';', or an empty string if none found.
**}
function get_named_pin_list(FromPin: tpin; ToPin: tpin): string;
begin
   // Initialize list with the first pin definition
   PinDefineList(List, [FromPin]);

   // Populate PinList with all pins in the specified range
   Count = PinsInRange(PinList, FromPin, ToPin, FALSE, TRUE);

   // Loop through each pin in the range
   for Index = 1 to Count do
   begin
      PinName = PinGetData(PinList[Index], PIN_Name);  // fetch the pin’s name

      // Only include pins that have a non-empty name
      IsNull = StrCompare(PinName, '');
      if (IsNull <> 0)
      begin
         Pin = PinList[Index];
         PinDefineList(SinglePinList, [Pin]);
         MiscAddLists(List, List, SinglePinList);  // add named pin to the list
      end
      else
      begin
         // Skip unnamed pins
      end;
   end;

   // Convert the collected named pins to a semicolon-delimited string
   Text = MiscListToString(List, ';');
   Result = Text;
end;


{**
  @brief   Convert an array of pin identifiers into a comma-separated string of their names.
  @param   PinList  Array of pin handles to transform.
  @return  A string containing each pin’s PIN_Name separated by commas (empty if PinList is empty).
**}
function transform_pinlist_name_str(PinList: tpinarray): string;
begin
   // Initialize result string
   NameStr = '';

   // Determine how many pins are in the input array
   Count = MiscGetListSize(PinList);
   //UIWriteNormal(Count);

   // Seed NameStr with the first pin’s name, if any
   if (Count >= 1)
   begin
      NameStr = PinGetData(PinList[1], PIN_Name); // get PIN_Name property
      //UIWriteNormal(NameStr);
   end;

   // Append remaining pin names, each prefixed by a comma
   if (Count >= 2)
   begin
      for Index = 2 to Count do
      begin
         PinName = PinGetData(PinList[Index], PIN_Name); // retrieve next pin name
         //UIWriteNormal(PinName);
         NameStr = StrAdd(NameStr, ',');     // add comma delimiter
         NameStr = StrAdd(NameStr, PinName); // append pin name
      end;
   end;

   // Return the combined list of names
   Result = NameStr;
end;


{**
  @brief   Define and execute a no-connection database group for two pin arrays.
  @param   HighName   Label for the high-voltage pin group.
  @param   HighList   Array of high-voltage pin identifiers.
  @param   LowName    Label for the low-voltage pin group.
  @param   LowList    Array of low-voltage pin identifiers.
  @return  void
**}
function no_conn_db_lists(HighName: string; HighList: tpinarray; LowName: string; LowList: tpinarray): void;
begin
   // Define the high-voltage pin list for database operations
   PinDefineList(PinHigh, HighList);

   // Define the low-voltage pin list for database operations
   PinDefineList(PinLow, LowList);

   // Execute the no-connection test group with the specified labels and pin lists
   NoConnGroupDB('NCDB', HighName, PinHigh, LowName, PinLow);
end;


{**
  @brief   Perform a no-connection database test treating pins matching a given info string as HIGH.
  @details
    1. Creates a list of pins whose PIN_Info matches @p PinInfoStr (HIGH pins).
    2. Computes the complementary LOW pin list by subtracting HIGH pins from @p FullPinList.
    3. Transforms the HIGH pin list into a comma-separated name string.
    4. Executes a no-connection DB test group with HIGH and LOW pin lists.
  @param   PinInfoStr   The PIN_Info value used to select HIGH pins.
  @param   FullPinList  Array of all pin identifiers to consider.
  @return  void
**}
function nc_db_pin_info_high(PinInfoStr: string; FullPinList: tarray): void;
begin
   // Tests pins with PinInfoStr in their PIN_Info field as HIGH and all others from the list as LOW.

   // Create list of HIGH pins matching the specified info string
   PinCreateList(HighPinList, PIN_Info, PinInfoStr);

   // Compute LOW pins by removing HIGH pins from the full list
   MiscSubtractLists(LowPinList, FullPinList, HighPinList);

   // Convert HIGH pin list to comma-separated names for display
   HighNames = transform_pinlist_name_str(HighPinList);

   // Execute the no-connection database test with HIGH and LOW groups
   no_conn_db_lists(HighNames, HighPinList, 'ALL OTHER PINS', LowPinList);
end;


{**
  @brief   Perform a no-connection database test treating pins matching a given info string as LOW.
  @details
    1. Creates a list of pins whose PIN_Info matches @p PinInfoStr (LOW pins).
    2. Computes the complementary HIGH pin list by subtracting LOW pins from @p FullPinList.
    3. Transforms the LOW pin list into a comma-separated name string.
    4. Executes a no-connection DB test group with HIGH and LOW pin lists.
  @param   PinInfoStr   The PIN_Info value used to select LOW pins.
  @param   FullPinList  Array of all pin identifiers to consider.
  @return  void
  @example
    // Example usage:
    // Get list of all pins in string format from pintable (FIRST PIN IN TABLE, LAST PIN IN TABLE)
    AllPinsListStr = get_named_pin_list("P1-A","P2-CASE");
    // Convert string to list
    MiscListFromString(AllPinsListStr,ListAllPins,';');
    // Get pins that have PIN_INFO set in pin table and set LOW
    nc_db_pin_info_low('CHASSIS',ListAllPins);
**}
function nc_db_pin_info_low(PinInfoStr: string; FullPinList: tarray): void;
begin
   {*
   // Tests pins with PinInfoStr in their PIN_Info field as LOW and all others
   // from the list as HIGH.
   *}

   // Create list of LOW pins matching the specified info string
   PinCreateList(LowPinList, PIN_Info, PinInfoStr);

   // Compute HIGH pins by removing LOW pins from the full list
   MiscSubtractLists(HighPinList, FullPinList, LowPinList);

   // Convert LOW pin list to a comma-separated name string
   LowNames = transform_pinlist_name_str(LowPinList);

   // Execute the no-connection database test with HIGH and LOW groups
   no_conn_db_lists('ALL OTHER PINS', HighPinList, LowNames, LowPinList);
end;


{**
  @brief   Execute a high-voltage no-connection test group with specified pin arrays.
  @details Defines separate high and low pin lists and invokes the HV no-connection group.
  @param   HighName   Label for the high-voltage pin group.
  @param   HighList   Array of pins to treat as high-voltage.
  @param   LowName    Label for the low-voltage pin group.
  @param   LowList    Array of pins to treat as low-voltage.
  @return  void
**}
function no_conn_hv_lists(HighName: string; HighList: tpinarray; LowName: string; LowList: tpinarray): void;
begin
   // Define the high-voltage pin list for the test group
   PinDefineList(PinHigh, HighList);

   // Define the low-voltage pin list for the test group
   PinDefineList(PinLow, LowList);

   // Perform the HV no-connection database group test
   NoConnGroupHV('NCHV', HighName, PinHigh, LowName, PinLow);
end;


{**
  @brief   Perform a high-voltage no-connection test treating pins matching a given info string as HIGH.
  @details
    1. Creates a list of pins whose PIN_Info equals @p PinInfoStr (HIGH pins).
    2. Computes the complementary LOW pin list by subtracting HIGH pins from @p FullPinList.
    3. Transforms the HIGH pin list into a comma-separated name string.
    4. Executes a high-voltage no-connection test group with HIGH and LOW pin lists.
  @param   PinInfoStr   The PIN_Info filter to select HIGH pins.
  @param   FullPinList  Array of all pin identifiers to consider.
  @return  void
**}
function nc_hv_pin_info_high(PinInfoStr: string; FullPinList: tarray): void;
begin
   // Tests pins with PinInfoStr in their PIN_Info field as HIGH and all others from the list as LOW.

   // Get HIGH pins
   PinCreateList(HighPinList, PIN_Info, PinInfoStr);

   // Get LOW pins
   MiscSubtractLists(LowPinList, FullPinList, HighPinList);

   // Convert HIGH pin list to a comma-separated name string
   HighNames = transform_pinlist_name_str(HighPinList);

   // Execute the high-voltage no-connection database test with the specified groups
   no_conn_hv_lists(HighNames, HighPinList, 'ALL OTHER PINS', LowPinList);
end;


{**
  @brief   Perform a high-voltage no-connection test treating pins matching a given info string as LOW.
  @details
    1. Builds a list of pins whose PIN_Info equals @p PinInfoStr (LOW pins).
    2. Computes the complementary HIGH pin list by subtracting LOW pins from @p FullPinList.
    3. Transforms the LOW pin list into a comma-separated name string.
    4. Executes a high-voltage no-connection database group test with the HIGH and LOW pin lists.
  @param   PinInfoStr   The PIN_Info value used to select LOW pins.
  @param   FullPinList  Array of all pin identifiers to consider.
  @return  void
**}
function nc_hv_pin_info_low(PinInfoStr: string; FullPinList: tarray): void;
begin
   // Tests pins with PinInfoStr in their PIN_Info field as LOW and all others from the list as HIGH.

   // Get LOW pins
   PinCreateList(LowPinList, PIN_Info, PinInfoStr);

   // Get HIGH pins
   MiscSubtractLists(HighPinList, FullPinList, LowPinList);

   // Convert LOW pin list to a comma-separated string of names
   LowNames = transform_pinlist_name_str(LowPinList);

   // Execute the high-voltage no-connection test with the specified groups
   no_conn_hv_lists('ALL OTHER PINS', HighPinList, LowNames, LowPinList);
end;


{**
 @brief Run a low-voltage isolation test and abort immediately if any new failure is detected.

 @details
 This routine wraps the LV isolation sequence with a fail-counter guard. It snapshots the
 main fail counter before and after the test and compares the values. If the counter has
 increased (i.e., new failures occurred during this call), it logs errors to the UI and
 report, then aborts the overall test run.

 Operational flow:
 - Record the starting value of the main fail counter (FAILCOUNTER_Main).
 - Apply/verify LV test options via test_lv_option().
 - Execute the LV isolation test via IsolationTestLV().
 - Record the ending value of the main fail counter.
 - If FailsEnd differs from FailsStart, emit errors and call MiscAbortTest().

 @param Description  Human-readable label for the session (not used in this routine but preserved
                     for signature consistency with related helpers and potential future reporting).
 @param PinList      List of pins intended for context (not used directly in this routine).

 @return void

 @pre
 - The following helpers and identifiers must exist: FailCounterGet(), test_lv_option(),
   IsolationTestLV(), UIWriteError(), ReportWriteError(), MiscAbortTest(), FAILCOUNTER_Main.
 - Variables AllPassed (boolean), FailsStart (integer), and FailsEnd (integer) are declared/valid.

 @post
 - If any new failure is detected (FailsEnd <> FailsStart), the procedure will abort the test flow.

 @sideeffects
 - Writes error messages to UI and report streams.
 - May terminate the active test sequence via MiscAbortTest().

 @note
 - AllPassed is initialized but not used to gate behavior; abort logic relies solely on the fail
   counter delta. This preserves existing semantics where failure handling is centralized via counters.
 - Parameters @p Description and @p PinList are accepted for API parity but are not referenced here.

 @see FailCounterGet, IsolationTestLV, test_lv_option, MiscAbortTest
}
function no_conn_lv_abort(Description: string; PinList: tpinarray): void;
begin
   AllPassed = TRUE;  // assume success until a failure occurs (legacy aggregate flag; not used below)

   // Main failure count (snapshot before running the LV isolation test)
   FailsStart = FailCounterGet(FAILCOUNTER_Main);

   test_lv_option(); // Configure/validate LV test options prior to execution

   IsolationTestLV(); // Execute the low-voltage isolation test sequence

   // Main failure count (snapshot after test run)
   FailsEnd = FailCounterGet(FAILCOUNTER_Main);

   // If any pin failed, report error and abort the test
   if (FailsStart <> FailsEnd)
   begin
      UIWriteError('LOW VOLTAGE ISOLATION TEST FAILED, ABORTING TEST'); // UI alert
      ReportWriteError('LOW VOLTAGE ISOLATION TEST FAILED, ABORTING TEST'); // Report log entry
      MiscAbortTest(); // Terminate further testing due to new failures detected
   end;
end;


{**
 @brief Execute a high-voltage “no-connection” (isolation) test across a list of pins.

 @details
 Iterates over @p PinList and invokes NoConnAllHV() per pin, passing through the
 human-readable @p Description for traceability in logs/reports. The routine tracks
 an aggregate status in AllPassed, which is initialized TRUE and flipped to FALSE
 if any individual pin test fails. The optional “abort on failure” section is
 currently commented out, so the function will complete the pass over all pins
 even if failures occur.

 Control flow notes:
 - Uses a 1-based loop: Index = 1 .. Count, where Count = MiscGetListSize(PinList).
 - Pin names are fetched via PinGetData() for potential UI/report context; related
   UI lines are present but commented out.

 @param Description  Label or test identifier forwarded to NoConnAllHV() for reporting.
 @param PinList      Array of pin handles/IDs (tpinarray) to be tested for HV isolation.

 @return void

 @pre
 - PinList is initialized; MiscGetListSize(), PinGetData(), and NoConnAllHV() are available.
 - Variables AllPassed (boolean), Count (integer), Index (integer), Result (boolean),
   and PinName (string) are declared/accessible in this scope as required by the language.

 @post
 - AllPassed reflects overall success (TRUE only if all per-pin tests returned TRUE).

 @sideeffects
 - Executes NoConnAllHV(), which may drive HV instrumentation and produce logs.
 - Optional UI/report writes are present but commented out in this function.

 @see NoConnAllHV, MiscGetListSize, PinGetData
}
function no_conn_hv(Description: string; PinList: tpinarray): void;
begin
   AllPassed = TRUE;  // assume success until a failure occurs

   Count = MiscGetListSize(PinList); // get number of pins to test
   //UIWriteNormal(Count); // optional: display total pin count

   // Perform high-voltage isolation test on each pin
   if (Count >= 1)
   begin
      for Index = 1 to Count do
      begin
         PinName = PinGetData(PinList[Index], PIN_Name); // fetch pin name for context (logging)
         //UIWriteNormal(PinName); // optional: echo pin under test
         Result = NoConnAllHV(Description, PinList[Index]); // test this pin (returns TRUE on pass)
         if (Result == FALSE)
         begin
            AllPassed = FALSE; // mark overall failure if any test fails
         end;
      end;
   end;

end;


{**
 @brief Run a high-voltage isolation (“no-connection”) test on POPULATED and UNPOPULATED contacts.

 @details
 The routine executes two HV isolation passes using no_conn_hv():
 1) POPULATED contacts taken from the primary netlist, and
 2) UNPOPULATED contacts computed as the set difference between all defined pins and all wired pins.

 Workflow:
 - Adds visual spacing and section headers to the UI.
 - Builds pin sets by tokenizing semicolon-delimited strings.
 - Applies isolation-HV configuration via ParamIsolationHV(), leaving all parameters unchanged
   except the fifth argument, which is set from @p Tmeas (timing/measurement dwell as defined
   by your platform).
 - Records the active measurement parameters under CMDGRP_IsolationHV.
 - Invokes no_conn_hv() for each pin set, forwarding @p Description for report/log traceability.

 @param Description  Human-readable label/identifier forwarded to no_conn_hv() for consistent reporting.
 @param Tmeas        Measurement/hold time applied through ParamIsolationHV()’s fifth parameter (default 1s).

 @return void

 @pre
 - Helper routines/identifiers are available: blank_line(), msg_box_border(), get_netlist_primary(),
   get_named_pin_list_all(), get_netlist_both(), MiscListFromString(), MiscSubtractLists(),
   ParamIsolationHV(), ReportWriteMeasurementParameters(), no_conn_hv(), CMDGRP_IsolationHV.
 - Variables/handles exist and are compatible with the helpers:
   PopulatedPinListStr, PopulatedPinList, AllPinsListStr, AllWireListStr,
   FullPinList, WirePinList, UnconnectedPinList.
 - Pin-list strings are semicolon-delimited (';').

 @sideeffects
 - Produces UI/report output (headings and parameter blocks).
 - Updates HV isolation configuration via ParamIsolationHV().

 @note
 - UNPOPULATED pins are computed as: UnconnectedPinList = FullPinList - WirePinList.
 - Only the fifth parameter of ParamIsolationHV() is changed here; all others are left as PARAM_DontChange.

 @see no_conn_hv, ParamIsolationHV, MiscListFromString, MiscSubtractLists,
      get_netlist_primary, get_named_pin_list_all, get_netlist_both
}
function no_conn_hv_populated(Description: string; Tmeas: ttime = 1s): void;
begin
   blank_line(); // Visual spacer before the POPULATED contacts section

   msg_box_border('Testing POPULATED contacts', '*'); // Section header for POPULATED pins

   PopulatedPinListStr = get_netlist_primary(); // Acquire semicolon-delimited primary-netlist pins
   MiscListFromString(PopulatedPinListStr,PopulatedPinList,';'); // Tokenize into PopulatedPinList

   no_conn_hv(Description, PopulatedPinList); // Execute HV isolation test on POPULATED pins with label

   blank_line(); // Spacer between sections
   msg_box_border('Testing UNPOPULATED contacts', '*'); // Section header for UNPOPULATED pins

   ParamIsolationHV(PARAM_DontChange, PARAM_DontChange, PARAM_DontChange, PARAM_DontChange, Tmeas); // Apply measurement dwell/time

//   ReportWriteMeasurementParameters(CMDGRP_IsolationHV); // Log active HV parameters for traceability

   AllPinsListStr = get_named_pin_list_all(); // Retrieve all defined pins (fixture/connector scope)

   AllWireListStr = get_netlist_both(); // Retrieve all wired pins/ends from the combined netlist

   MiscListFromString(AllPinsListStr,FullPinList,';'); // Tokenize full pin inventory
   MiscListFromString(AllWireListStr,WirePinList,';'); // Tokenize wired-pin inventory

   // Compute Unconnected pins by removing netlist wires from the full list
   MiscSubtractLists(UnconnectedPinList, FullPinList, WirePinList); // Unconnected = FullPinList - WirePinList

   no_conn_hv(Description, UnconnectedPinList); // Execute HV isolation test on UNPOPULATED pins with same label
end;


{**
 @brief Execute a dielectric-breakdown "no-connection" test for each pin in a list.

 @details
 Iterates over @p PinList and calls NoConnAllDB() for each pin, forwarding the
 human-readable @p Description for traceability in logs and reports. The routine
 maintains an aggregate status flag (AllPassed), initialized TRUE and set to FALSE
 if any individual pin test fails. The function completes testing of all pins
 regardless of failures; it does not report or abort on failure in this scope.

 Control flow and data:
 - Count is obtained via MiscGetListSize(PinList); loop is 1-based from 1 to Count.
 - Pin names are fetched with PinGetData() and may be echoed to UI if the commented
   UI lines are enabled.
 - NoConnAllDB() performs the dielectric-breakdown evaluation and returns TRUE/FALSE.

 @param Description  Label or identifier passed to NoConnAllDB() for reporting/traceability.
 @param PinList      Array of pins (tpinarray) to be subjected to dielectric-breakdown "no-connection" testing.

 @return void

 @pre
 - PinList is initialized and valid.
 - The following symbols are available in scope and compatible with this usage:
   MiscGetListSize(), PinGetData(), NoConnAllDB(),
   variables AllPassed (boolean), Count (integer), Index (integer),
   Result (boolean), and PinName (string).

 @post
 - AllPassed reflects aggregate outcome after the loop (TRUE only if all pins passed).

 @sideeffects
 - May drive high-voltage test equipment via NoConnAllDB().
 - Optional UI output is present but currently commented out in this routine.

 @note
 - This procedure does not itself log failures or abort; caller is responsible for any
   error handling based on AllPassed or per-pin results if captured externally.

 @see NoConnAllDB, MiscGetListSize, PinGetData
}
function no_conn_db(Description: string; PinList: tpinarray): void;
begin
   AllPassed = TRUE;  // assume success until a failure occurs

   Count = MiscGetListSize(PinList); // get number of pins to test
   //UIWriteNormal(Count); // optional: display total pin count

   // Perform high-voltage isolation test on each pin (dielectric-breakdown "no-connection" check)
   if (Count >= 1)
   begin
      for Index = 1 to Count do
      begin
         PinName = PinGetData(PinList[Index], PIN_Name); // fetch pin name for context (logging)
         //UIWriteNormal(PinName); // optional: echo pin under test
         Result = NoConnAllDB(Description, PinList[Index]); // run DB test for this pin; TRUE on pass
         if (Result == FALSE)
         begin
            AllPassed = FALSE; // mark overall failure if any test fails
         end;
      end;
   end;

end;


{**
 @brief Run a dielectric-breakdown “no-connection” test on POPULATED and UNPOPULATED contacts.

 @details
 Executes two dielectric-breakdown (DB) passes using no_conn_db():
 1) POPULATED contacts obtained from the primary netlist, then
 2) UNPOPULATED contacts computed as the set difference of all defined pins and all wired pins.

 The routine:
 - Adds visual spacing and section headers to the UI.
 - Builds pin lists by tokenizing semicolon-delimited strings.
 - Applies DB timing via ParamDielectricBreakdown() using @p Twait and @p Tmeas.
 - Records the active measurement parameters under CMDGRP_IsolationDB.
 - Invokes no_conn_db() for both pin sets, forwarding @p Description for report/log traceability.

 @param Description  Human-readable label/identifier forwarded to no_conn_db() for consistent reporting.
 @param Twait        Wait time before the DB measurement window (default 1s).
 @param Tmeas        Duration of the DB measurement window (default 1s).

 @return void

 @pre
 - Helper routines/identifiers are available: blank_line(), msg_box_border(), get_netlist_primary(),
   get_named_pin_list_all(), get_netlist_both(), MiscListFromString(), MiscSubtractLists(),
   ParamDielectricBreakdown(), ReportWriteMeasurementParameters(), no_conn_db(), CMDGRP_IsolationDB.
 - Variables/handles exist and are compatible with the helpers:
   PopulatedPinListStr, PopulatedPinList, AllPinsListStr, AllWireListStr,
   FullPinList, WirePinList, UnconnectedPinList.
 - @p Twait and @p Tmeas are valid for ParamDielectricBreakdown().

 @sideeffects
 - Produces UI/report output (headers and parameter blocks).
 - Updates dielectric-breakdown configuration via ParamDielectricBreakdown().
 - Initiates DB testing that may stress the UUT at high voltage.

 @note
 - UNPOPULATED pins are computed as: UnconnectedPinList = FullPinList - WirePinList.
 - Pin-list strings are expected to be semicolon-delimited (';').

 @see no_conn_db, ParamDielectricBreakdown, MiscListFromString, MiscSubtractLists,
      get_netlist_primary, get_named_pin_list_all, get_netlist_both
}
function no_conn_db_populated(Description: string; Twait: ttime = 1s; Tmeas: ttime = 1s): void;
begin
   blank_line(); // Visual spacer before the POPULATED contacts section

   test_db_option();

   msg_box_border('Testing POPULATED contacts', '*'); // Section header for POPULATED pins

   PopulatedPinListStr = get_netlist_primary(); // Acquire semicolon-delimited primary-netlist pins
   MiscListFromString(PopulatedPinListStr,PopulatedPinList,';'); // Tokenize into PopulatedPinList

   no_conn_db(Description, PopulatedPinList); // Execute dielectric-breakdown test on POPULATED pins with label

   blank_line(); // Spacer between sections
   msg_box_border('Testing UNPOPULATED contacts', '*'); // Section header for UNPOPULATED pins

   ParamDielectricBreakdown(PARAM_DontChange, PARAM_DontChange, Twait, Tmeas); // Apply DB timing (wait/measure)

//   ReportWriteMeasurementParameters(CMDGRP_IsolationDB); // Log active DB parameters for traceability

   AllPinsListStr = get_named_pin_list_all(); // Retrieve all defined pins (fixture/connector scope)

   AllWireListStr = get_netlist_both(); // Retrieve all wired pins/ends from the combined netlist

   MiscListFromString(AllPinsListStr,FullPinList,';'); // Tokenize full pin inventory
   MiscListFromString(AllWireListStr,WirePinList,';'); // Tokenize wired-pin inventory

   // Compute Unconnected pins by removing netlist wires from the full list
   MiscSubtractLists(UnconnectedPinList, FullPinList, WirePinList); // Unconnected = FullPinList - WirePinList

   no_conn_db(Description, UnconnectedPinList); // Execute dielectric-breakdown test on UNPOPULATED pins with same label
end;
