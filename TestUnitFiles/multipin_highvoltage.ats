{
  get_named_pin_list_all(Debug: boolean = FALSE): string
  //  Build a semicolon-delimited list of every pin in the pin table that has a non-empty name.

  get_named_pin_list(FromPin: tpin; ToPin: tpin): string
  //  Retrieve a semicolon-delimited string of named pins between two pin handles.

  transform_pinlist_name_str(PinList: tpinarray): string
  //  Convert an array of pin identifiers into a comma-separated string of their PIN_Name values.

  no_conn_db_lists(HighName: string; HighList: tpinarray; LowName: string; LowList: tpinarray; Debug: boolean = FALSE): void
  //  Define and execute a no-connection db test group for specified high and low pin arrays.

  nc_db_pin_info_high(PinInfoStr: string; Debug: boolean = FALSE): void
  //  Perform a no-connection DB test treating pins with matching PIN_Info as HIGH and all others as LOW.

  nc_db_pin_info_low(PinInfoStr: string; Debug: boolean = FALSE): void
  //  Perform a no-connection DB test treating pins with matching PIN_Info as LOW and all others as HIGH.

  no_conn_hv_lists(HighName: string; HighList: tpinarray; LowName: string; LowList: tpinarray; Debug: boolean = FALSE): void
  //  Execute a high-voltage no-connection test group for specified high and low pin arrays.

  nc_hv_pin_info_high(PinInfoStr: string; Debug: boolean = FALSE): void
  //  Perform a high-voltage no-connection test treating pins with matching PIN_Info as HIGH.

  nc_hv_pin_info_low(PinInfoStr: string; Debug: boolean = FALSE)
  //  Perform a high-voltage no-connection test treating pins with matching PIN_Info as LOW.

  no_conn_lv_abort(Description: string; PinList: tpinarray): void
  //  Perform low-voltage isolation on each pin in the list and abort the test if any fail.

  get_netlist_primary(Debug: boolean = FALSE): string
  //  Retrieve all primary component pin names from the netlist as a semicolon-delimited string.

  get_netlist_primary_all(Debug: boolean = FALSE): string;
  // Aggregate primary pins from supported component types into a semicolon-delimited string.

  get_netlist_both(Debug: boolean = FALSE): string
  //  Retrieve a list of all named wire pins from the netlist.

  get_netlist_from_primary_pin(Pin: tpin; Debug: boolean = FALSE): string
  // Retrieve the full wire-connected network for a primary pin and return it as a semicolon-delimited string.

  set_guard_tested(OptionStr: string; Debug: boolean = FALSE): void;
  // Set the tested state for a guard option in the global "GUARDS" store.

  wire_test_guard(Name: string; Pin1: tpin; Pin2: tpin; Debug: boolean = FALSE): integer; tests wires;
  // Execute a wire continuity guard test and update guard bookkeeping after execution.

  test_wires_guard(Debug: boolean = FALSE): integer;
  // Execute continuity guard tests across all discovered pin networks and compute an overall result.

  no_conn_hv_list(Description: string; PinList: tpinarray)
  //  Execute a high-voltage "no-connection" (isolation) test across a list of pins.

  no_conn_hv_exclude_pin_name(Name: string; ExcludeKeyword: string; Debug: boolean = FALSE): boolean
  // Test every named pin with HV except pins whose own PIN_Name contains a literal keyword.

  no_conn_hv_exclude_network(Name: string; ExcludeKeyword: string; Debug: boolean = FALSE): boolean
  // Test each allowed modeled electrical network once with HV and exclude networks by PIN_Name.

  no_conn_hv_current_populated(Description: string; Tmeas: ttime = 1s)
  //  Run a high-voltage DC dielectric breakdown test on POPULATED and UNPOPULATED contacts (WIRES ONLY!).

  no_conn_hv_populated(Description: string; Tmeas: ttime = 1s)
  //  Run a high-voltage "no-connection" (isolation) test on POPULATED and shorter duration on UNPOPULATED contacts (WIRES ONLY!).

  no_conn_db_list(Description: string; PinList: tpinarray)
  //  Execute a dielectric-breakdown "no-connection" test for each pin in a list.

  no_conn_db_exclude_pin_name(Name: string; ExcludeKeyword: string; Debug: boolean = FALSE): boolean
  // Test every named pin with DB except pins whose own PIN_Name contains a literal keyword.

  no_conn_db_exclude_network(Name: string; ExcludeKeyword: string; Debug: boolean = FALSE): boolean
  // Test each allowed modeled electrical network once with DB and exclude networks by PIN_Name.

  no_conn_db_populated(Description: string; Twait: ttime = 1s, Tmeas: ttime = 1s)
  //  Run a dielectric-breakdown "no-connection" test on POPULATED and shorter duration on UNPOPULATED contacts (WIRES ONLY!).

  no_conn_lv_list(Description: string; PinList: tpinarray): void;
  // Execute low-voltage guard checks across a list of pins.

  isolation_test_lv_guard(Debug: boolean = FALSE): void;
  // Run low-voltage isolation guard across all fixture pins.
}


{
 Dynamic no-connection test utilities using PIN_Info tags to build pin groups at runtime.

 Usage Example:
   // Retrieve all named pins between two endpoints:
   AllPinsListStr = get_named_pin_list("P1-A","P2-CASE");
   MiscListFromString(AllPinsListStr,ListAllPins,';');

   // Chassis DB test: pins tagged "CHASSIS" LOW vs. all others HIGH
   nc_db_pin_info_low('CHASSIS',ListAllPins);

   // HV isolation tests: treat switch contacts as HIGH against all others
   nc_hv_pin_info_high('SW1',ListAllPins);
   nc_hv_pin_info_high('SW2',ListAllPins);

 Typical applications include chassis isolation tests, switch contact verification, and multipin protocols.
 For further examples see Collins AS-0191-001, ONBOARD SYSTEMS AS-0192-001 and especially
 AS-0188-001 for multiple pins tested against all other pins (switch contacts against all others.)
}

{**
  @brief   Convert an array of pin identifiers into a comma-separated string of their names.
  @param   PinList  Array of pin handles to transform.
  @return  A string containing each pin�s PIN_Name separated by commas (empty if PinList is empty).
**}
function transform_pinlist_name_str(PinList: tpinarray): string;
begin
   // Initialize result string
   NameStr = '';

   // Determine how many pins are in the input array
   Count = MiscGetListSize(PinList);
   //UIWriteNormal(Count);

   // Seed NameStr with the first pin�s name, if any
   if (Count >= 1)
   begin
      NameStr = PinGetData(PinList[1], PIN_Name); // get PIN_Name property
      //UIWriteNormal(NameStr);
   end;

   // Append remaining pin names, each prefixed by a comma
   if (Count >= 2)
   begin
      for Index = 2 to Count do
      begin
         PinName = PinGetData(PinList[Index], PIN_Name); // retrieve next pin name
         //UIWriteNormal(PinName);
         NameStr = StrAdd(NameStr, ',');     // add comma delimiter
         NameStr = StrAdd(NameStr, PinName); // append pin name
      end;
   end;

   // Return the combined list of names
   Result = NameStr;
end;

function strip_list_empty_string(ListStr: string; Debug: boolean = FALSE): string;
begin
   Result = '';
   Count = MiscListFromString(ListStr, PinList, ';');

   if (Count)
   begin
      for Index = 1 to Count do
      begin
         PinNameStr = PinGetData(PinList[Index], PIN_Name);
         if (Debug)
         begin
            Str = StrAdd('Name: "', PinNameStr);
            Str = StrAdd(Str, '"');
            UIWriteWarning(Str);
         end;

         if (StrCompare(PinNameStr, '') <> 0)
         begin
            if (Debug)
            begin
               Str = StrAdd('Adding: ', PinNameStr);
               UIWriteWarning(Str);
            end;

            if (Index == 1)
            begin
               Pin = PinList[Index];
               MiscCreateList(StrippedList, 1);
               StrippedList[1] = Pin;
            end
            else
            begin
               Pin = PinList[Index];
               MiscCreateList(PinListSingle, 1);
               PinListSingle[1] = Pin;
               MiscAddLists(StrippedList, StrippedList, PinListSingle);
            end;
         end;
      end;

      Result = MiscListToString(StrippedList, ';');
   end;
end;

{**
  @brief   Retrieve a list of all primary named pins from the netlist.
  @details
    Calls NWCreatePinlist to gather pins of type COMPONENT_Wire with primary pin roles,
    then converts that pin list into a semicolon-delimited string for use in isolation or breakdown tests.
  @return  A string of primary pin names separated by ';'.
**}
function get_netlist_primary(Debug: boolean = FALSE): string;
begin
   // Create a pin list of all primary component pins of type wire
   NWCreatePinlist(PinList, COMPONENT_Wire, COMPONENTDATA_Name, '*', COMPONENTPINS_Primary, FALSE);

   // Convert the pin list to a semicolon-delimited string and return it
   Result = MiscListToString(PinList, ';');

   Result = strip_list_empty_string(Result, Debug);

   if (Debug)
   begin
      DebugNames = transform_pinlist_name_str(PinList);
      UIWriteNormal(DebugNames);
   end;
end;

{**
  @brief Build and return a semicolon-delimited list of all primary pins for the specified component.

  @details
  Queries the netlist for the given component type, collects its primary pins into
  a list, and serializes that list as a semicolon-delimited string. If no pins are
  found the function returns an empty string. When debug mode is enabled, a concise
  summary of the discovered pins is emitted to the operator interface.

  @param Component Integer identifier of the component type to query for primary pins.
  @param Debug When TRUE, emits a diagnostic summary of the discovered pins.

  @return Semicolon-delimited string of primary pins for the component; empty string if none.

  @pre Helper routines are available and the component/netlist data are initialized:
       - NWCreatePinlist(listRef, componentId, dataSelector, namePattern, pinClass, includeHidden)
       - MiscListToString(listRef, delimiter)
       - strip_list_empty_string(strRef)
       - StrAdd(base, suffix)
       - UIWriteWarning(message)

  @post If Debug is TRUE, a diagnostic message is written to the operator interface.

  @sideeffects May write a diagnostic line to the UI when Debug is TRUE.

  @header
  get_component_netlist_primary(Component: integer; Debug: boolean = FALSE): string;
  Return semicolon-delimited primary pins for a component.
*}
function get_component_netlist_primary(Component: integer; Debug: boolean = FALSE): string;
begin
   // Initialize the return value to an empty string; indicates "no pins" until proven otherwise.
   Result = '';

   // Create a pin list containing all primary pins for the specified component type.
   Count = NWCreatePinlist(PinList, Component, COMPONENTDATA_Name, '*', COMPONENTPINS_Primary, FALSE);

   // If any primary pins were found, serialize them to a semicolon-delimited string and normalize.
   if (Count > 0)
   begin
      // Convert the pin list to a string representation for return.
      Result = MiscListToString(PinList, ';');
      // Remove any empty elements from the serialized string (assumes in-place normalization).
      strip_list_empty_string(Result);
   end;

   // When debugging, emit a summary of pins discovered for the component.
   if (Debug)
   begin
      // Build a concise, human-readable message with the component id and resulting pin string.
      Str = StrAdd('Pins found for component: ', Component);
      Str = StrAdd(Str, ' --> ');
      Str = StrAdd(Str, Result);
      // Present the message to the operator interface.
      UIWriteWarning(Str);
   end;

end;

{**
  @brief Aggregate and serialize all primary pins across relevant components.

  @details
  Builds a unified collection of primary pins drawn from the standard component
  index range (0..8) and an additional variable-resistor component. For each
  component, the routine retrieves its primary-pin netlist as a semicolon-delimited
  string, tokenizes it into a list, and merges it into an accumulator. The final
  result is serialized into a semicolon-delimited string with empty entries removed.
  When debug mode is enabled, a human-readable name string for all accumulated pins
  is emitted to the operator interface.

  @param Debug When TRUE, emits diagnostic output of aggregated primary-pin names.

  @return Semicolon-delimited string of all aggregated primary pins.

  @pre Helper routines must be available and the active fixture context selected:
       - get_component_netlist_primary(index, Debug)
       - MiscCreateList(listRef, initialSize)
       - MiscListFromString(srcStr, dstList, delimiter)
       - MiscAddLists(dst, listA, listB)
       - MiscListToString(listRef, delimiter)
       - strip_list_empty_string(str)
       - transform_pinlist_name_str(listRef)
       - UIWriteWarning(message)

  @post Result contains a normalized, semicolon-delimited list of all primary pins.

  @sideeffects May write debug information to the operator interface when Debug is TRUE.

  @note The explicit variable-resistor component is processed after the 0..8 range.

  @header
  get_netlist_primary_all(Debug: boolean = FALSE): string;
  Aggregate and serialize all primary pins for the active fixture components.
*}
function get_netlist_primary_all(Debug: boolean = FALSE): string;
begin

   // Create the accumulator list that will hold all primary pins collected below.
   MiscCreateList(PrimaryPins, 1);
   
   // Iterate the standard component index range and collect primary pins per component.
   for Component = 0 to 8 do
   begin
      // Fetch the component's primary-pin netlist as a semicolon-delimited string.
      ListStr = get_component_netlist_primary(Component, Debug);

      // Process only non-empty netlist strings.
      if (StrCompare(ListStr, '') <> 0)
      begin
         // Tokenize the string into PinList; Count returns number of tokens parsed.
         Count = MiscListFromString(ListStr, PinList, ';');

         // If tokens were parsed, merge them into the running accumulator list.
         if (Count > 0)
         begin
            // Merge the primary pins into the accumulator.
            MiscAddLists(PrimaryPins, PrimaryPins, PinList);
         end;
      end;
   end;

   // Handle the variable-resistor component explicitly and merge its primary pins.
   ListStr = get_component_netlist_primary(COMPONENT_VariableResistor, Debug);

   // Process only non-empty netlist strings for the variable-resistor component.
   if (StrCompare(ListStr, '') <> 0)
   begin
      // Tokenize the variable-resistor netlist into PinList.
      Count = MiscListFromString(ListStr, PinList, ';');

      // If tokens were parsed, merge them into the running accumulator list.
      if (Count > 0)
      begin
         // Merge the primary pins into the accumulator.
         MiscAddLists(PrimaryPins, PrimaryPins, PinList);
      end;
   end;

   // Serialize the aggregated list of primary pins into a semicolon-delimited string.
   Result = MiscListToString(PrimaryPins, ';');

   // Normalize the serialized string by removing empty elements.
   Result = strip_list_empty_string(Result);

   // When debugging, emit a human-readable list of all accumulated primary pins.
   if (Debug)
   begin
      // Transform the pin list into a human-readable name string.
      DebugNames = transform_pinlist_name_str(PrimaryPins);
      // Present the names to the operator interface.
      UIWriteWarning(DebugNames);
   end;
end;


{**
  @brief Build and return a semicolon-delimited list of both primary and secondary pins for the specified component.

  @details
  For the provided component identifier, this routine queries the netlist for all pins
  classified as both primary and secondary. When any pins are found, they are serialized
  into a semicolon-delimited string and normalized to remove empty elements. If no pins
  are present, an empty string is returned. When debug mode is enabled, a concise summary
  of the discovered pins is emitted to the operator interface.

  @param Component Integer identifier of the component type to query for pins (both classes).
  @param Debug When TRUE, emits a diagnostic summary of the discovered pins.

  @return Semicolon-delimited string of pins for the component; empty string if none.

  @pre Helper routines are available and the component/netlist data are initialized:
       - NWCreatePinlist(listRef, componentId, dataSelector, namePattern, pinClass, includeHidden)
       - MiscListToString(listRef, delimiter)
       - strip_list_empty_string(strRef)
       - StrAdd(base, suffix)
       - UIWriteWarning(message)

  @post If Debug is TRUE, a diagnostic message is written to the operator interface.

  @sideeffects May write a diagnostic line to the UI when Debug is TRUE.

  @header
  get_component_netlist_both(Component: integer; Debug: boolean = FALSE): string;
  Return semicolon-delimited primary+secondary pins for a component.
*}
function get_component_netlist_both(Component: integer; Debug: boolean = FALSE): string;
begin
   // Initialize the return value to an empty string; indicates "no pins" until populated.
   Result = '';

   // Create a pin list containing both primary and secondary pins for the specified component type.
   Count = NWCreatePinlist(PinList, Component, COMPONENTDATA_Name, '*', COMPONENTPINS_Both, FALSE);

   // If any pins were found, serialize them to a semicolon-delimited string and normalize.
   if (Count > 0)
   begin
      // Convert the pin list to a string representation for return.
      Result = MiscListToString(PinList, ';');
      // Remove any empty elements from the serialized string (assumes in-place normalization).
      strip_list_empty_string(Result);
   end;

   // When debugging, emit a summary of pins discovered for the component.
   if (Debug)
   begin
      // Build a concise, human-readable message with the component id and resulting pin string.
      Str = StrAdd('Pins found for component: ', Component);
      Str = StrAdd(Str, ' --> ');
      Str = StrAdd(Str, Result);
      // Present the message to the operator interface.
      UIWriteWarning(Str);
   end;

end;


{**
  @brief Aggregate and serialize both primary and secondary pins across relevant components.

  @details
  Builds a unified collection of pins classified as both primary and secondary from the
  standard component index range (0..8) and the variable-resistor component. For each
  component, the routine retrieves its both-class pin netlist as a semicolon-delimited
  string, tokenizes it into a list, and merges it into an accumulator. The aggregated
  set is serialized to a semicolon-delimited string and normalized by removing empty
  entries. When debug mode is enabled, a human-readable name string for all accumulated
  pins is emitted to the operator interface.

  @param Debug When TRUE, emits diagnostic output of aggregated pin names.

  @return Semicolon-delimited string of all aggregated pins (both classes).

  @pre Helper routines must be available and the active fixture context selected:
       - get_component_netlist_both(index, Debug)
       - MiscCreateList(listRef, initialSize)
       - MiscListFromString(srcStr, dstList, delimiter)
       - MiscAddLists(dst, listA, listB)
       - MiscListToString(listRef, delimiter)
       - strip_list_empty_string(strRef)
       - transform_pinlist_name_str(listRef)
       - UIWriteWarning(message)

  @post Result contains a normalized, semicolon-delimited list of all pins (both classes).

  @sideeffects May write debug information to the operator interface when Debug is TRUE.

  @note The variable-resistor component is processed explicitly after the 0..8 range.

  @header
  get_netlist_both_all(Debug: boolean = FALSE): string;
  Aggregate and serialize both-class pins for the active fixture components.
*}
function get_netlist_both_all(Debug: boolean = FALSE): string;
begin

   // Create the accumulator list that will hold all pins (both classes) collected below.
   MiscCreateList(BothPins, 1);
   
   // Iterate the standard component index range and collect both-class pins per component.
   for Component = 0 to 8 do
   begin
      // Fetch the component's both-class pin netlist as a semicolon-delimited string.
      ListStr = get_component_netlist_both(Component, Debug);

      // Process only non-empty netlist strings.
      if (StrCompare(ListStr, '') <> 0)
      begin
         // Tokenize the string into PinList; Count returns number of tokens parsed.
         Count = MiscListFromString(ListStr, PinList, ';');

         // If tokens were parsed, merge them into the running accumulator list.
         if (Count > 0)
         begin
            // Merge the pins into the accumulator list.
            MiscAddLists(BothPins, BothPins, PinList);
         end;
      end;
   end;

   // Handle the variable-resistor component explicitly and merge its both-class pins.
   ListStr = get_component_netlist_both(COMPONENT_VariableResistor, Debug);

   // Process only non-empty netlist strings for the variable-resistor component.
   if (StrCompare(ListStr, '') <> 0)
   begin
      // Tokenize the variable-resistor netlist into PinList.
      Count = MiscListFromString(ListStr, PinList, ';');

      // If tokens were parsed, merge them into the running accumulator list.
      if (Count > 0)
      begin
         // Merge the pins into the accumulator list.
         MiscAddLists(BothPins, BothPins, PinList);
      end;
   end;

   // Serialize the aggregated list of pins into a semicolon-delimited string.
   Result = MiscListToString(BothPins, ';');

   // Normalize the serialized string by removing empty elements.
   Result = strip_list_empty_string(Result);

   // When debugging, emit a human-readable list of all accumulated pins.
   if (Debug)
   begin
      // Transform the pin list into a human-readable name string.
      DebugNames = transform_pinlist_name_str(BothPins);
      // Present the names to the operator interface.
      UIWriteWarning(DebugNames);
   end;
end;

{**
  @brief   Retrieve a list of all named wire pins from the netlist.
  @details
    Calls NWCreatePinlist to gather pins of type COMPONENT_Wire,
    then converts that pin list into a semicolon-delimited string for use in isolation or breakdown tests.
  @return  A string of wire pin names separated by ';'.
**}
function get_netlist_both(Debug: boolean = FALSE): string;
begin
   // Create a pin list of all wire pins of type wire
   NWCreatePinlist(PinList, COMPONENT_Wire, COMPONENTDATA_Name, '*', COMPONENTPINS_Both, FALSE);

   // Convert the pin list to a semicolon-delimited string and return it
   Result = MiscListToString(PinList, ';');

   Result = strip_list_empty_string(Result, Debug);

   if (Debug)
   begin
      DebugNames = transform_pinlist_name_str(PinList);
      UIWriteNormal(DebugNames);
   end;
end;

{**
  @brief Retrieve the full wire-connected network for a primary pin and return it as a semicolon-delimited string.

  @param Pin    Primary pin whose network is to be enumerated.
  @param Debug  When TRUE, emits a debug message listing the primary pin name and all network pin names.

  @return string  A semicolon-delimited list of pins in the same wire network as the primary pin.

  @details
  The routine queries the connectivity database for all pins electrically connected by wire
  to the given primary pin, converts the resulting pin list into a semicolon-delimited string,
  and returns that string. When debugging is enabled, it also formats and outputs a human-readable
  message showing the primary pin and the resolved network pin names.

  @pre NWGetNetworkPins, MiscListToString, transform_pinlist_name_str, PinGetData, StrAdd, and UIWriteNormal exist.
  @post When Debug is TRUE, a diagnostic message is written to the user interface.
**}
function get_netlist_from_primary_pin(Pin: tpin; Debug: boolean = FALSE): string;
begin
   // Populate PinList with all pins connected by wire to the given primary pin.
   NWGetNetworkPins(PinList, Pin, [COMPONENT_Wire], ANY, FALSE);

   // Convert the pin list to a semicolon-delimited string and assign to Result.
   PinListStr = MiscListToString(PinList, ';');

   Result = strip_list_empty_string(PinListStr, Debug);

   if (Debug)
   begin
      UIWriteWarning(StrAdd('Incoming: ', PinListStr));
      UIWriteWarning(StrAdd('Outgoing: ', Result));
   end;

   MiscListFromString(Result, PinList, ';');

   // If debugging is enabled, compose and emit a readable summary of the network.
   if (Debug)
   begin
      // Convert the pin list into a name-only, human-readable string.
      DebugNames = transform_pinlist_name_str(PinList);

      // Fetch the primary pin's display name (PIN_Name property).
      PinNameStr = PinGetData(Pin, PIN_Name);
      // Build "Primary pin: <name>, Network pins: <names>" for user feedback.
      Str = StrAdd('Primary pin: ', PinNameStr);
      Str = StrAdd(Str, ', Network pins: ');
      Str = StrAdd(Str, DebugNames);

      // Emit the composed diagnostic string.
      UIWriteNormal(Str);
   end;
end;

{**
  @brief   Retrieve a semicolon-delimited list of all named pins in the pin table.
  @details
    Iterates over every pin index from 1 to PinGetCount()-1, includes only pins whose
    PIN_Name is non-empty, and builds a semicolon-separated string of those pins.
  @return  A string of named pin indices separated by ';', or an empty string if none found.
**}
function get_named_pin_list_all(Debug: boolean = FALSE): string;
begin
   Result = '';
   CreatedList = FALSE;            // Flag to indicate the list has been seeded

   // Determine total number of pins
   Count = PinGetCount();

   // Iterate through each pin index
   for Index = 1 to Count - 1 do
   begin
      PinName = PinGetData(Index, PIN_Name);  // fetch this pin�s name

      // Only include pins that have a non-empty name
      IsNull = StrCompare(PinName, '');
      if (IsNull <> 0)
      begin
         if (Debug)
         begin
            UIWriteNormal(PinName);               // Debug: output the pin name
         end;
         PinDefineList(SinglePinList, [Index]); // create a single-item list for this pin

         if (CreatedList == FALSE)
         begin
            PinDefineList(List, [Index]);     // seed the master list on first named pin
            CreatedList = TRUE;
         end
         else
         begin
            MiscAddLists(List, List, SinglePinList);  // append this pin to the master list
         end;
      end
      else
      begin
         // Skip unnamed pins
      end;
   end;

   // Never stringify an uninitialized list when the project has no named test pins.
   if (CreatedList)
   begin
      Result = MiscListToString(List, ';');
   end;
end;

{**
  @brief   Retrieve a semicolon-delimited string of named pins within a specified range.
  @details
    1. Initializes a temporary list with the starting pin.
    2. Uses PinsInRange to collect all pins from @p FromPin to @p ToPin.
    3. Iterates through each pin, adding only those with a non-empty name to the list.
    4. Converts the final list to a semicolon-separated string.
  @param   FromPin  The first pin in the range to inspect.
  @param   ToPin    The last pin in the range to inspect.
  @return  A string of named pins separated by ';', or an empty string if none found.
**}
function get_named_pin_list(FromPin: tpin; ToPin: tpin): string;
begin
   // Initialize list with the first pin definition
   PinDefineList(List, [FromPin]);

   // Populate PinList with all pins in the specified range
   Count = PinsInRange(PinList, FromPin, ToPin, FALSE, TRUE);

   // Loop through each pin in the range
   for Index = 1 to Count do
   begin
      PinName = PinGetData(PinList[Index], PIN_Name);  // fetch the pin�s name

      // Only include pins that have a non-empty name
      IsNull = StrCompare(PinName, '');
      if (IsNull <> 0)
      begin
         Pin = PinList[Index];
         PinDefineList(SinglePinList, [Pin]);
         MiscAddLists(List, List, SinglePinList);  // add named pin to the list
      end
      else
      begin
         // Skip unnamed pins
      end;
   end;

   // Convert the collected named pins to a semicolon-delimited string
   Text = MiscListToString(List, ';');
   Result = Text;
end;

{**
  @brief Return TRUE when a pin name contains a keyword as a literal, case-insensitive substring.
  @details Lowercases both strings and compares every fixed-length substring. This deliberately
           avoids StrContains because that CEETIS primitive treats '*' as a wildcard. Arithmetic
           bounds are computed before StrCopy calls for ATS compiler compatibility.
  @param PinName Pin name to inspect.
  @param ExcludeKeyword Non-empty literal keyword supplied by a validated caller.
  @return TRUE for a literal substring match; otherwise FALSE.
**}
function pin_name_contains_literal_ci(PinName: string; ExcludeKeyword: string): boolean;
begin
   Result = FALSE;
   LowerPinName = StrLowerCase(PinName);
   LowerKeyword = StrLowerCase(ExcludeKeyword);
   PinNameLength = StrLength(LowerPinName);
   KeywordLength = StrLength(LowerKeyword);

   if ((KeywordLength > 0) AND (KeywordLength <= PinNameLength))
   begin
      LastStart = PinNameLength - KeywordLength + 1;
      for Position = 1 to LastStart do
      begin
         CandidateText = StrCopy(LowerPinName, Position, KeywordLength);
         if (StrCompare(CandidateText, LowerKeyword) == 0)
         begin
            Result = TRUE;
         end;
      end;
   end;
end;

{**
  @brief Interpret a raw CEETIS Allowed metadata string.
  @details Accepts TRUE, ON, and 1 as allowed; FALSE, OFF, and 0 as disabled,
           case-insensitively. Any other representation returns -1 so the caller can
           report and abort rather than guess before applying HV or DB.
  @param RawValue Raw string returned by PinGetData.
  @return 1 when allowed, 0 when disabled, or -1 when unknown.
**}
function pin_native_allowed_state(RawValue: string): integer;
begin
   Result = -1;
   LowerValue = StrLowerCase(RawValue);
   if ((StrCompare(LowerValue, 'true') == 0) OR
       (StrCompare(LowerValue, 'on') == 0) OR
       (StrCompare(LowerValue, '1') == 0))
   begin
      Result = 1;
   end
   else
   begin
      if ((StrCompare(LowerValue, 'false') == 0) OR
          (StrCompare(LowerValue, 'off') == 0) OR
          (StrCompare(LowerValue, '0') == 0))
      begin
         Result = 0;
      end;
   end;
end;

function hv_db_debug_header(TestType: string; Mode: string; Name: string; ExcludeKeyword: string; Debug: boolean): void;
begin
   if (Debug)
   begin
      Line = StrAdd('--- ', TestType);
      Line = StrAdd(Line, ' ');
      Line = StrAdd(Line, Mode);
      Line = StrAdd(Line, ' EXCLUSION DEBUG ---');
      UIWriteWarning(Line);
      UIWriteNormal(StrAdd('Name: ', Name));
      UIWriteNormal(StrAdd('ExcludeKeyword: ', ExcludeKeyword));
   end;
end;

function hv_db_debug_found(Pin: tpin; PinName: string; AllowedLabel: string; RawAllowed: string; Debug: boolean): void;
begin
   if (Debug)
   begin
      Line = StrAdd('FOUND: ', PinName);
      Line = StrAdd(Line, ' [Pin=');
      Line = StrAdd(Line, Pin);
      Line = StrAdd(Line, ', ');
      Line = StrAdd(Line, AllowedLabel);
      Line = StrAdd(Line, '=');
      Line = StrAdd(Line, RawAllowed);
      Line = StrAdd(Line, ']');
      UIWriteNormal(Line);
   end;
end;

function hv_db_debug_summary(Found: integer; Tested: integer; KeywordExcluded: integer;
   NativeExcluded: integer; Fallbacks: integer; Attempts: integer; Failures: integer;
   Debug: boolean): void;
begin
   if (Debug)
   begin
      Line = StrAdd('SUMMARY: found=', Found);
      Line = StrAdd(Line, ' tested=');
      Line = StrAdd(Line, Tested);
      Line = StrAdd(Line, ' keyword_excluded=');
      Line = StrAdd(Line, KeywordExcluded);
      Line = StrAdd(Line, ' native_excluded=');
      Line = StrAdd(Line, NativeExcluded);
      Line = StrAdd(Line, ' fallbacks=');
      Line = StrAdd(Line, Fallbacks);
      Line = StrAdd(Line, ' attempts=');
      Line = StrAdd(Line, Attempts);
      Line = StrAdd(Line, ' failures=');
      Line = StrAdd(Line, Failures);
      UIWriteWarning(Line);
   end;
end;

{**
  @brief Test all named pins individually with HV while honoring keyword and native exclusions.
  @param Name Test name passed unchanged to every NoConnAllHV call.
  @param ExcludeKeyword Literal case-insensitive substring matched only against PIN_Name.
  @param Debug When TRUE, prints grouped discovery, raw HV Allowed metadata, decisions, and summary.
  @return TRUE only when at least one primitive call was attempted and every call returned TRUE.
  @details Existing two-argument callers remain compatible. Every named candidate is excluded when
           its name matches or PIN_IsolationHVAllowed is disabled. Supported raw Allowed strings are
           TRUE/ON/1 and FALSE/OFF/0, case-insensitively; unknown values abort before any primitive.
           Empty keywords and zero-call selections also abort. Failures aggregate without stopping.
  @warning This mode filters only the candidate itself; use network mode to protect connected members.
**}
function no_conn_hv_exclude_pin_name(Name: string; ExcludeKeyword: string; Debug: boolean = FALSE): boolean;
begin
   Result = FALSE;
   AllPassed = TRUE;
   PrimitiveCallCount = 0;
   PrimitiveFailureCount = 0;
   TestedCount = 0;
   KeywordExcludedCount = 0;
   NativeExcludedCount = 0;
   FallbackCount = 0;
   CandidateCount = 0;
   MetadataValid = TRUE;

   if (StrCompare(ExcludeKeyword, '') == 0)
   begin
      UIWriteError('HV pin-name exclusion keyword is empty; no HV tests were attempted.');
      MiscAbortTest();
   end
   else
   begin
      hv_db_debug_header('HV', 'PIN-NAME', Name, ExcludeKeyword, Debug);
      NamedPinsText = get_named_pin_list_all();
      if (StrCompare(NamedPinsText, '') <> 0)
      begin
         CandidateCount = MiscListFromString(NamedPinsText, NamedPins, ';');
      end;

      if (CandidateCount > 0)
      begin
         // Validate and audit all native values before the first possible HV call.
         for CandidateIndex = 1 to CandidateCount do
         begin
            CandidatePin = NamedPins[CandidateIndex];
            CandidateName = PinGetData(CandidatePin, PIN_Name);
            RawAllowed = PinGetData(CandidatePin, PIN_IsolationHVAllowed);
            AllowedState = pin_native_allowed_state(RawAllowed);
            hv_db_debug_found(CandidatePin, CandidateName, 'HVAllowed', RawAllowed, Debug);
            if (AllowedState < 0)
            begin
               MetadataValid = FALSE;
               Line = StrAdd('Unknown PIN_IsolationHVAllowed value for ', CandidateName);
               Line = StrAdd(Line, ': ');
               Line = StrAdd(Line, RawAllowed);
               UIWriteError(Line);
            end;
         end;

         if (MetadataValid == FALSE)
         begin
            UIWriteError('HV Allowed metadata validation failed; no HV tests were attempted.');
            MiscAbortTest();
         end
         else
         begin
            for CandidateIndex = 1 to CandidateCount do
            begin
               CandidatePin = NamedPins[CandidateIndex];
               CandidateName = PinGetData(CandidatePin, PIN_Name);
               RawAllowed = PinGetData(CandidatePin, PIN_IsolationHVAllowed);
               AllowedState = pin_native_allowed_state(RawAllowed);
               KeywordExcluded = pin_name_contains_literal_ci(CandidateName, ExcludeKeyword);
               NativeExcluded = FALSE;
               if (AllowedState == 0)
               begin
                  NativeExcluded = TRUE;
               end;

               if (KeywordExcluded)
               begin
                  KeywordExcludedCount = KeywordExcludedCount + 1;
                  if (Debug)
                  begin
                     UIWriteWarning(StrAdd('EXCLUDED - keyword: ', CandidateName));
                  end;
               end;
               if (NativeExcluded)
               begin
                  NativeExcludedCount = NativeExcludedCount + 1;
                  if (Debug)
                  begin
                     UIWriteWarning(StrAdd('EXCLUDED - CEETIS HV disabled: ', CandidateName));
                  end;
               end;

               if ((KeywordExcluded == FALSE) AND (NativeExcluded == FALSE))
               begin
                  if (Debug)
                  begin
                     UIWriteNormal(StrAdd('TEST: ', CandidateName));
                  end;
                  TestedCount = TestedCount + 1;
                  PrimitiveCallCount = PrimitiveCallCount + 1;
                  PrimitivePassed = NoConnAllHV(Name, CandidatePin);
                  if (PrimitivePassed == FALSE)
                  begin
                     AllPassed = FALSE;
                     PrimitiveFailureCount = PrimitiveFailureCount + 1;
                  end;
               end;
            end;
         end;
      end;

      hv_db_debug_summary(CandidateCount, TestedCount, KeywordExcludedCount,
         NativeExcludedCount, FallbackCount, PrimitiveCallCount, PrimitiveFailureCount, Debug);
      if (PrimitiveCallCount == 0)
      begin
         UIWriteError('HV pin-name exclusion selected zero tests; no HV tests were attempted.');
         MiscAbortTest();
      end
      else
      begin
         Result = AllPassed;
      end;
   end;
end;

{**
  @brief Test all named pins individually with DB while honoring keyword and native exclusions.
  @param Name Test name passed unchanged to every NoConnAllDB call.
  @param ExcludeKeyword Literal case-insensitive substring matched only against PIN_Name.
  @param Debug When TRUE, prints grouped discovery, raw DB Allowed metadata, decisions, and summary.
  @return TRUE only when at least one primitive call was attempted and every call returned TRUE.
  @details PIN_DielectricBreakdownAllowed is interpreted centrally as TRUE/ON/1 or FALSE/OFF/0,
           case-insensitively. Unknown metadata, empty keywords, and zero-call selections abort safely.
**}
function no_conn_db_exclude_pin_name(Name: string; ExcludeKeyword: string; Debug: boolean = FALSE): boolean;
begin
   Result = FALSE;
   AllPassed = TRUE;
   PrimitiveCallCount = 0;
