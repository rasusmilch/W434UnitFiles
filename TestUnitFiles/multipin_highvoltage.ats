               UIWriteError(Line);
            end;
         end;

         if (MetadataValid == FALSE)
         begin
            UIWriteError('DB Allowed metadata validation failed; no DB tests were attempted.');
            MiscAbortTest();
         end
         else
         begin
            for CandidateIndex = 1 to CandidateCount do
            begin
               CandidatePin = NamedPins[CandidateIndex];
               CandidateName = PinGetData(CandidatePin, PIN_Name);
               RawAllowed = PinGetData(CandidatePin, PIN_DielectricBreakdownAllowed);
               AllowedState = pin_native_allowed_state(RawAllowed);
               KeywordExcluded = pin_name_contains_literal_ci(CandidateName, ExcludeKeyword);
               NativeExcluded = FALSE;
               if (AllowedState == 0)
               begin
                  NativeExcluded = TRUE;
               end;

               if (KeywordExcluded)
               begin
                  KeywordExcludedCount = KeywordExcludedCount + 1;
                  if (Debug)
                  begin
                     UIWriteWarning(StrAdd('EXCLUDED - keyword: ', CandidateName));
                  end;
               end;
               if (NativeExcluded)
               begin
                  NativeExcludedCount = NativeExcludedCount + 1;
                  if (Debug)
                  begin
                     UIWriteWarning(StrAdd('EXCLUDED - CEETIS DB disabled: ', CandidateName));
                  end;
               end;

               if ((KeywordExcluded == FALSE) AND (NativeExcluded == FALSE))
               begin
                  if (Debug)
                  begin
                     UIWriteNormal(StrAdd('TEST: ', CandidateName));
                  end;
                  TestedCount = TestedCount + 1;
                  PrimitiveCallCount = PrimitiveCallCount + 1;
                  PrimitivePassed = NoConnAllDB(Name, CandidatePin);
                  if (PrimitivePassed == FALSE)
                  begin
                     AllPassed = FALSE;
                     PrimitiveFailureCount = PrimitiveFailureCount + 1;
                  end;
               end;
            end;
         end;
      end;

      hv_db_debug_summary(CandidateCount, TestedCount, KeywordExcludedCount,
         NativeExcludedCount, FallbackCount, PrimitiveCallCount, PrimitiveFailureCount, Debug);
      if (PrimitiveCallCount == 0)
      begin
         UIWriteError('DB pin-name exclusion selected zero tests; no DB tests were attempted.');
         MiscAbortTest();
      end
      else
      begin
         Result = AllPassed;
      end;
   end;
end;

{**
  @brief Test each allowed modeled electrical network once with HV.
  @param Name Test name passed unchanged to every NoConnAllHV call.
  @param ExcludeKeyword Literal case-insensitive substring matched against every nonempty PIN_Name.
  @param Debug When TRUE, audits candidates, raw HV Allowed values, networks, reasons, fallbacks, and summary.
  @return TRUE only when at least one primitive call was attempted and every call returned TRUE.
  @details The protective closure contains all documented component types, ANY switches, and splices.
           A keyword match or native HV-disabled named real candidate member excludes the whole resolved
           network. Native values are prevalidated before testing. Unknown values abort rather than guess.
           Successfully resolved networks are address-deduplicated even after primitive failure. Discovery
           failure checks the candidate's own native state before the existing candidate-only fallback.
  @warning An unresolved candidate could still reach an unknown disabled member. Debug reports every
           fallback; exact NWGetNetworkPins and RES_HighPins equivalence requires controlled validation.
**}
function no_conn_hv_exclude_network(Name: string; ExcludeKeyword: string; Debug: boolean = FALSE): boolean;
begin
   Result = FALSE;
   AllPassed = TRUE;
   PrimitiveCallCount = 0;
   PrimitiveFailureCount = 0;
   TestedCount = 0;
   KeywordExcludedCount = 0;
   NativeExcludedCount = 0;
   FallbackCount = 0;
   CandidateCount = 0;
   MetadataValid = TRUE;

   if (StrCompare(ExcludeKeyword, '') == 0)
   begin
      UIWriteError('HV network exclusion keyword is empty; no HV tests were attempted.');
      MiscAbortTest();
   end
   else
   begin
      hv_db_debug_header('HV', 'NETWORK', Name, ExcludeKeyword, Debug);
      NamedPinsText = get_named_pin_list_all();
      if (StrCompare(NamedPinsText, '') <> 0)
      begin
         CandidateCount = MiscListFromString(NamedPinsText, NamedPins, ';');
      end;

      if (CandidateCount > 0)
      begin
         // Prevalidate all applicable native metadata before any network can be energized.
         for CandidateIndex = 1 to CandidateCount do
         begin
            CandidatePin = NamedPins[CandidateIndex];
            CandidateName = PinGetData(CandidatePin, PIN_Name);
            RawAllowed = PinGetData(CandidatePin, PIN_IsolationHVAllowed);
            AllowedState = pin_native_allowed_state(RawAllowed);
            hv_db_debug_found(CandidatePin, CandidateName, 'HVAllowed', RawAllowed, Debug);
            if (AllowedState < 0)
            begin
               MetadataValid = FALSE;
               Line = StrAdd('Unknown PIN_IsolationHVAllowed value for ', CandidateName);
               Line = StrAdd(Line, ': ');
               Line = StrAdd(Line, RawAllowed);
               UIWriteError(Line);
            end;
         end;

         if (MetadataValid == FALSE)
         begin
            UIWriteError('HV Allowed metadata validation failed; no HV tests were attempted.');
            MiscAbortTest();
         end
         else
         begin
            MiscCreateList(ProcessedCandidates, CandidateCount);
            ProcessedCandidateSize = MiscGetListSize(ProcessedCandidates);
            if (ProcessedCandidateSize < CandidateCount)
            begin
               UIWriteError('HV network bookkeeping allocation failed; no HV tests were attempted.');
               MiscAbortTest();
            end
            else
            begin
               for CandidateIndex = 1 to CandidateCount do
               begin
                  ProcessedCandidates[CandidateIndex] = FALSE;
               end;

               for CandidateIndex = 1 to CandidateCount do
               begin
                  if (ProcessedCandidates[CandidateIndex] == FALSE)
                  begin
                     CandidatePin = NamedPins[CandidateIndex];
                     CandidateName = PinGetData(CandidatePin, PIN_Name);
                     NetworkCount = NWGetNetworkPins(NetworkPins, CandidatePin,
                        [COMPONENT_Wire, COMPONENT_Switch, COMPONENT_Resistor, COMPONENT_Capacitor,
                         COMPONENT_Diode, COMPONENT_ZDiode, COMPONENT_CTwist, COMPONENT_RLCCombination,
                         COMPONENT_Attenuator, COMPONENT_CustomComponent, COMPONENT_VariableResistor],
                        ANY, TRUE);

                     OriginFound = FALSE;
                     if (NetworkCount > 0)
                     begin
                        for NetworkIndex = 1 to NetworkCount do
                        begin
                           if (NetworkPins[NetworkIndex] == CandidatePin)
                           begin
                              OriginFound = TRUE;
                           end;
                        end;
                     end;

                     if (OriginFound)
                     begin
                        NetworkExcluded = FALSE;
                        NetworkKeywordExcluded = FALSE;
                        NetworkNativeExcluded = FALSE;
                        NetworkText = 'NETWORK: ';
                        for NetworkIndex = 1 to NetworkCount do
                        begin
                           NetworkPin = NetworkPins[NetworkIndex];
                           NetworkPinName = PinGetData(NetworkPin, PIN_Name);
                           if (NetworkIndex > 1)
                           begin
                              NetworkText = StrAdd(NetworkText, ', ');
                           end;
                           if (StrCompare(NetworkPinName, '') == 0)
                           begin
                              NetworkText = StrAdd(NetworkText, '<unnamed>');
                           end
                           else
                           begin
                              NetworkText = StrAdd(NetworkText, NetworkPinName);
                           end;
                           NetworkText = StrAdd(NetworkText, '[');
                           NetworkText = StrAdd(NetworkText, NetworkPin);
                           NetworkText = StrAdd(NetworkText, ']');

                           KeywordExcluded = FALSE;
                           if (StrCompare(NetworkPinName, '') <> 0)
                           begin
                              KeywordExcluded = pin_name_contains_literal_ci(NetworkPinName, ExcludeKeyword);
                           end;
                           if (KeywordExcluded)
                           begin
                              NetworkExcluded = TRUE;
                              NetworkKeywordExcluded = TRUE;
                              if (Debug)
                              begin
                                 UIWriteWarning(StrAdd('EXCLUDED NETWORK - keyword member: ', NetworkPinName));
                              end;
                           end;

                           // Only initial named real candidates have applicable, prevalidated metadata.
                           NativeMemberFound = FALSE;
                           NativeExcluded = FALSE;
                           for LookupIndex = 1 to CandidateCount do
                           begin
                              if (NamedPins[LookupIndex] == NetworkPin)
                              begin
                                 NativeMemberFound = TRUE;
                              end;
                           end;
                           if (NativeMemberFound)
                           begin
                              RawAllowed = PinGetData(NetworkPin, PIN_IsolationHVAllowed);
                              AllowedState = pin_native_allowed_state(RawAllowed);
                              NativeExcluded = FALSE;
                              if (AllowedState == 0)
                              begin
                                 NativeExcluded = TRUE;
                              end;
                           end;
                           if (NativeExcluded)
                           begin
                              NetworkExcluded = TRUE;
                              NetworkNativeExcluded = TRUE;
                              if (Debug)
                              begin
                                 UIWriteWarning(StrAdd('EXCLUDED NETWORK - CEETIS HV-disabled member: ', NetworkPinName));
                              end;
                           end;
                        end;

                        if (Debug)
                        begin
                           UIWriteNormal(StrAdd('REPRESENTATIVE: ', CandidateName));
                           UIWriteNormal(NetworkText);
                        end;
                        if (NetworkKeywordExcluded)
                        begin
                           KeywordExcludedCount = KeywordExcludedCount + 1;
                        end;
                        if (NetworkNativeExcluded)
                        begin
                           NativeExcludedCount = NativeExcludedCount + 1;
                        end;

                        for MarkIndex = 1 to CandidateCount do
                        begin
                           for NetworkIndex = 1 to NetworkCount do
                           begin
                              if (NamedPins[MarkIndex] == NetworkPins[NetworkIndex])
                              begin
                                 ProcessedCandidates[MarkIndex] = TRUE;
                              end;
                           end;
                        end;

                        if (NetworkExcluded)
                        begin
                           if (Debug)
                           begin
                              UIWriteWarning(StrAdd('EXCLUDED NETWORK: representative ', CandidateName));
                           end;
                        end
                        else
                        begin
                           if (Debug)
                           begin
                              UIWriteNormal(StrAdd('TEST NETWORK: representative ', CandidateName));
                           end;
                           TestedCount = TestedCount + 1;
                           PrimitiveCallCount = PrimitiveCallCount + 1;
                           PrimitivePassed = NoConnAllHV(Name, CandidatePin);
                           if (PrimitivePassed == FALSE)
                           begin
                              AllPassed = FALSE;
                              PrimitiveFailureCount = PrimitiveFailureCount + 1;
                           end;
                        end;
                     end
                     else
                     begin
                        FallbackCount = FallbackCount + 1;
                        RawAllowed = PinGetData(CandidatePin, PIN_IsolationHVAllowed);
                        AllowedState = pin_native_allowed_state(RawAllowed);
                        KeywordExcluded = pin_name_contains_literal_ci(CandidateName, ExcludeKeyword);
                        NativeExcluded = FALSE;
                        if (AllowedState == 0)
                        begin
                           NativeExcluded = TRUE;
                        end;
                        if (Debug)
                        begin
                           UIWriteWarning(StrAdd('WARNING: network discovery failed for ', CandidateName));
                           UIWriteWarning('Network membership could not be proven; applying candidate-only fallback.');
                        end;
                        if (KeywordExcluded)
                        begin
                           KeywordExcludedCount = KeywordExcludedCount + 1;
                           if (Debug)
                           begin
                              UIWriteWarning(StrAdd('FALLBACK EXCLUDED - keyword: ', CandidateName));
                           end;
                        end;
                        if (NativeExcluded)
                        begin
                           NativeExcludedCount = NativeExcludedCount + 1;
                           if (Debug)
                           begin
                              UIWriteWarning(StrAdd('FALLBACK EXCLUDED - CEETIS HV disabled: ', CandidateName));
                           end;
                        end;
                        if ((KeywordExcluded == FALSE) AND (NativeExcluded == FALSE))
                        begin
                           if (Debug)
                           begin
                              UIWriteWarning(StrAdd('FALLBACK TEST: ', CandidateName));
                           end;
                           TestedCount = TestedCount + 1;
                           PrimitiveCallCount = PrimitiveCallCount + 1;
                           PrimitivePassed = NoConnAllHV(Name, CandidatePin);
                           if (PrimitivePassed == FALSE)
                           begin
                              AllPassed = FALSE;
                              PrimitiveFailureCount = PrimitiveFailureCount + 1;
                           end;
                        end;
                     end;
                  end;
               end;
            end;
         end;
      end;

      hv_db_debug_summary(CandidateCount, TestedCount, KeywordExcludedCount,
         NativeExcludedCount, FallbackCount, PrimitiveCallCount, PrimitiveFailureCount, Debug);
      if (PrimitiveCallCount == 0)
      begin
         UIWriteError('HV network exclusion selected zero tests; no HV tests were attempted.');
         MiscAbortTest();
      end
      else
      begin
         Result = AllPassed;
      end;
   end;
end;

{**
  @brief Test each allowed modeled electrical network once with DB.
  @param Name Test name passed unchanged to every NoConnAllDB call.
  @param ExcludeKeyword Literal case-insensitive substring matched against every nonempty PIN_Name.
  @param Debug When TRUE, audits candidates, raw DB Allowed values, networks, reasons, fallbacks, and summary.
  @return TRUE only when at least one primitive call was attempted and every call returned TRUE.
  @details A keyword match or native DB-disabled named real candidate member excludes the complete
           resolved network. PIN_DielectricBreakdownAllowed values are prevalidated before testing.
           Network resolution, exact-address deduplication, component closure, and zero-call safeguards
           match HV mode. Discovery fallback always checks the candidate's own native DB setting.
  @warning Debug exposes fallback ambiguity and protective-closure over-exclusion for controlled review.
**}
function no_conn_db_exclude_network(Name: string; ExcludeKeyword: string; Debug: boolean = FALSE): boolean;
begin
   Result = FALSE;
   AllPassed = TRUE;
   PrimitiveCallCount = 0;
   PrimitiveFailureCount = 0;
   TestedCount = 0;
   KeywordExcludedCount = 0;
   NativeExcludedCount = 0;
   FallbackCount = 0;
   CandidateCount = 0;
   MetadataValid = TRUE;

   if (StrCompare(ExcludeKeyword, '') == 0)
   begin
      UIWriteError('DB network exclusion keyword is empty; no DB tests were attempted.');
      MiscAbortTest();
   end
   else
   begin
      hv_db_debug_header('DB', 'NETWORK', Name, ExcludeKeyword, Debug);
      NamedPinsText = get_named_pin_list_all();
      if (StrCompare(NamedPinsText, '') <> 0)
      begin
         CandidateCount = MiscListFromString(NamedPinsText, NamedPins, ';');
      end;

      if (CandidateCount > 0)
      begin
         for CandidateIndex = 1 to CandidateCount do
         begin
            CandidatePin = NamedPins[CandidateIndex];
            CandidateName = PinGetData(CandidatePin, PIN_Name);
            RawAllowed = PinGetData(CandidatePin, PIN_DielectricBreakdownAllowed);
            AllowedState = pin_native_allowed_state(RawAllowed);
            hv_db_debug_found(CandidatePin, CandidateName, 'DBAllowed', RawAllowed, Debug);
            if (AllowedState < 0)
            begin
               MetadataValid = FALSE;
               Line = StrAdd('Unknown PIN_DielectricBreakdownAllowed value for ', CandidateName);
               Line = StrAdd(Line, ': ');
               Line = StrAdd(Line, RawAllowed);
               UIWriteError(Line);
            end;
         end;

         if (MetadataValid == FALSE)
         begin
            UIWriteError('DB Allowed metadata validation failed; no DB tests were attempted.');
            MiscAbortTest();
         end
         else
         begin
            MiscCreateList(ProcessedCandidates, CandidateCount);
            ProcessedCandidateSize = MiscGetListSize(ProcessedCandidates);
            if (ProcessedCandidateSize < CandidateCount)
            begin
               UIWriteError('DB network bookkeeping allocation failed; no DB tests were attempted.');
               MiscAbortTest();
            end
            else
            begin
               for CandidateIndex = 1 to CandidateCount do
               begin
                  ProcessedCandidates[CandidateIndex] = FALSE;
               end;

               for CandidateIndex = 1 to CandidateCount do
               begin
                  if (ProcessedCandidates[CandidateIndex] == FALSE)
                  begin
                     CandidatePin = NamedPins[CandidateIndex];
                     CandidateName = PinGetData(CandidatePin, PIN_Name);
                     NetworkCount = NWGetNetworkPins(NetworkPins, CandidatePin,
                        [COMPONENT_Wire, COMPONENT_Switch, COMPONENT_Resistor, COMPONENT_Capacitor,
                         COMPONENT_Diode, COMPONENT_ZDiode, COMPONENT_CTwist, COMPONENT_RLCCombination,
                         COMPONENT_Attenuator, COMPONENT_CustomComponent, COMPONENT_VariableResistor],
                        ANY, TRUE);

                     OriginFound = FALSE;
                     if (NetworkCount > 0)
                     begin
                        for NetworkIndex = 1 to NetworkCount do
                        begin
                           if (NetworkPins[NetworkIndex] == CandidatePin)
                           begin
                              OriginFound = TRUE;
                           end;
                        end;
                     end;

                     if (OriginFound)
                     begin
                        NetworkExcluded = FALSE;
                        NetworkKeywordExcluded = FALSE;
                        NetworkNativeExcluded = FALSE;
                        NetworkText = 'NETWORK: ';
                        for NetworkIndex = 1 to NetworkCount do
                        begin
                           NetworkPin = NetworkPins[NetworkIndex];
                           NetworkPinName = PinGetData(NetworkPin, PIN_Name);
                           if (NetworkIndex > 1)
                           begin
                              NetworkText = StrAdd(NetworkText, ', ');
                           end;
                           if (StrCompare(NetworkPinName, '') == 0)
                           begin
                              NetworkText = StrAdd(NetworkText, '<unnamed>');
                           end
                           else
                           begin
                              NetworkText = StrAdd(NetworkText, NetworkPinName);
                           end;
                           NetworkText = StrAdd(NetworkText, '[');
                           NetworkText = StrAdd(NetworkText, NetworkPin);
                           NetworkText = StrAdd(NetworkText, ']');

                           KeywordExcluded = FALSE;
                           if (StrCompare(NetworkPinName, '') <> 0)
                           begin
                              KeywordExcluded = pin_name_contains_literal_ci(NetworkPinName, ExcludeKeyword);
                           end;
                           if (KeywordExcluded)
                           begin
                              NetworkExcluded = TRUE;
                              NetworkKeywordExcluded = TRUE;
                              if (Debug)
                              begin
                                 UIWriteWarning(StrAdd('EXCLUDED NETWORK - keyword member: ', NetworkPinName));
                              end;
                           end;

                           NativeMemberFound = FALSE;
                           NativeExcluded = FALSE;
                           for LookupIndex = 1 to CandidateCount do
                           begin
                              if (NamedPins[LookupIndex] == NetworkPin)
                              begin
                                 NativeMemberFound = TRUE;
                              end;
                           end;
                           if (NativeMemberFound)
                           begin
                              RawAllowed = PinGetData(NetworkPin, PIN_DielectricBreakdownAllowed);
                              AllowedState = pin_native_allowed_state(RawAllowed);
                              NativeExcluded = FALSE;
                              if (AllowedState == 0)
                              begin
                                 NativeExcluded = TRUE;
                              end;
                           end;
                           if (NativeExcluded)
                           begin
                              NetworkExcluded = TRUE;
                              NetworkNativeExcluded = TRUE;
                              if (Debug)
                              begin
                                 UIWriteWarning(StrAdd('EXCLUDED NETWORK - CEETIS DB-disabled member: ', NetworkPinName));
                              end;
                           end;
                        end;

                        if (Debug)
                        begin
                           UIWriteNormal(StrAdd('REPRESENTATIVE: ', CandidateName));
                           UIWriteNormal(NetworkText);
                        end;
                        if (NetworkKeywordExcluded)
                        begin
                           KeywordExcludedCount = KeywordExcludedCount + 1;
                        end;
                        if (NetworkNativeExcluded)
                        begin
                           NativeExcludedCount = NativeExcludedCount + 1;
                        end;

                        for MarkIndex = 1 to CandidateCount do
                        begin
                           for NetworkIndex = 1 to NetworkCount do
                           begin
                              if (NamedPins[MarkIndex] == NetworkPins[NetworkIndex])
                              begin
                                 ProcessedCandidates[MarkIndex] = TRUE;
                              end;
                           end;
                        end;

                        if (NetworkExcluded)
                        begin
                           if (Debug)
                           begin
                              UIWriteWarning(StrAdd('EXCLUDED NETWORK: representative ', CandidateName));
                           end;
                        end
                        else
                        begin
                           if (Debug)
                           begin
                              UIWriteNormal(StrAdd('TEST NETWORK: representative ', CandidateName));
                           end;
                           TestedCount = TestedCount + 1;
                           PrimitiveCallCount = PrimitiveCallCount + 1;
                           PrimitivePassed = NoConnAllDB(Name, CandidatePin);
                           if (PrimitivePassed == FALSE)
                           begin
                              AllPassed = FALSE;
                              PrimitiveFailureCount = PrimitiveFailureCount + 1;
                           end;
                        end;
                     end
                     else
                     begin
                        FallbackCount = FallbackCount + 1;
                        RawAllowed = PinGetData(CandidatePin, PIN_DielectricBreakdownAllowed);
                        AllowedState = pin_native_allowed_state(RawAllowed);
                        KeywordExcluded = pin_name_contains_literal_ci(CandidateName, ExcludeKeyword);
                        NativeExcluded = FALSE;
                        if (AllowedState == 0)
                        begin
                           NativeExcluded = TRUE;
                        end;
                        if (Debug)
                        begin
                           UIWriteWarning(StrAdd('WARNING: network discovery failed for ', CandidateName));
                           UIWriteWarning('Network membership could not be proven; applying candidate-only fallback.');
                        end;
                        if (KeywordExcluded)
                        begin
                           KeywordExcludedCount = KeywordExcludedCount + 1;
                           if (Debug)
                           begin
                              UIWriteWarning(StrAdd('FALLBACK EXCLUDED - keyword: ', CandidateName));
                           end;
                        end;
                        if (NativeExcluded)
                        begin
                           NativeExcludedCount = NativeExcludedCount + 1;
                           if (Debug)
                           begin
                              UIWriteWarning(StrAdd('FALLBACK EXCLUDED - CEETIS DB disabled: ', CandidateName));
                           end;
                        end;
                        if ((KeywordExcluded == FALSE) AND (NativeExcluded == FALSE))
                        begin
                           if (Debug)
                           begin
                              UIWriteWarning(StrAdd('FALLBACK TEST: ', CandidateName));
                           end;
                           TestedCount = TestedCount + 1;
                           PrimitiveCallCount = PrimitiveCallCount + 1;
                           PrimitivePassed = NoConnAllDB(Name, CandidatePin);
                           if (PrimitivePassed == FALSE)
                           begin
                              AllPassed = FALSE;
                              PrimitiveFailureCount = PrimitiveFailureCount + 1;
                           end;
                        end;
                     end;
                  end;
               end;
            end;
         end;
      end;

      hv_db_debug_summary(CandidateCount, TestedCount, KeywordExcludedCount,
         NativeExcludedCount, FallbackCount, PrimitiveCallCount, PrimitiveFailureCount, Debug);
      if (PrimitiveCallCount == 0)
      begin
         UIWriteError('DB network exclusion selected zero tests; no DB tests were attempted.');
         MiscAbortTest();
      end
      else
      begin
         Result = AllPassed;
      end;
   end;
end;

// Entry point: marks a guard option as tested, or implicitly required if not already set.
{**
  @brief Set the tested state for a guard option in the global "GUARDS" store.

  @param OptionStr  Token appended to the "REQUIRE_" and "TESTED_" keys to select the guard option.
  @param Debug      Optional flag for verbose behavior (currently unused by this routine).

  @details
  Reads "REQUIRE_<OptionStr>" and "TESTED_<OptionStr>" from the "GUARDS" namespace.
  If the requirement is explicitly TRUE, the routine records "TESTED_<OptionStr>=TRUE".
  If the requirement is not TRUE, the routine implicitly establishes the requirement by
  setting "REQUIRE_<OptionStr>=TRUE". This allows callers that invoke the routine for an
  option not yet declared required to bootstrap that requirement without separate setup.

  @pre GlobalDataRead, GlobalDataWrite, StrAdd, and StrCompare are available and operational.
  @sideeffect Writes to the "GUARDS" namespace in the global data store.
  @return void
**}
function set_guard_tested(OptionStr: string; Debug: boolean = FALSE): void;
begin

   GlobalDataWrite(StrAdd('TESTED_', OptionStr), 'TRUE', 'GUARDS');
   GlobalDataWrite(StrAdd('REQUIRE_', OptionStr), 'TRUE', 'GUARDS');

end;

function no_conn_all_lv_guard(Name: string; Pin1: tpin; Debug: boolean = FALSE): integer;
begin
   Result = NoConnAllLV(Name, Pin1);

   // If the test did not pass, run the standardized failure timing/diagnostic handler.
   if (Result <> TESTSTEP_Passed)
   begin
      // Invoke diagnostic timing logic with the current debug setting.
      timer_fails_check(Debug);
   end;

   if (Result <> TESTSTEP_NotExecuted)
   begin
      // Record that the guard was exercised for this run (post-test bookkeeping).
      set_guard_tested('LV', Debug);
   end;
end;

function no_conn_all_hv_guard(Name: string; Pin1: tpin; Debug: boolean = FALSE): integer;
begin
   Result = NoConnAllHV(Name, Pin1);

   // If the test did not pass, run the standardized failure timing/diagnostic handler.
   if (Result <> TESTSTEP_Passed)
   begin
      // Invoke diagnostic timing logic with the current debug setting.
      timer_fails_check(Debug);
   end;

   if (Result <> TESTSTEP_NotExecuted)
   begin
      // Record that the guard was exercised for this run (post-test bookkeeping).
      set_guard_tested('HV', Debug);
   end;
end;

function no_conn_all_db_guard(Name: string; Pin1: tpin; Debug: boolean = FALSE): integer;
begin
   Result = NoConnAllDB(Name, Pin1);

   // If the test did not pass, run the standardized failure timing/diagnostic handler.
   if (Result <> TESTSTEP_Passed)
   begin
      // Invoke diagnostic timing logic with the current debug setting.
      timer_fails_check(Debug);
   end;

   if (Result <> TESTSTEP_NotExecuted)
   begin
      // Record that the guard was exercised for this run (post-test bookkeeping).
      set_guard_tested('DB', Debug);
   end;
end;

{**
  @brief Execute a wire continuity guard test and update guard bookkeeping after execution.

  @param Name   Human-readable test identifier forwarded to the underlying wire test.
  @param Pin1   First pin under test.
  @param Pin2   Second pin under test.
  @param Debug  When TRUE, enables verbose diagnostics in helper routines.

  @return integer The status code returned by the wire test (e.g., TESTSTEP_Passed on success).

  @details
  Runs a continuity test between two pins using the standard wire test routine. If the
  result is not a passing status, a standardized failure-timing/diagnostic handler is
  invoked. After test execution (regardless of outcome), the routine records that the
  continuity guard has been exercised for this run.

  @pre WireTest, timer_fails_check, and set_guard_tested are available in the environment.
  @post Guard bookkeeping is updated to reflect that the continuity was tested.
**}
function wire_test_guard(Name: string; Pin1: tpin; Pin2: tpin; Debug: boolean = FALSE): integer; tests wires;
begin

   if (Debug)
   begin
      Str = StrAdd('WireTest(', Name);
      Str = StrAdd(Str, ',');
      Str = StrAdd(Str, Pin1);
      Str = StrAdd(Str, ',');
      Str = StrAdd(Str, Pin2);
      Str = StrAdd(Str, ');');
      UIWriteWarning(Str);
   end;

   // Execute the continuity test between Pin1 and Pin2; capture the result code.
   Result = WireTest(Name, Pin1, Pin2);

   // If the test did not pass, run the standardized failure timing/diagnostic handler.
   if (Result <> TESTSTEP_Passed)
   begin
      // Invoke diagnostic timing logic with the current debug setting.
      timer_fails_check(Debug);
   end;

   if (Result <> TESTSTEP_NotExecuted)
   begin
      // Record that the continuity guard was exercised for this run (post-test bookkeeping).
      set_guard_tested('CONTINUITY', Debug);
   end;
end;

{**
  @brief Execute continuity guard tests across all discovered pin networks and compute an overall result.

  @param Debug  When TRUE, enables verbose diagnostics in helper routines used by this procedure.

  @return integer Overall step status: TESTSTEP_Passed if no continuity failures are detected; otherwise TESTSTEP_Failed.

  @details
  The routine enumerates primary pins from the netlist, then for each primary pin resolves its
  full network (all interconnected pins). The first pin of each network is treated as the primary
  reference; it is paired against each remaining pin in that network and evaluated via wire_test_guard.
  Any non-passing result increments a failure counter and triggers the standardized failure timing/
  diagnostic routine. If no failures are recorded across all discovered networks, the overall result
  is set to TESTSTEP_Passed; otherwise it remains TESTSTEP_Failed.

  @pre get_netlist_primary, get_netlist_from_primary_pin, MiscListFromString, wire_test_guard,
       UIWriteError, MiscAbortTest, and timer_fails_check are present and operational.

  @post On non-passing subtests, diagnostics/timing may be recorded by timer_fails_check.
**}
function test_wires_guard(Debug: boolean = FALSE): integer;
begin
   // Initialize failure counter and default overall result to failed.
   Fails = 0;
   Result = TESTSTEP_Failed;

   // Retrieve primary pins as a semicolon-delimited string (source of networks to test).
   AllPrimaryPinListStr = get_netlist_primary(Debug);

   if (Debug)
   begin
      UIWriteWarning(AllPrimaryPinListStr);
   end;

   // Parse primary pin list into ListAllPrimaryPins; Count receives the number of items.
   Count = MiscListFromString(AllPrimaryPinListStr,ListAllPrimaryPins,';');

   // Abort the test sequence if no primary pins were found.
   if (Count == 0)
   begin
      UIWriteError('NO PINS FOUND!');
      MiscAbortTest();
   end;

   // Iterate over each primary pin to process its associated network.
   for Index = 1 to Count do
   begin
      // Resolve the full network string (all pins connected to the current primary pin).
      NetworkPinListStr = get_netlist_from_primary_pin(ListAllPrimaryPins[Index], Debug);

      if (Debug)
      begin
         UIWriteWarning(NetworkPinListStr);
      end;

      // Tokenize the network into ListAllNetworkPins; NWCount receives the network size.
      NWCount = MiscListFromString(NetworkPinListStr,ListAllNetworkPins,';');

      // A valid network must contain at least two pins (primary + one secondary).
      if (NWCount < 2)
      begin
         UIWriteError('NO SECONDARY PINS FOUND');
         MiscAbortTest();
      end;

      // Select the first entry as the primary reference pin for pairwise continuity checks.
      PrimaryPin = ListAllNetworkPins[1];

      // Pair the primary pin against each remaining pin in the network.
      for SecondIndex = 2 to NWCount do
      begin
         // Select the next secondary pin to test against the primary reference.
         SecondaryPin = ListAllNetworkPins[SecondIndex];

         // Run the continuity guard test between the primary and secondary pins.
         TestResult = wire_test_guard('WIRE', PrimaryPin, SecondaryPin, Debug);

         // On any non-passing outcome, record the failure and run timing/diagnostics.
         if (TestResult <> TESTSTEP_Passed)
         begin
            Fails = Fails + 1;
            timer_fails_check(Debug);
         end;
      end;
   end;

   // If no failures were recorded across all networks, set overall result to passed.
   if (Fails == 0)
   begin
      Result = TESTSTEP_Passed;
   end;
end;


{**
 @brief Run a no-connection dielectric breakdown test between two labeled pin lists.

 @details
   Defines two pin groups for the dielectric breakdown no-connection test:
   - HIGH group: pins provided in @p HighList, labeled by @p HighName.
   - LOW  group: pins provided in @p LowList,  labeled by @p LowName.
   Optionally logs the resolved pin-name strings when @p Debug is TRUE, then
   invokes @c NoConnGroupDB with the supplied labels and lists.

 @param HighName  Label for the HIGH group (e.g., a descriptive name or category).
 @param HighList  Pin array comprising the HIGH group.
 @param LowName   Label for the LOW group (e.g., "ALL OTHER PINS").
 @param LowList   Pin array comprising the LOW group.
 @param Debug     When TRUE, emits human-readable lists of both groups to the UI.

 @return void

 @pre
   - @p HighList and @p LowList are valid @c tpinarray values.
   - Helper routines are available: @c PinDefineList, @c transform_pinlist_name_str,
     @c UIWriteNormal, @c StrAdd, @c NoConnGroupDB.

 @post
   - The no-connection dielectric breakdown group test is executed using the given
     labels and pin lists; if @p Debug is TRUE, group compositions are logged beforehand.

 @note
   - This routine does not modify the input lists; it defines internal groups and
     delegates execution to @c NoConnGroupDB.
*}
function no_conn_db_lists(HighName: string; HighList: tpinarray; LowName: string; LowList: tpinarray; Debug: boolean = FALSE): void;
begin
   // Define the HIGH group from the provided HighList for dielectric breakdown testing.
   PinDefineList(PinHigh, HighList);

   // Define the LOW group from the provided LowList for dielectric breakdown testing.
   PinDefineList(PinLow, LowList);

   // If debugging is enabled, stringify and log both group lists.
   if (Debug)
   begin
      // Build a printable name string for the HIGH list.
      HighListPinNames = transform_pinlist_name_str(HighList);

      // Build a printable name string for the LOW list.
      LowListPinNames = transform_pinlist_name_str(LowList);

      // Emit the HIGH list names to the UI.
      UIWriteNormal(StrAdd('HighListPinNames -> ', HighListPinNames));

      // Emit the LOW list names to the UI.
      UIWriteNormal(StrAdd('LowListPinNames -> ', LowListPinNames));
   end;

   // Invoke the no-connection dielectric breakdown group test with labels and lists.
   NoConnGroupDB('NCDB', HighName, HighList, LowName, LowList);

   timer_fails_check(Debug);

   set_guard_tested('DB');
end;



{**
 @brief Perform a no-connection dielectric breakdown test with HIGH pins selected by a PIN_Info substring; all others are LOW.

 @details
   Partitions the complete pin set into two groups based on @p PinInfoStr:
   - HIGH group: pins whose PIN_Info field contains the provided substring.
   - LOW group : every remaining pin (set difference Full - High).
   Optionally logs human-readable name lists when @p Debug is TRUE, then invokes
   @c no_conn_db_lists to execute the no-connection dielectric breakdown test.

 @param PinInfoStr  Substring matched against each pin's PIN_Info field to define the HIGH group.
 @param Debug       When TRUE, writes the full and HIGH pin name lists to the UI for traceability.

 @return void

 @pre
   The following helpers are available and behave as implied:
   get_named_pin_list_all, MiscListFromString, PinCreateList, MiscSubtractLists,
   transform_pinlist_name_str, UIWriteNormal, StrAdd, no_conn_db_lists.
   Working variables (e.g., FullPinList, HighPinList, LowPinList, HighNames, FullPinListNames) are valid in scope.

 @post
   No-connection dielectric breakdown test executed with:
   - HIGH = match(PIN_Info, PinInfoStr)
   - LOW  = FullPinList - HighPinList
*}
function nc_db_pin_info_high(PinInfoStr: string; Debug: boolean = FALSE): void;
begin
   // Retrieve the master list of all named pins as a delimited string.
   AllPinsListStr = get_named_pin_list_all();

   // Parse the master list into FullPinList using ';' as the delimiter.
   MiscListFromString(AllPinsListStr,FullPinList,';');

   // Build the HIGH group by selecting pins whose PIN_Info contains PinInfoStr.
   Count = PinCreateList(HighPinList, PIN_Info, PinInfoStr);

   if (Count == 0)
   begin
      UIWriteError(StrAdd('Error: Found 0 pins with given PinInfo: ', PinInfoStr));
      MiscAbortTest();
   end;

   if (Debug)
   begin
      UIWriteWarning(StrAdd('PinInfoStr: ', PinInfoStr));
      UIWriteWarning(StrAdd('PinInfo Count: ', Count));
   end;

   // Derive the LOW group as FullPinList minus HighPinList.
   MiscSubtractLists(LowPinList, FullPinList, HighPinList);

   // Create a comma-separated name string for the HIGH pins.
   HighNames = transform_pinlist_name_str(HighPinList);

   // When debugging, emit the full and HIGH pin name lists to the UI.
   if (Debug)
   begin
      // Create a printable name string for the full pin list.
      FullPinListNames = transform_pinlist_name_str(FullPinList);

      // Log the full pin set.
      UIWriteNormal(StrAdd('FullPinList -> ', FullPinListNames));

      // Log the HIGH pin set.
      UIWriteNormal(StrAdd('HighPinList -> ', HighNames));
   end;

   // Execute the no-connection dielectric breakdown test with the HIGH and LOW groups.
   no_conn_db_lists(HighNames, HighPinList, 'ALL OTHER PINS', LowPinList, Debug);
end;



{**
 @brief Perform a no-connection dielectric breakdown test with LOW pins selected by a PIN_Info substring; all others are HIGH.

 @details
   Partitions the complete pin set into two groups based on @p PinInfoStr:
   - LOW group : pins whose PIN_Info field contains the provided substring.
   - HIGH group: all remaining pins (set difference Full - Low).
   Optionally logs human-readable name lists when @p Debug is TRUE, then invokes
   @c no_conn_db_lists using the labeled HIGH group ("ALL OTHER PINS") and the derived LOW group.

 @param PinInfoStr  Substring matched against each pin's PIN_Info field to define the LOW group.
 @param Debug       When TRUE, writes the full and LOW pin name lists to the UI for traceability.

 @return void

 @pre
   The following helpers are available and behave as implied:
   get_named_pin_list_all, MiscListFromString, PinCreateList, MiscSubtractLists,
   transform_pinlist_name_str, UIWriteNormal, StrAdd, no_conn_db_lists.

 @post
   No-connection dielectric breakdown test executed with:
   - HIGH = FullPinList - LowPinList
   - LOW  = match(PIN_Info, PinInfoStr)
*}
function nc_db_pin_info_low(PinInfoStr: string; Debug: boolean = FALSE): void;
begin
   // Retrieve the master list of all named pins as a delimited string.
   AllPinsListStr = get_named_pin_list_all(Debug);

   // Parse the master pin string into FullPinList using ';' as the delimiter.
   MiscListFromString(AllPinsListStr,FullPinList,';');

   // Build the LOW group by selecting pins whose PIN_Info contains PinInfoStr.
   Count = PinCreateList(LowPinList, PIN_Info, PinInfoStr);

   if (Count == 0)
   begin
      UIWriteError(StrAdd('Error: Found 0 pins with given PinInfo: ', PinInfoStr));
      MiscAbortTest();
   end;

   if (Debug)
   begin
      UIWriteWarning(StrAdd('PinInfoStr: ', PinInfoStr));
      UIWriteWarning(StrAdd('PinInfo Count: ', Count));
   end;

   // Derive the HIGH group as the set difference: FullPinList minus LowPinList.
   MiscSubtractLists(HighPinList, FullPinList, LowPinList);

   // Create a comma-separated LOW pin name string for reporting and API usage.
   LowNames = transform_pinlist_name_str(LowPinList);

   // If debugging, stringify the full and LOW pin lists and write them to the UI.
   if (Debug)
   begin
      // Produce a printable name string for the full pin list.
      FullPinListNames = transform_pinlist_name_str(FullPinList);

      // Log the full and LOW pin sets for verification and traceability.
      UIWriteNormal(StrAdd('FullPinList -> ', FullPinListNames));
      UIWriteNormal(StrAdd('LowPinList -> ', LowNames));
   end;

   // Execute the no-connection dielectric breakdown test with HIGH vs. LOW groups.
   no_conn_db_lists('ALL OTHER PINS', HighPinList, LowNames, LowPinList, Debug);
end;




{**
 @brief Run a high-voltage (HV) no-connection group test between two explicit pin lists.

 @details
   This routine defines two pin groups for HV no-connection testing:
   - HIGH group: pins specified by @p HighList, labeled with @p HighName.
   - LOW  group: pins specified by @p LowList,  labeled with @p LowName.
   It optionally logs the resolved pin names when @p Debug is TRUE, then invokes
   the database-backed HV test @c NoConnGroupHV with the constructed groups.

 @param HighName  Human-readable label for the HIGH group (e.g., a list or role name).
 @param HighList  Pin array comprising the HIGH group to be driven/considered as HIGH.
 @param LowName   Human-readable label for the LOW group (e.g., "ALL OTHER PINS").
 @param LowList   Pin array comprising the LOW group to be driven/considered as LOW.
 @param Debug     When TRUE, prints the name-expanded contents of both groups.

 @return void

 @pre
   - @p HighList and @p LowList are valid @c tpinarray values.
   - @p PinHigh and @p PinLow are valid pin-set identifiers for @c PinDefineList.
   - Helper functions exist: @c PinDefineList, @c transform_pinlist_name_str, @c UIWriteNormal, @c StrAdd, @c NoConnGroupHV.

 @post
   - The HV no-connection group test is executed with the provided HIGH and LOW groups.
   - If @p Debug is TRUE, group compositions are emitted to the UI prior to test execution.

 @note
   - This function does not alter input lists; it defines internal test groups and delegates to @c NoConnGroupHV.
*}
function no_conn_hv_lists(HighName: string; HighList: tpinarray; LowName: string; LowList: tpinarray; Debug: boolean = FALSE): void;
begin
   // Define the HIGH test group from the provided HighList.
   PinDefineList(PinHigh, HighList);

   // Define the LOW test group from the provided LowList.
   PinDefineList(PinLow, LowList);

   // If debug is enabled, stringify both lists and write them to the UI.
   if (Debug)
   begin
      // Create a printable name string for the HIGH list.
      HighListPinNames = transform_pinlist_name_str(HighList);

      // Create a printable name string for the LOW list.
      LowListPinNames = transform_pinlist_name_str(LowList);

      // Emit the HIGH list names to the UI.
      UIWriteNormal(StrAdd('HighListPinNames -> ', HighListPinNames));

      // Emit the LOW list names to the UI.
      UIWriteNormal(StrAdd('LowListPinNames -> ', LowListPinNames));
   end;

   // Execute the HV no-connection group test with the labeled HIGH and LOW groups.
   NoConnGroupHV('NCHV', HighName, PinHigh, LowName, PinLow);

   timer_fails_check(Debug);
   
   set_guard_tested('HV');

end;



{**
 @brief Execute an HV no-connection test where HIGH pins are selected by a PIN_Info substring.

 @details
   Constructs two groups from the complete pin set:
   - HIGH: pins whose PIN_Info field contains @p PinInfoStr.
   - LOW : all remaining pins (set difference Full - High).
   Invokes @c no_conn_hv_lists to perform the high-voltage open (no-connection) test.
   If @p Debug is TRUE, logs the resolved name lists for verification.

 @param PinInfoStr  Substring to match against each pin's PIN_Info field; matching pins form the HIGH group.
 @param Debug       TRUE enables diagnostic UI output of the full and HIGH pin lists.

 @return void

 @pre
   The following helpers are available and behave as implied: get_named_pin_list_all, MiscListFromString,
   PinCreateList, MiscSubtractLists, transform_pinlist_name_str, UIWriteNormal, StrAdd, no_conn_hv_lists.

 @post
   HV no-connection test executed with HIGH = match(PIN_Info, PinInfoStr) and LOW = FullPinList - HighPinList.

 @note
   Matching semantics for HIGH selection follow @c PinCreateList with the @c PIN_Info selector.
*}
function nc_hv_pin_info_high(PinInfoStr: string; Debug: boolean = FALSE): void;
begin
   // Retrieve a string containing all named pins.
   AllPinsListStr = get_named_pin_list_all();

   // Parse the master pin string into FullPinList using ';' as the delimiter.
   MiscListFromString(AllPinsListStr,FullPinList,';');

   // Build HighPinList by selecting pins whose PIN_Info contains PinInfoStr.
   Count = PinCreateList(HighPinList, PIN_Info, PinInfoStr);

   if (Count == 0)
   begin
      UIWriteError(StrAdd('Error: Found 0 pins with given PinInfo: ', PinInfoStr));
      MiscAbortTest();
   end;

   if (Debug)
   begin
      UIWriteWarning(StrAdd('PinInfoStr: ', PinInfoStr));
      UIWriteWarning(StrAdd('PinInfo Count: ', Count));
   end;

   // Derive LowPinList as the set difference: FullPinList minus HighPinList.
   MiscSubtractLists(LowPinList, FullPinList, HighPinList);

   // Create a comma-separated HIGH pin name string for reporting and test API.
   HighNames = transform_pinlist_name_str(HighPinList);

   // If Debug is TRUE, emit the resolved pin name lists to the UI.
   if (Debug)
   begin
      // Convert FullPinList into a printable name string.
      FullPinListNames = transform_pinlist_name_str(FullPinList);

      // Log the full pin set for traceability.
      UIWriteNormal(StrAdd('FullPinList -> ', FullPinListNames));

      // Log the HIGH pin set for verification.
      UIWriteNormal(StrAdd('HighPinList -> ', HighNames));
   end;

   // Run the HV no-connection test using HIGH vs. "ALL OTHER PINS" (LOW group).
   no_conn_hv_lists(HighNames, HighPinList, 'ALL OTHER PINS', LowPinList, Debug);
end;

{**
 @brief Execute an HV no-connection test where LOW pins are selected by a PIN_Info substring.

 @details
   Builds two groups from the complete pin set:
   - LOW: pins whose PIN_Info field contains @p PinInfoStr.
   - HIGH: all remaining pins (set difference Full - Low).
   The function then calls @c no_conn_hv_lists to perform a high-voltage open (no-connection) test.
   When @p Debug is TRUE, it logs the resolved pin name lists to the UI for traceability.

 @param PinInfoStr  Substring to match against each pin's PIN_Info field; matching pins form the LOW group.
 @param Debug       TRUE enables diagnostic UI output of the full and LOW pin lists.

 @return void

 @pre
   The following helpers are available and behave as implied by their names:
   get_named_pin_list_all, MiscListFromString, PinCreateList, MiscSubtractLists,
   transform_pinlist_name_str, UIWriteNormal, StrAdd, no_conn_hv_lists.

 @post
   HV no-connection test executed with HIGH = FullPinList - LowPinList and LOW = match(PIN_Info, PinInfoStr).

 @note
   Matching semantics for LOW selection follow @c PinCreateList using the @c PIN_Info selector.
*}
function nc_hv_pin_info_low(PinInfoStr: string; Debug: boolean = FALSE): void;
begin
   // Treat pins whose PIN_Info contains PinInfoStr as LOW; all others become HIGH.

   // Retrieve a string containing all named pins.
   AllPinsListStr = get_named_pin_list_all();

   // Parse the master pin string into FullPinList using ';' as the delimiter.
   MiscListFromString(AllPinsListStr,FullPinList,';');

   // Build LowPinList by selecting pins whose PIN_Info contains PinInfoStr.
   Count = PinCreateList(LowPinList, PIN_Info, PinInfoStr);

   if (Count == 0)
   begin
      UIWriteError(StrAdd('Error: Found 0 pins with given PinInfo: ', PinInfoStr));
      MiscAbortTest();
   end;

   if (Debug)
   begin
      UIWriteWarning(StrAdd('PinInfoStr: ', PinInfoStr));
      UIWriteWarning(StrAdd('PinInfo Count: ', Count));
   end;

   // Derive HighPinList as the set difference: FullPinList minus LowPinList.
   MiscSubtractLists(HighPinList, FullPinList, LowPinList);

   // Create a comma-separated LOW pin name string for reporting and test API.
   LowNames = transform_pinlist_name_str(LowPinList);

   // If Debug is TRUE, emit the resolved pin name lists to the UI.
   if (Debug)
   begin
      // Convert FullPinList into a printable name string.
      FullPinListNames = transform_pinlist_name_str(FullPinList);

      // Log the full pin set for traceability.
      UIWriteNormal(StrAdd('FullPinList -> ', FullPinListNames));

      // Log the LOW pin set for verification.
      UIWriteNormal(StrAdd('LowPinList -> ', LowNames));
   end;

   // Run the HV no-connection test using HIGH (others) vs. LOW (matched by PIN_Info).
   no_conn_hv_lists('ALL OTHER PINS', HighPinList, LowNames, LowPinList, Debug);
end;

{**
 @brief Run a low-voltage isolation test and abort immediately if any new failure is detected.

 @details
 This routine wraps the LV isolation sequence with a fail-counter guard. It snapshots the
 main fail counter before and after the test and compares the values. If the counter has
 increased (i.e., new failures occurred during this call), it logs errors to the UI and
 report, then aborts the overall test run.

 Operational flow:
 - Record the starting value of the main fail counter (FAILCOUNTER_Main).
 - Apply/verify LV test options via test_lv_option().
 - Execute the LV isolation test via IsolationTestLV().
 - Record the ending value of the main fail counter.
 - If FailsEnd differs from FailsStart, emit errors and call MiscAbortTest().

 @param Description  Human-readable label for the session (not used in this routine but preserved
                     for signature consistency with related helpers and potential future reporting).
 @param PinList      List of pins intended for context (not used directly in this routine).

 @return void

 @pre
 - The following helpers and identifiers must exist: FailCounterGet(), test_lv_option(),
   IsolationTestLV(), UIWriteError(), ReportWriteError(), MiscAbortTest(), FAILCOUNTER_Main.
 - Variables AllPassed (boolean), FailsStart (integer), and FailsEnd (integer) are declared/valid.

 @post
 - If any new failure is detected (FailsEnd <> FailsStart), the procedure will abort the test flow.

 @sideeffects
 - Writes error messages to UI and report streams.
 - May terminate the active test sequence via MiscAbortTest().

 @note
 - AllPassed is initialized but not used to gate behavior; abort logic relies solely on the fail
   counter delta. This preserves existing semantics where failure handling is centralized via counters.
 - Parameters @p Description and @p PinList are accepted for API parity but are not referenced here.

 @see FailCounterGet, IsolationTestLV, test_lv_option, MiscAbortTest
}
function no_conn_lv_abort(Description: string; PinList: tpinarray): void;
begin
   AllPassed = TRUE;  // assume success until a failure occurs (legacy aggregate flag; not used below)

   // Main failure count (snapshot before running the LV isolation test)
   FailsStart = FailCounterGet(FAILCOUNTER_Main);

   test_lv_option(); // Configure/validate LV test options prior to execution

   IsolationTestLV(); // Execute the low-voltage isolation test sequence

   // Main failure count (snapshot after test run)
   FailsEnd = FailCounterGet(FAILCOUNTER_Main);

   // If any pin failed, report error and abort the test
   if (FailsStart <> FailsEnd)
   begin
      UIWriteError('LOW VOLTAGE ISOLATION TEST FAILED, ABORTING TEST'); // UI alert
      ReportWriteError('LOW VOLTAGE ISOLATION TEST FAILED, ABORTING TEST'); // Report log entry
      MiscAbortTest(); // Terminate further testing due to new failures detected
   end;
end;

{**
 @brief Execute a high-voltage 'no-connection' (isolation) test across a list of pins.

 @details
 Iterates over @p PinList and invokes NoConnAllHV() per pin, passing through the
 human-readable @p Description for traceability in logs/reports. The routine tracks
 an aggregate status in AllPassed, which is initialized TRUE and flipped to FALSE
 if any individual pin test fails. The optional 'abort on failure' section is
 currently commented out, so the function will complete the pass over all pins
 even if failures occur.

 Control flow notes:
 - Uses a 1-based loop: Index = 1 .. Count, where Count = MiscGetListSize(PinList).
 - Pin names are fetched via PinGetData() for potential UI/report context; related
   UI lines are present but commented out.

 @param Description  Label or test identifier forwarded to NoConnAllHV() for reporting.
 @param PinList      Array of pin handles/IDs (tpinarray) to be tested for HV isolation.

 @return void

 @pre
 - PinList is initialized; MiscGetListSize(), PinGetData(), and NoConnAllHV() are available.
 - Variables AllPassed (boolean), Count (integer), Index (integer), Result (boolean),
   and PinName (string) are declared/accessible in this scope as required by the language.

 @post
 - AllPassed reflects overall success (TRUE only if all per-pin tests returned TRUE).

 @sideeffects
 - Executes NoConnAllHV(), which may drive HV instrumentation and produce logs.
 - Optional UI/report writes are present but commented out in this function.

 @see NoConnAllHV, MiscGetListSize, PinGetData
}
function no_conn_hv_list(Description: string; PinList: tpinarray): void;
begin
   AllPassed = TRUE;  // assume success until a failure occurs

   Count = MiscGetListSize(PinList); // get number of pins to test
   //UIWriteNormal(Count); // optional: display total pin count

   // Perform high-voltage isolation test on each pin
   if (Count >= 1)
   begin
      for Index = 1 to Count do
      begin
         PinName = PinGetData(PinList[Index], PIN_Name); // fetch pin name for context (logging)
         //UIWriteNormal(PinName); // optional: echo pin under test
         Result = no_conn_all_hv_guard(Description, PinList[Index]); // test this pin (returns TRUE on pass)
         if (Result == FALSE)
         begin
            AllPassed = FALSE; // mark overall failure if any test fails
         end;
      end;
   end;

end;

{**
 @brief Run a high-voltage DC dielectric breakdown test on POPULATED and UNPOPULATED contacts.

 @details
 The routine executes two HV isolation passes using no_conn_hv_list():
 1) POPULATED contacts taken from the primary netlist (WIRES ONLY!), and
 2) UNPOPULATED contacts computed as the set difference between all defined pins and all wired pins.

 Workflow:
 - Adds visual spacing and section headers to the UI.
 - Builds pin sets by tokenizing semicolon-delimited strings.
 - Applies isolation-HV configuration via ParamIsolationHV(), leaving all parameters unchanged
   except the fifth argument, which is set from @p Tmeas (timing/measurement dwell as defined
   by your platform).
 - Records the active measurement parameters under CMDGRP_IsolationHV.
 - Invokes no_conn_hv_list() for each pin set, forwarding @p Description for report/log traceability.

 @param Description  Human-readable label/identifier forwarded to no_conn_hv_list() for consistent reporting.
 @param Tmeas        Measurement/hold time applied through ParamIsolationHV()'s fifth parameter (default 1s).

 @return void

 @pre
 - Helper routines/identifiers are available: blank_line(), msg_box_border(), get_netlist_primary(),
   get_named_pin_list_all(), get_netlist_both(), MiscListFromString(), MiscSubtractLists(),
   ParamIsolationHV(), ReportWriteMeasurementParameters(), no_conn_hv_list(), CMDGRP_IsolationHV.
 - Variables/handles exist and are compatible with the helpers:
   PopulatedPinListStr, PopulatedPinList, AllPinsListStr, AllWireListStr,
   FullPinList, WirePinList, UnconnectedPinList.
 - Pin-list strings are semicolon-delimited (';').

 @sideeffects
 - Produces UI/report output (headings and parameter blocks).
 - Updates HV isolation configuration via ParamIsolationHV().

 @note
 - UNPOPULATED pins are computed as: UnconnectedPinList = FullPinList - WirePinList.
 - Only the fifth parameter of ParamIsolationHV() is changed here; all others are left as PARAM_DontChange.

 @see no_conn_hv, ParamIsolationHV, MiscListFromString, MiscSubtractLists,
      get_netlist_primary, get_named_pin_list_all, get_netlist_both
}
function no_conn_hv_current_populated(Description: string = 'NCA DB'; Tmeas: ttime = 1s): void;
begin
   blank_line(); // Visual spacer before the POPULATED contacts section

   msg_box_border('Testing contacts -CONTAINED- in netlist', '*'); // Section header for POPULATED pins

   PopulatedPinListStr = get_netlist_primary(); // Acquire semicolon-delimited primary-netlist pins
   MiscListFromString(PopulatedPinListStr,PopulatedPinList,';'); // Tokenize into PopulatedPinList

   no_conn_hv_list(Description, PopulatedPinList); // Execute HV isolation test on POPULATED pins with label

   blank_line(); // Spacer between sections
   msg_box_border('Testing contacts -NOT- in netlist', '*'); // Section header for UNPOPULATED pins

   ParamIsolationHVCurrent(PARAM_DontChange, PARAM_DontChange, PARAM_DontChange, PARAM_DontChange, Tmeas);

//   ReportWriteMeasurementParameters(CMDGRP_IsolationHV); // Log active HV parameters for traceability

   AllPinsListStr = get_named_pin_list_all(); // Retrieve all defined pins (fixture/connector scope)

   AllWireListStr = get_netlist_both(); // Retrieve all wired pins/ends from the combined netlist

   MiscListFromString(AllPinsListStr,FullPinList,';'); // Tokenize full pin inventory
   MiscListFromString(AllWireListStr,WirePinList,';'); // Tokenize wired-pin inventory

   // Compute Unconnected pins by removing netlist wires from the full list
   MiscSubtractLists(UnconnectedPinList, FullPinList, WirePinList); // Unconnected = FullPinList - WirePinList

   no_conn_hv_list(Description, UnconnectedPinList); // Execute HV isolation test on UNPOPULATED pins with same label
end;

