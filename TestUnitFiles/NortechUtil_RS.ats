{
  function set_skip_rex(Debug: boolean = FALSE): void;
  // Set global to skip REX post processing

  function probe_test_4wire(Name: string; Pin1: tpin; Pin2: tpin; Debug: boolean = FALSE): integer;
  // Use a 4-wire probe

  check_required_options(Continuity: string; LV: string; HV: string; DB: string; GuardRequired: boolean = FALSE; Debug: boolean = FALSE): void
  // Check for required tests

  read_test_duration(Debug: boolean = FALSE): string
  //   Retrieve the test duration for the current project from FILE_TIMER_DURATIONS, or return "NULL" if not found.

  check_job_whitelist(Debug: boolean = FALSE): string
  //   Load the project's job whitelist from FILE_JOB_WHITELIST, prompt and verify the operator's job number, returning the raw whitelist or "NULL".

  test_cont_option(GuardRequired: boolean = FALSE): void
  // Ensure the continuity test option is supported and enabled.

  test_db_option(GuardRequired: boolean = FALSE): void
