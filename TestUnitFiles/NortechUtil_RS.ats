  ui_report_error(Line: string): void
  //   Write an error message to both the UI and the test report.

  ui_report_warning(Line: string): void;
  //   Write a warning message to the UI and log it normally in the report.

  ui_report_normal(Line: string): void
  //   Write a normal message to both the UI and the test report.

  blank_line(Report: boolean = TRUE): void
  //   Insert a blank line in the UI and optionally in the report.

  msg_box_border(ReportLine: string; BorderChar: string; Error: boolean = FALSE; Warning: boolean = FALSE; Report: boolean = TRUE): void
  //   Display a text line within a character border, routing output as error, warning, or normal.

  report_manual_reading(Line: string; Units: string; MinValue: real; MaxValue: real; Debug: boolean = FALSE): void
  //   Prompt for and validate a manual measurement, then display it in a bordered report.

  report_manual_table_begin(Title: string = ''; Debug: boolean = FALSE): void
  //   Start a TXT manual-reading table; call report_manual_table_add for rows, then report_manual_table_finish.

  report_manual_table_add(Reading: string; MinValue: real; MaxValue: real; Units: string = ''): void
  //   Prompt for one numeric manual reading and append one completed PASS/FAIL row to the active table.

  report_manual_table_finish(): void
  //   Render the active manual-reading table and clear its internal state.

  ui_dialog_operator_true_false(Title: string; Message: string; SuccessFlag: boolean; Debug: boolean = FALSE): boolean
  //   Show a True/False dialog, compare the response to SuccessFlag, log the result, and return whether an error occurred.

  max_real(Var1: real; Var2: real): real
  //   Return the greater of two real values.

  pad_str_char(PadChar: string; Str: string; Length: integer; Debug: boolean = FALSE): string
  //   Center Str within a field of given Length padded by spaces and bordered by PadChar.

  report_manual_reading_delta(LowerLine: string; UpperLine: string; Units: string; LowerMinValue: real; LowerMaxValue: real; UpperMinValue: real; UpperMaxValue: real; DeltaMin: real; DeltaMax: real; Debug: boolean = FALSE): void
  //   Prompt for two measurements, validate each and their difference, and display all three in a bordered summary.

  check_epicor_pn(PartNum: string): void
  //   Prompt for the Epicor part number and abort the test if it does not match the expected PartNum.

  ui_info_cancellable(Msg: string): void
  //   Show an informational OK/Cancel dialog that aborts the test if the operator cancels.

  timer_check_fails(Debug: boolean = FALSE): void
  //   Retrieve the main failure count and forward it to the timer error handler with optional debug logging.

  ui_test_prompt(Seconds: integer = 0; Message: string = 'PRESS SPACEBAR TO START TEST'; Debug: boolean = FALSE): void
  //   Initialize the test timer duration, display a start prompt, and start the timer.

  str_sw_two_state(SW1Name: string; SW1State: string; SW2Name: string; SW2State: string): string
  //   Return a string in the format "(SW1State, SW2State)" representing two switch states.

  str_sw_three_state(SW1Name: string; SW1State: string; SW2Name: string; SW2State: string; SW3Name: string; SW3State: string): string
  //   Return a string in the format "(SW1State, SW2State, SW3State)" representing three switch states.

  test_one_switch(SWName: string; Pin1: tpin; Pin2: tpin; NCState: boolean): boolean
  //   Perform NC/NO continuity tests on a single switch according to NCState order.

  test_one_switch_with_override(SWName: string; SWNameOverride: string; Pin1: tpin; Pin2: tpin; NCState: boolean): boolean
  //   Test a primary switch and its override through predefined states, aborting if NCState = FALSE.

  test_two_series(SWName1: string; SWName2: string; Pin1: tpin; Pin2: tpin; NCState: boolean): boolean
  //   Perform series continuity tests on two switches in three phases when NCState = TRUE.

  test_two_series_with_override(SW1Name: string; SW2Name: string; SWOverrideName: string; Pin1: tpin; Pin2: tpin; NCState: boolean): boolean
  //   Perform series continuity tests on two switches plus an override switch through multiple phases when NCState = TRUE.

  rcl_test_cap_report(CapAvg: real; TolPercent: integer): void
  //   Calculate and report the upper and lower tolerance bounds for a given average capacitance.

  rcl_test_cap(Name: string; FromPin: tpin; ToPin: tpin; CapAvg: real; TolPercent: integer; ReportTol: boolean = FALSE): boolean
  //   Verify the electrical components group is active, optionally report tolerances, and execute an RLC capacitance test.

  operator_name_from_id(): string
  //   Lookup and return the operator's name based on the current operator ID from FILE_OPERATOR_ID_MAP, aborting on error.

  ui_print_helper(Str: string; Report: boolean = FALSE; Warning: boolean = FALSE; Error: boolean = FALSE; Debug: boolean = FALSE): void;
  // Route a message to UI or report with severity flags and guard against invalid combinations.


}

constants
begin
{
   For consistency, precise files begin with 'FILE_' whereas templates intended
   to be transformed into another string by calling StrReplace(); or
   archive_protocol(); begin with 'TMPL_'.
}
   FILE_TIMER_DURATIONS = 'O:\Test Eng\Support_Files\W434\test_durations.ini';
   FILE_JOB_WHITELIST = 'O:\Test Eng\Support_Files\W434\job_numbers_whitelist.ini';
   FILE_OPERATOR_ID_MAP = 'O:\Test Eng\Support_Files\W434\operator_id_mapping.ini';

   // Dedicated Global Data section and TXT width contract for report_manual_table.
   REPORT_MANUAL_TABLE_SECTION = '__Nortech_ReportManualTable_v1';
   REPORT_MANUAL_TABLE_MAX_WIDTH = 86;
end;

// Set global to skip REX post processing
function set_skip_rex(Debug: boolean = FALSE): void;
begin
   GlobalDataWrite('SKIP_REX', 'TRUE', 'ARCHIVE');
end;

function probe_test_4wire(Name: string; Pin1: tpin; Pin2: tpin; Debug: boolean = FALSE): integer;
begin
   // Make sure to use "Autostart" in Continuity Parameters to let operators "fix" poor connections.
   ParamAutostart(COMMANDS_Continuity, ON);

   ConnectionTest(Name, Pin1, Pin2);

   UIBeep(2048Hz, 512ms);
end;

{**
  @brief   Open the test-duration INI file and retrieve the duration for the current project.
  @details
    1. Fetches the project filename via `ProjectGetFilename()`.
    2. Opens the INI file defined by `FILE_TIMER_DURATIONS`.
    3. Parses the project path to determine the base filename (without extension).
    4. Reads the corresponding duration from the `[Durations]` section.
    5. Displays error dialogs on failure to open the file or parse the filename.
    6. Logs intermediate values when `Debug` is TRUE.
  @param   Debug  Optional flag to enable debug logging (default: FALSE).
  @return  The test duration string from the INI file, or `"NULL"` if not found.
**}
function read_test_duration(Debug: boolean = FALSE): string;
begin
   // Retrieve the full project filename
   ProjectFilename = ProjectGetFilename();

   if (Debug)  // log the project filename when debugging
   begin
     UIWriteWarning(StrAdd('Project filename: ', ProjectFilename));
   end;

   // Open the INI file containing test durations
   Handle = FileOpenIni(FILE_TIMER_DURATIONS);

   if (Debug)  // log the file handle returned
   begin
      UIWriteWarning(StrAdd('File handle: ', Handle));
   end;

   if (Handle == 0)  // check for failure to open file
   begin
      UIErrorDialog('COULD NOT OPEN TEST DURATION FILE.<BR><BR>CONTACT TEST LAB.');
   end
   else
   begin
      // Split the project path into parts using backslash
      MiscListFromString(ProjectFilename, PathParts, '\');
      BaseFileNameIndex = MiscGetListSize(PathParts);

      if (Debug)  // log the index of the base filename in the path parts
      begin
         UIWriteWarning(StrAdd('Base filename index: ', BaseFileNameIndex));
      end;

      // Isolate the filename and split on '.' to separate root name and extension
      MiscListFromString(PathParts[BaseFileNameIndex], RootFilenameList, '.');

      if (MiscGetListSize(RootFilenameList) == 2)  // expect exactly [name, extension]
      begin
         BaseFileName = StrTrim(RootFilenameList[1]);  // trimmed root name
      end
      else  // malformed filename
      begin
         UIErrorDialog('Test duration configuration error!<BR><BR>CONTACT TEST LAB.');
      end;

      if (Debug)  // log the determined base filename
      begin
         UIWriteWarning(StrAdd('Base filename: ', BaseFileName));
      end;

      // Read the duration value from the INI under section "Durations"
      TestDuration = FileGetIni(Handle, 'Durations', BaseFileName, 'NULL');

      if (Debug)  // log the retrieved test duration
      begin
         UIWriteWarning(StrAdd('Test Duration: ', TestDuration));
      end;
   end;

   FileCloseIni(Handle);             // close the INI file handle
   Result = TestDuration;            // return the duration (or "NULL")
end;

{**
  @brief   Load and validate the job whitelist for the current project, prompting the operator as needed.
  @details
    1. Retrieves the current project filename.
    2. Opens the INI file defined by FILE_JOB_WHITELIST.
    3. Parses the project path to determine the base filename (without extension).
    4. Reads the comma-separated whitelist of job numbers from the [Whitelist] section.
    5. If a whitelist is found, prompts the operator to enter a job number and compares it (case-insensitive) against the list.
    6. Aborts the test if the operator cancels or enters a non-whitelisted job.
  @param   Debug  Optional flag to enable debug logging (default FALSE).
  @return  The raw whitelist string from the INI file, or "NULL" if not found.
**}
function check_job_whitelist(Debug: boolean = FALSE): string;
begin
   // Get the full project filename
   ProjectFilename = ProjectGetFilename();

   if (Debug)                        // optionally log the filename
   begin
     UIWriteWarning(StrAdd('Job whitelist project filename: ', ProjectFilename));
   end;

   // Open the whitelist INI file
   Handle = FileOpenIni(FILE_JOB_WHITELIST);

   if (Debug)                        // optionally log the file handle
   begin
      UIWriteWarning(StrAdd('Job whitelist file handle: ', Handle));
   end;

   if (Handle == 0)                  // check for failure to open
   begin
      UIErrorDialog('COULD NOT OPEN JOB WHITELIST FILE.<BR><BR>CONTACT TEST LAB.');
   end
   else
   begin
      // Split path into components by '\'
      MiscListFromString(ProjectFilename, PathParts, '\');
      BaseFileNameIndex = MiscGetListSize(PathParts);

      if (Debug)                     // optionally log which part is the filename
      begin
         UIWriteWarning(StrAdd('Job whitelist base filename index: ', BaseFileNameIndex));
      end;

      // Isolate the filename and split on '.' to separate name and extension
      MiscListFromString(PathParts[BaseFileNameIndex], RootFilenameList, '.');

      if (MiscGetListSize(RootFilenameList) == 2)  // ensure one dot present
      begin
         BaseFileName = StrTrim(RootFilenameList[1]);  // trimmed root name
      end
      else                                // configuration error if unexpected format
      begin
         UIErrorDialog('Job whitelist file configuration error!<BR><BR>CONTACT TEST LAB.');
      end;

      if (Debug)                         // optionally log the determined base filename
      begin
         UIWriteWarning(StrAdd('Job whitelist base filename: ', BaseFileName));
      end;

      // Read the whitelist entry (comma-separated) or "NULL" if missing
      JobWhitelist = FileGetIni(Handle, 'Whitelist', BaseFileName, 'NULL');

      if (Debug)                         // optionally log the raw whitelist
      begin
         UIWriteWarning(StrAdd('Jobs in whitelist: ', JobWhitelist));
      end;
   end;

   FileCloseIni(Handle);                // always close the INI handle

   if (StrCompare(JobWhitelist, 'NULL') <> 0)  // if a whitelist was found
   begin
      InputResult = '';                 // prepare to capture operator input
      // Prompt operator for current job number
      Button = UIEditDialog('Job number', 'Enter the current job number', FALSE, TRUE, InputResult);

      if (Button == DIALOGRESULT_Ok)    // operator provided an entry
      begin
         if (Debug)                     // optionally log the entered job
         begin
            UIWriteWarning(StrAdd('Job number: ', InputResult));
         end;

         // Normalize input for comparison
         InputJobLower = StrLowerCase(StrTrim(InputResult));

         // Split the whitelist string into individual jobs
         Count = MiscListFromString(JobWhitelist, ListJobs, ',');

         if (Debug)                     // optionally log how many jobs found
         begin
            UIWriteWarning(StrAdd('Number of found jobs in whitelist: ', Count));
         end;

         JobFound = FALSE;              // assume not found until matched

         // Iterate through each whitelisted job
         for Index = 1 to Count do
         begin
            JobLower = StrLowerCase(StrTrim(ListJobs[Index]));  // normalize list entry
            if (StrCompare(InputJobLower, JobLower) == 0)       // match found?
            begin
               JobFound = TRUE;
               if (Debug)                                       // optionally log the match
               begin
                  UIWriteWarning(StrAdd('Job found: ', InputJobLower));
               end;
            end;
         end;

         if (JobFound == FALSE)        // no match in whitelist
         begin
            UIWriteError(StrAdd(InputJobLower, ' did not match whitelisted job list. Check job number or contact test lab.'));
            UIErrorDialog(StrAdd(InputJobLower, ' did not match whitelisted job list<BR>Check job number or contact test lab.'));
            MiscAbortTest();           // abort the test run
         end;
      end
      else                            // operator canceled entry dialog
      begin
         UIWriteError('Operator did not enter a required job number');
         MiscAbortTest();             // abort the test run
      end;
   end;

   Result = JobWhitelist;             // return the raw whitelist or "NULL"
end;

{**
  @brief   Ensure the continuity test option is supported and enabled.
  @details
    1. Verifies that the machine supports the continuity command group.
    2. Verifies that the continuity command group is currently active/enabled.
    If either check fails, an error dialog is shown and the test is aborted.
  @return  void
**}
function test_cont_option(GuardRequired: boolean = FALSE): void;
begin
   if (GuardRequired)
   begin
      GlobalDataWrite('REQUIRE_CONTINUITY', 'TRUE', 'GUARDS');
      GlobalDataWrite('TESTED_CONTINUITY', 'FALSE', 'GUARDS');
   end;

   // Check if the command group is available
   if (ParamIsCommandGroupAvailable(CMDGRP_Continuity) == FALSE)
   begin
      // Display an error dialog instructing use of an approved tester
      UIErrorDialog('THIS MACHINE DOES NOT CURRENTLY SUPPORT A REQUIRED TESTING METHOD (CONTINUITY)<BR>PLEASE TEST ON AN APPROVED AEROSPACE TESTER');
      // Abort the current test sequence
      MiscAbortTest();
   end;

   // Check if the command group is active/enabled
   if (ParamIsCommandGroupActive(CMDGRP_Continuity) == FALSE)
   begin
      // Display an error dialog indicating the command group is not enabled
      UIErrorDialog('THIS TEST DOES NOT HAVE THE REQUIRED CONTINUITY COMMAND GROUP ENABLED!<BR>CONTACT TEST DEPARTMENT');
      // Abort the current test sequence
      MiscAbortTest();
   end;
end;

{**
  @brief   Ensure the dielectric breakdown test option is supported and enabled.
  @details
    1. Verifies that the machine supports the dielectric breakdown (ACDB) command group.
    2. Verifies that the ACDB command group is currently active/enabled.
    If either check fails, an error dialog is shown and the test is aborted.
  @return  void
**}
function test_db_option(GuardRequired: boolean = FALSE): void;
begin
   // Check if the dielectric breakdown command group is available
   if (ParamIsCommandGroupAvailable(CMDGRP_DielectricBreakdown) == FALSE)
   begin
      // Display an error dialog instructing use of an approved tester
      UIErrorDialog('THIS MACHINE DOES NOT CURRENTLY SUPPORT A REQUIRED TESTING METHOD (ACDB)<BR>PLEASE TEST ON AN APPROVED AEROSPACE TESTER');
      // Abort the current test sequence
      MiscAbortTest();
   end;

   // Check if the dielectric breakdown command group is active/enabled
   if (ParamIsCommandGroupActive(CMDGRP_DielectricBreakdown) == FALSE)
   begin
      // Display an error dialog indicating the command group is not enabled
      UIErrorDialog('THIS TEST DOES NOT HAVE THE REQUIRED DIELECTRIC BREAKDOWN COMMAND GROUP ENABLED!<BR>CONTACT TEST DEPARTMENT');
      // Abort the current test sequence
      MiscAbortTest();
   end;
end;

{**
  @brief   Ensure the low-voltage isolation option is supported and enabled.
  @details
    Checks availability and activation of the LV isolation command group.
    If the command group is not supported or not enabled, displays an error dialog and aborts the test.
  @return  void
**}
function test_lv_option(GuardRequired: boolean = FALSE): void;
begin
   // Check if LV isolation command group is available
   if (ParamIsCommandGroupAvailable(CMDGRP_IsolationLV) == FALSE)
   begin
      // Display error instructing use of an approved tester
      UIErrorDialog('THIS MACHINE DOES NOT CURRENTLY SUPPORT A REQUIRED TESTING METHOD (LV ISOLATION)<BR>PLEASE TEST ON AN APPROVED AEROSPACE TESTER');
      // Abort the current test sequence
      MiscAbortTest();
   end;

   // Check if LV isolation command group is active/enabled
   if (ParamIsCommandGroupActive(CMDGRP_IsolationLV) == FALSE)
   begin
      // Display error indicating the command group is not enabled
      UIErrorDialog('THIS TEST DOES NOT HAVE THE REQUIRED LV ISOLATION COMMAND GROUP ENABLED!<BR>CONTACT TEST DEPARTMENT');
      // Abort the current test sequence
      MiscAbortTest();
   end;
end;

{**
  @brief   Ensure the high-voltage isolation option is supported and enabled.
  @details
    Verifies that the machine supports the HV isolation command group (CMDGRP_IsolationHV)
    and that it is currently active; if either check fails, an error dialog is shown and
    the test is aborted.
  @return  void
**}
function test_hv_option(GuardRequired: boolean = FALSE): void;
begin
   // Verify HV isolation command group is available
   if (ParamIsCommandGroupAvailable(CMDGRP_IsolationHV) == FALSE)
   begin
      // Display error instructing use of an approved tester
      UIErrorDialog('THIS MACHINE DOES NOT CURRENTLY SUPPORT A REQUIRED TESTING METHOD (HV ISOLATION)<BR>PLEASE TEST ON AN APPROVED AEROSPACE TESTER');
      // Abort the current test sequence
      MiscAbortTest();
   end;

   // Verify HV isolation command group is active/enabled
   if (ParamIsCommandGroupActive(CMDGRP_IsolationHV) == FALSE)
   begin
      // Display error indicating the command group is not enabled
      UIErrorDialog('THIS TEST DOES NOT HAVE THE REQUIRED HV ISOLATION COMMAND GROUP ENABLED!<BR>CONTACT TEST DEPARTMENT');
      // Abort the current test sequence
      MiscAbortTest();
   end;
end;

{**
  @brief   Validate that all required test options are supported and enabled.
  @details
    Sequentially calls test_lv_option, test_hv_option, and test_db_option to ensure low-voltage isolation,
    high-voltage isolation, and dielectric breakdown command groups are available and active.
  @return  void
**}
function test_as_options(GuardRequired: boolean = FALSE): void;
begin
   test_cont_option(GuardRequired); // Verify continuity support and activation
   test_lv_option(GuardRequired);   // Verify low-voltage isolation support and activation
   test_hv_option(GuardRequired);   // Verify high-voltage isolation support and activation
   test_db_option(GuardRequired);   // Verify dielectric breakdown support and activation
end;

function check_required_options(Continuity: string; LV: string; HV: string; DB: string; GuardRequired: boolean = FALSE; Debug: boolean = FALSE): void;
begin
   if (StrCompare(Continuity, 'FALSE') <> 0)
   begin
      test_cont_option(GuardRequired);
   end;

   if (StrCompare(LV, 'FALSE') <> 0)
   begin
      test_lv_option(GuardRequired);
   end;

   if (StrCompare(HV, 'FALSE') <> 0)
   begin
      test_hv_option(GuardRequired);
   end;

   if (StrCompare(DB, 'FALSE') <> 0)
   begin
      test_db_option(GuardRequired);
   end;
end;



{**
  @brief   Increment the failure counter for non-specific (other) errors.
  @details Calls `FailCounterCount` with the `FAILCOUNTER_Others` identifier to log an
           occurrence of an "other" type failure.
  @return  void
**}
function fail_count_other_increase(): void;
begin
   // Increment the 'Others' failure counter
   FailCounterCount(FAILCOUNTER_Others);
end;

{**
  @brief   Write an error message to both the UI and the report log.
  @param   Line  The error message to display and record.
  @return  void
**}
function ui_report_error(Line: string): void;
begin
   // Output the error to the user interface
   UIWriteError(Line);
   // Log the error in the test report
   ReportWriteError(Line);
end;

{**
  @brief   Display a warning message to the UI and log it normally in the report.
  @param   Line  The warning text to display and record.
  @return  void
**}
function ui_report_warning(Line: string): void;
begin
   UIWriteWarning(Line);        // output warning to the user interface
   ReportWriteNormal(Line);     // record the warning in the report log
end;


{**
  @brief   Display a normal message to the operator and record it in the report.
  @details
    Calls UIWriteNormal to output the message on the UI and ReportWriteNormal to log the same message in the report.
  @param   Line  The message text to display and log.
  @return  void
**}
function ui_report_normal(Line: string): void;
begin
   UIWriteNormal(Line);         // write the message to the user interface
   ReportWriteNormal(Line);     // record the message in the test report
end;


{**
  @brief   Insert a blank line in the UI and optionally in the report.
  @details
    Always writes a single space line via UIWriteNormal. If @p Report is TRUE,
    also writes a space line in the report via ReportWriteNormal.
  @param   Report  When TRUE (default), echo the blank line into the report log as well.
  @return  void
**}
function blank_line(Report: boolean = TRUE): void;
begin
   // Write a blank line to the user interface
   UIWriteNormal(' ');

   if (Report == TRUE)
   begin
      // Also write a blank line to the report log
      ReportWriteNormal(' ');
   end;
end;


{**
  @brief   Display a text line within a character border, routing output as error, warning, or normal.
  @details
    Constructs a top and bottom border using the first character of BorderChar, builds the middle line containing ReportLine,
    then outputs the boxed lines via reporting functions (error, warning, or normal) if Report is TRUE,
    or direct UI write functions otherwise. Aborts if both Error and Warning are set simultaneously.
  @param   ReportLine   The text to display inside the border.
  @param   BorderChar   The character used to draw the border (only the first character is used).
  @param   Error        If TRUE, routes the boxed output via ui_report_error or UIWriteError.
  @param   Warning      If TRUE, routes the boxed output via ui_report_warning or UIWriteWarning.
  @param   Report       If TRUE, uses report logging functions; otherwise uses direct UI write functions.
**}
function msg_box_border(ReportLine: string; BorderChar: string; Error: boolean = FALSE; Warning: boolean = FALSE; Report: boolean = TRUE): void;
begin
   // Extract the first character of BorderChar for drawing
   StrBoxChar = StrCopy(BorderChar, 1, 1);

   // Build the middle line: "<border> <ReportLine> <border>"
   String = StrAdd(StrBoxChar, ' ');
   String = StrAdd(String, ReportLine);
   String = StrAdd(String, ' ');
   String = StrAdd(String, StrBoxChar);

   // Determine total length for top/bottom borders
   StrLen = StrLength(String);
   BoxTopLen = StrLen;

   // Construct the top/bottom border of repeated border characters
   StrBoxTop = '';
   for Char = 1 to BoxTopLen do
   begin
      StrBoxTop = StrAdd(StrBoxTop, StrBoxChar);
   end;

   // Construct the middle border line with spaces inside
   StrBoxMiddle = StrBoxChar;
   for Char = 1 to BoxTopLen - 2 do
   begin
      StrBoxMiddle = StrAdd(StrBoxMiddle, ' ');
   end;
   StrBoxMiddle = StrAdd(StrBoxMiddle, StrBoxChar);

   // Validate that Error and Warning are not both set
   if (Error AND Warning)
   begin
      UIErrorDialog('ERROR: CANNOT HAVE BOTH WARNING AND ERROR SET');
      MiscAbortTest();
   end;

   // Output the boxed lines according to Report flag
   if (Report)
   begin
      // Use reporting functions
      if (Error)
      begin
         ui_report_error(StrBoxTop);
         ui_report_error(String);
         ui_report_error(StrBoxTop);
      end;

      if (Warning)
      begin
         ui_report_warning(StrBoxTop);
         ui_report_warning(String);
         ui_report_warning(StrBoxTop);
      end;

      if ((Error == FALSE) AND (Warning == FALSE))
      begin
         ui_report_normal(StrBoxTop);
         ui_report_normal(String);
         ui_report_normal(StrBoxTop);
      end;
   end
   else
   begin
      // Use direct UI write functions
      if (Error)
      begin
         UIWriteError(StrBoxTop);
         UIWriteError(String);
         UIWriteError(StrBoxTop);
      end;

      if (Warning == TRUE)
      begin
         UIWriteWarning(StrBoxTop);
         UIWriteWarning(String);
         UIWriteWarning(StrBoxTop);
      end;

      if (Error == FALSE AND Warning == FALSE)
      begin
         UIWriteNormal(StrBoxTop);
         UIWriteNormal(String);
         UIWriteNormal(StrBoxTop);
      end;
   end;
end;



{**
  @brief   Prompt operator for a manual measurement, validate and report the result.
  @details
    Displays an input dialog asking the operator to enter a value for @p Line in @p Units.
    Validates the entry format (integer or real), checks against @p MinValue and @p MaxValue,
    reports errors via @c ui_report_error and increments the failure counter if out of range
    or canceled.  Finally, displays the measured value in a bordered message box.
  @param   Line      Description of the measurement prompt.
  @param   Units     Units to display alongside the prompt and result.
  @param   MinValue  Minimum allowable numeric value.
  @param   MaxValue  Maximum allowable numeric value.
  @param   Debug     Optional flag to enable debug logging (default FALSE).
  @return  void
**}
function report_manual_reading(Line: string; Units: string; MinValue: real; MaxValue: real; Debug: boolean = FALSE): void;
begin
   // Initialize error flag
   Error = FALSE;

   // Insert a blank line before prompting
   blank_line(TRUE);

   // Build the input prompt text
   MsgText = StrAdd('Enter manual reading:<BR>', Line);
   MsgText = StrAdd(MsgText, ' (');
   MsgText = StrAdd(MsgText, Units);
   MsgText = StrAdd(MsgText, ')');

   // Default input result
   InputResult = '0';

   // Prompt the operator for a value
   Button = UIEditDialog('Enter Value', MsgText, FALSE, TRUE, InputResult);

   if (Button == DIALOGRESULT_Ok)
   begin
      // Log the entered value if debugging
      if (Debug)
      begin
         UIWriteNormal(StrAdd('Entered value: ', InputResult));
      end;
   end
   else
   begin
      // Operator canceled input
      UIWriteNormal('Canceled by operator');
      Error = TRUE;
      // Record a generic failure
      fail_count_other_increase();
   end;

   // Initialize numeric conversion
   ValueEntered = 0.0;

   // Convert if integer format
   if (FormatIsInteger(InputResult))
   begin
      ValueEntered = InputResult;
   end;

   // Convert if real format
   if (FormatIsReal(InputResult))
   begin
      ValueEntered = InputResult;
   end;

   // Validate against maximum
   if (ValueEntered > MaxValue)
   begin
      ErrorLine = StrAdd('Value entered above maximum value: ', MaxValue);
      ErrorLine = StrAdd(ErrorLine, ' ');
      ErrorLine = StrAdd(ErrorLine, Units);
      ui_report_error(ErrorLine);
      Error = TRUE;
      fail_count_other_increase();
   end;

   // Validate against minimum
   if (ValueEntered < MinValue)
   begin
      ErrorLine = StrAdd('Value entered below minimum value: ', MinValue);
      ErrorLine = StrAdd(ErrorLine, ' ');
      ErrorLine = StrAdd(ErrorLine, Units);
      ui_report_error(ErrorLine);
      Error = TRUE;
      fail_count_other_increase();
   end;

   // Build the result report line
   ReportLine = '';
   ReportLine = StrAdd(ReportLine, Line);
   ReportLine = StrAdd(ReportLine, ' measured value (');
   ReportLine = StrAdd(ReportLine, MinValue);
   ReportLine = StrAdd(ReportLine, '-');
   ReportLine = StrAdd(ReportLine, MaxValue);
   ReportLine = StrAdd(ReportLine, ' ');
   ReportLine = StrAdd(ReportLine, Units);
   ReportLine = StrAdd(ReportLine, '): ');
   ReportLine = StrAdd(ReportLine, ValueEntered);
   ReportLine = StrAdd(ReportLine, ' ');
   ReportLine = StrAdd(ReportLine, Units);

   // Display the bordered report
   msg_box_border(ReportLine, '*', Error);

   // Insert a blank line after reporting
   blank_line(TRUE);
end;



{**
  @brief   Clear all internal state for the report_manual_table builder.
  @details
    The manual table builder keeps its active lifecycle and arbitrary row set in one
    dedicated Global Data section so callers do not have to pass arrays, row counts,
    or indexes between begin/add/finish calls. This helper owns only that private
    section and never calls GlobalDataClear().
**}
function report_manual_table_reset_state(): void;
begin
   GlobalDataDeleteSection(REPORT_MANUAL_TABLE_SECTION);
end;

{**
  @brief   Handle programming/configuration errors for the manual table builder.
  @details
    Misuse of the builder is an authoring/configuration defect, not a product
    failure. The error is shown to the operator, written permanently to the report,
    the builder state is cleared, and the test is aborted without incrementing the
    Others failure counter.
**}
function report_manual_table_program_error(Message: string): void;
begin
   ErrorText = StrAdd('Manual reading table configuration error: ', Message);
   UIErrorDialog(ErrorText);
   ui_report_error(ErrorText);
   report_manual_table_reset_state();
   MiscAbortTest();
end;

{**
  @brief   Return a string containing @p Character repeated @p Count times.
  @param   Character  Character string to append for each repeat cycle.
  @param   Count      Number of copies to append.
**}
function report_manual_table_repeat(Character: string; Count: integer): string;
begin
   Result = '';
   RepeatIndex = 1;
   while (RepeatIndex <= Count)
   begin
      Result = StrAdd(Result, Character);
      RepeatIndex = RepeatIndex + 1;
   end;
end;

{**
  @brief   Build a column-aligned segmented table border.
  @details Each segment is the column content width plus two hyphens for the
           visible left and right cell padding spaces. The six plus signs align
           with the six vertical separators in standard table rows.
**}
function report_manual_table_build_border(ReadingWidth: integer; MinWidth: integer; MaxWidth: integer; MeasuredWidth: integer; ResultWidth: integer): string;
begin
   Result = '+';
   Result = StrAdd(Result, report_manual_table_repeat('-', ReadingWidth + 2));
   Result = StrAdd(Result, '+');
   Result = StrAdd(Result, report_manual_table_repeat('-', MinWidth + 2));
   Result = StrAdd(Result, '+');
   Result = StrAdd(Result, report_manual_table_repeat('-', MaxWidth + 2));
   Result = StrAdd(Result, '+');
   Result = StrAdd(Result, report_manual_table_repeat('-', MeasuredWidth + 2));
   Result = StrAdd(Result, '+');
   Result = StrAdd(Result, report_manual_table_repeat('-', ResultWidth + 2));
   Result = StrAdd(Result, '+');
end;

{**
  @brief   Build one aligned table row while preserving visible separators.
  @details All cells must already be no wider than their target widths. Alignment
           helpers are used only for padding, never for truncation.
**}
function report_manual_table_build_row(Reading: string; MinText: string; MaxText: string; MeasuredText: string; ResultText: string; ReadingWidth: integer; MinWidth: integer; MaxWidth: integer; MeasuredWidth: integer; ResultWidth: integer): string;
begin
   Result = '| ';
   Result = StrAdd(Result, FormatAlignLeft(Reading, ReadingWidth, ' '));
   Result = StrAdd(Result, ' | ');
   Result = StrAdd(Result, FormatAlignRight(MinText, MinWidth, ' '));
   Result = StrAdd(Result, ' | ');
   Result = StrAdd(Result, FormatAlignRight(MaxText, MaxWidth, ' '));
   Result = StrAdd(Result, ' | ');
   Result = StrAdd(Result, FormatAlignRight(MeasuredText, MeasuredWidth, ' '));
   Result = StrAdd(Result, ' | ');
   Result = StrAdd(Result, FormatAlignCenter(ResultText, ResultWidth));
   Result = StrAdd(Result, ' |');
end;

{**
  @brief   Store one completed row in the dedicated Global Data section.
  @details The row is stored as independent keys rather than as delimited text so
           arbitrary descriptions and units cannot corrupt the table state.
**}
function report_manual_table_store_row(Reading: string; MinText: string; MaxText: string; Units: string; MeasuredText: string; RowResult: string): void;
begin
   RowCount = GlobalDataRead('row_count', '0', REPORT_MANUAL_TABLE_SECTION);
   RowCount = RowCount + 1;
   RowKey = StrAdd('row_', RowCount);

   GlobalDataWrite('row_count', RowCount, REPORT_MANUAL_TABLE_SECTION);
   GlobalDataWrite(StrAdd(RowKey, '_reading'), Reading, REPORT_MANUAL_TABLE_SECTION);
   GlobalDataWrite(StrAdd(RowKey, '_min'), MinText, REPORT_MANUAL_TABLE_SECTION);
   GlobalDataWrite(StrAdd(RowKey, '_max'), MaxText, REPORT_MANUAL_TABLE_SECTION);
   GlobalDataWrite(StrAdd(RowKey, '_units'), Units, REPORT_MANUAL_TABLE_SECTION);
   GlobalDataWrite(StrAdd(RowKey, '_measured'), MeasuredText, REPORT_MANUAL_TABLE_SECTION);
   GlobalDataWrite(StrAdd(RowKey, '_result'), RowResult, REPORT_MANUAL_TABLE_SECTION);
end;

{**
  @brief   Append units to a numeric display string when units were supplied.
**}
function report_manual_table_value_units(ValueText: string; Units: string): string;
begin
   Result = ValueText;
   if (StrLength(Units) > 0)
   begin
      Result = StrAdd(Result, ' ');
      Result = StrAdd(Result, Units);
   end;
end;

{**
  @brief   Render the active manual-reading table through the normal TXT report stream.
  @details
    The width formula is: sum(column widths) + 16 visible padding/separator
    characters for five columns. Reading text and titles are emitted in continuation
    lines when needed; long unbroken text is hard-split with StrCopy so content is
    never truncated and each physical line remains within 86 characters.
**}
function report_manual_table_render(): void;
begin
   RowCount = GlobalDataRead('row_count', '0', REPORT_MANUAL_TABLE_SECTION);
   Canceled = GlobalDataRead('canceled', 'FALSE', REPORT_MANUAL_TABLE_SECTION);
   Failed = GlobalDataRead('failed', 'FALSE', REPORT_MANUAL_TABLE_SECTION);
   Debug = GlobalDataRead('debug', 'FALSE', REPORT_MANUAL_TABLE_SECTION);

   if (
      ((StrCompare(Canceled, 'TRUE') <> 0) AND (StrCompare(Canceled, 'FALSE') <> 0)) OR
      ((StrCompare(Failed, 'TRUE') <> 0) AND (StrCompare(Failed, 'FALSE') <> 0)) OR
      ((StrCompare(Debug, 'TRUE') <> 0) AND (StrCompare(Debug, 'FALSE') <> 0))
   )
   begin
      report_manual_table_program_error('manual table Boolean state is corrupt.');
   end;

   if ((RowCount == 0) AND (StrCompare(Canceled, 'FALSE') == 0))
   begin
      report_manual_table_program_error('finish called with no completed readings.');
   end;

   MinWidth = StrLength('Min');
   MaxWidth = StrLength('Max');
   MeasuredWidth = StrLength('Measured');
   ResultWidth = StrLength('Result');
   NaturalReadingWidth = StrLength('Reading');

   RowIndex = 1;
   while (RowIndex <= RowCount)
   begin
      RowKey = StrAdd('row_', RowIndex);
      Units = GlobalDataRead(StrAdd(RowKey, '_units'), '', REPORT_MANUAL_TABLE_SECTION);
      ReadingText = GlobalDataRead(StrAdd(RowKey, '_reading'), '', REPORT_MANUAL_TABLE_SECTION);
      MinCell = report_manual_table_value_units(GlobalDataRead(StrAdd(RowKey, '_min'), '', REPORT_MANUAL_TABLE_SECTION), Units);
      MaxCell = report_manual_table_value_units(GlobalDataRead(StrAdd(RowKey, '_max'), '', REPORT_MANUAL_TABLE_SECTION), Units);
      MeasuredCell = report_manual_table_value_units(GlobalDataRead(StrAdd(RowKey, '_measured'), '', REPORT_MANUAL_TABLE_SECTION), Units);

      if (StrLength(ReadingText) > NaturalReadingWidth)
      begin
         NaturalReadingWidth = StrLength(ReadingText);
      end;
      if (StrLength(MinCell) > MinWidth)
      begin
         MinWidth = StrLength(MinCell);
      end;
      if (StrLength(MaxCell) > MaxWidth)
      begin
         MaxWidth = StrLength(MaxCell);
      end;
      if (StrLength(MeasuredCell) > MeasuredWidth)
      begin
         MeasuredWidth = StrLength(MeasuredCell);
      end;
      RowIndex = RowIndex + 1;
   end;

   if (StrLength('PASS') > ResultWidth)
   begin
      ResultWidth = StrLength('PASS');
   end;
   if (StrLength('FAIL') > ResultWidth)
   begin
      ResultWidth = StrLength('FAIL');
   end;

   MaxReadingWidth = REPORT_MANUAL_TABLE_MAX_WIDTH - 16 - MinWidth - MaxWidth - MeasuredWidth - ResultWidth;
   if (MaxReadingWidth < StrLength('Reading'))
   begin
      report_manual_table_program_error('fixed value columns leave no room for the Reading header within 86 characters.');
   end;

   ReadingWidth = NaturalReadingWidth;
   if (ReadingWidth > MaxReadingWidth)
   begin
      ReadingWidth = MaxReadingWidth;
   end;

   TableWidth = ReadingWidth + MinWidth + MaxWidth + MeasuredWidth + ResultWidth + 16;
   LongestGroupStatus = StrLength('GROUP RESULT: CANCELED (FAIL)');
   if (StrLength('GROUP RESULT: FAIL + CANCELED') > LongestGroupStatus)
   begin
      LongestGroupStatus = StrLength('GROUP RESULT: FAIL + CANCELED');
   end;
   if ((TableWidth - 4) < LongestGroupStatus)
   begin
      ReadingWidth = ReadingWidth + (LongestGroupStatus - (TableWidth - 4));
      if (ReadingWidth > MaxReadingWidth)
      begin
         report_manual_table_program_error('group result text cannot fit within the 86-character manual table limit.');
      end;
      TableWidth = ReadingWidth + MinWidth + MaxWidth + MeasuredWidth + ResultWidth + 16;
   end;

   if (TableWidth > REPORT_MANUAL_TABLE_MAX_WIDTH)
   begin
      report_manual_table_program_error('calculated table width exceeds 86 characters.');
   end;

   if (StrCompare(Debug, 'TRUE') == 0)
   begin
      UIWriteNormal(StrAdd('manual table rows: ', RowCount));
      UIWriteNormal(StrAdd('manual table width: ', TableWidth));
      UIWriteNormal(StrAdd('manual table reading width: ', ReadingWidth));
   end;

   Border = report_manual_table_build_border(ReadingWidth, MinWidth, MaxWidth, MeasuredWidth, ResultWidth);
   if (StrLength(Border) > REPORT_MANUAL_TABLE_MAX_WIDTH)
   begin
      report_manual_table_program_error('border line exceeds 86 characters.');
   end;

   ui_report_normal(Border);

   Title = StrTrim(GlobalDataRead('title', '', REPORT_MANUAL_TABLE_SECTION));
   TitleWidth = TableWidth - 4;
   if (StrLength(Title) > 0)
   begin
      WrappedCount = StrWordWrap(Title, TitleWidth, WrappedLines);
      WrappedIndex = 1;
      while (WrappedIndex <= WrappedCount)
      begin
         TitlePart = StrTrim(WrappedLines[WrappedIndex]);
         while (StrLength(TitlePart) > 0)
         begin
            TitleSegment = StrCopy(TitlePart, 1, TitleWidth);
            TitlePart = StrCopy(TitlePart, TitleWidth + 1, StrLength(TitlePart));
            Line = '| ';
            Line = StrAdd(Line, FormatAlignCenter(TitleSegment, TitleWidth));
            Line = StrAdd(Line, ' |');
            if (StrLength(Line) > REPORT_MANUAL_TABLE_MAX_WIDTH)
            begin
               report_manual_table_program_error('title line exceeds 86 characters.');
            end;
            ui_report_normal(Line);
         end;
         WrappedIndex = WrappedIndex + 1;
      end;
      ui_report_normal(Border);
   end;

   Header = report_manual_table_build_row('Reading', 'Min', 'Max', 'Measured', 'Result', ReadingWidth, MinWidth, MaxWidth, MeasuredWidth, ResultWidth);
   if (StrLength(Header) > REPORT_MANUAL_TABLE_MAX_WIDTH)
   begin
      report_manual_table_program_error('header line exceeds 86 characters.');
   end;
   ui_report_normal(Header);
   ui_report_normal(Border);

   RowIndex = 1;
   while (RowIndex <= RowCount)
   begin
      RowKey = StrAdd('row_', RowIndex);
      ReadingText = GlobalDataRead(StrAdd(RowKey, '_reading'), '', REPORT_MANUAL_TABLE_SECTION);
      Units = GlobalDataRead(StrAdd(RowKey, '_units'), '', REPORT_MANUAL_TABLE_SECTION);
      MinCell = report_manual_table_value_units(GlobalDataRead(StrAdd(RowKey, '_min'), '', REPORT_MANUAL_TABLE_SECTION), Units);
      MaxCell = report_manual_table_value_units(GlobalDataRead(StrAdd(RowKey, '_max'), '', REPORT_MANUAL_TABLE_SECTION), Units);
      MeasuredCell = report_manual_table_value_units(GlobalDataRead(StrAdd(RowKey, '_measured'), '', REPORT_MANUAL_TABLE_SECTION), Units);
      RowResult = GlobalDataRead(StrAdd(RowKey, '_result'), '', REPORT_MANUAL_TABLE_SECTION);
      FirstLine = TRUE;
      WrappedCount = StrWordWrap(ReadingText, ReadingWidth, WrappedLines);
      WrappedIndex = 1;
      while (WrappedIndex <= WrappedCount)
      begin
         ReadingPart = StrTrim(WrappedLines[WrappedIndex]);
         while (StrLength(ReadingPart) > 0)
         begin
            ReadingSegment = StrCopy(ReadingPart, 1, ReadingWidth);
            ReadingPart = StrCopy(ReadingPart, ReadingWidth + 1, StrLength(ReadingPart));

            if (FirstLine)
            begin
               Line = report_manual_table_build_row(ReadingSegment, MinCell, MaxCell, MeasuredCell, RowResult, ReadingWidth, MinWidth, MaxWidth, MeasuredWidth, ResultWidth);
               FirstLine = FALSE;
            end
            else
            begin
               Line = report_manual_table_build_row(ReadingSegment, '', '', '', '', ReadingWidth, MinWidth, MaxWidth, MeasuredWidth, ResultWidth);
            end;

            if (StrLength(Line) > REPORT_MANUAL_TABLE_MAX_WIDTH)
            begin
               report_manual_table_program_error('data line exceeds 86 characters.');
            end;
            ui_report_normal(Line);
         end;
         WrappedIndex = WrappedIndex + 1;
      end;

      RowIndex = RowIndex + 1;
   end;

   ui_report_normal(Border);

   if ((StrCompare(Failed, 'FALSE') == 0) AND (StrCompare(Canceled, 'FALSE') == 0))
   begin
      GroupStatus = 'GROUP RESULT: PASS';
   end;
   if ((StrCompare(Failed, 'TRUE') == 0) AND (StrCompare(Canceled, 'FALSE') == 0))
   begin
      GroupStatus = 'GROUP RESULT: FAIL';
   end;
   if ((StrCompare(Failed, 'FALSE') == 0) AND (StrCompare(Canceled, 'TRUE') == 0))
   begin
      GroupStatus = 'GROUP RESULT: CANCELED (FAIL)';
   end;
   if ((StrCompare(Failed, 'TRUE') == 0) AND (StrCompare(Canceled, 'TRUE') == 0))
   begin
      GroupStatus = 'GROUP RESULT: FAIL + CANCELED';
   end;

   while (StrLength(GroupStatus) > 0)
   begin
      StatusPart = StrCopy(GroupStatus, 1, TableWidth - 4);
      GroupStatus = StrCopy(GroupStatus, TableWidth - 3, StrLength(GroupStatus));
      Line = '| ';
      Line = StrAdd(Line, FormatAlignCenter(StatusPart, TableWidth - 4));
      Line = StrAdd(Line, ' |');
      if (StrLength(Line) > REPORT_MANUAL_TABLE_MAX_WIDTH)
      begin
         report_manual_table_program_error('group status line exceeds 86 characters.');
      end;
      ui_report_normal(Line);
   end;

   ui_report_normal(Border);
end;

{**
  @brief   Start a new manual-reading table.
  @details
    A table must be started before rows are added and must be finished exactly once.
    Only one table may be active; nested/concurrent tables are programming errors.
    The optional Debug setting is stored once here and controls operator-only
    diagnostics for later add/finish calls. No prompts or report lines are produced
    by a successful begin call.
  @param   Title  Optional TXT table title. Empty or whitespace-only titles are omitted.
  @param   Debug  When TRUE, write limited diagnostic details to the operator UI only.
  @return  void
**}
function report_manual_table_begin(Title: string = ''; Debug: boolean = FALSE): void;
begin
   State = GlobalDataRead('state', 'IDLE', REPORT_MANUAL_TABLE_SECTION);
   if (StrCompare(State, 'IDLE') <> 0)
   begin
      report_manual_table_program_error('begin called while a manual reading table is already active.');
   end;

   report_manual_table_reset_state();
   GlobalDataWrite('state', 'ACTIVE', REPORT_MANUAL_TABLE_SECTION);
   GlobalDataWrite('title', Title, REPORT_MANUAL_TABLE_SECTION);
   if (Debug)
   begin
      GlobalDataWrite('debug', 'TRUE', REPORT_MANUAL_TABLE_SECTION);
   end
   else
   begin
      GlobalDataWrite('debug', 'FALSE', REPORT_MANUAL_TABLE_SECTION);
   end;
   GlobalDataWrite('row_count', '0', REPORT_MANUAL_TABLE_SECTION);
   GlobalDataWrite('failed', 'FALSE', REPORT_MANUAL_TABLE_SECTION);
   GlobalDataWrite('canceled', 'FALSE', REPORT_MANUAL_TABLE_SECTION);
   GlobalDataWrite('cancel_counted', 'FALSE', REPORT_MANUAL_TABLE_SECTION);
end;

{**
  @brief   Prompt for and append one numeric reading to the active manual table.
  @details
    The reading definition is atomic: description, limits, units, measured value,
    and PASS/FAIL result are stored together under the builder's private Global Data
    section. Nonnumeric input is trimmed for validation, reported only to the
    operator with the raw invalid text, and reprompted without failure counting or
    permanent report output. Accepted out-of-range values increment the Others
    failure counter exactly once, store a FAIL row, and allow later rows to proceed.
    Canceling marks the group canceled, increments the Others counter once total,
    and makes later add calls silent no-ops until finish renders completed rows.
  @param   Reading   Required reading description shown to the operator and report.
  @param   MinValue  Inclusive minimum accepted numeric value.
  @param   MaxValue  Inclusive maximum accepted numeric value; may equal MinValue.
  @param   Units     Optional units displayed in Min, Max, and Measured cells.
  @return  void
**}
function report_manual_table_add(Reading: string; MinValue: real; MaxValue: real; Units: string = ''): void;
begin
   State = GlobalDataRead('state', 'IDLE', REPORT_MANUAL_TABLE_SECTION);
   if (StrCompare(State, 'IDLE') == 0)
   begin
      report_manual_table_program_error('add called before report_manual_table_begin.');
   end;
   if ((StrCompare(State, 'ACTIVE') <> 0) AND (StrCompare(State, 'CANCELED') <> 0))
   begin
      report_manual_table_program_error('manual table lifecycle state is corrupt.');
   end;

   if (StrCompare(State, 'CANCELED') == 0)
   begin
      // After cancellation, unanswered readings collectively count as one failure.
      // Later add calls must not prompt, report, or increment any counter.
   end
   else
   begin
      if (StrLength(StrTrim(Reading)) == 0)
      begin
         report_manual_table_program_error('manual table row has an empty Reading description.');
      end;

      if (MinValue > MaxValue)
      begin
         report_manual_table_program_error('manual table row has MinValue greater than MaxValue.');
      end;

      Accepted = FALSE;
      Canceled = FALSE;
      do
      begin
         MsgText = StrAdd('Enter manual reading:<BR>', Reading);
         if (StrLength(Units) > 0)
         begin
            MsgText = StrAdd(MsgText, ' (');
            MsgText = StrAdd(MsgText, Units);
            MsgText = StrAdd(MsgText, ')');
         end;

         InputResult = '0';
         Button = UIEditDialog('Enter Value', MsgText, FALSE, TRUE, InputResult);

         if (Button == DIALOGRESULT_Ok)
         begin
            RawInput = InputResult;
            InputResult = StrTrim(InputResult);
            if (FormatIsInteger(InputResult) OR FormatIsReal(InputResult))
            begin
               ValueEntered = InputResult;
               Accepted = TRUE;
            end
            else
            begin
               ErrorLine = StrAdd('Invalid numeric input for manual reading:<BR>', Reading);
               ErrorLine = StrAdd(ErrorLine, '<BR>Entered: ');
               ErrorLine = StrAdd(ErrorLine, RawInput);
               ErrorLine = StrAdd(ErrorLine, '<BR>Please enter a numeric value.');
               UIErrorDialog(ErrorLine);
            end;
         end
         else
         begin
            Canceled = TRUE;
            Accepted = TRUE;
         end;
      end
      while (Accepted == FALSE);

      if (Canceled)
      begin
         CancelCounted = GlobalDataRead('cancel_counted', 'FALSE', REPORT_MANUAL_TABLE_SECTION);
         if ((StrCompare(CancelCounted, 'TRUE') <> 0) AND (StrCompare(CancelCounted, 'FALSE') <> 0))
         begin
            report_manual_table_program_error('manual table cancellation count state is corrupt.');
         end;
         if (StrCompare(CancelCounted, 'FALSE') == 0)
         begin
            fail_count_other_increase();
            GlobalDataWrite('cancel_counted', 'TRUE', REPORT_MANUAL_TABLE_SECTION);
         end;
         GlobalDataWrite('canceled', 'TRUE', REPORT_MANUAL_TABLE_SECTION);
         GlobalDataWrite('state', 'CANCELED', REPORT_MANUAL_TABLE_SECTION);
      end
      else
      begin
         MinText = StrAdd('', MinValue);
         MaxText = StrAdd('', MaxValue);
         MeasuredText = StrAdd('', ValueEntered);

         OutOfRange = FALSE;
         if ((ValueEntered < MinValue) OR (ValueEntered > MaxValue))
         begin
            OutOfRange = TRUE;
         end;

         if (OutOfRange)
         begin
            ErrorLine = StrAdd('Manual reading out of range:<BR>', Reading);
            ErrorLine = StrAdd(ErrorLine, '<BR>Entered: ');
            ErrorLine = StrAdd(ErrorLine, report_manual_table_value_units(MeasuredText, Units));
            ErrorLine = StrAdd(ErrorLine, '<BR>Minimum: ');
            ErrorLine = StrAdd(ErrorLine, report_manual_table_value_units(MinText, Units));
            ErrorLine = StrAdd(ErrorLine, '<BR>Maximum: ');
            ErrorLine = StrAdd(ErrorLine, report_manual_table_value_units(MaxText, Units));
            UIErrorDialog(ErrorLine);
            fail_count_other_increase();
            GlobalDataWrite('failed', 'TRUE', REPORT_MANUAL_TABLE_SECTION);
            report_manual_table_store_row(Reading, MinText, MaxText, Units, MeasuredText, 'FAIL');
         end
         else
         begin
            report_manual_table_store_row(Reading, MinText, MaxText, Units, MeasuredText, 'PASS');
         end;
      end;
   end;
end;

{**
  @brief   Render and clear the active manual-reading table.
  @details
    finish writes one compact TXT-oriented ASCII table through ui_report_normal(),
    including completed PASS/FAIL rows and an exact group status. It never increments
    failure counters and never returns entered values to the caller. Programming
    misuse, corrupt state, or impossible 86-character rendering is reported as a
    configuration error and aborts the test without product-failure counting.
  @return  void
**}
function report_manual_table_finish(): void;
begin
   State = GlobalDataRead('state', 'IDLE', REPORT_MANUAL_TABLE_SECTION);
   if (StrCompare(State, 'IDLE') == 0)
   begin
      report_manual_table_program_error('finish called before report_manual_table_begin.');
   end;
   if ((StrCompare(State, 'ACTIVE') <> 0) AND (StrCompare(State, 'CANCELED') <> 0))
   begin
      report_manual_table_program_error('manual table lifecycle state is corrupt.');
   end;

   report_manual_table_render();
   report_manual_table_reset_state();
end;


{*
 * @brief   Display a TRUE/FALSE prompt to the operator, log the choice, and report pass/fail.
 *
 * Presents a dialog titled @p Title with the question @p Message and three buttons:
 * "Cancel", "True", and "False".  Compares the operator�s choice against @p SuccessFlag:
 * if they match, the test passes; otherwise it fails.  Any cancellation or mismatch
 * increments the failure counter and records an error message.  Finally, draws a
 * bordered report line and returns prompt pass (TRUE) or failure (FALSE).
 *
 * @param   Title         The caption text for the dialog window.
 * @param   Message       The prompt or question displayed to the operator.
 * @param   SuccessFlag   If TRUE, selecting "True" is a pass; if FALSE, selecting "False" is a pass.
 * @param   Debug         Optional flag to enable extra debug output (default is FALSE).
 * @return  Returns       FALSE if an error or test failure occurred, TRUE on a successful pass.
 *}
function ui_dialog_operator_true_false(Title: string; Message: string; SuccessFlag: boolean; Debug: boolean = FALSE): boolean;
begin

   // Initialize report line and status flags
   ReportLine = '';            // text to display in the report box
   OperatorResult = FALSE;     // operator�s True/False choice
   Error = FALSE;              // tracks whether an error/failure occurred

   // Show a custom dialog with Cancel, True, False buttons
   Button = UIMessageDialogCustom(Title, Message, ['CANCEL', 'TRUE', 'FALSE']);
   switch(Button)
   begin
      case DIALOGRESULT_Closed:
      begin
         UIWriteError('Operator closed dialog box!');  // log error on close
         Error = TRUE;
         fail_count_other_increase();                  // increment failure counter
      end;
      case DIALOGRESULT_Button1:
      begin
         UIWriteError('Operator canceled dialog box!'); // log error on cancel
         Error = TRUE;
         fail_count_other_increase();                   // increment failure counter
      end;
      case DIALOGRESULT_Button2:
      begin
         OperatorResult = TRUE;                         // operator chose TRUE
      end;
      case DIALOGRESULT_Button3:
      begin
         OperatorResult = FALSE;                        // operator chose FALSE
      end;
   end;

   // Evaluate operator choice against expected success flag
   if (SuccessFlag)
   begin
      if (OperatorResult)
      begin
         ReportLine = StrAdd(Message, ': PASS');      // correct choice ? pass
      end
      else
      begin
         ReportLine = StrAdd(Message, ': FAIL');      // incorrect ? fail
         if (NOT Error)
         begin
            fail_count_other_increase();              // count failure if not already error
         end;
         Error = TRUE;                                // mark as error/failure
      end;
   end
   else
   begin
      if (OperatorResult)
      begin
         ReportLine = StrAdd(Message, ': FAIL');      // should have been False ? fail
         if (NOT Error)
         begin
            fail_count_other_increase();              // count failure
         end;
         Error = TRUE;                                // mark as error/failure
      end
      else
      begin
         ReportLine = StrAdd(Message, ': PASS');      // correct choice ? pass
      end;
   end;

   // Display the result in a bordered message box
   msg_box_border(ReportLine, '*', Error);           // use '*' border, indicate error if any

   blank_line(TRUE);                                 // add a blank line for readability

   Result = TRUE;

   if (Error)
   begin
      Result = FALSE;                                // return FALSE on error/failure
   end;

end;

function max_real(Var1: real; Var2: real): real;
begin
   // There is an arith_max() function
   Result = Var1;

   if (Var2 > Var1) 
   begin
      Result = Var2;
   end;
end;

{**
  @brief   Frame and center-pad a string with spaces between border characters.
  @details Calculates the number of spaces needed on each side of @p Str so that the total
           inside width equals @p Length, then surrounds the result with @p PadChar.
           If the padding difference is odd, the extra space is added to the right side.
  @param   PadChar  A single-character string used as the left and right border.
  @param   Str      The text to be padded.
  @param   Length   The target length of the text area (excluding the two border characters).
  @param   Debug    Optional flag; when TRUE, outputs intermediate values for debugging.
  @return  The resulting string, padded and bounded by @p PadChar.
**}
function pad_str_char(PadChar: string; Str: string; Length: integer; Debug: boolean = FALSE): string;
begin
   // Get the current length of the input string
   StrLen = StrLength(Str);

   // Determine how many total padding spaces are needed
   LenDiff = Length - StrLen;

   // Split the padding roughly evenly between left and right
   LenSplit = LenDiff / 2;

   // Start building result with left border character
   Result = PadChar;

   // Compute how many spaces to add on the left side (excluding one taken by border)
   TargetPadding = LenSplit - 1;

   // Add left-side spaces
   for Count = 1 to TargetPadding do
   begin
      Result = StrAdd(Result, ' ');
   end;

   // Insert the original string
   Result = StrAdd(Result, Str);

   // If total padding is odd, add one extra space on the right
   if (ArithOdd(LenDiff))
   begin
      TargetPadding = TargetPadding + 1;
   end;

   // Add right-side spaces
   for Count = 1 to TargetPadding do
   begin
      Result = StrAdd(Result, ' ');
   end;

   // Append the right border character
   Result = StrAdd(Result, PadChar);

   // Output debug information if requested
   if (Debug)
   begin
      UIWriteNormal(StrAdd('StrLen: ', StrLen));          // length of original string
      UIWriteNormal(StrAdd('LenDiff: ', LenDiff));        // total padding needed
      UIWriteNormal(StrAdd('LenSplit: ', LenSplit));      // half of padding
      UIWriteNormal(StrAdd('TargetPadding: ', TargetPadding)); // final per-side padding
   end;
end;


{**
  @brief   Prompt for two manual readings, validate each against individual ranges and their difference, and display results.
  @details
    1. Displays an input dialog for the lower measurement described by @p LowerLine in units @p Units.
    2. Validates the lower value against [@p LowerMinValue, @p LowerMaxValue]; aborts on cancel or out-of-range.
    3. Repeats steps 1�2 for the upper measurement described by @p UpperLine and bounds [@p UpperMinValue, @p UpperMaxValue].
    4. Computes the delta = upper � lower, validates it against [@p DeltaMin, @p DeltaMax]; aborts on failure.
    5. Constructs and displays a bordered summary of the lower, upper, and delta values.
  @param   LowerLine      Text describing the lower measurement prompt.
  @param   UpperLine      Text describing the upper measurement prompt.
  @param   Units          Units label shown alongside prompts and results.
  @param   LowerMinValue  Minimum allowable lower reading.
  @param   LowerMaxValue  Maximum allowable lower reading.
  @param   UpperMinValue  Minimum allowable upper reading.
  @param   UpperMaxValue  Maximum allowable upper reading.
  @param   DeltaMin       Minimum allowable difference (upper minus lower).
  @param   DeltaMax       Maximum allowable difference (upper minus lower).
  @param   Debug          Optional flag to enable debug logging (default FALSE).
  @return  void
**}
function report_manual_reading_delta(LowerLine: string; UpperLine: string; Units: string; LowerMinValue: real; LowerMaxValue: real; UpperMinValue: real; UpperMaxValue: real; DeltaMin: real; DeltaMax: real; Debug: boolean = FALSE): void;
begin
   // Insert blank line before first prompt
   blank_line(TRUE);

   // Build prompt message for lower value
   MsgText = StrAdd('Enter manual reading:<BR>', LowerLine);
   MsgText = StrAdd(MsgText, ' (');
   MsgText = StrAdd(MsgText, Units);
   MsgText = StrAdd(MsgText, ')');

   // Initialize input result
   InputResult = '0';

   // Show input dialog for lower measurement
   Button = UIEditDialog('Enter Value', MsgText, FALSE, TRUE, InputResult);

   // Handle lower value entry or cancellation
   if (Button == DIALOGRESULT_Ok)
   begin
      if (Debug)
      begin
         // Debug: log the raw entered string
         UIWriteNormal(StrAdd('Entered value: ', InputResult));
      end;
   end
   else
   begin
      // Operator canceled lower input ? abort test
      UIWriteNormal('Canceled by operator');
      MiscAbortTest();
   end;

   // Convert lower input to numeric form
   LowerValueEntered = 0.0;
   if (FormatIsInteger(InputResult))
   begin
      LowerValueEntered = InputResult;
   end;
   if (FormatIsReal(InputResult))
   begin
      LowerValueEntered = InputResult;
   end;

   // Validate lower value range
   if (LowerValueEntered > LowerMaxValue)
   begin
      ErrorLine = StrAdd('Value entered above maximum value: ', LowerMaxValue);
      ErrorLine = StrAdd(ErrorLine, Units);
      ui_report_error(ErrorLine);
      MiscAbortTest();
   end;
   if (LowerValueEntered < LowerMinValue)
   begin
      ErrorLine = StrAdd('Value entered below minimum value: ', LowerMinValue);
      ErrorLine = StrAdd(ErrorLine, Units);
      ui_report_error(ErrorLine);
      MiscAbortTest();
   end;

   // Prompt for upper measurement
   MsgText = StrAdd('Enter manual reading:<BR>', UpperLine);
   MsgText = StrAdd(MsgText, ' (');
   MsgText = StrAdd(MsgText, Units);
   MsgText = StrAdd(MsgText, ')');

   InputResult = '0';
   Button = UIEditDialog('Enter Value', MsgText, FALSE, TRUE, InputResult);

   // Handle upper value entry or cancellation
   if (Button == DIALOGRESULT_Ok)
   begin
      if (Debug)
      begin
         // Debug: log the raw entered string
         UIWriteNormal(StrAdd('Entered value: ', InputResult));
      end;
   end
   else
   begin
      // Operator canceled upper input ? abort test
      UIWriteNormal('Canceled by operator');
      MiscAbortTest();
   end;

   // Convert upper input to numeric form
   UpperValueEntered = 0.0;
   if (FormatIsInteger(InputResult))
   begin
      UpperValueEntered = InputResult;
   end;
   if (FormatIsReal(InputResult))
   begin
      UpperValueEntered = InputResult;
   end;

   // Validate upper value range
   if (UpperValueEntered > UpperMaxValue)
   begin
      ErrorLine = StrAdd('Value entered above maximum value: ', UpperMaxValue);
      ErrorLine = StrAdd(ErrorLine, Units);
      ui_report_error(ErrorLine);
      MiscAbortTest();
   end;
   if (UpperValueEntered < UpperMinValue)
   begin
      ErrorLine = StrAdd('Value entered below minimum value: ', UpperMinValue);
      ErrorLine = StrAdd(ErrorLine, Units);
      ui_report_error(ErrorLine);
      MiscAbortTest();
   end;

   // Compute difference between upper and lower
   Delta = UpperValueEntered - LowerValueEntered;

   // Validate delta range
   if (Delta < DeltaMin)
   begin
      ErrorLine = StrAdd('Delta between values lower than limit: ', DeltaMin);
      ErrorLine = StrAdd(ErrorLine, Units);
      ui_report_error(ErrorLine);
      MiscAbortTest();
   end;
   if (Delta > DeltaMax)
   begin
      ErrorLine = StrAdd('Delta between values higher than limit: ', DeltaMax);
      ErrorLine = StrAdd(ErrorLine, Units);
      ui_report_error(ErrorLine);
      MiscAbortTest();
   end;

   // Build report lines for lower, upper, and delta
   ReportLowerLine = '';
   ReportLowerLine = StrAdd(ReportLowerLine, LowerLine);
   ReportLowerLine = StrAdd(ReportLowerLine, ' measured value (');
   ReportLowerLine = StrAdd(ReportLowerLine, LowerMinValue);
   ReportLowerLine = StrAdd(ReportLowerLine, '-');
   ReportLowerLine = StrAdd(ReportLowerLine, LowerMaxValue);
   ReportLowerLine = StrAdd(ReportLowerLine, ' ');
   ReportLowerLine = StrAdd(ReportLowerLine, Units);
   ReportLowerLine = StrAdd(ReportLowerLine, '): ');
   ReportLowerLine = StrAdd(ReportLowerLine, LowerValueEntered);
   ReportLowerLine = StrAdd(ReportLowerLine, ' ');
   ReportLowerLine = StrAdd(ReportLowerLine, Units);

   ReportUpperLine = '';
   ReportUpperLine = StrAdd(ReportUpperLine, UpperLine);
   ReportUpperLine = StrAdd(ReportUpperLine, ' measured value (');
   ReportUpperLine = StrAdd(ReportUpperLine, UpperMinValue);
   ReportUpperLine = StrAdd(ReportUpperLine, '-');
   ReportUpperLine = StrAdd(ReportUpperLine, UpperMaxValue);
   ReportUpperLine = StrAdd(ReportUpperLine, ' ');
   ReportUpperLine = StrAdd(ReportUpperLine, Units);
   ReportUpperLine = StrAdd(ReportUpperLine, '): ');
   ReportUpperLine = StrAdd(ReportUpperLine, UpperValueEntered);
   ReportUpperLine = StrAdd(ReportUpperLine, ' ');
   ReportUpperLine = StrAdd(ReportUpperLine, Units);

   ReportDeltaLine = '';
   ReportDeltaLine = StrAdd(ReportDeltaLine, 'Delta value (');
   ReportDeltaLine = StrAdd(ReportDeltaLine, DeltaMin);
   ReportDeltaLine = StrAdd(ReportDeltaLine, '-');
   ReportDeltaLine = StrAdd(ReportDeltaLine, DeltaMax);
   ReportDeltaLine = StrAdd(ReportDeltaLine, ' ');
   ReportDeltaLine = StrAdd(ReportDeltaLine, Units);
   ReportDeltaLine = StrAdd(ReportDeltaLine, '): ');
   ReportDeltaLine = StrAdd(ReportDeltaLine, Delta);
   ReportDeltaLine = StrAdd(ReportDeltaLine, ' ');
   ReportDeltaLine = StrAdd(ReportDeltaLine, Units);

   // Determine maximum string length for uniform box width
   StrLenLower = StrLength(ReportLowerLine);
   StrLenUpper = StrLength(ReportUpperLine);
   StrLenDelta = StrLength(ReportDeltaLine);

   MaxStrLen = 0;
   MaxStrLen = max_real(MaxStrLen, StrLenLower);
   MaxStrLen = max_real(MaxStrLen, StrLenUpper);
   MaxStrLen = max_real(MaxStrLen, StrLenDelta);

   BoxTopLen = MaxStrLen + 4;

   // Pad each report line to match box width
   ReportLowerLine = pad_str_char('*', ReportLowerLine, BoxTopLen, FALSE);
   ReportUpperLine = pad_str_char('*', ReportUpperLine, BoxTopLen, FALSE);
   ReportDeltaLine = pad_str_char('*', ReportDeltaLine, BoxTopLen, FALSE);

   // Build box top and middle borders
   StrBoxTop = '';
   for Char = 1 to BoxTopLen do
   begin
      StrBoxTop = StrAdd(StrBoxTop, '*');
   end;
   StrBoxMiddle = '*';
   for Char = 1 to BoxTopLen - 2 do
   begin
      StrBoxMiddle = StrAdd(StrBoxMiddle, ' ');
   end;
   StrBoxMiddle = StrAdd(StrBoxMiddle, '*');

   // Output the boxed report
   ui_report_normal(StrBoxTop);
   ui_report_normal(ReportLowerLine);
   ui_report_normal(ReportUpperLine);
   ui_report_normal(ReportDeltaLine);
   ui_report_normal(StrBoxTop);

   // Insert a blank line after reporting
   blank_line(TRUE);
end;


{**
  @brief   Prompt the operator to enter or scan the Epicor part number and verify it matches the expected value.
  @param   PartNum  The expected Epicor part number for this test.
  @return  void
**}
function check_epicor_pn(PartNum: string): void;
begin
   // Initialize the input result buffer
   InputResult = '';

   // Prompt the operator to enter or scan the Epicor part number
   Button = UIEditDialog(
      'Epicor Part Number',
      'Scan or enter the Epicor PN from the Traveler',
      FALSE,
      TRUE,
      InputResult
   );

   // If the operator clicked OK, validate the entry
   if (Button == DIALOGRESULT_Ok)
   begin
      // Trim whitespace from the entered value
      InputResult = StrTrim(InputResult);

      // Compare the expected part number to the operator�s entry
      Result = StrCompare(PartNum, InputResult);

      // If they do not match, display a boxed error and abort
      if (Result <> 0)
      begin
         ui_report_error('*********************************************');
         ui_report_error('* WRONG PART NUMBER ENTERED FOR THIS TEST!  *');
         ui_report_error('* PLEASE VERIFY YOU HAVE THE CORRECT TEST   *');
         ui_report_error('* FOR YOUR PART NUMBER OR CONTACT TEST LAB! *');
         ui_report_error('*********************************************');
         MiscAbortTest();  // stop the test due to mismatch
      end;
   end
   else
   begin
      // Operator canceled the entry ? log error and abort
      ui_report_error('User canceled entering PN');
      MiscAbortTest();
   end;
end;


{**
  @brief   Display an informational dialog that the operator can cancel to abort the test.
  @param   Msg   The message text to show in the OK/Cancel dialog.
  @return  void
**}
function ui_info_cancellable(Msg: string): void;
begin
   // Display an OK/Cancel dialog with the provided message
   Button = UIMessageDialogOkCancel(Msg);

   // If the operator selects Cancel, abort the test execution
   if (Button == DIALOGRESULT_Cancel)
   begin
      MiscAbortTest();
   end;
end;


{**
  @brief   Check the main failure counter and notify the timer subsystem of errors.
  @details
    Retrieves the current failure count from the main failure counter (FAILCOUNTER_Main)
    and forwards it, along with the debug flag, to the timer error handler function.
  @param   Debug  Optional flag to enable debug logging (default FALSE).
  @return  void
**}
function timer_check_fails(Debug: boolean = FALSE): void;
begin
   // Get the number of failures recorded in the main counter
   Fails = FailCounterGet(FAILCOUNTER_Main);

   if (Debug)
   begin
      // Log the current fail count for debugging
      UIWriteWarning(StrAdd('Fail Counter [Main]:', Fails));
   end;

   // Pass the fail count and debug flag to the timer's error handling routine
   timer_set_errors(Fails, Debug);
end;


{**
  @brief   Initialize and prompt the operator to start the test, then start the test timer.
  @details
    - Clears existing timer errors.
    - Uses @p Seconds if non-zero; otherwise reads the duration from an INI file.
    - If the INI lookup returns "NULL", sets duration to zero, stops the timer, and displays "Unknown".
    - Configures and starts the timer if a positive duration is available.
    - Displays a cancellable info dialog with @p Message.
    - Enables global message printing and begins the timer.
  @param   Seconds  Optional override for the test duration in seconds (default = 0).
  @param   Message  The prompt text shown in the start dialog (default = 'PRESS SPACEBAR TO START TEST').
  @param   Debug    Optional flag to enable debug logging (default = FALSE).
  @return  void
**}
function ui_test_prompt(Seconds: integer = 0; Message: string = 'PRESS SPACEBAR TO START TEST'; Debug: boolean = FALSE): void;
begin
   // Clear any previous timer error counts
   timer_set_errors(0, Debug);

   // Determine test duration: use provided Seconds or read from configuration
   if (Seconds <> 0)
   begin
     // Override duration with the passed parameter
     Test_seconds = Seconds;
   end
   else
   begin
      // Fetch duration string from INI file
      Test_duration = read_test_duration(Debug);
      if (Debug)
      begin
         UIWriteNormal(StrAdd('Returned test duration: ', Test_duration));  // debug log
      end;

      // If INI lookup failed, handle as unknown duration
      if (StrCompare(Test_duration, 'NULL') == 0)
      begin
         if (Debug)
         begin
            UIWriteNormal('Test duration is NULL, setting to ZERO (0) and displaying message');  // debug log
         end;
         Test_seconds = 0;                                        // no valid duration
         timer_stop(Debug, TRUE);                                // ensure timer is stopped
         timer_disp_str('Unknown', 0, Debug, TRUE);              // display 'Unknown' on timer
      end
      else
      begin
         // Convert the returned duration string to numeric seconds
         Test_seconds = Test_duration;
         if (Debug)
         begin
            UIWriteNormal(StrAdd('Setting seconds to: ', Test_seconds));  // debug log
         end;
      end;
   end;

   // Configure the timer display only if a positive duration is set
   if (Test_seconds <> 0)
   begin
      timer_set(Test_seconds, Debug, TRUE);  // prepare timer with duration
   end;

   // Show a start prompt that the operator can cancel
   ui_info_cancellable(Message);

   // Ensure messages will be printed via the GlobalDataRead flag
   GlobalDataRead('MsgPrint', ON);

   // Start the timer if it was configured
   if (Test_seconds <> 0)
   begin
      timer_start(Debug);
   end;

   // Insert a blank line after starting
   blank_line(TRUE);
end;


{**
  @brief   Build a parenthesized string showing the states of two switches.
  @param   SW1Name   Name of the first switch (for reference).
  @param   SW1State  State text of the first switch.
  @param   SW2Name   Name of the second switch (for reference).
  @param   SW2State  State text of the second switch.
  @return  A string in the format "(SW1State, SW2State)".
**}
function str_sw_two_state(SW1Name: string; SW1State: string; SW2Name: string; SW2State: string): string;
begin
   // Initialize result with an opening parenthesis
   Result = '(';
   // Append the first switch state
   Result = StrAdd(Result, SW1State);
   // Append a comma and space separator
   Result = StrAdd(Result, ', ');
   // Append the second switch state
   Result = StrAdd(Result, SW2State);
   // Append the closing parenthesis
   Result = StrAdd(Result, ')');
end;


//function str_sw_three_state(SW1Name: string; SW1State: string; SW2Name: string; SW2State: string; SW3Name: string; SW3State: string): string;
//begin
//   Result = StrAdd(SW1Name, ' ');
