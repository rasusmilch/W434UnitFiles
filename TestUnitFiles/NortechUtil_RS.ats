//   Result = StrAdd(Result, ' ');
//   Result = StrAdd(Result, SW3State);
//end;

{**
  @brief   Build a parenthesized string showing the states of three switches.
  @param   SW1Name   Name of the first switch (for reference).
  @param   SW1State  State text of the first switch.
  @param   SW2Name   Name of the second switch (for reference).
  @param   SW2State  State text of the second switch.
  @param   SW3Name   Name of the third switch (for reference).
  @param   SW3State  State text of the third switch.
  @return  A string in the format "(SW1State, SW2State, SW3State)".
**}
function str_sw_three_state(SW1Name: string; SW1State: string; SW2Name: string; SW2State: string; SW3Name: string; SW3State: string): string;
begin
   // Initialize result with opening parenthesis and first switch state
   Result = StrAdd('(', SW1State);
   // Append comma and space separator
   Result = StrAdd(Result, ', ');
   // Append second switch state
   Result = StrAdd(Result, SW2State);
   // Append comma and space separator
   Result = StrAdd(Result, ', ');
   // Append third switch state
   Result = StrAdd(Result, SW3State);
   // Append closing parenthesis
   Result = StrAdd(Result, ')');
end;


{**
  @brief   Verify a two-pin switch in both its states (NC and NO) according to the specified default.
  @param   SWName   The label or identifier of the switch under test.
  @param   Pin1     The first terminal pin of the switch.
  @param   Pin2     The second terminal pin of the switch.
  @param   NCState  If TRUE, test closed (NC) first then open (NO); if FALSE, test open first then closed.
  @return  Returns TRUE if both continuity and no-continuity tests complete without abort; test is aborted on failure or cancel.
**}
function test_one_switch(SWName: string; Pin1: tpin; Pin2: tpin; NCState: boolean): boolean;
begin
   // Build and display the test header
   String = 'TESTING SWITCH ';
   String = StrAdd(String, SWName);

   // Add spacing in UI and report for readability
   blank_line();

   // Display the header in UI and report
   msg_box_border(String, '*');

   if (NCState == TRUE)
   begin
      // --- Test Normally Closed (NC) first ---
      String = StrAdd(SWName, ' CLOSED');
      ConnectionTest(String, Pin1, Pin2);

      // Prompt operator to change switch to Open
      String = StrAdd('PRESS AND HOLD ', SWName);
      ui_info_cancellable(String);

      // --- Test Normally Open (NO) now ---
      String = StrAdd(SWName, ' OPEN');
      NoConnectionLV(String, Pin1, Pin2);
   end
   else
   begin
      // --- Test Normally Open (NO) first ---
      String = StrAdd(SWName, ' OPEN');
      NoConnectionLV(String, Pin1, Pin2);

      // Prompt operator to change switch to Closed
      String = StrAdd('PRESS AND HOLD ', SWName);
      ui_info_cancellable(String);

      // --- Test Normally Closed (NC) now ---
      String = StrAdd(SWName, ' CLOSED');
      ConnectionTest(String, Pin1, Pin2);
   end;

   // Prompt operator to release all switch contacts before proceeding
   ui_info_cancellable('RELEASE ALL SWITCHES');

   // Note: Underlying test functions abort on failure; returned value indicates overall success
end;

{**
  @brief   Perform continuity/no-continuity tests on a primary switch and its override counterpart.
  @details
    - Displays a combined header: "TESTING SWITCHES @p SWName, @p SWNameOverride".
    - If @p NCState = TRUE, executes three test phases:
      1. Primary CLOSED, override OPEN.
      2. Both OPEN after prompting the operator to hold the primary switch.
      3. Primary OPEN, override CLOSED after prompting the operator to hold the override switch.
    - If @p NCState = FALSE, shows an unimplemented notice and aborts the test.
    - Finally, prompts the operator to release all switches.
  @param   SWName           Identifier of the primary switch under test.
  @param   SWNameOverride   Identifier of the override switch under test.
  @param   Pin1             First pin used for continuity/no-continuity checks.
  @param   Pin2             Second pin used for continuity/no-continuity checks.
  @param   NCState          If TRUE, perform the NC-first test sequence; else abort as unimplemented.
  @return  TRUE if tests complete without abort; aborts on failure or unimplemented branch.
**}
function test_one_switch_with_override(SWName: string; SWNameOverride: string; Pin1: tpin; Pin2: tpin; NCState: boolean): boolean;
begin
   // Build test header combining both switch names
   String = 'TESTING SWITCHES ';
   String = StrAdd(String, SWName);
   String = StrAdd(String, ', ');
   String = StrAdd(String, SWNameOverride);

   // Add spacing in UI and report for readability
   blank_line();

   // Display the header in UI and report
   msg_box_border(String, '*');

   if (NCState == TRUE)
   begin
      // --- Phase 1: primary CLOSED, override OPEN (1,0) ---
      String = str_sw_two_state(SWName, 'CLOSED', SWNameOverride, 'OPEN');
      ui_report_normal(StrAdd('Continuity: ', String));
      ConnectionTest('SW', Pin1, Pin2);

      // Prompt operator to hold the primary switch
      String = StrAdd('PRESS AND HOLD ', SWName);
      ui_info_cancellable(String);

      // --- Phase 2: both OPEN (0,0) ---
      String = str_sw_two_state(SWName, 'OPEN', SWNameOverride, 'OPEN');
      ui_report_normal(StrAdd('NCLV: ', String));
      NoConnectionLV('NCLV', Pin1, Pin2);

      // Prompt operator to hold the override switch
      String = StrAdd('PRESS AND HOLD ', SWNameOverride);
      ui_info_cancellable(String);

      // --- Phase 3: primary OPEN, override CLOSED (0,1) ---
      String = str_sw_two_state(SWName, 'OPEN', SWNameOverride, 'CLOSED');
      ui_report_normal(StrAdd('Continuity: ', String));
      ConnectionTest('SW', Pin1, Pin2);
   end
   else
   begin
      // NCState = FALSE: test not implemented
      UIInfoDialog('TEST NOT IMPLEMENTED. PLEASE CONTACT TEST DEPARTMENT');
      MiscAbortTest();
   end;

   // Final prompt to release all switches
   ui_info_cancellable('RELEASE ALL SWITCHES');
end;


{**
  @brief   Perform series continuity tests on two switches in a single circuit.
  @details
    - Displays a header combining @p SWName1 and @p SWName2.
    - If @p NCState = TRUE, executes three test phases in series:
      1. Both switches CLOSED (1,1).
      2. First switch OPEN, second CLOSED (0,1) after prompting operator.
      3. First CLOSED, second OPEN (1,0) after prompting operator.
    - If @p NCState = FALSE, displays a not-implemented dialog and aborts.
    - Finally, prompts the operator to release all switches.
  @param   SWName1  Identifier for the first switch.
  @param   SWName2  Identifier for the second switch.
  @param   Pin1     First terminal pin for continuity checks.
  @param   Pin2     Second terminal pin for continuity checks.
  @param   NCState  If TRUE, run the series NC-first sequence; otherwise abort as unimplemented.
  @return  Returns TRUE upon successful test sequence; aborts on error or unimplemented branch.
**}
function test_two_series(SWName1: string; SWName2: string; Pin1: tpin; Pin2: tpin; NCState: boolean): boolean;
begin
   // Initialize the test header string
   String = 'TESTING SWITCHES ';
   String = StrAdd(String, SWName1);
   String = StrAdd(String, ', ');
   String = StrAdd(String, SWName2);

   // Add spacing in UI and report for readability
   blank_line();

   // Display the header in UI and report
   msg_box_border(String, '*');

   if (NCState == TRUE)
   begin
      // --- Phase 1: both switches CLOSED (1,1) ---
      String = str_sw_two_state(SWName1, 'CLOSED', SWName2, 'CLOSED');
      ui_report_normal(StrAdd('Continuity: ', String));
      ConnectionTest('SW', Pin1, Pin2);

      // --- Phase 2: first OPEN, second CLOSED (0,1) ---
      String = StrAdd('PRESS AND HOLD ', SWName1);
      ui_info_cancellable(String);
      String = str_sw_two_state(SWName1, 'OPEN', SWName2, 'CLOSED');
      ui_report_normal(StrAdd('NCLV: ', String));
      NoConnectionLV('NCLV', Pin1, Pin2);

      // --- Phase 3: first CLOSED, second OPEN (1,0) ---
      String = StrAdd('RELEASE ', SWName1);
      String = StrAdd(String, '<BR>PRESS AND HOLD ');
      String = StrAdd(String, SWName2);
      ui_info_cancellable(String);
      String = str_sw_two_state(SWName1, 'CLOSED', SWName2, 'OPEN');
      ui_report_normal(StrAdd('NCLV: ', String));
      NoConnectionLV('NCLV', Pin1, Pin2);
   end
   else
   begin
      // Unimplemented NCState = FALSE branch: notify and abort
      UIInfoDialog('TEST NOT IMPLEMENTED. PLEASE CONTACT TEST DEPARTMENT');
      MiscAbortTest();
   end;

   // Final prompt to release all switches
   ui_info_cancellable('RELEASE ALL SWITCHES');
end;


{**
  @brief   Perform series continuity tests on two switches with an override switch.
  @details
    - Constructs and displays a header combining @p SW1Name, @p SW2Name, and @p SWOverrideName.
    - If @p NCState = TRUE, executes the following sequence:
      1. Test both switches closed and override open (1,1,0).
      2. Prompt operator to hold @p SW1Name, then test (0,1,0).
      3. Prompt operator to release @p SW1Name and hold @p SW2Name, then test (1,0,0).
      4. Prompt operator to hold @p SWOverrideName, then test (1,0,1).
    - If @p NCState = FALSE, displays a not-implemented message and aborts.
    - Finally, prompts the operator to release all switches.
  @param   SW1Name          Identifier for the first switch.
  @param   SW2Name          Identifier for the second switch.
  @param   SWOverrideName   Identifier for the override switch.
  @param   Pin1             First terminal pin for continuity tests.
  @param   Pin2             Second terminal pin for continuity tests.
  @param   NCState          If TRUE, run the NC-first series sequence; otherwise abort.
  @return  TRUE if the test sequence completes without abort; aborts on failure or unimplemented branch.
**}
function test_two_series_with_override(SW1Name: string; SW2Name: string; SWOverrideName: string; Pin1: tpin; Pin2: tpin; NCState: boolean): boolean;
begin
   // Build the test header with all switch names
   String = 'TESTING SWITCHES ';
   String = StrAdd(String, SW1Name);
   String = StrAdd(String, ', ');
   String = StrAdd(String, SW2Name);
   String = StrAdd(String, ', ');
   String = StrAdd(String, SWOverrideName);

   // Add spacing in UI and report for readability
   blank_line();

   // Display the header in UI and report
   msg_box_border(String, '*');

   if (NCState == TRUE)
   begin
      // --- Phase 1: S1 CLOSED, S2 CLOSED, Override OPEN (1,1,0) ---
      String = str_sw_three_state(SW1Name, 'CLOSED', SW2Name, 'CLOSED', SWOverrideName, 'OPEN');
      ui_report_normal(StrAdd('Continuity: ', String));
      ConnectionTest('SW', Pin1, Pin2);

      // --- Phase 2: Prompt to hold S1, then test S1 OPEN, S2 CLOSED, Override OPEN (0,1,0) ---
      String = StrAdd('PRESS AND HOLD ', SW1Name);
      ui_info_cancellable(String);
      String = str_sw_three_state(SW1Name, 'OPEN',   SW2Name, 'CLOSED', SWOverrideName, 'OPEN');
      ui_report_normal(StrAdd('NCLV: ', String));
      NoConnectionLV('NCLV', Pin1, Pin2);

      // --- Phase 3: Prompt to release S1 and hold S2, then test S1 CLOSED, S2 OPEN, Override OPEN (1,0,0) ---
      String = StrAdd('RELEASE ', SW1Name);
      String = StrAdd(String, '<BR>PRESS AND HOLD ');
      String = StrAdd(String, SW2Name);
      ui_info_cancellable(String);
      String = str_sw_three_state(SW1Name, 'CLOSED', SW2Name, 'OPEN',   SWOverrideName, 'OPEN');
      ui_report_normal(StrAdd('NCLV: ', String));
      NoConnectionLV('NCLV', Pin1, Pin2);

      // --- Phase 4: Prompt to hold Override, then test S1 CLOSED, S2 OPEN, Override CLOSED (1,0,1) ---
      String = StrAdd('PRESS AND HOLD ', SWOverrideName);
      ui_info_cancellable(String);
      String = str_sw_three_state(SW1Name, 'CLOSED', SW2Name, 'OPEN',   SWOverrideName, 'CLOSED');
      ui_report_normal(StrAdd('Continuity: ', String));
      ConnectionTest('WIRE', Pin1, Pin2);
   end
   else
   begin
      // Unimplemented branch: notify operator and abort test
      UIInfoDialog('TEST NOT IMPLEMENTED. PLEASE CONTACT TEST DEPARTMENT');
      MiscAbortTest();
   end;

   // Final prompt to release all switches before proceeding
   ui_info_cancellable('RELEASE ALL SWITCHES');
end;


{**
  @brief   Calculate and display the capacitance tolerance range.
  @details Computes the upper and lower tolerance limits from the average capacitance
           (@p CapAvg) and a percentage tolerance (@p TolPercent), then reports the
           formatted range.
  @param   CapAvg      Average capacitance in Farads (e.g., 1.0E-9 for 1 nF).
  @param   TolPercent  Integer percentage tolerance (e.g., 10 for �10%).
  @return  void
**}
function rcl_test_cap_report(CapAvg: real; TolPercent: integer): void;
begin
   // Print out tolerances for capacitance testing.
   // CapAvg: Specify as unitless float in Farads. nF is 1.0E-9
   // TolPercent: Integer percentage tolerance.

   UpperTol = CapAvg * (1 + (TolPercent / 100)); // calculate upper tolerance limit
   LowerTol = CapAvg * (1 - (TolPercent / 100)); // calculate lower tolerance limit

   blank_line(TRUE);                             // insert blank line before report

   ui_report_normal('Capacitance parameters');   // header for capacitance report
   String = StrAdd('Average: ', FormatCapacitance(CapAvg)); // add average value
   String = StrAdd(String, ', Tolerance: ');
   String = StrAdd(String, TolPercent);          // add tolerance percentage
   String = StrAdd(String, '%  ->  [');
   String = StrAdd(String, FormatCapacitance(LowerTol)); // add lower bound
   String = StrAdd(String, ' - ');
   String = StrAdd(String, FormatCapacitance(UpperTol)); // add upper bound
   String = StrAdd(String, ']');

   ui_report_normal(String);                     // display the full tolerance range

   blank_line(TRUE);                             // insert blank line after report
end;


{**
  @brief   Perform a capacitance test on specified pins with tolerance checking.
  @details
    Checks that the Electrical Components command group is active before testing.
    Computes upper and lower tolerance limits from the average capacitance (@p CapAvg)
    and percentage tolerance (@p TolPercent).  If @p ReportTol is TRUE, reports the
    tolerance parameters before running the test.  Executes an RLC parallel capacitance
    test and returns its result.  Aborts the test with an error if the command group
    is not active.
  @param   Name        Descriptive name for the capacitor under test.
  @param   FromPin     Starting terminal pin for the capacitance measurement.
  @param   ToPin       Ending terminal pin for the capacitance measurement.
  @param   CapAvg      Average capacitance in Farads (e.g., 1.0E-9 for 1 nF).
  @param   TolPercent  Integer percentage tolerance (e.g., 10 for �10%).
  @param   ReportTol   Optional flag to display tolerance info before testing (default FALSE).
  @return  TRUE if the capacitance falls within tolerance, FALSE otherwise.
**}
function rcl_test_cap(Name: string; Pin1: tpin; Pin2: tpin; CapAvg: real; TolPercent: integer; ReportTol: boolean = FALSE): boolean; tests rlccombinations;
begin
   Result = FALSE;  // default to failure

   // Verify electrical components support is available
   if (ParamIsCommandGroupActive(CMDGRP_ElectricalComponents))
   begin
      // Calculate tolerance bounds based on average and percentage
      UpperTol = CapAvg * (1 + (TolPercent / 100));  // upper limit
      LowerTol = CapAvg * (1 - (TolPercent / 100));  // lower limit

      if (ReportTol)
      begin
         // Optionally display tolerance parameters in report
         rcl_test_cap_report(CapAvg, TolPercent);
      end;

      // Execute the actual RLC parallel capacitance test
      Result = RLCParallelCapacitanceTest(Name, Pin1, Pin2, LowerTol, UpperTol);
   end
   else
   begin
      // Command group inactive ? report error and abort test
      ui_report_error('Electrical Components command group NOT ACTIVE! ABORTING TEST! Contact test department.');
      MiscAbortTest();
   end;

//   blank_line(TRUE);  // spacing after test
end;


{**
  @brief   Retrieve the operator�s name from the operator ID mapping file.
  @details
    1. Attempts to open the INI file defined by `FILE_OPERATOR_ID_MAP`.
    2. Reads the current operator ID from global data key `"Value1"` in `"TestStart InputData"`.
    3. Looks up the corresponding name in the `[OperatorID]` section using that ID.
    4. If the file cannot be opened or the lookup returns `"NULL"`, displays error dialogs, logs the error, and aborts the test.
  @return  The operator name string on success; never returns if an error occurs (test is aborted).
**}
function operator_name_from_id(): string;
begin
   // Default to "NULL" until a valid name is found
   Result = 'NULL';

   // Open the operator ID mapping INI file
   Handle = FileOpenIni(FILE_OPERATOR_ID_MAP);

   if (Handle == 0)
   begin
      // Failed to open file => notify operator and prevent further testing
      UIErrorDialog('COULD NOT OPEN OPERATOR ID FILE.<BR><BR>CONTACT TEST LAB.');
   end
   else
   begin
      // Retrieve the operator ID from global data
      Operator = GlobalDataRead('Value1', '', 'TestStart InputData');
      // Fetch the name corresponding to the operator ID
      OperatorName = FileGetIni(Handle, 'OperatorID', Operator, 'NULL');
      FileCloseIni(Handle);

      if (StrCompare(OperatorName, 'NULL') == 0)
      begin
         // No matching name found => log error, report, and abort
         UIWriteError('OPERATOR ID NOT FOUND. CONTACT TEST LAB');
         ReportWriteError('OPERATOR ID NOT FOUND, TEST AUTOMATICALLY ABORTED.');
         MiscAbortTest();
      end
      else
      begin
         // Valid name found => return it
         Result = OperatorName;
      end;
   end;
end;

{**
  @brief   Report the main failure counter total to the timer.
  @details
    Retrieves the count from the main failure counter (FAILCOUNTER_Main) and calls
    timer_set_errors to update the timer�s error register.
  @param   Debug  Optional flag to enable debug logging when TRUE (default FALSE).
  @return  void
**}
function timer_fails_check(Debug: boolean = FALSE): void;
begin
   // Main failure count
   Fails = FailCounterGet(FAILCOUNTER_Main);

   // Update the timer�s error register with the aggregated failure count
   timer_set_errors(Fails, Debug);
end;

{**
  @brief Route a message to either the report channel or the live UI with warning/error/normal handling.

  @details
  Dispatches the supplied text to one of two output paths:
  - **Report path** (when Report is TRUE): uses `ui_report_*` routines.
  - **UI path** (when Report is FALSE): uses `UIWrite*` routines.
  In each path, the routine:
  1) Emits a warning message if `Warning` is TRUE.
  2) Emits an error message if `Error` is TRUE.
  3) Validates that `Warning` and `Error` are not simultaneously TRUE; if they are,
     it opens an error dialog and aborts the active test sequence.
  4) Otherwise, emits a normal (non-severity) message.

  Note: The message may be emitted more than once in a given path (e.g., warning and then normal),
  depending on the combination of flags. The `Debug` parameter is accepted but not used here.

  @param Str The text to emit.
  @param Report When TRUE, route output through the report subsystem (`ui_report_*`).
  @param Warning When TRUE, also emit the message as a warning.
  @param Error When TRUE, also emit the message as an error.
  @param Debug Reserved for future diagnostic behavior; not used in this implementation.

  @return None.

  @pre The following routines must be available and an active test/UI context present:
       - ui_report_warning(str), ui_report_error(str), ui_report_normal(str)
       - UIWriteWarning(str), UIWriteError(str), UIWriteNormal(str)
       - UIErrorDialog(str), MiscAbortTest()

  @post If both `Error` and `Warning` are TRUE, an error dialog is displayed and the current test is aborted.

  @sideeffects Produces user-visible/report-visible output; may terminate the current test on invalid flag combinations.

  @header
  ui_print_helper(Str: string; Report: boolean = FALSE; Warning: boolean = FALSE; Error: boolean = FALSE; Debug: boolean = FALSE): void;
  Route a message to UI or report with severity flags and guard against invalid combinations.
*}
function ui_print_helper(Str: string; Report: boolean = FALSE; Warning: boolean = FALSE; Error: boolean = FALSE; Debug: boolean = FALSE): void;
begin

   if (Debug)
   begin
      DebugStr = StrAdd('Report: ', Report);
      DebugStr = StrAdd(DebugStr, ', Warning: ');
      DebugStr = StrAdd(DebugStr, Warning);
      DebugStr = StrAdd(DebugStr, ', Error: ');
      DebugStr = StrAdd(DebugStr, Error);
      UIWriteWarning(DebugStr);
   end;

   // Select the reporting path: report subsystem when TRUE, otherwise live UI.
   if (Report)
   begin
      // Guard against invalid simultaneous severity flags.
      if (Error AND Warning)
      begin
         UIErrorDialog('Invalid: ERROR AND WARNING SET FOR OUTPUT');
         MiscAbortTest();
      end;

      if (Error)
      begin
         // Emit the normal (non-severity) UI message.
         ui_report_error(Str);
      end
      else
      begin
         if (Warning)
         begin
            ui_report_warning(Str);
         end
         else
         begin
            ui_report_normal(Str);
         end;
      end;
   end
   else
   begin
      // Guard against invalid simultaneous severity flags.
      if (Error AND Warning)
      begin
         UIErrorDialog('Invalid: ERROR AND WARNING SET FOR OUTPUT');
         MiscAbortTest();
      end;

      if (Error)
      begin
         // Emit the normal (non-severity) UI message.
         UIWriteError(Str);
      end
      else
      begin
         if (Warning)
         begin
            UIWriteWarning(Str);
         end
         else
         begin
            UIWriteNormal(Str);
         end;
      end;
   end;
end;

{**
  @brief Forward a single text segment to the UI/report printing helper.

  @details
  Thin wrapper that forwards one string argument and all severity/route flags to
  the underlying printing helper. No concatenation or transformation is performed.

  @param Str1 The text to emit.
  @param Report When TRUE, route output to the report subsystem; otherwise to live UI.
  @param Warning When TRUE, mark the message as a warning in the chosen channel.
  @param Error When TRUE, mark the message as an error in the chosen channel.
  @param Debug Passed through to the helper for potential diagnostic behavior.

  @return None.

  @post Message may be emitted to UI and/or report depending on flags.

  @sideeffects Produces user-visible/report-visible output via ui_print_helper.

  @header
  ui_print_str_1(Str1: string; Report: boolean = FALSE; Warning: boolean = FALSE; Error: boolean = FALSE; Debug: boolean = FALSE): void;
  Forward single string to print helper.
*}
function ui_print_str_1(Str1: string; Report: boolean = FALSE; Warning: boolean = FALSE; Error: boolean = FALSE; Debug: boolean = FALSE): void;
begin
   // Forward the single segment string and all flags to the printing helper.
   ui_print_helper(Str1, Report, Warning, Error, Debug);

end;

{**
  @brief Concatenate two text segments (Str1 + Str2) and emit via the printing helper.

  @details
  Builds a message by sequentially appending Str2 to Str1 (no separator inserted),
  then forwards the combined string and all severity/route flags to the helper.

  @param Str1 First text segment.
  @param Str2 Second text segment appended to Str1.
  @param Report When TRUE, route output to the report subsystem; otherwise to live UI.
  @param Warning When TRUE, mark the message as a warning in the chosen channel.
  @param Error When TRUE, mark the message as an error in the chosen channel.
  @param Debug Passed through to the helper for potential diagnostic behavior.

  @return None.

  @note Concatenation is direct with no delimiter; caller must include spaces if needed.

  @post Combined message may be emitted to UI and/or report depending on flags.

  @sideeffects Produces user-visible/report-visible output via ui_print_helper.

  @header
  ui_print_str_2(Str1: string; Str2: string; Report: boolean = FALSE; Warning: boolean = FALSE; Error: boolean = FALSE; Debug: boolean = FALSE): void;
  Concatenate two strings then print via helper.
*}
function ui_print_str_2(Str1: string; Str2: string; Report: boolean = FALSE; Warning: boolean = FALSE; Error: boolean = FALSE; Debug: boolean = FALSE): void;
begin
   // Initialize with Str1 and append Str2.
   Str = StrAdd(Str1, Str2);

   // Forward the combined string and flags to the printing helper.
   ui_print_helper(Str, Report, Warning, Error, Debug);
   
end;

{**
  @brief Concatenate three text segments (Str1 + Str2 + Str3) and emit via the printing helper.

  @details
  Sequentially appends Str2 and Str3 to Str1 (no separators inserted) to form the
  message payload, then forwards it with all severity/route flags to the helper.

  @param Str1 First text segment.
  @param Str2 Second text segment.
  @param Str3 Third text segment.
  @param Report When TRUE, route output to the report subsystem; otherwise to live UI.
  @param Warning When TRUE, mark the message as a warning in the chosen channel.
  @param Error When TRUE, mark the message as an error in the chosen channel.
  @param Debug Passed through to the helper for potential diagnostic behavior.

  @return None.

  @note Concatenation is direct with no delimiter; caller must include spaces if needed.

  @post Combined message may be emitted to UI and/or report depending on flags.

  @sideeffects Produces user-visible/report-visible output via ui_print_helper.

  @header
  ui_print_str_3(Str1: string; Str2: string; Str3: string; Report: boolean = FALSE; Warning: boolean = FALSE; Error: boolean = FALSE; Debug: boolean = FALSE): void;
  Concatenate three strings then print via helper.
*}
function ui_print_str_3(Str1: string; Str2: string; Str3: string; Report: boolean = FALSE; Warning: boolean = FALSE; Error: boolean = FALSE; Debug: boolean = FALSE): void;
begin
   // Initialize with Str1 and append Str2.
   Str = StrAdd(Str1, Str2);
   // Append Str3 to the intermediate string.
   Str = StrAdd(Str, Str3);

   // Forward the combined string and flags to the printing helper.
   ui_print_helper(Str, Report, Warning, Error, Debug);
   
end;

{**
  @brief Concatenate four text segments (Str1 + Str2 + Str3 + Str4) and emit via the printing helper.

  @details
  Sequentially appends Str2, Str3, and Str4 to Str1 (no separators inserted) to
  build the message payload, then forwards it with all severity/route flags.

  @param Str1 First text segment.
  @param Str2 Second text segment.
  @param Str3 Third text segment.
  @param Str4 Fourth text segment.
