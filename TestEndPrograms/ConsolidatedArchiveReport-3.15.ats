constants
begin
{
   For consistency, precise files begin with 'FILE_' whereas templates intended
   to be transformed into another string by calling StrReplace(); or
   archive_protocol(); begin with 'TMPL_'.
}
   FILE_CUSTOMERS = 'O:\Test Eng\Support_Files\W434\customers.ini';
   TMPL_DURATION = 'O:\Test Eng\Support_Files\W434\durations\$STATION$.txt';

   FILE_REPORT_TXT_BJI = 'C:\Users\Public\Documents\CEETIS\Temp\Reports\DefaultReport_txt.txt';
   FILE_REPORT_NORTECH_TXT_BJI = 'C:\Users\Public\Documents\CEETIS\Temp\Reports\Nortech_Default_TXT.txt';
   TMPL_ARCHIVE_TXT_BJI = 'O:\Test Eng\DATA\W434\<Year>\$CUST$\<ProjectName>\<ProjectName>-<SerialNumber>-<Year><Month><Day>-<Hour><Minute><Second>.txt';

   TMPL_REPORT_HTML_COLLINS = 'C:\Users\Public\Documents\CEETIS\Temp\Reports\ATP-$ATPNUM$_html.html';
   TMPL_REPORT_PDF_COLLINS = 'C:\REX\output\ATP-$ATPNUM$.pdf';
   TMPL_ARCHIVE_HTML_COLLINS = 'O:\Test Eng\DATA\W434\<Year>\COLLINS_HTML\<ProjectName>\<ProjectName>-<SerialNumber>-<Year><Month><Day>-<Hour><Minute><Second>.html';
   TMPL_ARCHIVE_PDF_COLLINS = 'O:\Test Eng\DATA\W434\<Year>\COLLINS_PDF\<ProjectName>\<ProjectName>-<SerialNumber>-<Year><Month><Day>-<Hour><Minute><Second>.pdf';

   FILE_REPORT_PDF_AERO_DEFAULT = 'C:\REX\output\AS-DEFAULT.pdf';
   FILE_REPORT_PDF_KLUNE_DEFAULT = 'C:\REX\output\KLUNE-DEFAULT.pdf';
   TMPL_ARCHIVE_PDF_AERO_DEFAULT = 'O:\Test Eng\DATA\W434\<Year>\$CUST$_PDF\<ProjectName>\<ProjectName>-<SerialNumber>-<Year><Month><Day>-<Hour><Minute><Second>.pdf';

   PYTHON_EXE = 'C:\Python\pythonw.exe';

   REX_PARAMS_DEFAULT_AERO = 'C:\REX\rex.py -m default_as -r C:\Users\Public\Documents\CEETIS\Temp\Reports\DefaultReport_txt.txt -o AS-DEFAULT.pdf';
   REX_PARAMS_NORTECH_AERO = 'C:\REX\rex.py -m default_as -r C:\Users\Public\Documents\CEETIS\Temp\Reports\Nortech_Default_TXT.txt -o AS-DEFAULT.pdf';

   REX_PARAMS_DEFAULT_KLUNE = 'C:\REX\rex.py -m w434_klune -r C:\Users\Public\Documents\CEETIS\Temp\Reports\DefaultReport_txt.txt -o KLUNE-DEFAULT.pdf --force-invalid-output';
   REX_PARAMS_NORTECH_KLUNE = 'C:\REX\rex.py -m w434_klune -r C:\Users\Public\Documents\CEETIS\Temp\Reports\Nortech_Default_TXT.txt -o KLUNE-DEFAULT.pdf --force-invalid-output';

   TMPL_REX_PARAMS_COLLINS_ATP = 'C:\REX\rex.py -m atp$ATPNUM$ -r ATP-$ATPNUM$_html.html -o ATP-$ATPNUM$.pdf';

   // TSX report is the same as FILE_REPORT_TXT_BJI until a custom TSX format is final.
   FILE_REPORT_TXT_TSX = 'C:\Users\Public\Documents\CEETIS\Temp\Reports\DefaultReport_txt.txt';
   TMPL_ARCHIVE_TXT_TSX = '\\az-fs1\chksmPBI\Weetech Reports\Bemidji\<ProjectName>-<SerialNumber>-<Year><Month><Day>-<Hour><Minute><Second>.txt';

   // Path breaks down as follows:
   // 1: "O:"
   // 2: "Test Eng"
   // 3: "434"
   // 4: CUSTOMER_NAME or DIR_TO_MAP_TO_CUSTOMER_NAME
   PARENT_INDEX = 4;
end;


function record_duration(): void;
begin
{
   Write test durations out to a file unique to the test station.
}
   TestStationID = MiscGetTestStationIdentifier();
   DurationFile = StrReplace(TMPL_DURATION, '$STATION$', TestStationID, FALSE);
   Handle = FileOpenText(DurationFile);

   if (Handle <> 0)
   begin
      Assembly = ProjectGetFilename();

      StartTime = DTGetTestDateTime();
      EndTime = DTNow();
      Duration = EndTime - StartTime;

      Hours = DTHour(Duration);
      Minutes = DTMinute(Duration);
      Seconds = DTSecond(Duration);

      HoursInSeconds = Hours * 3600;
      MinutesInSeconds = Minutes * 60;

      TotalSeconds = HoursInSeconds + MinutesInSeconds + Seconds;
      TotalSeconds = StrAdd(TotalSeconds, 's');

      Years = DTYear(StartTime);
      Months = DTMonth(StartTime);
      Days = DTDay(StartTime);
      Hours = DTHour(StartTime);
      Minutes = DTMinute(StartTime);
      Seconds = DTSecond(StartTime);


      // Get test result
      UserBreak = FALSE;
      Passed = FALSE;
      TestEndGetTestResult(UserBreak, Passed);

      if (UserBreak)
      begin
         TestResult = 'ABORT';
      end
      else
      begin
         if (Passed)
         begin
            TestResult = 'PASS';
         end
         else
         begin
            TestResult = 'FAIL';
         end;
      end;

      SerialNumber = GlobalDataGetSerialNumber();
      if (StrCompare(SerialNumber, '') == 0)
      begin
         SerialNumber = 'NULL';
      end;

      Line = StrAdd(Assembly, '|');
      Line = StrAdd(Line, TotalSeconds);
      Line = StrAdd(Line, '|');
      Line = StrAdd(Line, Years);
      Line = StrAdd(Line, '-');
      Line = StrAdd(Line, Months);
      Line = StrAdd(Line, '-');
      Line = StrAdd(Line, Days);
      Line = StrAdd(Line, ' ');
      Line = StrAdd(Line, Hours);
      Line = StrAdd(Line, ':');
      Line = StrAdd(Line, Minutes);
      Line = StrAdd(Line, ':');
      Line = StrAdd(Line, Seconds);
      Line = StrAdd(Line, '|');
      Line = StrAdd(Line, TestResult);
      Line = StrAdd(Line, '|');
      Line = StrAdd(Line, SerialNumber);

      FileAddText(Handle, Line);
      FileSaveText(Handle);
   end;

   FileCloseText(Handle);
end;


function resolve_customer_name(): string;
begin
{
   Infer the customer name.

   Start by checking global data, which could be set via
   set_customer('CUST_NAME') in NortechUtil.unit, or could also have been set
   directly. If no value is set in global data, use the parent directory in
   conjunction with the mapping file. This allows us to map things like 'GE_C8'
   to 'GEHC', or 'NORTHROP' to 'NORTHROP GRUMMAN'. If no customer mapping is
   found, just use the parent directory.
}
   Customer = GlobalDataRead('Customer', 'DEFAULT');

   // IF NOT SPECIFIED, USE PARENT DIRECTORY TO INFER CUSTOMER WHEN POSSIBLE
   // ADD NEW CUSTOMER DEFINITIONS WITHIN THE CUSTOMERS FILE SPECIFIED AT THE
   // TOP OF THIS SOURCE CODE FILE.
   if (StrCompare(Customer, 'DEFAULT') == 0)
   begin
      ProjectFilename = ProjectGetFilename();

      // IF THE TEST IS INSIDE THE TEST LAB FOLDER, SET CUSTOMER TO 'TEST LAB'.
      IsTestLab = StrPosition('TEST LAB', ProjectFilename);

      if (IsTestLab)
      begin
         Customer = 'TEST LAB';
      end
      else
      begin
         Handle = FileOpenIni(FILE_CUSTOMERS);

         if (Handle == 0)
         begin
            UIErrorDialog('COULD NOT OPEN CUSTOMERS INDEX FILE.<BR><BR>CONTACT TEST LAB.');
         end
         else
         begin
            // USE THE PARENT DIR NAME TO REMAP TO CUSTOMER NAME
            MiscListFromString(ProjectFilename, PathParts, '\');

            if (StrCompare(PathParts[2], 'Test Eng') == 0 AND StrCompare(PathParts[3], '434') == 0)
            begin
               Customer = FileGetIni(Handle, 'DirectoryMap', PathParts[PARENT_INDEX], Customer);
            end;
         end;

         FileCloseIni(Handle);
      end;
   end;

   Result = Customer;
end;


function archive_collins_atp_pass(ATPNum: string): void;
begin
{
   Use CEETIS CUP to run Python for Collins data sheet generation.

   ATPNum: This value should map to a defined REX ATP module, so a value of
           '2723' will map to the REX module 'atp2723.py'.

   Checks to ensure the test is not a PRETEST. Uses CUP to launch Python with
   parameters matching the test. Cleans up after itself so we don't
   accidentally reuse the generated PDF.
}
   ProjectFilename = ProjectGetFilename();
   IsPretest = StrContains('*PRE*', ProjectFilename, FALSE);

   if (NOT IsPretest)
   begin
      // Execute external util for processing of report & forced print.
      UIWriteNormal('LAUNCHING REX FOR REPORT PROCESSING...');
      Params = StrReplace(TMPL_REX_PARAMS_COLLINS_ATP, '$ATPNUM$', ATPNum, TRUE);
      CUPExecuteCommand('CEETIS_CUP_001', 'run program', [PYTHON_EXE, Params], 30s, ResultData);

      CollinsPDFReport = StrReplace(TMPL_REPORT_PDF_COLLINS, '$ATPNUM$', ATPNum, FALSE);

      if (FileExists(CollinsPDFReport))
      begin
         archive_protocol(CollinsPDFReport, TMPL_ARCHIVE_PDF_COLLINS, TRUE, FALSE, FALSE);
         FileDelete(CollinsPDFReport);
      end;
   end;
end;


function assembly_is_aerospace(): boolean;
begin
   ProjectPathAndFilename = ProjectGetFilename();
   Count = MiscListFromString(ProjectPathAndFilename, PathParts, '\');

   // Take the first three characters of the test name and make it uppercase
   AssemblyType = StrUpperCase(StrCopy(PathParts[Count], 1, 3));

   if (StrCompare(AssemblyType, 'AS-') == 0)
   begin
      Result = TRUE;
   end
   else
   begin
      Result = FALSE;
   end;
end;


function archive_default_aero_pdf(Customer: string; Debug: boolean = FALSE): void;
begin
{
   Use CEETIS CUP to run Python for report generation.

   Call REX with parameters for default 'AS-' reporting.

   Checks to ensure the test is not a PRETEST. Uses CUP to launch Python with
   parameters matching the test. Cleans up after itself so we don't
   accidentally reuse the generated PDF.
}
   ProjectFilename = ProjectGetFilename();
   IsPretest = StrPosition('PRE', ProjectFilename);

   if (IsPretest == 0)
   begin
      // Execute external util for processing of report & forced print.

      UIWriteNormal('LAUNCHING REX FOR REPORT PROCESSING...');

      CommandResult = CUP_Result_ProgramNotStarted;

      if (FileExists(FILE_REPORT_NORTECH_TXT_BJI))
      begin
         CommandResult = CUPExecuteCommand('CEETIS_CUP_001', 'run program', [PYTHON_EXE, REX_PARAMS_NORTECH_AERO], 30s, ResultData);
      end
      else
      begin
         if (FileExists(FILE_REPORT_TXT_BJI))
         begin
            CommandResult = CUPExecuteCommand('CEETIS_CUP_001', 'run program', [PYTHON_EXE, REX_PARAMS_DEFAULT_AERO], 30s, ResultData);
         end
         else
         begin
            UIWriteError('COULD NOT FIND TEST REPORT FOR REX! CONTACT TEST DEPARMENT!');
         end;
      end;

   if (Debug)
   begin
   if (CommandResult > 0)
   begin
      for Zaehl = 1 to CommandResult do
      begin
         UIWriteWarning(StrAdd(StrAdd(Zaehl, ': '), ResultData[Zaehl]));
      end;
   end
   else
   begin

      switch (CommandResult)
      begin
         case CUP_Result_ProgramNotFound: begin
            UIWriteError('Program not found');
         end;
         case CUP_Result_ProgramNotStarted: begin
            UIWriteError('Program could not be started');
         end;
         case CUP_Result_CommandSendError: begin
            UIWriteError('Command could not be sent');
         end;
         case CUP_Result_CommandTimeout: begin
            UIWriteError('Command timed out');
         end;
         case CUP_Result_NotACUP: begin
            UIWriteError('Not a CUP');
         end;
         default: begin
            UIWriteError('Unknown error');
         end;
      end;
   end;
   end;


      ReportDest = StrReplace(TMPL_ARCHIVE_PDF_AERO_DEFAULT, '$CUST$', Customer, FALSE);

      if (FileExists(FILE_REPORT_PDF_AERO_DEFAULT))
      begin
         archive_protocol(FILE_REPORT_PDF_AERO_DEFAULT, ReportDest, TRUE, FALSE, FALSE);
         FileDelete(FILE_REPORT_PDF_AERO_DEFAULT);
      end;
   end;
end;

