   end;

end;

{**
  @brief Verify a guard option's sentinel: if the option is required, it must have been tested.

  @param OptionStr  Option key suffix used to form "REQUIRE_<OptionStr>" and "TESTED_<OptionStr>" entries.
  @param Debug      Enables verbose/interactive behavior in user interface helpers.

  @return boolean   TRUE if either (a) the option is not required, or (b) it is required and has been tested.
                    FALSE if the option is required but has not been tested.

  @details
  Reads the requirement and tested state for a guard option from the "GUARDS" namespace.
  If the option is marked required but not tested, an error string is constructed and both a
  log entry and an error dialog are issued. Otherwise, the result is TRUE.

  @pre GlobalDataRead, StrAdd, StrCompare, UIWriteError, and UIErrorDialog are available.
  @post On required-but-untested, an error is logged and an error dialog is displayed.
  @sideeffect Emits user interface feedback via UIWriteError and UIErrorDialog on failures.
**}
function test_options_sentinal(OptionStr: string; Debug: boolean = FALSE): boolean;
begin
   // Default pessimistically: assume sentinel not satisfied until checks pass.
   Result = FALSE;

   // Read required/tested flags for this option from the "GUARDS" namespace.
   Required = GlobalDataRead(StrAdd('REQUIRE_', OptionStr), 'NULL', 'GUARDS');
   Tested = GlobalDataRead(StrAdd('TESTED_', OptionStr), 'NULL', 'GUARDS');

   // Branch: if this option is marked required, enforce that it was tested.
   if (StrCompare(Required, 'TRUE') == 0)
   begin
      // Required: pass only if the tested flag is explicitly TRUE.
      if (StrCompare(Tested, 'TRUE') <> 0)
      begin
         // Compose and report the failure condition to the operator/log.
         OptionErrorStr = StrAdd(OptionStr, ' TEST REQUIRED BUT NOT TESTED!');
         UIWriteError(OptionErrorStr);

         // Present an interactive error dialog to ensure visibility.
         UIErrorDialog(OptionErrorStr);
      end
      else
      begin
         // Required and tested: sentinel satisfied.
         Result = TRUE;
      end;
   end
   else
   begin
      // Not required: sentinel trivially satisfied.
      Result = TRUE;
   end;
end;

{**
  @brief Check that all guard option sentinels are satisfied: continuity, low voltage, high voltage, and dielectric breakdown.

  @param UserBreak Wehn TRUE, skips checking sentinals since the user aborted the test.
  @param Debug  When TRUE, enables verbose/interactive behavior in called verification routines.

  @return boolean  TRUE only if every required guard option is confirmed tested; FALSE if any required
                   option (continuity, low voltage, high voltage, dielectric breakdown) is required
                   but not tested.

  @details
  This routine delegates to test_options_sentinal for each guard category. It starts with an
  optimistic TRUE and sets the overall result to FALSE upon any failing sentinel check. The four
  categories validated are:
   - Continuity
   - Low voltage
   - High voltage
   - Dielectric breakdown

  @pre test_options_sentinal is available and performs the required/tested verification, including
       any user interface error reporting.
  @post The called sentinel checks may emit user-facing errors or dialogs if requirements are unmet.
**}
function test_options_all_sentinals(UserBreak: boolean; Debug: boolean = FALSE): boolean;
begin

   // Start optimistic: assume all sentinels are satisfied until a check fails.
   Result = TRUE;

   if (UserBreak == FALSE)
      begin
      // Continuity sentinel: fail overall if continuity is required but not tested.
      if (test_options_sentinal('CONTINUITY', Debug) == FALSE)
      begin
         Result = FALSE;
      end;

      // Low voltage sentinel: fail overall if low voltage is required but not tested.
      if (test_options_sentinal('LV', Debug) == FALSE)
      begin
         Result = FALSE;
      end;

      // High voltage sentinel: fail overall if high voltage is required but not tested.
      if (test_options_sentinal('HV', Debug) == FALSE)
      begin
         Result = FALSE;
      end;

      // Dielectric breakdown sentinel: fail overall if dielectric breakdown is required but not tested.
      if (test_options_sentinal('DB', Debug) == FALSE)
      begin
         Result = FALSE;
      end;
   end;
end;


function main(): void;
begin
   // Get test result
   UserBreak = FALSE;
   Passed = FALSE;
   TestEndGetTestResult(UserBreak, Passed);

   Sentinal = test_options_all_sentinals(UserBreak);

   if (Sentinal == FALSE)
   begin
      UIWriteError('*************************************************************');
      UIWriteError('* ERROR! A REQUIRED SENTINAL WAS NOT SET! CONTACT TEST LAB! *');
      UIWriteError('*************************************************************');
   end
   else
   begin

      if (print_allowed())
      begin
         PrintAllReports();
      end;

      ArchiveTestResult();

      record_duration();

      if (Passed)
      begin
         // moved record_duration() so ABORT & FAIL would also be recorded.
      end
      else
      begin
         // Brief message if aborted by user
         if (UserBreak)
         begin
            UIWriteNormal('');
            Text = '----- ';
            Text = StrAdd(Text, LocalText('49#Aborted by user'));
            Text = StrAdd(Text, ' -----');
            UIWriteWarning(Text);
         end
         else
         begin
            unplug_check();
         end;
      end;


      {******************************************************************************
      *   ARCHIVING SECTION REFERENCE
      *   archive_protocol(SOURCE, DEST, PASS, FAIL, ABORT);
      *      SOURCE (String): Full path to source report.
      *      DEST (String): Destination string as template.
      *      PASS (Boolean): Archive passing test.
      *      FAIL (Boolean): Archive failing test.
      *      ABORT (Boolean): Archive aborted test.
      *
      *   First archive all BJI reports (passing & failing, no aborts).
      *   Second, check for additional customer-specific requirements.
      *   Third, archvie all TSX reports (passing & failing, no aborts).
      ******************************************************************************}

      Customer = resolve_customer_name();

      // ARCHIVE FOR BJI IN ALL PASS/FAIL CIRCUMSTANCES
      BJIArchive = StrReplace(TMPL_ARCHIVE_TXT_BJI, '$CUST$', Customer, FALSE);

      if (FileExists(FILE_REPORT_NORTECH_TXT_BJI))
      begin
         archive_protocol(FILE_REPORT_NORTECH_TXT_BJI, BJIArchive, TRUE, TRUE, FALSE);
      end
      else
      begin
         if (FileExists(FILE_REPORT_TXT_BJI))
         begin
            archive_protocol(FILE_REPORT_TXT_BJI, BJIArchive, TRUE, TRUE, FALSE);
         end
         else
         begin
            UIWriteError('ERROR: COULD NOT FIND TEST REPORT FILE! CONTACT TEST DEPARTMENT!');
         end;
      end;



      // ARCHIVE & PROCESSING RULES FOR SPECIFIC CUSTOMERS
      // NOTE: If matched against a customer, ensure all possible sub-cases are handled!
      //       i.e. match against COLLINS and then handle ATPs, but also handle non-ATP 'AS'
      //       assemblies. Base archive_protocol prior to switch/case block will ensure
      //       default reports are preserved.

      // Check if we need to skip launching REX
      Skip_REX = get_skip_rex();
      if (Skip_REX)
      begin
         UIWriteNormal('REX HAS BEEN DISABLED FOR THIS TEST.');
      end;

      switch (Customer)
      begin
         case 'COLLINS':
         begin
            // Only do extra work if covered by an ATP.
            ATPNum = GlobalDataRead('Collins.ATP', 'NULL');

            if (StrCompare(ATPNum, 'NULL') <> 0)
            begin
               CollinsReport = StrReplace(TMPL_REPORT_HTML_COLLINS, '$ATPNUM$', ATPNum, FALSE);
               archive_protocol(CollinsReport, TMPL_ARCHIVE_HTML_COLLINS, TRUE, TRUE, FALSE);

               // When passing, create the Collins data sheet PDF
               if (Passed)
               begin
                  archive_collins_atp_pass(ATPNum);
               end;
            end
            else
            begin
               if (assembly_is_aerospace() AND NOT Skip_REX)
               begin
                  archive_default_aero_pdf(Customer);
               end;
            end;
         end;
         case 'TRIUMPH':
         begin
            // do nothing since these reports are handled 'custom'. thanks, rob.
         end;
         case 'KLUNE':
         begin
            archive_nortech_klune_pdf(Customer);
         end;
         case 'TEST LAB':
         begin
            // Never write a TSX report for TEST LAB tests
            GlobalDataWrite('Nortech.NOTSX', '1');
         end;
         default:
         begin
            // Default actions for tests not previously handled.
            // For all 'AS-' assemblies, post-process to include header on each page
            if (assembly_is_aerospace() AND NOT Skip_REX AND Passed)
            begin
               archive_default_aero_pdf(Customer);
            end;
         end;
      end;

      // LASTLY ARCHIVE FOR TSX IF THIS IS A NON-TEST LAB TEST RESULT
      // No_TSX = GlobalDataRead('Nortech.NOTSX', '0');
      No_TSX = '1'; // TSX appears to be dead, so stop archiving additional reports for now.
      if (StrCompare(No_TSX, '1') <> 0)
      begin
         archive_protocol(FILE_REPORT_TXT_TSX, TMPL_ARCHIVE_TXT_TSX, TRUE, TRUE, FALSE);
      end;

      timer_stop(FALSE, TRUE);

      if (UserBreak)
      begin
         timer_disp_str('ABORT', FALSE, FALSE);
      end
      else
      begin
         if (Passed)
         begin
            timer_disp_str('PASS', FALSE, FALSE);
         end
         else
         begin
            timer_disp_str('FAIL', FALSE, FALSE);
         end;
      end;

      // Show the test result if the test passed or failed
      UITestResult(Passed, UserBreak, TRUE, 600s);

      // If global data is not cleared, Operator ID will be preserved between
      // unrelated tests. Last verified in CEETIS 4.13-08.
      GlobalDataClear();

      // Two files may be created by the tests now until we consolidate all testers.
      // Once we archive, we need to delete so we don't process previous test results
      if (FileExists(FILE_REPORT_NORTECH_TXT_BJI))
      begin
         FileDelete(FILE_REPORT_NORTECH_TXT_BJI);
      end
      else
      begin
         if (FileExists(FILE_REPORT_TXT_BJI))
         begin
            FileDelete(FILE_REPORT_TXT_BJI);
         end
         else
         begin
            UIWriteError('COULD NOT DELETE TEMP TEST RESULT! CONTACT TEST DEPARTMENT!');
         end;
      end;
   end;
end;

