constants
begin
{
   For consistency, precise files begin with 'FILE_' whereas templates intended
   to be transformed into another string by calling StrReplace(); or
   archive_protocol(); begin with 'TMPL_'.
}
   FILE_OPERATOR_ID_MAP = 'O:\Test Eng\Support_Files\W434\operator_id_mapping.ini';
end;

{**
  @brief   Retrieve the operator?s name from the operator ID mapping file.
  @details
    1. Attempts to open the INI file defined by `FILE_OPERATOR_ID_MAP`.
    2. Reads the current operator ID from global data key `"Value1"` in `"TestStart InputData"`.
    3. If no operator ID input exists, treats the operator ID as optional and returns success.
    4. If an operator ID input exists, looks up the corresponding name in the `[OperatorID]` section using that ID.
    5. If the file cannot be opened or the lookup returns `"NULL"`, displays error dialogs, logs the error, and aborts the test.
   @return  TRUE if no operator ID was supplied or if the supplied operator ID is valid; aborts on invalid supplied ID.
**}
function is_operator_id_valid(): string;
begin
   // Default to false until no operator ID is required or a valid name is found
   Result = FALSE;

   // Open the operator ID mapping INI file
   Handle = FileOpenIni(FILE_OPERATOR_ID_MAP);

   if (Handle == 0)
   begin
      // Failed to open file => notify operator and prevent further testing
      UIErrorDialog('COULD NOT OPEN OPERATOR ID FILE.<BR><BR>CONTACT TEST LAB.');
   end
   else
   begin
      // Retrieve the operator ID from global data. NULL means no operator ID line was supplied.
      Operator = GlobalDataRead('Value1', 'NULL', 'TestStart InputData');

      if (StrCompare(Operator, 'NULL') == 0)
      begin
         // No operator ID line exists for this test; treat operator ID as optional.
         FileCloseIni(Handle);
         Result = TRUE;
      end
      else
      begin
         // Fetch the name corresponding to the supplied operator ID
         OperatorName = FileGetIni(Handle, 'OperatorID', Operator, 'NULL');
         FileCloseIni(Handle);

         if (StrCompare(OperatorName, 'NULL') == 0)
         begin
            // Operator ID was supplied but no matching name was found => log error, report, and abort
            UIWriteError('OPERATOR ID NOT FOUND. CONTACT TEST LAB');
            ReportWriteError('OPERATOR ID NOT FOUND, TEST AUTOMATICALLY ABORTED.');
            MiscAbortTest();
         end
         else
         begin
            // Valid name found => return success
            Result = TRUE;
         end;
      end;
   end;
end;