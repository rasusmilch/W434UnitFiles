function main(): void;
begin
   UIClearScreen();

   TestInitialized = TRUE;

   //Prompt for order number if enabled
   OrderNumber = ProjectGetTestInitSettings(TESTINIT_OrderNumber);
   if (OrderNumber)
   begin
      TestInitialized = ordernumber();
   end;
   
   if (NOT TestInitialized)
   begin
      TestInitSetTestAllowed(FALSE);
   end;
end;

